<script>
document.addEventListener('DOMContentLoaded', function() {

  // =========================================
  // PARALLAX DATA POINTS
  // =========================================
  const dataPointsContainer = document.getElementById('dcParallaxData');
  
  if (dataPointsContainer) {
    let ticking = false;
    
    window.addEventListener('scroll', function() {
      if (!ticking) {
        window.requestAnimationFrame(function() {
          const scrollY = window.pageYOffset;
          dataPointsContainer.style.transform = `translateY(${scrollY * 0.3}px)`;
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  }

  // =========================================
  // SCROLL REVEAL FOR DATA CARDS
  // =========================================
  const observerOptions = {
    threshold: 0.2,
    rootMargin: '0px 0px -60px 0px'
  };

  const revealObserver = new IntersectionObserver(function(entries) {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
      }
    });
  }, observerOptions);

  document.querySelectorAll('[data-scroll-reveal]').forEach(card => {
    revealObserver.observe(card);
  });

  // =========================================
  // INTERACTIVE STAGE BADGES
  // =========================================
  const stageBadges = document.querySelectorAll('.stage-badge');
  const stagePanels = document.querySelectorAll('.stage-panel');

  stageBadges.forEach(badge => {
    badge.addEventListener('click', function() {
      const targetStage = this.getAttribute('data-stage');
      
      // Update active badge
      stageBadges.forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      
      // Show corresponding panel
      stagePanels.forEach(panel => {
        panel.classList.remove('active');
        if (panel.id === `stage-${targetStage}`) {
          panel.classList.add('active');
        }
      });
    });
  });

});
</script>