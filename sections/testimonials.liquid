{% comment %}
  Testimonials Section
  Minimal glass cards, star ratings, avatar + name
  Masonry-style layout on desktop, scroll reveal stagger
{% endcomment %}

<style>
/* ── SECTION ──────────────────────────────────────────────────── */
.ta-testi {
  padding: var(--testi-pt, 5.5rem) 1.5rem var(--testi-pb, 5.5rem);
  background: var(--ta-bg-surface, #0E0E12);
  position: relative;
  overflow: hidden;
}

/* Ambient glows */
.ta-testi::before {
  content: '';
  position: absolute;
  top: -10%;
  right: -5%;
  width: 500px; height: 500px;
  background: radial-gradient(circle, rgba(6,182,212,0.06) 0%, transparent 65%);
  filter: blur(60px);
  pointer-events: none;
}

.ta-testi::after {
  content: '';
  position: absolute;
  bottom: -10%;
  left: -5%;
  width: 400px; height: 400px;
  background: radial-gradient(circle, rgba(124,58,237,0.06) 0%, transparent 65%);
  filter: blur(60px);
  pointer-events: none;
}

/* ── HEADER ───────────────────────────────────────────────────── */
.ta-testi__inner { max-width: 1200px; margin: 0 auto; position: relative; }

.ta-testi__hdr {
  text-align: center;
  margin-bottom: clamp(2.5rem, 5vw, 4rem);
}

.ta-testi__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: #67E8F9;
  margin-bottom: 1rem;
}

html[data-theme="light"] .ta-testi__eyebrow { color: #0891B2; }

.ta-testi__eyebrow::before {
  content: '';
  width: 5px; height: 5px;
  border-radius: 50%;
  background: #06B6D4;
  box-shadow: 0 0 8px rgba(6,182,212,0.9);
  flex-shrink: 0;
}

.ta-testi__title {
  font-family: var(--ta-font-display, 'Plus Jakarta Sans', sans-serif);
  font-size: clamp(1.9rem, 4vw, 3rem);
  font-weight: 800;
  letter-spacing: -0.035em;
  line-height: 1.15;
  color: var(--ta-text-primary, #F8F8FF);
  margin: 0;
}

html[data-theme="light"] .ta-testi__title { color: #1A1A2E; }

/* ── MASONRY GRID ─────────────────────────────────────────────── */
.ta-testi__grid {
  display: grid;
  grid-template-columns: repeat(var(--testi-cols, 3), 1fr);
  gap: 1.25rem;
  align-items: start;
}

@media (max-width: 960px)  { .ta-testi__grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 560px)  { .ta-testi__grid { grid-template-columns: 1fr; } }

/* ── CARD ─────────────────────────────────────────────────────── */
.ta-testi__card {
  background: var(--ta-bg-elevated, #18181E);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 20px;
  padding: 1.75rem;
  position: relative;
  overflow: hidden;
  transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
}

html[data-theme="light"] .ta-testi__card {
  background: rgba(255,255,255,0.85);
  border-color: rgba(0,0,0,0.06);
  box-shadow: 0 2px 16px rgba(0,0,0,0.05);
}

.ta-testi__card:hover {
  border-color: rgba(6,182,212,0.2);
  box-shadow: 0 12px 40px rgba(0,0,0,0.35), 0 0 40px rgba(6,182,212,0.05);
  transform: translateY(-3px);
}

html[data-theme="light"] .ta-testi__card:hover {
  border-color: rgba(8,145,178,0.15);
  box-shadow: 0 8px 32px rgba(0,0,0,0.09);
}

/* Top edge line */
.ta-testi__card::before {
  content: '';
  position: absolute;
  top: 0; left: 15%; right: 15%;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(6,182,212,0.35) 50%, transparent);
  pointer-events: none;
}

/* ── Quote mark ── */
.ta-testi__quote-mark {
  font-size: 3.5rem;
  line-height: 1;
  color: rgba(6,182,212,0.25);
  font-family: Georgia, serif;
  margin-bottom: 0.25rem;
  display: block;
}

html[data-theme="light"] .ta-testi__quote-mark { color: rgba(8,145,178,0.2); }

/* ── Stars ── */
.ta-testi__stars {
  display: flex;
  gap: 2px;
  margin-bottom: 1rem;
}

.ta-testi__star {
  width: 14px; height: 14px;
  color: #E3FC02;
}

html[data-theme="light"] .ta-testi__star { color: #CA9A00; }

/* ── Quote text ── */
.ta-testi__text {
  font-size: 0.9rem;
  line-height: 1.7;
  color: var(--ta-text-secondary, rgba(248,248,255,0.7));
  margin: 0 0 1.5rem;
  font-style: italic;
}

html[data-theme="light"] .ta-testi__text { color: #52526B; }

/* ── Author row ── */
.ta-testi__author {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.ta-testi__avatar {
  width: 40px; height: 40px;
  border-radius: 50%;
  object-fit: cover;
  border: 1px solid rgba(255,255,255,0.1);
  flex-shrink: 0;
  background: rgba(124,58,237,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1rem;
  overflow: hidden;
}

html[data-theme="light"] .ta-testi__avatar { border-color: rgba(0,0,0,0.08); }

.ta-testi__author-info { min-width: 0; }

.ta-testi__name {
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--ta-text-primary, #F8F8FF);
  letter-spacing: -0.01em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

html[data-theme="light"] .ta-testi__name { color: #1A1A2E; }

.ta-testi__role {
  font-size: 0.76rem;
  color: var(--ta-text-tertiary, rgba(248,248,255,0.35));
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

html[data-theme="light"] .ta-testi__role { color: #8E8EA6; }

/* ── Scroll reveal ── */
.ta-testi__card {
  opacity: 0;
  transform: translateY(20px);
  transition:
    opacity 0.65s cubic-bezier(0.22,1,0.36,1),
    transform 0.65s cubic-bezier(0.22,1,0.36,1),
    border-color 0.3s ease,
    box-shadow 0.3s ease;
}

.ta-testi__card.ta-is-visible { opacity: 1; transform: translateY(0); }

@media (prefers-reduced-motion: reduce) {
  .ta-testi__card { opacity: 1 !important; transform: none !important; }
}
</style>

<section
  class="ta-testi"
  style="
    --testi-pt: {{ section.settings.padding_top }}px;
    --testi-pb: {{ section.settings.padding_bottom }}px;
    --testi-cols: {{ section.settings.columns }};
  "
>
  <div class="ta-testi__inner">

    {%- if section.settings.eyebrow != blank or section.settings.title != blank -%}
      <div class="ta-testi__hdr ta-animate ta-animate-fade-up">
        {%- if section.settings.eyebrow != blank -%}
          <div class="ta-testi__eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="ta-testi__title">{{ section.settings.title }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="ta-testi__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'testimonial' -%}
          <div
            class="ta-testi__card"
            style="transition-delay: {{ forloop.index0 | times: 0.1 }}s;"
            {{ block.shopify_attributes }}
          >
            <span class="ta-testi__quote-mark" aria-hidden="true">&ldquo;</span>

            <!-- Stars -->
            {%- if block.settings.stars > 0 -%}
              <div class="ta-testi__stars" aria-label="{{ block.settings.stars }} out of 5 stars">
                {%- for i in (1..5) -%}
                  <svg class="ta-testi__star" viewBox="0 0 20 20" fill="{% if i <= block.settings.stars %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="1.5">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- if block.settings.quote != blank -%}
              <p class="ta-testi__text">{{ block.settings.quote }}</p>
            {%- endif -%}

            <div class="ta-testi__author">
              <div class="ta-testi__avatar">
                {%- if block.settings.avatar != blank -%}
                  {{ block.settings.avatar | image_url: width: 80 | image_tag: loading: 'lazy', alt: block.settings.name }}
                {%- else -%}
                  {{ block.settings.name | slice: 0 | upcase }}
                {%- endif -%}
              </div>
              <div class="ta-testi__author-info">
                <p class="ta-testi__name">{{ block.settings.name }}</p>
                <p class="ta-testi__role">{{ block.settings.role }}</p>
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

<script>
(function () {
  var cards = document.querySelectorAll('.ta-testi__card');
  if (!cards.length) return;
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) { e.target.classList.add('ta-is-visible'); io.unobserve(e.target); }
    });
  }, { threshold: 0.1 });
  cards.forEach(function (c) { io.observe(c); });
})();
</script>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section-testimonials",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Client Stories"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Trusted by teams that move fast"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Columns (desktop)",
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 88
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "min": 0,
          "max": 5,
          "step": 1,
          "label": "Stars (0 = hide)",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Tenda Analytics transformed the way we use data. We went from gut-feel decisions to confident, insight-led strategies in under a month."
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Sarah K."
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role & company",
          "default": "Head of Growth, RetailCo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "stars": 5, "quote": "Tenda Analytics transformed the way we use data. We went from gut-feel decisions to confident, insight-led strategies in under a month.", "name": "Sarah K.", "role": "Head of Growth, RetailCo" } },
        { "type": "testimonial", "settings": { "stars": 5, "quote": "The BI dashboards they built for us have saved our team 15 hours a week. The quality and attention to detail is truly enterprise-grade.", "name": "James M.", "role": "CEO, FinServ Ltd" } },
        { "type": "testimonial", "settings": { "stars": 5, "quote": "Finally a partner who speaks both business and data fluently. Their advisory work directly contributed to our 40% revenue uplift last quarter.", "name": "Amara D.", "role": "CMO, E-Commerce Brand" } }
      ]
    }
  ]
}
{% endschema %}
