{% comment %}
  Tenda Blog - Admin Dashboard Friendly + LinkedIn Featured Insights
  Simply add blog posts through Shopify Admin - no coding required!
  
  HOW TO ADD POSTS:
  1. Go to: Shopify Admin → Online Store → Blog Posts
  2. Click "Add blog post"
  3. Fill in:
     - Title: Your blog title
     - Content: Your full article
     - Excerpt: 2-3 sentence summary (shows on card)
     - Tags: Add category (e.g., "Retail Ops", "Marketing AI")
     - Featured Image: Upload hero image
  4. Click "Save" and "Publish"
  
  That's it! Your post will automatically appear on this page.
{% endcomment %}

<style>
:root {
  --neon: #E3FC02;
  --neon-glow: rgba(227, 252, 2, 0.4);
  --neon-subtle: rgba(227, 252, 2, 0.15);
  --neon-border: rgba(227, 252, 2, 0.1);
  --bg: #1F1F21;
  --glass: rgba(255, 255, 255, 0.03);
  --text: #f5f5f7;
  --muted: rgba(245, 245, 247, 0.6);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  overflow-x: hidden;
}

/* ===================================
   GLOBAL NEON SCROLLBAR
   =================================== */

::-webkit-scrollbar {
  width: 10px;
}

::-webkit-scrollbar-track {
  background: #121212;
}

::-webkit-scrollbar-thumb {
  background: var(--neon);
  border-radius: 10px;
  box-shadow: 0 0 10px var(--neon-glow);
}

::-webkit-scrollbar-thumb:hover {
  background: #f6ff4d;
  box-shadow: 0 0 15px rgba(227, 252, 2, 0.6);
}

/* ===================================
   BLOG HUB CONTAINER
   =================================== */

.blog-hub {
  background: linear-gradient(180deg, 
    #1F1F21 0%,
    #171719 15%,
    #1F1F21 50%,
    #171719 100%
  );
  min-height: 100vh;
  padding: 10vh 5%;
}

/* ===================================
   HERO SECTION
   =================================== */

.blog-hero {
  text-align: center;
  padding-bottom: 8vh;
  position: relative;
  border-bottom: 1px solid var(--neon-border);
  margin-bottom: 8vh;
}

.blog-hero::before {
  content: '';
  position: absolute;
  top: -5vh;
  left: 20%;
  right: 20%;
  height: 1px;
  background: linear-gradient(90deg,
    transparent 0%,
    var(--neon) 50%,
    transparent 100%
  );
}

.hero-eyebrow {
  font-size: 0.875rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--neon);
  margin-bottom: 1.5rem;
  opacity: 0;
  animation: fadeIn 0.6s ease forwards;
}

@keyframes fadeIn {
  to { opacity: 1; }
}

.hero-title {
  font-size: clamp(2.5rem, 6vw, 4.5rem);
  font-weight: 800;
  line-height: 1.1;
  margin-bottom: 1.5rem;
  opacity: 0;
  animation: fadeIn 0.8s ease 0.2s forwards;
}

.hero-subtitle {
  font-size: clamp(1.125rem, 2vw, 1.375rem);
  color: var(--muted);
  max-width: 700px;
  margin: 0 auto;
  line-height: 1.6;
  opacity: 0;
  animation: fadeIn 0.8s ease 0.4s forwards;
}

/* ===================================
   INSIGHTS GRID - THREE COLUMN LAYOUT
   =================================== */

.insights-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 40px;
  max-width: 1400px;
  margin: 0 auto;
}

/* ===================================
   BLOG TEASER CARDS
   =================================== */

.blog-card {
  background: var(--glass);
  backdrop-filter: blur(25px);
  -webkit-backdrop-filter: blur(25px);
  border: 0.5px solid var(--neon-border);
  border-radius: 24px;
  position: relative;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  overflow: hidden;
  opacity: 0;
  transform: translateY(30px);
  display: flex;
  flex-direction: column;
  min-height: 550px;
  text-decoration: none;
  color: inherit;
}

.blog-card.reveal {
  animation: revealCard 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.blog-card:nth-child(1) {
  animation-delay: 0.2s;
}

.blog-card:nth-child(2) {
  animation-delay: 0.4s;
}

.blog-card:nth-child(3) {
  animation-delay: 0.6s;
}

@keyframes revealCard {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Neon Top Border with Pulse */
.blog-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: var(--neon);
  box-shadow: 0 0 10px var(--neon-glow);
  transition: all 0.4s ease;
  z-index: 1;
}

/* Micro-Interactions on Hover */
.blog-card:hover {
  transform: translateY(-10px) scale(1.02);
  box-shadow: 0 20px 60px rgba(0,0,0,0.6), 0 0 40px var(--neon-subtle);
  border-color: var(--neon);
}

.blog-card:hover::before {
  height: 3px;
  box-shadow: 0 0 25px var(--neon-glow), 0 0 50px rgba(227, 252, 2, 0.3);
  animation: neonPulse 1.5s ease-in-out infinite;
}

@keyframes neonPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}

/* Background Zoom on Hover */
.blog-card:hover .card-background {
  transform: scale(1.1);
}

/* ===================================
   CARD BACKGROUND IMAGE
   =================================== */

.card-background {
  position: absolute;
  inset: 0;
  z-index: 0;
  transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  overflow: hidden;
}

.card-background img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.15;
  filter: blur(3px);
}

/* ===================================
   CARD HEADER
   =================================== */

.card-header {
  position: relative;
  z-index: 2;
  padding: 2rem 2rem 1rem;
}

.badge {
  display: inline-block;
  padding: 0.5rem 1rem;
  background: rgba(227, 252, 2, 0.95);
  color: #000;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  border-radius: 6px;
  box-shadow: 0 4px 15px rgba(227, 252, 2, 0.4);
  transition: all 0.3s ease;
}

.blog-card:hover .badge {
  transform: scale(1.05);
  box-shadow: 0 6px 20px rgba(227, 252, 2, 0.6);
}

/* ===================================
   TEASER CONTENT (GLASSMORPHISM)
   =================================== */

.teaser-content {
  position: relative;
  z-index: 2;
  flex: 1;
  padding: 1rem 2rem 2rem;
  background: rgba(31, 31, 33, 0.85);
  backdrop-filter: blur(25px);
  -webkit-backdrop-filter: blur(25px);
  overflow-y: auto;
  max-height: 320px;
}

/* Neon Scrollbar for Teaser Content */
.teaser-content::-webkit-scrollbar {
  width: 6px;
}

.teaser-content::-webkit-scrollbar-track {
  background: rgba(255, 255, 255, 0.05);
}

.teaser-content::-webkit-scrollbar-thumb {
  background: var(--neon);
  border-radius: 10px;
  box-shadow: 0 0 8px rgba(227, 252, 2, 0.5);
}

.teaser-content::-webkit-scrollbar-thumb:hover {
  background: #f6ff4d;
  box-shadow: 0 0 12px rgba(227, 252, 2, 0.7);
}

.teaser-content h3 {
  font-size: 1.75rem;
  font-weight: 700;
  line-height: 1.3;
  margin-bottom: 1rem;
  color: var(--text);
}

.teaser-content .excerpt {
  font-size: 1.0625rem;
  line-height: 1.7;
  color: var(--muted);
  font-style: italic;
}

.teaser-content .excerpt::before,
.teaser-content .excerpt::after {
  content: '"';
  color: var(--neon);
  font-size: 1.5rem;
  line-height: 0;
  vertical-align: -0.2em;
}

/* ===================================
   CARD META
   =================================== */

.card-meta {
  position: relative;
  z-index: 2;
  padding: 1rem 2rem 2rem;
  background: rgba(31, 31, 33, 0.85);
  backdrop-filter: blur(25px);
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 0.875rem;
  color: var(--muted);
}

.read-time {
  color: var(--neon);
  font-weight: 600;
}

/* LinkedIn CTA Button */
.linkedin-cta {
  width: 100%;
  padding: 1rem 2rem;
  background: rgba(227, 252, 2, 0.05);
  border: 1.5px solid rgba(227, 252, 2, 0.3);
  border-radius: 12px;
  color: var(--neon);
  font-size: 0.875rem;
  font-weight: 700;
  text-align: center;
  text-decoration: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  transition: all 0.3s ease;
  letter-spacing: 0.02em;
}

.linkedin-cta:hover {
  background: rgba(227, 252, 2, 0.1);
  border-color: var(--neon);
  box-shadow: 0 0 20px rgba(227, 252, 2, 0.3),
              inset 0 0 15px rgba(227, 252, 2, 0.1);
  transform: translateY(-2px);
}

.linkedin-cta svg {
  width: 16px;
  height: 16px;
}

/* ===================================
   RESPONSIVE
   =================================== */

@media (max-width: 1100px) {
  .insights-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
  }

  /* Third card spans 2 columns and centers */
  .blog-card:nth-child(3) {
    grid-column: 1 / -1;
    max-width: 600px;
    margin: 0 auto;
    width: 100%;
  }
}

@media (max-width: 900px) {
  .insights-grid {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .blog-card {
    min-height: 500px;
  }

  .blog-card:nth-child(3) {
    grid-column: auto;
    max-width: none;
  }

  .teaser-content {
    max-height: 280px;
  }
}

@media (max-width: 640px) {
  .blog-hub {
    padding: 8vh 5%;
  }

  .blog-hero {
    padding-bottom: 6vh;
    margin-bottom: 6vh;
  }

  .insights-grid {
    gap: 2rem;
  }

  .blog-card {
    min-height: 480px;
  }

  .card-header {
    padding: 1.5rem 1.5rem 1rem;
  }

  .teaser-content {
    padding: 1rem 1.5rem 1.5rem;
    max-height: 250px;
  }

  .teaser-content h3 {
    font-size: 1.5rem;
  }

  .teaser-content .excerpt {
    font-size: 1rem;
  }

  .card-meta {
    padding: 1rem 1.5rem 1.5rem;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .linkedin-cta {
    padding: 0.875rem 1.5rem;
    font-size: 0.8125rem;
  }
}
</style>

<div class="blog-hub">

  <!-- Hero -->
  <section class="blog-hero">
    <div class="hero-eyebrow">Tenda Live-Insights</div>
    <h1 class="hero-title">Data That Drives Decisions</h1>
    <p class="hero-subtitle">
      Real stories from African operators turning messy data into clear daily decisions.
    </p>
  </section>

  <!-- Insights Grid - Automatically populated from Shopify Blog -->
  <div class="insights-grid">
    
    {% comment %}
      This loop automatically pulls all published blog posts
      No coding needed - just add posts via Shopify Admin!
    {% endcomment %}
    
    {% for article in blog.articles %}
    <a href="{{ article.url }}" class="blog-card reveal">
      
      <!-- Background Image (from Featured Image in admin) -->
      {% if article.image %}
      <div class="card-background">
        <img src="{{ article.image | img_url: 'large' }}" 
             alt="{{ article.title }}" 
             loading="lazy">
      </div>
      {% endif %}

      <!-- Card Header (from Tags in admin) -->
      <div class="card-header">
        {% if article.tags.size > 0 %}
          <span class="badge">INSIGHT: {{ article.tags.first | upcase }}</span>
        {% else %}
          <span class="badge">INSIGHT</span>
        {% endif %}
      </div>

      <!-- Teaser Content (from Title and Excerpt in admin) -->
      <div class="teaser-content">
        <h3>{{ article.title }}</h3>
        <div class="excerpt">
          {% if article.excerpt != blank %}
            {{ article.excerpt | strip_html }}
          {% else %}
            {{ article.content | strip_html | truncatewords: 40 }}
          {% endif %}
        </div>
      </div>

      <!-- Card Meta (auto-calculated from publish date and content) -->
      <div class="card-meta">
        <span>{{ article.published_at | date: '%B %d, %Y' }}</span>
        <span class="read-time">
          {% assign word_count = article.content | strip_html | split: ' ' | size %}
          {% assign read_time = word_count | divided_by: 200 %}
          {% if read_time < 1 %}{% assign read_time = 1 %}{% endif %}
          {{ read_time }}-min read
        </span>
      </div>

    </a>
    {% endfor %}

    <!-- THIRD CARD: LinkedIn Featured Insight -->
    <a href="https://www.linkedin.com/posts/tendaafrica_10-numbers-that-should-run-your-week-activity-7295031878313127936-XGHG" 
       target="_blank"
       rel="noopener noreferrer"
       class="blog-card reveal">
      
      <!-- Background Pattern -->
      <div class="card-background">
        <img src="data:image/svg+xml,%3Csvg width='100' height='100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpattern id='grid' width='10' height='10' patternUnits='userSpaceOnUse'%3E%3Cpath d='M 10 0 L 0 0 0 10' fill='none' stroke='rgba(227,252,2,0.05)' stroke-width='0.5'/%3E%3C/pattern%3E%3Crect width='100' height='100' fill='url(%23grid)' /%3E%3C/svg%3E" 
             alt="Data Grid Pattern"
             style="opacity: 0.08;">
      </div>

      <!-- Card Header -->
      <div class="card-header">
        <span class="badge">INSIGHT: RETAIL NUMBERS</span>
      </div>

      <!-- Teaser Content -->
      <div class="teaser-content">
        <h3>10 Numbers That Should Run Your Week</h3>
        <div class="excerpt">
          Stop guessing and start measuring. From stock-to-sales ratios to customer acquisition cost, these 10 metrics are the heartbeat of a high-performance retail engine. If you aren't tracking these, you're flying blind in a data-driven market.
        </div>
      </div>

      <!-- LinkedIn CTA -->
      <div class="card-meta" style="padding-bottom: 1.5rem;">
        <div class="linkedin-cta">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect x="2" y="9" width="4" height="12"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
          View Full Insight on LinkedIn
        </div>
      </div>

    </a>

  </div>

</div>

<script>
// Intersection Observer for card reveals
const observerOptions = {
  threshold: 0.1,
  rootMargin: '0px 0px -50px 0px'
};

const observer = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.classList.add('visible');
      observer.unobserve(entry.target);
    }
  });
}, observerOptions);

// Observe cards
setTimeout(() => {
  document.querySelectorAll('.blog-card').forEach(card => {
    observer.observe(card);
  });
}, 100);
</script>