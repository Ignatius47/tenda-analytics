{% comment %}
═══════════════════════════════════════════════════════════════
TENDA COLLECTION - NATIVE SHOPIFY CHECKOUT
Product cards that link to Shopify product pages → Add to Cart → Checkout
Same behavior as "Recommended For You" products in cart
═══════════════════════════════════════════════════════════════
{% endcomment %}

<style>
:root {
  --tenda-neon: #E3FC02;
  --tenda-neon-glow: rgba(227, 252, 2, 0.4);
  --tenda-black: #000000;
  --tenda-white: #FFFFFF;
  --tenda-dark: #1a1a1a;
  --tenda-glass: rgba(255, 255, 255, 0.03);
  --tenda-border: rgba(255, 255, 255, 0.06);
}

/* ═══════════════════════════════════════════════════════
   PAGE CONTAINER
   ═══════════════════════════════════════════════════════ */

.tenda-shop-container {
  background: linear-gradient(180deg, 
    #0a0a0c 0%,
    var(--tenda-dark) 15%,
    #0a0a0c 50%,
    var(--tenda-dark) 100%
  );
  min-height: 100vh;
  padding: 3rem 0 6rem;
}

/* ═══════════════════════════════════════════════════════
   HEADER SECTION
   ═══════════════════════════════════════════════════════ */

.tenda-shop-header {
  text-align: center;
  padding: 2rem 1rem 4rem;
  border-bottom: 1px solid rgba(227, 252, 2, 0.1);
  position: relative;
}

.tenda-shop-header::before {
  content: '';
  position: absolute;
  top: -2rem;
  left: 20%;
  right: 20%;
  height: 1px;
  background: linear-gradient(90deg,
    transparent 0%,
    var(--tenda-neon) 50%,
    transparent 100%
  );
}

.tenda-shop-eyebrow {
  font-size: 0.875rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--tenda-neon);
  margin-bottom: 1rem;
  opacity: 0;
  animation: fadeIn 0.6s ease forwards;
}

@keyframes fadeIn {
  to { opacity: 1; }
}

.tenda-shop-title {
  font-size: clamp(2.5rem, 6vw, 4rem);
  font-weight: 900;
  color: var(--tenda-white);
  margin: 0 0 1rem;
  letter-spacing: -0.04em;
  line-height: 1.1;
  background: linear-gradient(135deg, #fff 0%, rgba(227,252,2,0.8) 100%);
  background-size: 200% 200%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  opacity: 0;
  animation: fadeIn 0.8s ease 0.2s forwards;
}

.tenda-shop-subtitle {
  font-size: clamp(1rem, 2vw, 1.25rem);
  color: rgba(255, 255, 255, 0.7);
  max-width: 700px;
  margin: 0 auto 2rem;
  line-height: 1.6;
  opacity: 0;
  animation: fadeIn 0.8s ease 0.4s forwards;
}

.tenda-shop-count {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.625rem 1.5rem;
  background: rgba(227, 252, 2, 0.08);
  border: 1px solid rgba(227, 252, 2, 0.25);
  border-radius: 100px;
  font-weight: 700;
  color: var(--tenda-neon);
  font-size: 0.9375rem;
  box-shadow: 0 0 20px rgba(227, 252, 2, 0.15);
  opacity: 0;
  animation: fadeIn 0.8s ease 0.6s forwards;
}

/* ═══════════════════════════════════════════════════════
   FILTERS
   ═══════════════════════════════════════════════════════ */

.tenda-filters {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(10, 10, 12, 0.95);
  backdrop-filter: blur(25px);
  -webkit-backdrop-filter: blur(25px);
  border-bottom: 1px solid rgba(227, 252, 2, 0.1);
  padding: 1.25rem 1rem;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
}

.tenda-filters-inner {
  max-width: 1400px;
  margin: 0 auto;
  display: flex;
  justify-content: center;
  gap: 0.875rem;
  flex-wrap: wrap;
}

.tenda-filter-pill {
  padding: 0.75rem 1.75rem;
  border-radius: 100px;
  border: 2px solid rgba(227, 252, 2, 0.15);
  background: transparent;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 700;
  font-size: 0.875rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  cursor: pointer;
  transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  position: relative;
  overflow: hidden;
}

.tenda-filter-pill::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  border-radius: 50%;
  background: rgba(227, 252, 2, 0.1);
  transform: translate(-50%, -50%);
  transition: width 0.4s ease, height 0.4s ease;
}

.tenda-filter-pill:hover {
  background: rgba(227, 252, 2, 0.08);
  border-color: rgba(227, 252, 2, 0.4);
  color: var(--tenda-neon);
  transform: translateY(-2px);
}

.tenda-filter-pill:hover::before {
  width: 200%;
  height: 200%;
}

.tenda-filter-pill.active {
  background: var(--tenda-neon);
  border-color: var(--tenda-neon);
  color: var(--tenda-black);
  box-shadow: 0 6px 24px var(--tenda-neon-glow);
  transform: translateY(-2px);
}

.tenda-filter-pill.active::before {
  display: none;
}

/* ═══════════════════════════════════════════════════════
   PRODUCTS GRID - MATCHES CART RECOMMENDED PRODUCTS STYLE
   ═══════════════════════════════════════════════════════ */

.tenda-products-grid {
  max-width: 1400px;
  margin: 3.5rem auto 0;
  padding: 0 1.5rem;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 2rem;
  justify-content: center;
}

/* ═══════════════════════════════════════════════════════
   PRODUCT CARD - EXACTLY LIKE CART RECOMMENDED PRODUCTS
   ═══════════════════════════════════════════════════════ */

.tenda-product-card {
  background: var(--tenda-glass);
  border: 1px solid var(--tenda-border);
  border-radius: 18px;
  padding: 1.125rem;
  text-decoration: none;
  display: flex;
  flex-direction: column;
  gap: 0.875rem;
  transition: all 0.42s cubic-bezier(0.34, 1.56, 0.64, 1);
  position: relative;
  overflow: hidden;
  opacity: 0;
  transform: translateY(30px);
  animation: cardReveal 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes cardReveal {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Stagger animation delays */
.tenda-product-card:nth-child(1)  { animation-delay: 0.1s; }
.tenda-product-card:nth-child(2)  { animation-delay: 0.15s; }
.tenda-product-card:nth-child(3)  { animation-delay: 0.2s; }
.tenda-product-card:nth-child(4)  { animation-delay: 0.25s; }
.tenda-product-card:nth-child(5)  { animation-delay: 0.3s; }
.tenda-product-card:nth-child(6)  { animation-delay: 0.35s; }
.tenda-product-card:nth-child(7)  { animation-delay: 0.4s; }
.tenda-product-card:nth-child(8)  { animation-delay: 0.45s; }
.tenda-product-card:nth-child(9)  { animation-delay: 0.5s; }
.tenda-product-card:nth-child(10) { animation-delay: 0.55s; }
.tenda-product-card:nth-child(11) { animation-delay: 0.6s; }
.tenda-product-card:nth-child(12) { animation-delay: 0.65s; }

/* Neon top border */
.tenda-product-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: var(--tenda-neon);
  box-shadow: 0 0 10px var(--tenda-neon-glow);
  transition: all 0.4s ease;
}

.tenda-product-card:hover {
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(227, 252, 2, 0.25);
  transform: translateY(-8px) scale(1.03);
  box-shadow: 0 16px 48px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(227, 252, 2, 0.12);
}

.tenda-product-card:hover::before {
  height: 3px;
  box-shadow: 0 0 20px var(--tenda-neon-glow);
}

/* ═══════════════════════════════════════════════════════
   PRODUCT IMAGE
   ═══════════════════════════════════════════════════════ */

.tenda-card-img-wrapper {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 14px;
  overflow: hidden;
  background: rgba(0, 0, 0, 0.25);
  position: relative;
}

.tenda-card-img-wrapper img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
  transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tenda-product-card:hover .tenda-card-img-wrapper img {
  transform: scale(1.05);
}

/* Fallback icon when no image */
.tenda-card-icon {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 4.5rem;
  opacity: 0.15;
  filter: grayscale(0.6);
}

/* ═══════════════════════════════════════════════════════
   BADGES
   ═══════════════════════════════════════════════════════ */

.tenda-card-badges {
  position: absolute;
  top: 0.875rem;
  right: 0.875rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  z-index: 2;
}

.tenda-badge {
  padding: 0.375rem 0.875rem;
  border-radius: 100px;
  font-size: 0.6875rem;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.tenda-badge-free {
  background: rgba(227, 252, 2, 0.95);
  color: var(--tenda-black);
  box-shadow: 0 4px 16px rgba(227, 252, 2, 0.5);
}

.tenda-badge-new {
  background: rgba(59, 130, 246, 0.9);
  color: var(--tenda-white);
}

.tenda-badge-sale {
  background: rgba(239, 68, 68, 0.9);
  color: var(--tenda-white);
}

.tenda-badge-popular {
  background: rgba(168, 85, 247, 0.9);
  color: var(--tenda-white);
}

/* ═══════════════════════════════════════════════════════
   PRODUCT DETAILS
   ═══════════════════════════════════════════════════════ */

.tenda-card-title {
  font-size: 0.9375rem;
  font-weight: 700;
  color: var(--tenda-white);
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  min-height: 2.7em;
  margin-top: auto;
}

.tenda-card-vendor {
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--tenda-neon);
  margin-bottom: 0.25rem;
}

.tenda-card-price {
  font-size: 1.125rem;
  font-weight: 900;
  color: var(--tenda-neon);
  margin-top: auto;
  letter-spacing: -0.02em;
  display: flex;
  align-items: baseline;
  gap: 0.5rem;
}

.tenda-price-compare {
  font-size: 0.875rem;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.4);
  text-decoration: line-through;
}

/* ═══════════════════════════════════════════════════════
   EMPTY STATE
   ═══════════════════════════════════════════════════════ */

.tenda-empty-state {
  text-align: center;
  padding: 6rem 2rem;
  max-width: 600px;
  margin: 0 auto;
}

.tenda-empty-icon {
  font-size: 5rem;
  margin-bottom: 1.5rem;
  opacity: 0.3;
}

.tenda-empty-title {
  font-size: 2rem;
  font-weight: 900;
  color: var(--tenda-white);
  margin-bottom: 0.75rem;
}

.tenda-empty-text {
  font-size: 1.125rem;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.6;
}

/* ═══════════════════════════════════════════════════════
   RESPONSIVE
   ═══════════════════════════════════════════════════════ */

@media (max-width: 1200px) {
  .tenda-products-grid {
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.75rem;
  }
}

@media (max-width: 768px) {
  .tenda-shop-container {
    padding: 2rem 0 4rem;
  }

  .tenda-shop-header {
    padding: 1.5rem 1rem 2.5rem;
  }

  .tenda-products-grid {
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1.25rem;
    padding: 0 1rem;
    margin-top: 2.5rem;
  }

  .tenda-product-card {
    padding: 0.875rem;
    gap: 0.75rem;
  }

  .tenda-card-img-wrapper {
    border-radius: 12px;
  }

  .tenda-card-title {
    font-size: 0.875rem;
  }

  .tenda-card-price {
    font-size: 1rem;
  }

  .tenda-filters {
    padding: 1rem;
  }

  .tenda-filter-pill {
    padding: 0.625rem 1.25rem;
    font-size: 0.8125rem;
  }
}

@media (max-width: 480px) {
  .tenda-products-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
</style>

<div class="tenda-shop-container">
  
  <!-- Header Section -->
  <div class="tenda-shop-header">
    <div class="tenda-shop-eyebrow">Intelligence Network</div>
    <h1 class="tenda-shop-title">{{ collection.title | default: "Shop" }}</h1>
    
    {% if collection.description != blank %}
      <p class="tenda-shop-subtitle">{{ collection.description }}</p>
    {% else %}
      <p class="tenda-shop-subtitle">
        Operational frameworks, playbooks, and tools for African operators.
      </p>
    {% endif %}
    
    <div class="tenda-shop-count">
      📦 {{ collection.products_count | default: collection.products.size }} 
      {{ collection.products_count | default: collection.products.size | pluralize: 'Product', 'Products' }}
    </div>
  </div>

  <!-- Filters -->
  <div class="tenda-filters">
    <div class="tenda-filters-inner">
      <button class="tenda-filter-pill active" data-filter="all">All Products</button>
      <button class="tenda-filter-pill" data-filter="free">Free</button>
      <button class="tenda-filter-pill" data-filter="new">New Arrivals</button>
      <button class="tenda-filter-pill" data-filter="sale">On Sale</button>
      <button class="tenda-filter-pill" data-filter="popular">Popular</button>
    </div>
  </div>

  <!-- Products Grid -->
  {% if collection.products.size > 0 %}
    <div class="tenda-products-grid">
      {% for product in collection.products %}
        
        {% liquid
          # Determine product attributes
          assign is_free = false
          if product.price == 0
            assign is_free = true
          endif
          
          assign is_new = false
          assign is_sale = false
          assign is_popular = false
          assign filters = 'all'
          
          # Check tags for filters
          for tag in product.tags
            assign tag_lower = tag | downcase
            
            if tag_lower contains 'new'
              assign is_new = true
              assign filters = filters | append: ' new'
            endif
            
            if tag_lower contains 'popular' or tag_lower contains 'bestseller'
              assign is_popular = true
              assign filters = filters | append: ' popular'
            endif
          endfor
          
          # Check if on sale
          if product.compare_at_price > product.price
            assign is_sale = true
            assign filters = filters | append: ' sale'
          endif
          
          # Add free filter
          if is_free
            assign filters = filters | append: ' free'
          endif
        %}
        
        <a href="{{ product.url }}" class="tenda-product-card" data-filters="{{ filters }}">
          
          <!-- Product Image -->
          <div class="tenda-card-img-wrapper">
            {% if product.featured_image %}
              <img 
                src="{{ product.featured_image | img_url: '400x400' }}" 
                alt="{{ product.featured_image.alt | escape | default: product.title }}"
                loading="lazy"
                width="400"
                height="400">
            {% else %}
              <div class="tenda-card-icon">📦</div>
            {% endif %}
            
            <!-- Badges -->
            <div class="tenda-card-badges">
              {% if is_free %}
                <span class="tenda-badge tenda-badge-free">FREE</span>
              {% endif %}
              
              {% if is_new %}
                <span class="tenda-badge tenda-badge-new">NEW</span>
              {% endif %}
              
              {% if is_sale %}
                <span class="tenda-badge tenda-badge-sale">SALE</span>
              {% endif %}
              
              {% if is_popular %}
                <span class="tenda-badge tenda-badge-popular">POPULAR</span>
              {% endif %}
            </div>
          </div>
          
          <!-- Product Details -->
          {% if settings.show_vendor and product.vendor != blank %}
            <div class="tenda-card-vendor">{{ product.vendor }}</div>
          {% endif %}
          
          <div class="tenda-card-title">{{ product.title | truncate: 60 }}</div>
          
          <div class="tenda-card-price">
            {% if is_free %}
              Free
            {% elsif is_sale %}
              {{ product.price | money }}
              <span class="tenda-price-compare">{{ product.compare_at_price | money }}</span>
            {% else %}
              {{ product.price | money }}
            {% endif %}
          </div>
          
        </a>
        
      {% endfor %}
    </div>
    
  {% else %}
    
    <!-- Empty State -->
    <div class="tenda-empty-state">
      <div class="tenda-empty-icon">📭</div>
      <h2 class="tenda-empty-title">No Products Yet</h2>
      <p class="tenda-empty-text">
        Check back soon. We're building something special.
      </p>
    </div>
    
  {% endif %}

</div>

<script>
(function() {
  'use strict';
  
  // ═══════════════════════════════════════════════════════
  // FILTERING SYSTEM
  // ═══════════════════════════════════════════════════════
  
  function initFilters() {
    const pills = document.querySelectorAll('.tenda-filter-pill');
    const cards = document.querySelectorAll('.tenda-product-card');
    
    if (!pills.length || !cards.length) return;
    
    pills.forEach(pill => {
      pill.addEventListener('click', function() {
        const filter = this.dataset.filter;
        
        // Update active state
        pills.forEach(p => p.classList.remove('active'));
        this.classList.add('active');
        
        // Filter products
        cards.forEach(card => {
          const filters = card.dataset.filters.split(' ');
          
          if (filter === 'all' || filters.includes(filter)) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  }
  
  // ═══════════════════════════════════════════════════════
  // INIT
  // ═══════════════════════════════════════════════════════
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFilters);
  } else {
    initFilters();
  }
  
})();
</script>

{% comment %}
═══════════════════════════════════════════════════════════════
USAGE INSTRUCTIONS:

1. This template displays products as cards (like cart recommendations)
2. Clicking a card goes to the product page
3. Product page has native "Add to Cart" button
4. Cart → Checkout → Order confirmation
5. Admin gets order notification emails automatically
6. Inventory tracked in real-time via Shopify

SHOPIFY ADMIN SETUP:

1. Products → Add product
2. Upload product image
3. Set price (or set to 0.00 for free)
4. Add product description
5. Add tags: "new", "popular", "bestseller" for filtering
6. For digital products:
   - Use Shopify app: "Digital Downloads" or "SendOwl"
   - Or manually email PDF after order received
   
BENEFITS:

✅ Real-time inventory management
✅ Automatic order emails to admin
✅ Customer purchase history
✅ Analytics & reporting
✅ Abandoned cart recovery
✅ Payment processing built-in
✅ No custom backend needed

═══════════════════════════════════════════════════════════════
{% endcomment %}
