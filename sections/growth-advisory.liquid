<script>
// =========================================
// PARALLAX GRAIN SCROLLING
// =========================================
document.addEventListener('DOMContentLoaded', function() {
  const grain = document.getElementById('gaParallaxGrain');
  
  if (grain) {
    let ticking = false;
    
    window.addEventListener('scroll', function() {
      if (!ticking) {
        window.requestAnimationFrame(function() {
          const scrollY = window.pageYOffset;
          // Move grain at 40% speed of scroll for depth effect
          grain.style.transform = `translateY(${scrollY * 0.4}px)`;
          ticking = false;
        });
        ticking = true;
      }
    });
  }

  // =========================================
  // MAGNETIC HOVER EFFECT ON PILLAR CARDS
  // =========================================
  const magneticCards = document.querySelectorAll('[data-magnetic]');
  
  magneticCards.forEach(card => {
    card.addEventListener('mousemove', function(e) {
      const rect = this.getBoundingClientRect();
      const x = e.clientX - rect.left - rect.width / 2;
      const y = e.clientY - rect.top - rect.height / 2;
      
      // Magnetic pull intensity: 15% of cursor offset
      const moveX = x * 0.15;
      const moveY = y * 0.15;
      
      // Apply magnetic shift to card content
      const content = this.querySelectorAll('.pillar-card__icon, .pillar-card__title, .pillar-card__description, .pillar-card__features, .pillar-card__link');
      content.forEach(el => {
        el.style.transform = `translate(${moveX}px, ${moveY}px)`;
      });
    });
    
    card.addEventListener('mouseleave', function() {
      // Reset position
      const content = this.querySelectorAll('.pillar-card__icon, .pillar-card__title, .pillar-card__description, .pillar-card__features, .pillar-card__link');
      content.forEach(el => {
        el.style.transform = '';
      });
    });
  });
});
</script>