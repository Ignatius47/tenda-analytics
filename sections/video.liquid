/* Remove any horizontal overflow */
@media screen and (max-width: 749px) {
  body {
    overflow-x: hidden !important;
  }
  
  .video-section.hero-video,
  .tenda-video-container {
    overflow: hidden !important;
  }
}

</style>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: 0px;
    padding-bottom: 0px;
  }
{%- endstyle -%}

{%- liquid
  assign poster_image = section.settings.cover_image
-%}

<!-- NEBULA ENVIRONMENT -->
<canvas id="dataDustCanvas"></canvas>
<div class="nebula-leak-1"></div>
<div class="nebula-leak-2"></div>
<div class="nebula-leak-3"></div>

<div class="video-section hero-video section-{{ section.id }}-padding">
  
  <div class="tenda-video-container">
    <!-- Poster Image (Shows if no video or while loading) -->
    {%- if poster_image -%}
      <img 
        src="{{ poster_image | image_url: width: 1920 }}"
        srcset="{{ poster_image | image_url: width: 750 }} 750w,
                {{ poster_image | image_url: width: 1100 }} 1100w,
                {{ poster_image | image_url: width: 1500 }} 1500w,
                {{ poster_image | image_url: width: 1920 }} 1920w"
        sizes="100vw"
        alt="{{ section.settings.heading | escape }}"
        class="tenda-video-poster"
        loading="eager"
      >
    {%- endif -%}

    <!-- Video Element (Stealth Autoplay) -->
    {%- if section.settings.video -%}
      {{
        section.settings.video
        | video_tag:
          id: 'tendaHeroVideo',
          class: 'tenda-video-player',
          image_size: '1100x',
          autoplay: true,
          loop: true,
          muted: true,
          playsinline: true,
          controls: false
      }}
    {%- elsif section.settings.video_url -%}
      <!-- Fallback for external videos -->
      <div style="position:absolute;top:0;left:0;width:100%;height:100%;z-index:1;">
        {%- if section.settings.video_url.type == 'youtube' -%}
          <iframe
            id="tendaHeroVideo"
            src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=1&mute=1&loop=1&playlist={{ section.settings.video_url.id }}&controls=0&modestbranding=1&playsinline=1"
            style="position:absolute;top:0;left:0;width:100%;height:100%;border:0;"
            allow="autoplay; encrypted-media"
            allowfullscreen
          ></iframe>
        {%- else -%}
          <iframe
            id="tendaHeroVideo"
            src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay=1&muted=1&loop=1&background=1&controls=0"
            style="position:absolute;top:0;left:0;width:100%;height:100%;border:0;"
            allow="autoplay; encrypted-media"
            allowfullscreen
          ></iframe>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Overlay Gradient -->
    <div class="tenda-video-overlay"></div>

    <!-- Hero Content Overlay -->
    <div class="video-hero-content" id="heroContent">
      {%- unless section.settings.heading == blank -%}
        {%- liquid
          assign heading_words = section.settings.heading | split: ' '
          assign last_word_index = heading_words.size | minus: 1
        -%}
        <h1 class="video-hero-title">
          {%- for word in heading_words -%}
            {%- if forloop.index0 == last_word_index -%}
              <span class="accent">{{ word }}</span>
            {%- else -%}
              {{ word }}{% unless forloop.last %} {% endunless %}
            {%- endif -%}
          {%- endfor -%}
        </h1>
      {%- endunless -%}
      
      {%- unless section.settings.subheading == blank -%}
        <p class="video-hero-subtitle">
          {{ section.settings.subheading }}
        </p>
      {%- endunless -%}

      {%- if section.settings.button_label != blank or section.settings.button_label_2 != blank -%}
        <div class="video-hero-cta">
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link }}" class="video-hero-btn video-hero-btn-primary" id="primaryCTA">
              <span>{{ section.settings.button_label }}</span>
            </a>
          {%- endif -%}
          
          {%- if section.settings.button_label_2 != blank -%}
            <a href="{{ section.settings.button_link_2 }}" class="video-hero-btn video-hero-btn-secondary">
              <span>{{ section.settings.button_label_2 }}</span>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <!-- Scroll Indicator -->
    <div class="scroll-indicator">
      <span class="scroll-indicator-text">Scroll</span>
      <div class="scroll-indicator-arrow"></div>
    </div>

    <!-- Custom Tenda Video Controls (HUD) -->
    <div class="tenda-video-controls">
      <!-- Progress Bar -->
      <div class="tenda-progress-bar" id="progressBar">
        <div class="tenda-progress-fill" id="progressFill"></div>
      </div>

      <!-- Floating HUD Controls -->
      <div class="tenda-hud-controls">
        <!-- Mute/Unmute Button -->
        <button class="tenda-mute-btn" id="muteBtn" aria-label="Toggle Mute">
          <svg id="muteIcon" viewBox="0 0 24 24">
            <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
          </svg>
          <svg id="unmuteIcon" viewBox="0 0 24 24" style="display:none;">
            <path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/>
          </svg>
        </button>

        <!-- Fullscreen Button -->
        <button class="tenda-fullscreen-btn" id="fullscreenBtn" aria-label="Toggle Fullscreen">
          <svg viewBox="0 0 24 24">
            <path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/>
          </svg>
        </button>
      </div>

      <!-- Center Play/Pause Pulse -->
      <div class="tenda-center-play" id="centerPlay">
        <svg viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
      </div>
    </div>
  </div>

</div>

<script>
  /* ===================================
     NEBULA DATA DUST PARTICLE SYSTEM
     =================================== */

  (function() {
    'use strict';

    const canvas = document.getElementById('dataDustCanvas');
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    let width, height;
    let particles = [];
    const isMobile = window.innerWidth < 750;
    const particleCount = isMobile ? 100 : 300;
    let scrollVelocity = 0;
    let lastScrollY = window.pageYOffset;

    function resize() {
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width;
      canvas.height = height;
    }

    class Particle {
      constructor() {
        this.reset();
      }

      reset() {
        this.x = Math.random() * width;
        this.y = Math.random() * height;
        this.z = Math.random() * 1500 + 500;
        this.baseSpeed = isMobile ? 0.3 : 0.5 + Math.random() * 1.5;
        this.size = (1500 / this.z) * (isMobile ? 1.5 : 2);
        this.opacity = Math.random() * 0.6 + 0.2;
      }

      update(warpSpeed) {
        this.z -= this.baseSpeed * warpSpeed;

        if (this.z <= 1) {
          this.reset();
          this.z = 1500;
        }

        const scale = 1500 / this.z;
        this.size = scale * (isMobile ? 1.5 : 2);
        this.opacity = Math.min(1, scale * (isMobile ? 0.5 : 0.4));

        this.screenX = (this.x - width / 2) * scale + width / 2;
        this.screenY = (this.y - height / 2) * scale + height / 2;
      }

      draw() {
        const tailLength = isMobile ? scrollVelocity * 2 : scrollVelocity * 3;
        if (tailLength > 5) {
          ctx.strokeStyle = `rgba(227, 252, 2, ${this.opacity * 0.3})`;
          ctx.lineWidth = this.size * 0.5;
          ctx.beginPath();
          ctx.moveTo(this.screenX, this.screenY);
          ctx.lineTo(
            this.screenX + (Math.random() - 0.5) * tailLength,
            this.screenY + tailLength
          );
          ctx.stroke();
        }

        ctx.fillStyle = `rgba(227, 252, 2, ${this.opacity})`;
        ctx.beginPath();
        ctx.arc(this.screenX, this.screenY, this.size, 0, Math.PI * 2);
        ctx.fill();

        if (!isMobile) {
          ctx.fillStyle = `rgba(227, 252, 2, ${this.opacity * 0.2})`;
          ctx.beginPath();
          ctx.arc(this.screenX, this.screenY, this.size * 2, 0, Math.PI * 2);
          ctx.fill();
        }
      }
    }

    function init() {
      resize();
      particles = [];
      for (let i = 0; i < particleCount; i++) {
        particles.push(new Particle());
      }
    }

    window.addEventListener('scroll', function() {
      const currentScrollY = window.pageYOffset;
      scrollVelocity = Math.abs(currentScrollY - lastScrollY);
      lastScrollY = currentScrollY;
      
      setTimeout(() => {
        scrollVelocity *= 0.9;
      }, 50);
    }, { passive: true });

    function animate() {
      ctx.clearRect(0, 0, width, height);

      const warpSpeed = 1 + (scrollVelocity / 10);

      particles.forEach(particle => {
        particle.update(warpSpeed);
        particle.draw();
      });

      requestAnimationFrame(animate);
    }

    window.addEventListener('resize', resize);

    init();
    animate();

  })();

  /* ===================================
     LENIS SMOOTH SCROLL (DESKTOP ONLY)
     =================================== */

  if (typeof Lenis !== 'undefined' && window.innerWidth >= 750) {
    const lenis = new Lenis({
      duration: 1.2,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      orientation: 'vertical',
      smoothWheel: true,
      wheelMultiplier: 1,
      touchMultiplier: 2
    });

    function raf(time) {
      lenis.raf(time);
      requestAnimationFrame(raf);
    }
    requestAnimationFrame(raf);

    if (typeof ScrollTrigger !== 'undefined') {
      lenis.on('scroll', ScrollTrigger.update);
    }
  }

  /* ===================================
     CUSTOM TENDA VIDEO PLAYER
     =================================== */

  document.addEventListener('DOMContentLoaded', function() {
    const video = document.getElementById('tendaHeroVideo');
    const muteBtn = document.getElementById('muteBtn');
    const fullscreenBtn = document.getElementById('fullscreenBtn');
    const progressBar = document.getElementById('progressBar');
    const progressFill = document.getElementById('progressFill');
    const centerPlay = document.getElementById('centerPlay');
    const heroContent = document.getElementById('heroContent');
    const muteIcon = document.getElementById('muteIcon');
    const unmuteIcon = document.getElementById('unmuteIcon');
    const videoSection = document.querySelector('.video-section.hero-video');
    const primaryCTA = document.getElementById('primaryCTA');

    // Only add controls for native video (not iframes)
    if (!video || video.tagName !== 'VIDEO') return;

    // Mute/Unmute Toggle
    if (muteBtn) {
      muteBtn.addEventListener('click', function() {
        video.muted = !video.muted;
        
        if (video.muted) {
          muteIcon.style.display = 'none';
          unmuteIcon.style.display = 'block';
          muteBtn.classList.remove('active');
          document.body.classList.remove('video-focused');
        } else {
          muteIcon.style.display = 'block';
          unmuteIcon.style.display = 'none';
          muteBtn.classList.add('active');
          document.body.classList.add('video-focused');
        }
      });
    }

    // Fullscreen Toggle
    if (fullscreenBtn) {
      fullscreenBtn.addEventListener('click', function() {
        if (!document.fullscreenElement) {
          videoSection.requestFullscreen().catch(err => {
            console.log('Fullscreen error:', err);
          });
        } else {
          document.exitFullscreen();
        }
      });
    }

    // Play/Pause on Video Click
    video.addEventListener('click', function() {
      if (video.paused) {
        video.play();
        centerPlay.classList.remove('show');
      } else {
        video.pause();
        centerPlay.classList.add('show');
        setTimeout(() => {
          if (video.paused) {
            centerPlay.classList.remove('show');
          }
        }, 2000);
      }
    });

    // Progress Bar Update
    video.addEventListener('timeupdate', function() {
      const progress = (video.currentTime / video.duration) * 100;
      progressFill.style.width = progress + '%';
    });

    // Progress Bar Click to Seek
    if (progressBar) {
      progressBar.addEventListener('click', function(e) {
        const rect = progressBar.getBoundingClientRect();
        const pos = (e.clientX - rect.left) / rect.width;
        video.currentTime = pos * video.duration;
      });
    }

    // Waitlist CTA - Blur Video
    if (primaryCTA) {
      primaryCTA.addEventListener('click', function(e) {
        const href = this.getAttribute('href');
        if (href && (href.includes('waitlist') || href.includes('modal') || href.includes('#'))) {
          videoSection.classList.add('blurred');
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "Hero Video (Tenda)",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Make your numbers move.",
      "label": "Hero title",
      "info": "Last word will be highlighted in neon yellow"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Video Settings"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Upload Video",
      "info": "For best results, use MP4 format. Custom controls work with uploaded videos."
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "label": "Or use video URL",
      "info": "YouTube or Vimeo (note: custom controls are limited with external videos)"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Poster image",
      "info": "Shows before video loads or as fallback"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make section full width",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Hero Video (Tenda)"
    }
  ]
}
{% endschema %}