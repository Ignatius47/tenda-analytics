<script>
document.addEventListener('DOMContentLoaded', function() {
  // Manifesto scroll reveal
  const manifestoSpans = document.querySelectorAll('.manifesto-span');
  const manifestoSection = document.getElementById('manifestoSection');

  function revealManifestoWords() {
    const sectionTop = manifestoSection.getBoundingClientRect().top;
    const sectionHeight = manifestoSection.offsetHeight;
    const viewportCenter = window.innerHeight / 2;
    
    const scrollProgress = Math.max(0, Math.min(1, 
      (viewportCenter - sectionTop) / (sectionHeight * 0.5)
    ));

    const wordsToReveal = Math.floor(scrollProgress * manifestoSpans.length);

    manifestoSpans.forEach((span, index) => {
      if (index < wordsToReveal) {
        span.classList.add('revealed');
      } else {
        span.classList.remove('revealed');
      }
    });
  }

  window.addEventListener('scroll', revealManifestoWords);

  // Magnetic buttons
  const magneticButtons = document.querySelectorAll('[data-magnetic]');

  magneticButtons.forEach(btn => {
    btn.addEventListener('mousemove', function(e) {
      const rect = this.getBoundingClientRect();
      const btnCenterX = rect.left + rect.width / 2;
      const btnCenterY = rect.top + rect.height / 2;
      
      const deltaX = e.clientX - btnCenterX;
      const deltaY = e.clientY - btnCenterY;
      const distance = Math.sqrt(deltaX * deltaX + deltaY * deltaY);
      
      const magneticRadius = 50;
      
      if (distance < magneticRadius) {
        const pull = (magneticRadius - distance) / magneticRadius;
        const moveX = deltaX * pull * 0.4;
        const moveY = deltaY * pull * 0.4;
        
        this.style.transform = `translate(${moveX}px, ${moveY}px) scale(1.02)`;
      }
    });

    btn.addEventListener('mouseleave', function() {
      this.style.transform = '';
    });
  });
});
</script>

