                <input type="checkbox" name="expertise" value="marketing" class="expertise-checkbox" style="width: 20px; height: 20px; border: 2px solid rgba(255, 255, 255, 0.3); border-radius: 4px; background: transparent; cursor: pointer; appearance: none;">
