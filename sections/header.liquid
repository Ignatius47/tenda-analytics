    display: flex !important;
    align-items: center !important; /* Vertical centering */
    justify-content: space-between !important;
    padding: 0 1.5rem !important;
    height: var(--header-height);
    position: relative;
    width: 100% !important;
  }

  /* Three-column perfect centering - Equal flex basis */
  .header__heading,
  .header__icons {
    flex: 1 0 0 !important; /* Forces equal width */
  }

  .header__inline-menu {
    flex: 2 0 auto !important; /* Center gets double space */
    display: flex !important;
    justify-content: center !important; /* Horizontally centered */
    align-items: center !important; /* Vertically centered */
  }

