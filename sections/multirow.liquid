      });
    }

    // Close on Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && entryModal.classList.contains('active')) {
        closeModal();
      }
    });

    // ===================================
    // FORM SUBMISSION
    // ===================================

    if (modalForm) {
      modalForm.addEventListener('submit', function(e) {
        // After form submits, check for success
        setTimeout(function() {
          // Check if URL has newsletter hash (Shopify success redirect)
          if (window.location.hash === '#newsletter' || window.location.search.includes('customer_posted=true')) {
            // Hide content panels
            if (modalContentPanel) modalContentPanel.style.display = 'none';
            if (modalImagePanel) modalImagePanel.style.display = 'none';
            
            // Show success state
            modalSuccessState.classList.add('active');
            
            // Auto-close after 4 seconds
            setTimeout(function() {
              closeModal();
              
              // Reset for next time (if they clear cookies)
              setTimeout(function() {
                if (modalContentPanel) modalContentPanel.style.display = 'flex';
                if (modalImagePanel) modalImagePanel.style.display = 'block';
                modalSuccessState.classList.remove('active');
              }, 500);
            }, 4000);
          }
        }, 500);
      });
    }

    console.log('Dual-panel modal initialized');
  });


