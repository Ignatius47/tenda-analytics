{% comment %}
  Growth & Advisory — Premium Liquid Glass Showcase
  Tenda — Advisory and data for real business growth
{% endcomment %}

<style>
/* ================================================
   GROWTH & ADVISORY — LIQUID GLASS SHOWCASE
   ================================================ */

:root {
  --ga-bg:        #0F0F11;
  --ga-surface:   rgba(28, 28, 30, 0.88);
  --ga-accent:    #E3FC02;
  --ga-text:      #ffffff;
  --ga-muted:     rgba(255,255,255,0.45);
  --ga-border:    rgba(227,252,2,0.15);
  --ga-spring:    cubic-bezier(0.34,1.56,0.64,1);
  --ga-smooth:    cubic-bezier(0.16, 1, 0.3, 1);
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  background: var(--ga-bg);
  color: var(--ga-text);
  font-family: system-ui, -apple-system, sans-serif;
  overflow-x: hidden;
}

/* Smooth inertia scrolling */
html {
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
}

/* ── PARALLAX BACKGROUND GRAIN ──────────────────── */
.ga-parallax-grain {
  position: fixed;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  opacity: 0.025;
  pointer-events: none;
  z-index: 0;
  will-change: transform;
}

.ga-page { position: relative; z-index: 1; }

/* ================================================
   HIGH-IMPACT HERO SECTION — SPLIT LAYOUT
   ================================================ */

.ga-hero {
  padding: 140px 5% 100px;
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 5rem;
  align-items: center;
  max-width: 1500px;
  margin: 0 auto;
  min-height: 90vh;
  position: relative;
  
  /* Genie entrance animation */
  opacity: 0;
  transform: scale(0.92) translateY(50px);
  animation: gaGenieOpen 0.85s var(--ga-spring) 0.15s forwards;
}

@keyframes gaGenieOpen {
  0%   { opacity: 0; transform: scale(0.92) translateY(50px); filter: blur(14px); }
  58%  { opacity: 1; transform: scale(1.02) translateY(-10px); filter: blur(0); }
  78%  { transform: scale(0.99) translateY(4px); }
  100% { opacity: 1; transform: scale(1) translateY(0); filter: blur(0); }
}

/* ── LEFT: BOLD TEXT ────────────────────────────── */
.ga-hero__text {
  opacity: 0;
  transform: translateY(35px);
  animation: gaSlideUp 0.75s var(--ga-spring) 0.5s forwards;
}

@keyframes gaSlideUp {
  to { opacity: 1; transform: translateY(0); }
}

.ga-hero__eyebrow {
  font-size: 0.875rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--ga-accent);
  margin-bottom: 1.75rem;
  display: flex;
  align-items: center;
  gap: 0.625rem;
}

/* Pulsing neon status dot */
.ga-hero__eyebrow::before {
  content: '';
  width: 9px; height: 9px;
  background: var(--ga-accent);
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 0 14px rgba(227,252,2,0.8);
  animation: gaDotPulse 2.8s ease-in-out infinite;
}

@keyframes gaDotPulse {
  0%,100% { box-shadow: 0 0 0 0 rgba(227,252,2,0.8); }
  50%      { box-shadow: 0 0 0 10px rgba(227,252,2,0); }
}

/* Heavy headline with proper line-height to prevent truncation */
.ga-hero__title {
  font-size: clamp(2.75rem, 7vw, 5.5rem);
  font-weight: 900;
  letter-spacing: -0.055em;
  line-height: 1.25;  /* Increased from 1.18 to 1.25 to prevent clipping */
  margin-bottom: 2rem;
  padding-bottom: 0.2em;  /* Increased from 0.15em for extra safety */
  overflow: visible;
  display: block;
}

.ga-hero__title span {
  background: linear-gradient(135deg, var(--ga-text) 0%, var(--ga-accent) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  text-shadow: none;
}

.ga-hero__description {
  font-size: clamp(1.125rem, 2.2vw, 1.5rem);
  color: var(--ga-muted);
  line-height: 1.75;
  margin-bottom: 3rem;
  max-width: 580px;
}

.ga-hero__stats {
  display: flex;
  gap: 3rem;
  margin-bottom: 3rem;
  flex-wrap: wrap;
}

.ga-stat {
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
}

.ga-stat__value {
  font-size: 2.5rem;
  font-weight: 900;
  color: var(--ga-accent);
  letter-spacing: -0.04em;
  line-height: 1;
}

.ga-stat__label {
  font-size: 0.875rem;
  color: var(--ga-muted);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.ga-hero__cta {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  background: var(--ga-accent);
  color: #000;
  border: none;
  border-radius: 16px;
  padding: 1.25rem 2.75rem;
  font-weight: 800;
  font-size: 1.125rem;
  cursor: pointer;
  text-decoration: none;
  position: relative;
  overflow: hidden;
  letter-spacing: 0.01em;
  transition: transform 0.35s var(--ga-spring), box-shadow 0.35s ease;
  box-shadow: 0 10px 36px rgba(227,252,2,0.35), inset 0 1px 0 rgba(255,255,255,0.35);
}

/* Glass shine sweep */
.ga-hero__cta::before {
  content: '';
  position: absolute;
  top: 0; left: -100%;
  width: 60%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.42), transparent);
  transition: left 0.55s ease;
}

.ga-hero__cta:hover::before { left: 200%; }

.ga-hero__cta:hover {
  transform: translateY(-4px) scale(1.04);
  box-shadow: 0 16px 52px rgba(227,252,2,0.56);
}

.ga-hero__cta svg {
  width: 20px; height: 20px;
  stroke: currentColor;
  transition: transform 0.35s var(--ga-spring);
}

.ga-hero__cta:hover svg {
  transform: translateX(5px);
}

/* ── RIGHT: HIGH-FIDELITY IMAGE ─────────────────── */
.ga-hero__visual {
  position: relative;
  opacity: 0;
  transform: translateY(40px) scale(0.96);
  animation: gaImageReveal 0.9s var(--ga-spring) 0.65s forwards;
}

@keyframes gaImageReveal {
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.ga-hero__image-frame {
  position: relative;
  border-radius: 28px;
  overflow: hidden;
  box-shadow: 
    0 40px 100px rgba(0,0,0,0.6),
    0 0 0 1px rgba(227,252,2,0.18),
    inset 0 1px 0 rgba(255,255,255,0.1);
  backdrop-filter: blur(2px);
}

.ga-hero__image-frame img {
  width: 100%;
  height: auto;
  display: block;
  transition: transform 0.7s ease;
}

.ga-hero__image-frame:hover img {
  transform: scale(1.06);
}

/* Floating neon accent frame */
.ga-hero__visual::before {
  content: '';
  position: absolute;
  top: -16px; right: -16px;
  width: calc(100% + 32px);
  height: calc(100% + 32px);
  border: 2.5px solid rgba(227,252,2,0.28);
  border-radius: 32px;
  pointer-events: none;
  z-index: -1;
}

/* ================================================
   THE "PILLAR" GRID — INTERACTIVE GLASS CARDS
   ================================================ */

.ga-pillars-section {
  padding: 120px 5% 100px;
  max-width: 1500px;
  margin: 0 auto;
  position: relative;
}

.ga-pillars-section__header {
  text-align: center;
  margin-bottom: 5rem;
  opacity: 0;
  transform: translateY(35px);
  animation: gaSlideUp 0.75s var(--ga-spring) 0.8s forwards;
}

.ga-pillars-section__label {
  font-size: 0.875rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--ga-accent);
  margin-bottom: 1.25rem;
}

.ga-pillars-section__title {
  font-size: clamp(2.25rem, 5vw, 3.75rem);
  font-weight: 900;
  letter-spacing: -0.045em;
  line-height: 1.25;  /* Increased from 1.2 to prevent letter clipping */
  margin-bottom: 1.25rem;
  padding-bottom: 0.15em;  /* Extra padding for descenders */
}

/* Neon yellow accent text */
.accent-text {
  color: var(--ga-accent);
  position: relative;
}

.ga-pillars-section__subtitle {
  font-size: 1.25rem;
  color: var(--ga-muted);
  max-width: 680px;
  margin: 0 auto;
  line-height: 1.7;
}

/* Grid of pillar cards */
.ga-pillars-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
  gap: 2.5rem;
}

/* Four-column grid for desktop */
.ga-pillars-grid--four {
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 2rem;
}

@media screen and (min-width: 1200px) {
  .ga-pillars-grid--four {
    grid-template-columns: repeat(4, 1fr);
  }
}

@media screen and (min-width: 768px) and (max-width: 1199px) {
  .ga-pillars-grid--four {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* Individual pillar card — frosted glass with magnetic hover */
.advisory-pillar-card {
  background: rgba(31, 31, 33, 0.85);
  backdrop-filter: blur(25px) saturate(160%);
  -webkit-backdrop-filter: blur(25px) saturate(160%);
  border: 1px solid rgba(227, 252, 2, 0.15);
  border-radius: 16px;
  padding: 2.5rem 2rem;
  position: relative;
  overflow: hidden;
  cursor: default;
  transition: all 0.6s cubic-bezier(0.2, 1, 0.3, 1);
  
  /* Hidden by default for scroll reveal */
  opacity: 0;
  transform: translateY(30px);
}

/* Scroll reveal animation class */
.advisory-pillar-card.is-visible {
  opacity: 1;
  transform: translateY(0);
}

/* Staggered delays applied via JavaScript */
.advisory-pillar-card:nth-child(1).is-visible { transition-delay: 0s; }
.advisory-pillar-card:nth-child(2).is-visible { transition-delay: 0.1s; }
.advisory-pillar-card:nth-child(3).is-visible { transition-delay: 0.2s; }
.advisory-pillar-card:nth-child(4).is-visible { transition-delay: 0.3s; }

/* Top-edge neon seam */
.advisory-pillar-card::before {
  content: '';
  position: absolute;
  top: 0; left: 18%; right: 18%;
  height: 1px;
  background: linear-gradient(90deg, 
    transparent 0%, 
    rgba(227,252,2,0.45) 50%, 
    transparent 100%
  );
  pointer-events: none;
  z-index: 2;
}

/* Radial glow that expands on hover */
.advisory-pillar-card::after {
  content: '';
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 250px; height: 250px;
  background: radial-gradient(circle, rgba(227,252,2,0.06) 0%, transparent 65%);
  opacity: 0;
  transition: all 0.7s ease;
  pointer-events: none;
  z-index: 0;
}

/* Hover: lift + neon glow expansion + 20% brighter border */
.advisory-pillar-card:hover {
  transform: translateY(-12px) scale(1.02);
  border-color: rgba(227, 252, 2, 0.35);  /* 20% brighter: 0.15 → 0.35 */
  box-shadow: 
    0 10px 40px rgba(0, 0, 0, 0.5),
    0 0 15px rgba(227, 252, 2, 0.2),
    inset 0 1px 0 rgba(255,255,255,0.1);
}

.advisory-pillar-card:hover::after {
  opacity: 1;
  width: 400px; height: 400px;
}

.advisory-pillar-card > * { position: relative; z-index: 1; }

/* Card number badge */
.pillar-card__number {
  position: absolute;
  top: 1.75rem;
  left: 1.75rem;
  font-size: 0.75rem;
  font-weight: 800;
  color: var(--ga-accent);
  background: rgba(227,252,2,0.08);
  border: 1px solid rgba(227,252,2,0.2);
  border-radius: 8px;
  padding: 0.3rem 0.65rem;
  letter-spacing: 0.05em;
  z-index: 3;
}

/* Pulsing neon status indicator */
.pillar-card__status {
  position: absolute;
  top: 2.25rem;
  right: 2.25rem;
  width: 11px; height: 11px;
  background: var(--ga-accent);
  border-radius: 50%;
  box-shadow: 0 0 14px rgba(227,252,2,0.85);
  animation: gaDotPulse 2.8s ease-in-out infinite;
  z-index: 3;
}

.pillar-card__icon {
  width: 64px; height: 64px;
  background: rgba(227,252,2,0.12);
  border: 1px solid rgba(227,252,2,0.28);
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 2.25rem;
  transition: all 0.5s var(--ga-spring);
}

.advisory-pillar-card:hover .pillar-card__icon {
  background: rgba(227,252,2,0.2);
  border-color: rgba(227,252,2,0.5);
  transform: scale(1.1) rotate(8deg);
  box-shadow: 0 4px 18px rgba(227,252,2,0.3);
}

.pillar-card__icon svg {
  width: 32px; height: 32px;
  stroke: var(--ga-accent);
  fill: none;
  stroke-width: 2;
}

.pillar-card__title {
  font-size: 1.75rem;
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1.28;
  margin-bottom: 1.125rem;
  /* Prevent truncation */
  padding-bottom: 0.1em;
}

.pillar-card__description {
  font-size: 1.0625rem;
  color: var(--ga-muted);
  line-height: 1.75;
  margin-bottom: 2rem;
}

.pillar-card__features {
  display: flex;
  flex-direction: column;
  gap: 0.875rem;
  margin-bottom: 2.25rem;
}

.pillar-card__feature {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  font-size: 0.9375rem;
  color: rgba(255,255,255,0.8);
  line-height: 1.6;
}

.pillar-card__feature::before {
  content: '';
  width: 7px; height: 7px;
  background: var(--ga-accent);
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 0.5em;
  box-shadow: 0 0 8px rgba(227,252,2,0.6);
}

.pillar-card__link {
  display: inline-flex;
  align-items: center;
  gap: 0.625rem;
  color: var(--ga-accent);
  font-size: 0.9375rem;
  font-weight: 700;
  text-decoration: none;
  transition: gap 0.35s var(--ga-spring);
  letter-spacing: 0.01em;
}

.pillar-card__link:hover {
  gap: 1rem;
}

.pillar-card__link svg {
  width: 16px; height: 16px;
  stroke: currentColor;
  transition: transform 0.35s var(--ga-spring);
}

.pillar-card__link:hover svg {
  transform: translateX(4px);
}

/* ── METRICS PILL TAGS WITH PULSE ────────────── */
.pillar-card__metrics {
  display: flex;
  align-items: center;
  gap: 0.625rem;
  flex-wrap: wrap;
  margin-top: 1.75rem;
  padding-top: 1.75rem;
  border-top: 1px solid rgba(255,255,255,0.06);
}

.metrics-label {
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--ga-muted);
}

.metrics-values {
  font-size: 0.8125rem;
  font-weight: 600;
  color: rgba(255,255,255,0.7);
  letter-spacing: 0.02em;
  padding: 0.35rem 0.85rem;
  background: rgba(227,252,2,0.05);
  border: 1px solid rgba(227,252,2,0.12);
  border-radius: 100px;
  animation: metricsPulse 3.5s ease-in-out infinite;
  box-shadow: 0 0 0 0 rgba(227,252,2,0.3);
}

@keyframes metricsPulse {
  0%, 100% { 
    border-color: rgba(227,252,2,0.12);
    box-shadow: 0 0 0 0 rgba(227,252,2,0.3);
  }
  50% { 
    border-color: rgba(227,252,2,0.28);
    box-shadow: 0 0 0 4px rgba(227,252,2,0);
  }
}

/* ================================================
   SUCCESS STORIES — AUTO-SCROLL CLIENT LOGOS
   ================================================ */

.ga-success-stories {
  padding: 100px 5% 120px;
  background: rgba(0,0,0,0.3);
  position: relative;
  overflow: hidden;
}

.ga-success-stories::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, 
    transparent 0%, 
    rgba(227,252,2,0.3) 50%, 
    transparent 100%
  );
}

.ga-success-stories__header {
  text-align: center;
  margin-bottom: 4rem;
  opacity: 0;
  transform: translateY(30px);
  animation: gaSlideUp 0.75s var(--ga-spring) 1.6s forwards;
}

.ga-success-stories__label {
  font-size: 0.875rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--ga-accent);
  margin-bottom: 1rem;
}

.ga-success-stories__title {
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 900;
  letter-spacing: -0.04em;
  margin-bottom: 0.875rem;
}

.ga-success-stories__subtitle {
  font-size: 1.125rem;
  color: var(--ga-muted);
  max-width: 620px;
  margin: 0 auto;
}

/* Infinite horizontal scroll container */
.ga-logo-scroll {
  position: relative;
  width: 100%;
  overflow: hidden;
  mask-image: linear-gradient(
    to right,
    transparent 0%,
    black 10%,
    black 90%,
    transparent 100%
  );
  -webkit-mask-image: linear-gradient(
    to right,
    transparent 0%,
    black 10%,
    black 90%,
    transparent 100%
  );
}

.ga-logo-scroll__track {
  display: flex;
  gap: 4rem;
  animation: gaLogoScroll 40s linear infinite;
  will-change: transform;
}

@keyframes gaLogoScroll {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.ga-logo-scroll:hover .ga-logo-scroll__track {
  animation-play-state: paused;
}

.ga-logo-item {
  flex-shrink: 0;
  width: 180px;
  height: 80px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 14px;
  padding: 1.25rem;
  transition: all 0.4s var(--ga-spring);
  backdrop-filter: blur(8px);
}

.ga-logo-item:hover {
  background: rgba(255,255,255,0.06);
  border-color: rgba(227,252,2,0.3);
  transform: translateY(-4px) scale(1.05);
  box-shadow: 0 8px 24px rgba(0,0,0,0.3);
}

.ga-logo-item img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  filter: grayscale(1) brightness(0.7);
  transition: filter 0.4s ease;
}

.ga-logo-item:hover img {
  filter: grayscale(0) brightness(1);
}

/* ================================================
   FLOATING CONTACT ADVISORY BUTTON
   ================================================ */

.ga-floating-contact {
  position: fixed;
  bottom: 2.5rem;
  right: 2.5rem;
  z-index: 10000;
  opacity: 0;
  visibility: hidden;
  transform: translateY(20px) scale(0.9);
  transition: all 0.45s cubic-bezier(0.34,1.56,0.64,1);
}

.ga-floating-contact.is-visible {
  opacity: 1;
  visibility: visible;
  transform: translateY(0) scale(1);
}

.ga-floating-contact__button {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  background: var(--ga-accent);
  color: #000;
  border: none;
  border-radius: 100px;
  padding: 1.125rem 2.25rem;
  font-weight: 800;
  font-size: 1rem;
  cursor: pointer;
  text-decoration: none;
  position: relative;
  overflow: hidden;
  letter-spacing: 0.01em;
  box-shadow: 
    0 12px 36px rgba(227,252,2,0.4),
    0 0 0 4px rgba(227,252,2,0.15),
    inset 0 1px 0 rgba(255,255,255,0.4);
  transition: all 0.35s var(--ga-spring);
  animation: floatingPulse 3s ease-in-out infinite;
}

@keyframes floatingPulse {
  0%, 100% {
    transform: scale(1);
    box-shadow: 
      0 12px 36px rgba(227,252,2,0.4),
      0 0 0 4px rgba(227,252,2,0.15),
      inset 0 1px 0 rgba(255,255,255,0.4);
  }
  50% {
    transform: scale(1.05);
    box-shadow: 
      0 16px 48px rgba(227,252,2,0.6),
      0 0 0 8px rgba(227,252,2,0),
      inset 0 1px 0 rgba(255,255,255,0.45);
  }
}

/* Pause pulse on hover */
.ga-floating-contact__button:hover {
  animation-play-state: paused;
  transform: translateY(-4px) scale(1.08);
  box-shadow: 
    0 18px 54px rgba(227,252,2,0.65),
    0 0 0 6px rgba(227,252,2,0.2),
    inset 0 1px 0 rgba(255,255,255,0.5);
}

/* Glass shine sweep */
.ga-floating-contact__button::before {
  content: '';
  position: absolute;
  top: 0; left: -100%;
  width: 50%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.45), transparent);
  transition: left 0.5s ease;
}

.ga-floating-contact__button:hover::before {
  left: 200%;
}

.ga-floating-contact__icon {
  width: 20px; height: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ga-floating-contact__icon svg {
  width: 100%; height: 100%;
  stroke: currentColor;
  fill: none;
  stroke-width: 2.5;
}

/* Mobile positioning */
@media screen and (max-width: 768px) {
  .ga-floating-contact {
    bottom: 1.5rem;
    right: 1.5rem;
  }

  .ga-floating-contact__button {
    padding: 1rem 1.75rem;
    font-size: 0.9375rem;
  }
}

/* ================================================
   RESPONSIVE ADJUSTMENTS
   ================================================ */

@media screen and (max-width: 1024px) {
  .ga-hero {
    grid-template-columns: 1fr;
    gap: 3.5rem;
    padding: 100px 4% 80px;
    min-height: auto;
  }

  .ga-hero__title {
    font-size: clamp(2.25rem, 8vw, 3.5rem);
  }

  .ga-hero__visual::before {
    display: none;
  }

  .ga-pillars-grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .advisory-pillar-card {
    padding: 2.5rem 2rem;
  }

  .ga-logo-scroll__track {
    gap: 3rem;
  }

  .ga-logo-item {
    width: 150px;
    height: 70px;
  }
}

@media screen and (max-width: 640px) {
  .ga-hero {
    padding: 80px 4% 60px;
  }

  .ga-hero__stats {
    gap: 2rem;
  }

  .ga-stat__value {
    font-size: 2rem;
  }

  .advisory-pillar-card {
    padding: 2rem 1.75rem;
  }

  .pillar-card__title {
    font-size: 1.5rem;
  }

  .ga-logo-item {
    width: 130px;
    height: 60px;
  }
}

