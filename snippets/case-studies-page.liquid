{% comment %}
  Tenda Case Studies - Authoritative & Data-Driven
  High-impact success stories with premium animations
{% endcomment %}

<style>
/* ================================================
   CASE STUDIES - AUTHORITATIVE EXPERIENCE
   ================================================ */

:root {
  --case-bg:        #1F1F21;
  --case-accent:    #E3FC02;
  --case-text:      #ffffff;
  --case-muted:     rgba(255,255,255,0.55);
  --case-border:    rgba(227,252,2,0.15);
  --case-smooth:    cubic-bezier(0.16, 1, 0.3, 1);
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  background: var(--case-bg);
  color: var(--case-text);
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', Roboto, sans-serif;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

html {
  scroll-behavior: smooth;
}

/* Typography Fix */
h1, h2, h3, h4, h5, h6 {
  line-height: 1.3 !important;
  padding-bottom: 0.2em !important;
  overflow: visible !important;
}

/* ================================================
   CREATIVE BACKGROUND
   ================================================ */

.case-background {
  position: fixed;
  inset: 0;
  background: 
    linear-gradient(180deg,
      #1F1F21 0%,
      #171719 20%,
      #1F1F21 50%,
      #232325 80%,
      #1F1F21 100%
    ),
    radial-gradient(ellipse 80% 50% at 50% 10%, rgba(227,252,2,0.06) 0%, transparent 60%),
    radial-gradient(ellipse 60% 40% at 10% 60%, rgba(227,252,2,0.03) 0%, transparent 50%);
  pointer-events: none;
  z-index: 0;
}

.case-page {
  position: relative;
  z-index: 1;
}

/* ================================================
   VERTICAL CONNECTOR LINE
   ================================================ */

.vertical-connector {
  position: fixed;
  left: 50%;
  top: 0;
  width: 1px;
  height: 100vh;
  background: linear-gradient(180deg,
    transparent 0%,
    rgba(227,252,2,0.4) 10%,
    rgba(227,252,2,0.2) 90%,
    transparent 100%
  );
  transform: translateX(-50%);
  z-index: 10;
  pointer-events: none;
  opacity: 0;
  animation: lineAppear 1s ease 0.5s forwards;
}

@keyframes lineAppear {
  to { opacity: 1; }
}

/* ================================================
   HERO SECTION
   ================================================ */

.case-hero {
  padding: 180px 5% 100px;
  max-width: 1400px;
  margin: 0 auto;
  text-align: center;
  position: relative;
}

.case-hero__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.625rem;
  font-size: 0.875rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--case-accent);
  margin-bottom: 2rem;
  text-shadow: 0 0 10px rgba(227,252,2,0.4);
}

.case-hero__eyebrow::before {
  content: '';
  width: 8px;
  height: 8px;
  background: var(--case-accent);
  border-radius: 50%;
  box-shadow: 0 0 12px rgba(227,252,2,0.8);
  animation: dotPulse 2.5s ease-in-out infinite;
}

@keyframes dotPulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(227,252,2,0.8); }
  50%      { box-shadow: 0 0 0 12px rgba(227,252,2,0); }
}

.case-hero__title {
  font-size: clamp(3rem, 8vw, 5.5rem);
  font-weight: 900;
  letter-spacing: -0.05em;
  line-height: 1.1;
  margin-bottom: 2rem;
}

.case-hero__subtitle {
  font-size: clamp(1.25rem, 2.5vw, 1.75rem);
  color: var(--case-muted);
  line-height: 1.6;
  max-width: 800px;
  margin: 0 auto 3rem;
}

/* Stats Bar */
.stats-bar {
  display: flex;
  justify-content: center;
  gap: 4rem;
  flex-wrap: wrap;
  margin-top: 4rem;
}

.stat-item {
  text-align: center;
}

.stat-item__value {
  font-size: 3rem;
  font-weight: 900;
  color: var(--case-accent);
  line-height: 1;
  margin-bottom: 0.5rem;
  text-shadow: 0 0 20px rgba(227,252,2,0.4);
  font-variant-numeric: tabular-nums;
}

.stat-item__label {
  font-size: 0.9375rem;
  color: var(--case-muted);
  font-weight: 600;
  letter-spacing: 0.05em;
}

/* ================================================
   FEATURED CASE STUDY (HERO)
   ================================================ */

.featured-case {
  padding: 100px 5%;
  max-width: 1400px;
  margin: 0 auto;
}

.featured-case__container {
  background: rgba(255,255,255,0.04);
  backdrop-filter: blur(40px) saturate(180%);
  border: 1px solid var(--case-border);
  border-radius: 24px;
  overflow: hidden;
  position: relative;
  transition: all 0.5s var(--case-smooth);
}

.featured-case__container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 12%;
  right: 12%;
  height: 1px;
  background: linear-gradient(90deg,
    transparent 0%,
    var(--case-accent) 50%,
    transparent 100%
  );
  box-shadow: 0 0 10px rgba(227,252,2,0.6);
}

.featured-case__container:hover {
  border-color: rgba(227,252,2,0.4);
  box-shadow: 0 20px 60px rgba(0,0,0,0.5), 0 0 40px rgba(227,252,2,0.15);
  transform: translateY(-5px);
}

.featured-case__grid {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 0;
}

.featured-case__image {
  position: relative;
  height: 600px;
  overflow: hidden;
  background: linear-gradient(135deg, rgba(227,252,2,0.05) 0%, transparent 100%);
}

.featured-case__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: grayscale(30%) contrast(1.1);
  transition: transform 0.6s ease;
}

.featured-case__container:hover .featured-case__image img {
  transform: scale(1.05);
}

.featured-case__content {
  padding: 4rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.featured-case__badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: rgba(227,252,2,0.12);
  border: 1px solid rgba(227,252,2,0.3);
  border-radius: 8px;
  padding: 0.5rem 1rem;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--case-accent);
  margin-bottom: 2rem;
  width: fit-content;
  box-shadow: 0 0 10px rgba(227,252,2,0.2);
}

.featured-case__title {
  font-size: 2.5rem;
  font-weight: 900;
  letter-spacing: -0.04em;
  margin-bottom: 1.5rem;
}

.featured-case__description {
  font-size: 1.125rem;
  color: var(--case-muted);
  line-height: 1.7;
  margin-bottom: 2.5rem;
}

/* Before/After Metrics */
.metrics-comparison {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2rem;
  margin-bottom: 2.5rem;
  padding: 2rem;
  background: rgba(0,0,0,0.2);
  border-radius: 12px;
  border: 1px solid rgba(227,252,2,0.1);
}

.metric {
  text-align: center;
}

.metric__label {
  font-size: 0.8125rem;
  color: var(--case-muted);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 0.75rem;
  font-weight: 600;
}

.metric__value {
  font-size: 2.5rem;
  font-weight: 900;
  color: var(--case-accent);
  line-height: 1;
  text-shadow: 0 0 15px rgba(227,252,2,0.4);
  font-variant-numeric: tabular-nums;
}

.metric__arrow {
  display: inline-block;
  margin-left: 0.5rem;
  color: var(--case-accent);
  font-size: 2rem;
}

.featured-case__cta {
  display: inline-flex;
  align-items: center;
  gap: 0.625rem;
  background: var(--case-accent);
  color: #000;
  border: none;
  border-radius: 12px;
  padding: 1rem 2rem;
  font-weight: 800;
  font-size: 0.9375rem;
  text-decoration: none;
  letter-spacing: 0.01em;
  transition: all 0.3s ease;
  box-shadow: 0 4px 16px rgba(227,252,2,0.3);
  width: fit-content;
}

.featured-case__cta:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 28px rgba(227,252,2,0.5);
}

.featured-case__cta svg {
  width: 16px;
  height: 16px;
  stroke: currentColor;
}

/* ================================================
   ANIMATED CATEGORY DIVIDER
   ================================================ */

.category-divider {
  padding: 100px 5% 60px;
  max-width: 1400px;
  margin: 0 auto;
  text-align: center;
  position: relative;
}

.category-divider__line {
  position: relative;
  width: 100%;
  height: 2px;
  margin: 3rem 0;
  overflow: hidden;
}

.category-divider__line::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg,
    transparent 0%,
    rgba(227,252,2,0.6) 20%,
    rgba(227,252,2,1) 50%,
    rgba(227,252,2,0.6) 80%,
    transparent 100%
  );
  box-shadow: 0 0 20px rgba(227,252,2,0.4);
  border-radius: 50px;
  transform: scaleX(0);
  transform-origin: left;
  animation: drawLine 1.5s ease forwards;
}

@keyframes drawLine {
  to { transform: scaleX(1); }
}

.category-divider__title {
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 900;
  letter-spacing: -0.04em;
  margin-bottom: 1rem;
}

.category-divider__subtitle {
  font-size: 1.125rem;
  color: var(--case-muted);
  max-width: 600px;
  margin: 0 auto;
  line-height: 1.7;
}

/* ================================================
   CASE STUDIES GRID
   ================================================ */

.cases-grid {
  padding: 60px 5% 100px;
  max-width: 1400px;
  margin: 0 auto;
}

.cases-grid__container {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
  gap: 2.5rem;
}

/* Editorial Case Card with Parallax */
.case-card {
  background: rgba(255,255,255,0.03);
  backdrop-filter: blur(30px) saturate(150%);
  border: 1px solid var(--case-border);
  border-radius: 20px;
  overflow: hidden;
  position: relative;
  cursor: pointer;
  transition: all 0.5s var(--case-smooth);
  transform-style: preserve-3d;
  perspective: 1000px;
}

.case-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 15%;
  right: 15%;
  height: 1px;
  background: linear-gradient(90deg,
    transparent 0%,
    var(--case-accent) 50%,
    transparent 100%
  );
  z-index: 2;
}

.case-card:hover {
  border-color: rgba(227,252,2,0.5);
  transform: translateY(-10px) translateZ(20px);
  box-shadow: 
    0 20px 60px rgba(0,0,0,0.6),
    0 0 40px rgba(227,252,2,0.2);
}

/* Parallax Image */
.case-card__image {
  position: relative;
  height: 280px;
  overflow: hidden;
  background: linear-gradient(135deg, rgba(227,252,2,0.03) 0%, transparent 100%);
}

.case-card__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: grayscale(40%) contrast(1.1);
  transition: transform 0.8s ease;
  will-change: transform;
}

.case-card:hover .case-card__image img {
  transform: scale(1.08) translateZ(10px);
}

/* Floating Logo */
.case-card__logo {
  position: absolute;
  top: 20px;
  right: 20px;
  background: rgba(255,255,255,0.95);
  padding: 0.75rem 1.25rem;
  border-radius: 10px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.3);
  transition: transform 0.8s ease;
  z-index: 3;
  will-change: transform;
}

.case-card:hover .case-card__logo {
  transform: translateZ(30px) scale(1.05);
}

.case-card__logo img {
  height: 24px;
  width: auto;
  display: block;
}

.case-card__content {
  padding: 2.5rem;
}

.case-card__industry {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--case-accent);
  margin-bottom: 1.25rem;
  padding: 0.375rem 0.875rem;
  background: rgba(227,252,2,0.1);
  border: 1px solid rgba(227,252,2,0.25);
  border-radius: 6px;
}

.case-card__title {
  font-size: 1.75rem;
  font-weight: 800;
  letter-spacing: -0.03em;
  margin-bottom: 1rem;
}

.case-card__description {
  font-size: 1rem;
  color: var(--case-muted);
  line-height: 1.7;
  margin-bottom: 2rem;
}

/* Before/After Pills */
.case-card__metrics {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

.metric-pill {
  background: rgba(0,0,0,0.3);
  border: 1px solid rgba(227,252,2,0.2);
  border-radius: 100px;
  padding: 0.625rem 1.25rem;
  font-size: 0.875rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  transition: all 0.3s ease;
}

.case-card:hover .metric-pill {
  border-color: rgba(227,252,2,0.5);
  box-shadow: 0 0 15px rgba(227,252,2,0.3);
}

.metric-pill__value {
  color: var(--case-accent);
  font-variant-numeric: tabular-nums;
}

.metric-pill__arrow {
  color: var(--case-accent);
}

/* ================================================
   RESPONSIVE
   ================================================ */

@media screen and (max-width: 1024px) {
  .featured-case__grid {
    grid-template-columns: 1fr;
  }

  .featured-case__image {
    height: 400px;
  }

  .cases-grid__container {
    grid-template-columns: 1fr;
  }

  .stats-bar {
    gap: 2rem;
  }
}

@media screen and (max-width: 768px) {
  .case-hero {
    padding: 140px 5% 80px;
  }

  .featured-case__content {
    padding: 2.5rem 2rem;
  }

  .metrics-comparison {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .case-card__content {
    padding: 2rem 1.5rem;
  }
}
</style>

<!-- Background -->
<div class="case-background"></div>

<!-- Vertical Connector Line -->
<div class="vertical-connector"></div>

<div class="case-page">

  <!-- ========================================
       HERO SECTION
       ======================================== -->
  <section class="case-hero">
    <p class="case-hero__eyebrow">Success Stories</p>
    
    <h1 class="case-hero__title">
      Transforming retail data into measurable growth.
    </h1>
    
    <p class="case-hero__subtitle">
      Real businesses. Real results. See how we've helped African retail and service brands turn their data into decisions that drive revenue, improve margins, and accelerate growth.
    </p>

    <!-- Impact Stats Bar -->
    <div class="stats-bar">
      <div class="stat-item">
        <div class="stat-item__value">$12M+</div>
        <div class="stat-item__label">Revenue Impact</div>
      </div>
      <div class="stat-item">
        <div class="stat-item__value">40+</div>
        <div class="stat-item__label">Client Success Stories</div>
      </div>
      <div class="stat-item">
        <div class="stat-item__value">8.5x</div>
        <div class="stat-item__label">Average ROI</div>
      </div>
    </div>
  </section>

  <!-- Distinct Divider -->
  <div class="section-divider" 
       style="
          width: 100%;
          height: 2px;
          margin: 3rem 0 4rem 0;
          background: linear-gradient(
              90deg,
              transparent 0%,
              rgba(227, 252, 2, 0.6) 20%,
              rgba(227, 252, 2, 1) 50%,
              rgba(227, 252, 2, 0.6) 80%,
              transparent 100%
          );
          box-shadow: 0 0 20px rgba(227, 252, 2, 0.4);
          border-radius: 50px;
       ">
