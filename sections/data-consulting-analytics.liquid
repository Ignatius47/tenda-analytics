{% comment %}
  Data Consulting & Analytics — Technical Infrastructure Showcase
  Tenda — Infrastructure for smart decisions
{% endcomment %}

<style>
/* ================================================
   DATA CONSULTING — TECHNICAL INFRASTRUCTURE
   ================================================ */

:root {
  --dc-bg:        #0a0a0c;
  --dc-surface:   rgba(28, 28, 30, 0.88);
  --dc-accent:    #E3FC02;
  --dc-cyan:      #00F2FF;
  --dc-text:      #ffffff;
  --dc-muted:     rgba(255,255,255,0.45);
  --dc-border:    rgba(0,242,255,0.2);
  --dc-spring:    cubic-bezier(0.34,1.56,0.64,1);
  --dc-smooth:    cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  background: var(--dc-bg);
  color: var(--dc-text);
  font-family: system-ui, -apple-system, sans-serif;
  overflow-x: hidden;
}

html {
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
}

/* ── PARALLAX DATA POINTS BACKGROUND ──────────── */
.dc-parallax-data {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  will-change: transform;
}

.dc-data-point {
  position: absolute;
  width: 3px;
  height: 3px;
  background: var(--dc-cyan);
  border-radius: 50%;
  opacity: 0.15;
  box-shadow: 0 0 8px rgba(0,242,255,0.4);
  animation: dataFloat 4s ease-in-out infinite;
}

@keyframes dataFloat {
  0%, 100% { transform: translateY(0) scale(1); opacity: 0.15; }
  50%      { transform: translateY(-15px) scale(1.2); opacity: 0.35; }
}

/* Distribute data points */
.dc-data-point:nth-child(1) { top: 15%; left: 10%; animation-delay: 0s; }
.dc-data-point:nth-child(2) { top: 25%; left: 85%; animation-delay: 0.5s; }
.dc-data-point:nth-child(3) { top: 45%; left: 20%; animation-delay: 1s; }
.dc-data-point:nth-child(4) { top: 55%; left: 75%; animation-delay: 1.5s; }
.dc-data-point:nth-child(5) { top: 70%; left: 40%; animation-delay: 2s; }
.dc-data-point:nth-child(6) { top: 80%; left: 65%; animation-delay: 2.5s; }
.dc-data-point:nth-child(7) { top: 35%; left: 50%; animation-delay: 0.8s; }
.dc-data-point:nth-child(8) { top: 60%; left: 90%; animation-delay: 1.8s; }

.dc-page { position: relative; z-index: 1; }

/* ================================================
   HERO SECTION
   ================================================ */

.dc-hero {
  padding: 140px 5% 100px;
  display: grid;
  grid-template-columns: 1.15fr 1fr;
  gap: 5rem;
  align-items: center;
  max-width: 1500px;
  margin: 0 auto;
  min-height: 88vh;
  position: relative;
  
  opacity: 0;
  transform: scale(0.93) translateY(45px);
  animation: dcGenieOpen 0.82s var(--dc-spring) 0.18s forwards;
}

@keyframes dcGenieOpen {
  0%   { opacity: 0; transform: scale(0.93) translateY(45px); filter: blur(12px); }
  60%  { opacity: 1; transform: scale(1.02) translateY(-8px); filter: blur(0); }
  80%  { transform: scale(0.99) translateY(3px); }
  100% { opacity: 1; transform: scale(1) translateY(0); filter: blur(0); }
}

.dc-hero__text {
  opacity: 0;
  transform: translateY(32px);
  animation: dcSlideUp 0.7s var(--dc-spring) 0.55s forwards;
}

@keyframes dcSlideUp {
  to { opacity: 1; transform: translateY(0); }
}

.dc-hero__eyebrow {
  font-size: 0.875rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--dc-cyan);
  margin-bottom: 1.75rem;
  display: flex;
  align-items: center;
  gap: 0.625rem;
}

.dc-hero__eyebrow::before {
  content: '';
  width: 8px; height: 8px;
  background: var(--dc-cyan);
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 0 12px rgba(0,242,255,0.9);
  animation: dcDotPulse 2.5s ease-in-out infinite;
}

@keyframes dcDotPulse {
  0%,100% { box-shadow: 0 0 0 0 rgba(0,242,255,0.9); }
  50%      { box-shadow: 0 0 0 8px rgba(0,242,255,0); }
}

.dc-hero__title {
  font-size: clamp(2.75rem, 7vw, 5.25rem);
  font-weight: 900;
  letter-spacing: -0.055em;
  line-height: 1.3;  /* Fixed to prevent clipping */
  margin-bottom: 2rem;
  padding-bottom: 0.2em;
  overflow: visible;
  display: block;
}

.dc-hero__title span {
  background: linear-gradient(135deg, var(--dc-text) 0%, var(--dc-cyan) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* Cyan accent for key phrase */
.cyan-accent {
  background: linear-gradient(135deg, var(--dc-cyan) 0%, var(--dc-accent) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.dc-hero__description {
  font-size: clamp(1.125rem, 2.2vw, 1.5rem);
  color: var(--dc-muted);
  line-height: 1.75;
  margin-bottom: 3rem;
  max-width: 600px;
}

.dc-hero__stats {
  display: flex;
  gap: 3rem;
  margin-bottom: 3rem;
  flex-wrap: wrap;
}

.dc-stat {
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
}

.dc-stat__value {
  font-size: 2.5rem;
  font-weight: 900;
  background: linear-gradient(135deg, var(--dc-cyan) 0%, var(--dc-accent) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  letter-spacing: -0.04em;
  line-height: 1;
}

.dc-stat__label {
  font-size: 0.875rem;
  color: var(--dc-muted);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.dc-hero__cta {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  background: linear-gradient(135deg, var(--dc-cyan) 0%, var(--dc-accent) 100%);
  color: #000;
  border: none;
  border-radius: 16px;
  padding: 1.25rem 2.75rem;
  font-weight: 800;
  font-size: 1.125rem;
  cursor: pointer;
  text-decoration: none;
  position: relative;
  overflow: hidden;
  letter-spacing: 0.01em;
  transition: transform 0.35s var(--dc-spring), box-shadow 0.35s ease;
  box-shadow: 
    0 10px 36px rgba(0,242,255,0.35),
    inset 0 1px 0 rgba(255,255,255,0.35);
}

.dc-hero__cta::before {
  content: '';
  position: absolute;
  top: 0; left: -100%;
  width: 60%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.42), transparent);
  transition: left 0.55s ease;
}

.dc-hero__cta:hover::before { left: 200%; }

.dc-hero__cta:hover {
  transform: translateY(-4px) scale(1.04);
  box-shadow: 
    0 16px 52px rgba(0,242,255,0.56),
    inset 0 1px 0 rgba(255,255,255,0.4);
}

.dc-hero__cta svg {
  width: 20px; height: 20px;
  stroke: currentColor;
  transition: transform 0.35s var(--dc-spring);
}

.dc-hero__cta:hover svg {
  transform: translateX(5px);
}

/* Right side visual */
.dc-hero__visual {
  position: relative;
  opacity: 0;
  transform: translateY(35px) scale(0.97);
  animation: dcImageReveal 0.85s var(--dc-spring) 0.7s forwards;
}

@keyframes dcImageReveal {
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.dc-hero__image-frame {
  position: relative;
  border-radius: 28px;
  overflow: hidden;
  box-shadow: 
    0 40px 100px rgba(0,0,0,0.65),
    0 0 0 1px rgba(0,242,255,0.2),
    inset 0 1px 0 rgba(255,255,255,0.1);
  backdrop-filter: blur(2px);
}

.dc-hero__image-frame img {
  width: 100%;
  height: auto;
  display: block;
  transition: transform 0.7s ease;
}

.dc-hero__image-frame:hover img {
  transform: scale(1.06);
}

.dc-hero__visual::before {
  content: '';
  position: absolute;
  top: -16px; right: -16px;
  width: calc(100% + 32px);
  height: calc(100% + 32px);
  border: 2.5px solid;
  border-image: linear-gradient(135deg, var(--dc-cyan) 0%, var(--dc-accent) 100%) 1;
  border-radius: 32px;
  opacity: 0.3;
  pointer-events: none;
  z-index: -1;
}

/* ================================================
   INFRASTRUCTURE GRID — FOUR TECHNICAL PILLARS
   ================================================ */

.dc-infrastructure-section {
  padding: 120px 5% 100px;
  max-width: 1500px;
  margin: 0 auto;
  position: relative;
}

.dc-infrastructure-section__header {
  text-align: center;
  margin-bottom: 5rem;
  opacity: 0;
  transform: translateY(32px);
  animation: dcSlideUp 0.7s var(--dc-spring) 0.85s forwards;
}

.dc-infrastructure-section__label {
  font-size: 0.875rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--dc-cyan);
  margin-bottom: 1.25rem;
}

.dc-infrastructure-section__title {
  font-size: clamp(2.25rem, 5vw, 3.75rem);
  font-weight: 900;
  letter-spacing: -0.045em;
  line-height: 1.3;  /* Fixed */
  margin-bottom: 1.25rem;
  padding-bottom: 0.15em;
}

.dc-infrastructure-section__subtitle {
  font-size: 1.25rem;
  color: var(--dc-muted);
  max-width: 680px;
  margin: 0 auto;
  line-height: 1.7;
}

/* Four-column grid */
.dc-infrastructure-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 2rem;
}

@media screen and (min-width: 1200px) {
  .dc-infrastructure-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

@media screen and (min-width: 768px) and (max-width: 1199px) {
  .dc-infrastructure-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* ── DATA CARD WITH GRADIENT BORDER ──────────── */
.data-card {
  background: rgba(31, 31, 33, 0.85);
  backdrop-filter: blur(30px) saturate(155%);
  -webkit-backdrop-filter: blur(30px) saturate(155%);
  border: 1px solid transparent;
  background-clip: padding-box;
  border-radius: 16px;
  padding: 2.5rem 2rem;
  position: relative;
  overflow: hidden;
  cursor: default;
  transition: transform 0.4s var(--dc-smooth);
  
  /* Hidden for scroll reveal */
  opacity: 0;
  transform: translateY(35px);
}

/* Gradient border pseudo-element */
.data-card::before {
  content: "";
  position: absolute;
  top: -1px; bottom: -1px;
  left: -1px; right: -1px;
  background: linear-gradient(135deg, var(--dc-cyan) 0%, var(--dc-accent) 100%);
  border-radius: 16px;
  z-index: -1;
  opacity: 0.25;
  transition: opacity 0.35s ease;
}

/* Data stream border animation */
@keyframes borderDraw {
  0%   { clip-path: inset(0 100% 100% 0); }
  25%  { clip-path: inset(0 0 100% 0); }
  50%  { clip-path: inset(0 0 0 0); }
  75%  { clip-path: inset(0 0 0 100%); }
  100% { clip-path: inset(0 0 0 0); opacity: 0.25; }
}

.data-card.is-visible::before {
  animation: borderDraw 1.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

/* Intense glow on hover */
.data-card:hover::before {
  opacity: 1;
}

/* Top-edge seam */
.data-card::after {
  content: '';
  position: absolute;
  top: 0; left: 15%; right: 15%;
  height: 1px;
  background: linear-gradient(90deg, 
    transparent 0%, 
    var(--dc-cyan) 50%, 
    transparent 100%
  );
  pointer-events: none;
  z-index: 2;
}

/* Scroll reveal */
.data-card.is-visible {
  opacity: 1;
  transform: translateY(0);
}

.data-card:nth-child(1).is-visible { transition-delay: 0s; }
.data-card:nth-child(2).is-visible { transition-delay: 0.12s; }
.data-card:nth-child(3).is-visible { transition-delay: 0.24s; }
.data-card:nth-child(4).is-visible { transition-delay: 0.36s; }

.data-card:hover {
  transform: translateY(-10px) scale(1.02);
  box-shadow: 
    0 12px 42px rgba(0,0,0,0.5),
    0 0 20px rgba(0,242,255,0.15);
}

.data-card > * { position: relative; z-index: 1; }

/* Card number */
.data-card__number {
  position: absolute;
  top: 1.75rem;
  left: 1.75rem;
  font-size: 0.75rem;
  font-weight: 800;
  color: var(--dc-cyan);
  background: rgba(0,242,255,0.08);
  border: 1px solid rgba(0,242,255,0.2);
  border-radius: 8px;
  padding: 0.3rem 0.65rem;
  letter-spacing: 0.05em;
  z-index: 3;
}

/* Status dot */
.data-card__status {
  position: absolute;
  top: 2.25rem;
  right: 2.25rem;
  width: 10px; height: 10px;
  background: var(--dc-cyan);
  border-radius: 50%;
  box-shadow: 0 0 12px rgba(0,242,255,0.85);
  animation: dcDotPulse 2.5s ease-in-out infinite;
  z-index: 3;
}

.data-card__icon {
  width: 60px; height: 60px;
  background: rgba(0,242,255,0.08);
  border: 1px solid rgba(0,242,255,0.22);
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 2rem;
  transition: all 0.45s var(--dc-spring);
}

.data-card:hover .data-card__icon {
  background: rgba(0,242,255,0.15);
  border-color: rgba(0,242,255,0.4);
  transform: scale(1.08) rotate(-5deg);
  box-shadow: 0 4px 16px rgba(0,242,255,0.25);
}

.data-card__icon svg {
  width: 30px; height: 30px;
  stroke: var(--dc-cyan);
  fill: none;
  stroke-width: 2;
}

.data-card__title {
  font-size: 1.5rem;
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1.3;  /* Fixed */
  margin-bottom: 1rem;
  padding-bottom: 0.1em;
}

.data-card__description {
  font-size: 0.9375rem;
  color: var(--dc-muted);
  line-height: 1.7;
  margin-bottom: 1.75rem;
}

.data-card__features {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  margin-bottom: 2rem;
}

.data-card__feature {
  display: flex;
  align-items: flex-start;
  gap: 0.65rem;
  font-size: 0.875rem;
  color: rgba(255,255,255,0.75);
  line-height: 1.6;
}

.data-card__feature::before {
  content: '';
  width: 6px; height: 6px;
  background: var(--dc-cyan);
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 0.5em;
  box-shadow: 0 0 6px rgba(0,242,255,0.7);
}

/* ── OUTCOMES WITH CYAN GLOW ──────────────────── */
.data-card__outcomes {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  padding-top: 1.5rem;
  border-top: 1px solid rgba(255,255,255,0.06);
}

.outcomes-label {
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--dc-muted);
}

.outcomes-text {
  font-size: 0.8125rem;
  font-weight: 600;
  color: rgba(255,255,255,0.65);
  padding: 0.4rem 0.9rem;
  background: rgba(0,242,255,0.04);
  border: 1px solid rgba(0,242,255,0.12);
  border-radius: 100px;
  transition: all 0.35s ease;
  box-shadow: 0 0 0 0 rgba(0,242,255,0.4);
}

/* Cyan glow intensifies on card hover */
.data-card:hover .outcomes-text {
  background: rgba(0,242,255,0.1);
  border-color: rgba(0,242,255,0.35);
  color: rgba(255,255,255,0.9);
  box-shadow: 
    0 0 0 3px rgba(0,242,255,0.15),
    0 0 12px rgba(0,242,255,0.4);
}

.data-card__link {
  display: inline-flex;
  align-items: center;
  gap: 0.625rem;
  color: var(--dc-cyan);
  font-size: 0.875rem;
  font-weight: 700;
  text-decoration: none;
  transition: gap 0.35s var(--dc-spring);
  letter-spacing: 0.01em;
  margin-top: 1.25rem;
}

.data-card__link:hover {
  gap: 0.95rem;
}

.data-card__link svg {
  width: 15px; height: 15px;
  stroke: currentColor;
  transition: transform 0.35s var(--dc-spring);
}

.data-card__link:hover svg {
  transform: translateX(3px);
}

/* ================================================
   "WE MEET YOU WHERE YOU ARE" — STAGES SECTION
   ================================================ */

.dc-stages-section {
  padding: 120px 5% 100px;
  background: rgba(0,0,0,0.3);
  position: relative;
  overflow: hidden;
}

.dc-stages-section::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, 
    transparent 0%, 
    rgba(0,242,255,0.3) 50%, 
    transparent 100%
  );
}

.dc-stages-section__header {
  text-align: center;
  margin-bottom: 4rem;
  opacity: 0;
  transform: translateY(28px);
  animation: dcSlideUp 0.7s var(--dc-spring) 1.2s forwards;
}

.dc-stages-section__label {
  font-size: 0.875rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--dc-cyan);
  margin-bottom: 1rem;
}

.dc-stages-section__title {
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 900;
  letter-spacing: -0.04em;
  line-height: 1.3;
  margin-bottom: 0.875rem;
}

.dc-stages-section__subtitle {
  font-size: 1.125rem;
  color: var(--dc-muted);
  max-width: 620px;
  margin: 0 auto;
  line-height: 1.65;
}

/* Stage badges (interactive triggers) */
.dc-stages-badges {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1.25rem;
  flex-wrap: wrap;
  margin-bottom: 3rem;
}

.stage-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: rgba(0,242,255,0.06);
  border: 1px solid rgba(0,242,255,0.2);
  border-radius: 100px;
  padding: 0.75rem 1.75rem;
  font-size: 0.875rem;
  font-weight: 700;
  color: rgba(255,255,255,0.7);
  cursor: pointer;
  transition: all 0.35s var(--dc-spring);
  position: relative;
  overflow: hidden;
}

.stage-badge::before {
  content: '';
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 0; height: 0;
  background: rgba(0,242,255,0.2);
  border-radius: 50%;
  transition: width 0.4s ease, height 0.4s ease;
}

.stage-badge:hover, .stage-badge.active {
  background: rgba(0,242,255,0.15);
  border-color: rgba(0,242,255,0.5);
  color: var(--dc-cyan);
  transform: translateY(-3px) scale(1.05);
  box-shadow: 0 6px 20px rgba(0,242,255,0.25);
}

.stage-badge:hover::before, .stage-badge.active::before {
  width: 200px; height: 200px;
}

.stage-badge__icon {
  width: 18px; height: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stage-badge__icon svg {
  width: 100%; height: 100%;
  stroke: currentColor;
  fill: none;
}

/* Stage content panels */
.dc-stages-content {
  max-width: 900px;
  margin: 0 auto;
}

.stage-panel {
  display: none;
  opacity: 0;
  transform: translateY(20px);
  animation: stageFadeIn 0.5s var(--dc-spring) forwards;
}

.stage-panel.active {
  display: block;
}

@keyframes stageFadeIn {
  to { opacity: 1; transform: translateY(0); }
}

.stage-panel__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 1.75rem;
}

.stage-example {
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 14px;
  padding: 1.75rem;
  transition: all 0.35s ease;
}

.stage-example:hover {
  background: rgba(255,255,255,0.06);
  border-color: rgba(0,242,255,0.3);
  transform: translateY(-5px);
  box-shadow: 0 8px 24px rgba(0,0,0,0.3);
}

.stage-example__title {
  font-size: 1rem;
  font-weight: 700;
  color: var(--dc-cyan);
  margin-bottom: 0.75rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.stage-example__title::before {
  content: '';
  width: 8px; height: 8px;
  background: var(--dc-cyan);
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 0 8px rgba(0,242,255,0.7);
}

.stage-example__description {
  font-size: 0.875rem;
  color: var(--dc-muted);
  line-height: 1.65;
}

/* ================================================
   RESPONSIVE
   ================================================ */

@media screen and (max-width: 1024px) {
  .dc-hero {
    grid-template-columns: 1fr;
    gap: 3.5rem;
    padding: 100px 4% 80px;
    min-height: auto;
  }

  .dc-hero__visual::before {
    display: none;
  }

  .dc-infrastructure-grid {
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  .data-card {
    padding: 2rem 1.75rem;
  }
}

@media screen and (max-width: 640px) {
  .dc-hero {
    padding: 80px 4% 60px;
  }

  .dc-hero__stats {
    gap: 2rem;
  }

  .dc-stat__value {
    font-size: 2rem;
