{% comment %}
  Tenda Blog Teaser Cards - Fixed Image Fit for Desktop
  Images now use object-fit: contain to show full image without cropping
{% endcomment %}

<style>
:root {
  --neon: #E3FC02;
  --neon-glow: rgba(227, 252, 2, 0.4);
  --neon-subtle: rgba(227, 252, 2, 0.15);
  --neon-border: rgba(227, 252, 2, 0.1);
  --bg: #1F1F21;
  --glass: rgba(255, 255, 255, 0.03);
  --text: #f5f5f7;
  --muted: rgba(245, 245, 247, 0.6);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  overflow-x: hidden;
}

/* ===================================
   GLOBAL NEON SCROLLBAR
   =================================== */

::-webkit-scrollbar {
  width: 10px;
}

::-webkit-scrollbar-track {
  background: #121212;
}

::-webkit-scrollbar-thumb {
  background: var(--neon);
  border-radius: 10px;
  box-shadow: 0 0 10px var(--neon-glow);
}

::-webkit-scrollbar-thumb:hover {
  background: #f6ff4d;
  box-shadow: 0 0 15px rgba(227, 252, 2, 0.6);
}

/* ===================================
   BLOG HUB CONTAINER
   =================================== */

.blog-hub {
  background: linear-gradient(180deg, 
    #1F1F21 0%,
    #171719 15%,
    #1F1F21 50%,
    #171719 100%
  );
  min-height: 100vh;
  padding: 10vh 5%;
}

/* ===================================
   HERO SECTION
   =================================== */

.blog-hero {
  text-align: center;
  padding-bottom: 8vh;
  position: relative;
  border-bottom: 1px solid var(--neon-border);
  margin-bottom: 8vh;
}

.blog-hero::before {
  content: '';
  position: absolute;
  top: -5vh;
  left: 20%;
  right: 20%;
  height: 1px;
  background: linear-gradient(90deg,
    transparent 0%,
    var(--neon) 50%,
    transparent 100%
  );
}

.hero-eyebrow {
  font-size: 0.875rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--neon);
  margin-bottom: 1.5rem;
  opacity: 0;
  animation: fadeIn 0.6s ease forwards;
}

@keyframes fadeIn {
  to { opacity: 1; }
}

.hero-title {
  font-size: clamp(2.5rem, 6vw, 4.5rem);
  font-weight: 800;
  line-height: 1.1;
  margin-bottom: 1.5rem;
  opacity: 0;
  animation: fadeIn 0.8s ease 0.2s forwards;
}

.hero-subtitle {
  font-size: clamp(1.125rem, 2vw, 1.375rem);
  color: var(--muted);
  max-width: 700px;
  margin: 0 auto;
  line-height: 1.6;
  opacity: 0;
  animation: fadeIn 0.8s ease 0.4s forwards;
}

/* ===================================
   INSIGHTS GRID - 2×2 PERFECT SYMMETRY
   =================================== */

.insights-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2.5rem;
  max-width: 1400px;
  margin: 0 auto;
}

/* ===================================
   CARD IMAGE HEADER - TOP SECTION (FIXED)
   =================================== */

.card-image-header {
  position: relative;
  width: 100%;
  height: 240px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-image-header::before {
  content: "";
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  filter: blur(20px);
  transform: scale(1.1);
  opacity: 0.5;
  z-index: 1;
}

.card-image-header img {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
  display: block;
}
.card-image-header::before {
  background-image: var(--bg);
}

/* Subtle zoom on hover (less aggressive since we're using contain) */
.blog-card:hover .card-image-header img {
  transform: scale(1.05);
}

/* ===================================
   BLOG TEASER CARDS - UNIFIED HEIGHT
   =================================== */

.blog-card {
  background: var(--glass);
  backdrop-filter: blur(25px);
  -webkit-backdrop-filter: blur(25px);
  border: 0.5px solid var(--neon-border);
  border-radius: 24px;
  position: relative;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  overflow: hidden;
  opacity: 0;
  transform: translateY(30px);
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 620px;
}

.blog-card.reveal {
  animation: revealCard 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.blog-card:nth-child(1) {
  animation-delay: 0.2s;
}

.blog-card:nth-child(2) {
  animation-delay: 0.4s;
}

.blog-card:nth-child(3) {
  animation-delay: 0.6s;
}

.blog-card:nth-child(4) {
  animation-delay: 0.8s;
}

.blog-card:nth-child(5) {
  animation-delay: 1.0s;
}

@keyframes revealCard {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Neon Top Border with Pulse */
.blog-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: var(--neon);
  box-shadow: 0 0 10px var(--neon-glow);
  transition: all 0.4s ease;
  z-index: 1;
}

/* Micro-Interactions on Hover */
.blog-card:hover {
  transform: translateY(-10px) scale(1.02);
  box-shadow: 0 20px 60px rgba(0,0,0,0.6), 0 0 40px var(--neon-subtle);
  border-color: var(--neon);
}

.blog-card:hover::before {
  height: 3px;
  box-shadow: 0 0 25px var(--neon-glow), 0 0 50px rgba(227, 252, 2, 0.3);
  animation: neonPulse 1.5s ease-in-out infinite;
}

@keyframes neonPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}

/* Background Zoom on Hover */
.blog-card:hover .card-background {
  transform: scale(1.1);
}

/* ===================================
   CARD BACKGROUND IMAGE
   =================================== */

.card-background {
  position: absolute;
  inset: 0;
  z-index: 0;
  transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  overflow: hidden;
}

.card-background img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.15;
  filter: blur(3px);
}

/* ===================================
   CARD HEADER
   =================================== */

.card-header {
  position: relative;
  z-index: 2;
  padding: 1.5rem 2rem 1rem;
  flex-shrink: 0;
}

.badge {
  display: inline-block;
  padding: 0.5rem 1rem;
  background: rgba(227, 252, 2, 0.95);
  color: #000;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  border-radius: 6px;
  box-shadow: 0 4px 15px rgba(227, 252, 2, 0.4);
  transition: all 0.3s ease;
}

.blog-card:hover .badge {
  transform: scale(1.05);
  box-shadow: 0 6px 20px rgba(227, 252, 2, 0.6);
}

/* ===================================
   TEASER CONTENT - PUSHED TO BOTTOM
   =================================== */

.teaser-content {
  position: relative;
  z-index: 2;
  flex: 1;
  padding: 1rem 2rem;
  background: rgba(31, 31, 33, 0.85);
  backdrop-filter: blur(25px);
  -webkit-backdrop-filter: blur(25px);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  overflow-y: auto;
  max-height: 300px;
}

/* Neon Scrollbar for Teaser Content */
.teaser-content::-webkit-scrollbar {
  width: 6px;
}

.teaser-content::-webkit-scrollbar-track {
  background: rgba(255, 255, 255, 0.05);
}

.teaser-content::-webkit-scrollbar-thumb {
  background: var(--neon);
  border-radius: 10px;
  box-shadow: 0 0 8px rgba(227, 252, 2, 0.5);
}

.teaser-content::-webkit-scrollbar-thumb:hover {
  background: #f6ff4d;
  box-shadow: 0 0 12px rgba(227, 252, 2, 0.7);
}

.teaser-content h3 {
  font-size: 1.75rem;
  font-weight: 700;
  line-height: 1.3;
  margin-bottom: 1rem;
  color: var(--text);
}

.teaser-content p {
  font-size: 1.0625rem;
  line-height: 1.7;
  color: var(--muted);
  font-style: italic;
  margin-top: auto;
}

.teaser-content p::before,
.teaser-content p::after {
  content: '"';
  color: var(--neon);
  font-size: 1.5rem;
  line-height: 0;
  vertical-align: -0.2em;
}

/* ===================================
   TENDA NEON BUTTON - ANCHORED AT BOTTOM
   =================================== */

.tenda-btn-neon {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.625rem;
  width: calc(100% - 4rem);
  margin: 0 2rem 2rem;
  padding: 1.125rem 2rem;
  background: transparent;
  color: var(--neon);
  border: 2px solid var(--neon);
  border-radius: 12px;
  font-size: 1rem;
  font-weight: 700;
  text-decoration: none;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 0 20px rgba(227, 252, 2, 0.2);
  cursor: pointer;
  margin-top: auto;
  flex-shrink: 0;
}

.tenda-btn-neon:hover {
  background: var(--neon);
  color: #000;
  transform: translateY(-2px);
  box-shadow: 0 8px 30px var(--neon-glow);
}

.tenda-btn-neon svg {
  width: 20px;
  height: 20px;
  transition: transform 0.3s ease;
  flex-shrink: 0;
}

.tenda-btn-neon:hover svg {
  transform: scale(1.1);
}

/* ===================================
   FLOATING WHATSAPP
   =================================== */

.whatsapp-specialist {
  position: fixed;
  bottom: 88px;
  right: 28px;
  padding: 1rem 1.5rem;
  background: var(--neon);
  color: #000;
  border: none;
  border-radius: 980px;
  font-size: 0.9375rem;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 4px 20px var(--neon-glow);
  z-index: 9999;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  align-items: center;
  gap: 0.5rem;
  white-space: nowrap;
  text-decoration: none;
}

.whatsapp-specialist:hover {
  transform: translateY(-4px) scale(1.05);
  box-shadow: 0 8px 30px var(--neon-glow);
}

/* ===================================
   RESPONSIVE - MOBILE STACK
   =================================== */

@media (max-width: 1200px) {
  .insights-grid {
    gap: 2rem;
  }

  .blog-card {
    min-height: 600px;
  }
}

@media (max-width: 900px) {
  .insights-grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .blog-card {
    min-height: 580px;
  }

  .card-image-header {
    height: 220px;
  }

  .teaser-content {
    max-height: 280px;
  }

  .whatsapp-specialist {
    bottom: 74px;
    right: 20px;
    padding: 0.875rem 1.25rem;
    font-size: 0.875rem;
  }
}

@media (max-width: 640px) {
  .blog-hub {
    padding: 8vh 5%;
  }

  .blog-hero {
    padding-bottom: 6vh;
    margin-bottom: 6vh;
  }

  .insights-grid {
    gap: 2rem;
  }

  .blog-card {
    min-height: 560px;
  }

  .card-image-header {
    height: 200px;
  }

  .card-header {
    padding: 1.25rem 1.5rem 1rem;
  }

  .teaser-content {
    padding: 1rem 1.5rem 1.5rem;
    max-height: 260px;
  }

  .teaser-content h3 {
    font-size: 1.5rem;
  }

  .teaser-content p {
    font-size: 1rem;
  }

  .tenda-btn-neon {
    width: calc(100% - 3rem);
    margin: 0 1.5rem 1.5rem;
    padding: 1rem 1.5rem;
    font-size: 0.9375rem;
  }
}

</style>

