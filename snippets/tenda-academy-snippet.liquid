<script>
// Tab Switching
function switchTab(tabId) {
  document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
  document.querySelectorAll('.tab-trigger').forEach(t => t.classList.remove('active'));
  
  document.getElementById(tabId).classList.add('active');
  event.currentTarget.classList.add('active');
  
  window.scrollTo({top: 0, behavior: 'smooth'});
  
  setTimeout(() => {
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  }, 100);
}

// Script to show selected filename
  document.getElementById('cvFile').addEventListener('change', function(e) {
    const fileName = e.target.files[0] ? e.target.files[0].name : "Upload CV/Portfolio (PDF/Doc)";
    document.getElementById('fileNameDisplay').textContent = fileName;
    document.getElementById('fileNameDisplay').style.color = "#E3FC02"; // Tenda Neon color
  });

// Intersection Observer
const observer = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.classList.add('visible');
    }
  });
}, { threshold: 0.1 });

document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

// Category Filtering
document.querySelectorAll('.filter-pill').forEach(pill => {
  pill.addEventListener('click', function() {
    document.querySelectorAll('.filter-pill').forEach(p => p.classList.remove('active'));
    this.classList.add('active');
    
    const category = this.dataset.category;
    
    document.querySelectorAll('.resource-card').forEach(card => {
      if (category === 'all' || card.dataset.category === category) {
        card.style.display = 'block';
        setTimeout(() => {
          card.style.opacity = '1';
          card.style.transform = 'scale(1)';
        }, 10);
      } else {
        card.style.opacity = '0';
        card.style.transform = 'scale(0.95)';
        setTimeout(() => {
          card.style.display = 'none';
        }, 300);
      }
    });
  });
});

// Timeline Animation
const timelineSteps = document.querySelectorAll('.timeline-step');
const timelineLine = document.getElementById('timelineLine');

function animateTimeline() {
  const windowCenter = window.innerHeight / 2;
  
  timelineSteps.forEach((step, index) => {
    const rect = step.getBoundingClientRect();
    const stepCenter = rect.top + rect.height / 2;
    
    if (stepCenter < windowCenter + 100) {
      step.classList.add('active');
      
      if (index === timelineSteps.length - 1 && step.classList.contains('active')) {
        timelineLine.classList.add('active');
      }
    }
  });
}

window.addEventListener('scroll', animateTimeline);
animateTimeline();

// Form Progress & Validation
const form = document.getElementById('applicationForm');
const progressBar = document.getElementById('formProgressBar');
const requiredFields = form.querySelectorAll('[required]');

function updateProgress() {
  let filledFields = 0;
  requiredFields.forEach(field => {
    if (field.type === 'checkbox') {
      const checkboxes = form.querySelectorAll('input[name="' + field.name + '"]:checked');
      if (checkboxes.length > 0) filledFields++;
    } else if (field.value.trim() !== '') {
      filledFields++;
    }
  });
  
  const progress = (filledFields / requiredFields.length) * 100;
  progressBar.style.width = progress + '%';
}

requiredFields.forEach(field => {
  field.addEventListener('input', function() {
    updateProgress();
    if (this.value.trim() !== '' && this.checkValidity()) {
      this.classList.add('valid');
    } else {
      this.classList.remove('valid');
    }
  });
  field.addEventListener('change', updateProgress);
});

// Availability Slider
const slider = document.getElementById('availabilitySlider');
const sliderValue = document.getElementById('sliderValue');

slider.addEventListener('input', function() {
  sliderValue.textContent = this.value + ' hours';
});

// Checkbox Styling
const checkboxes = document.querySelectorAll('.expertise-checkbox');
checkboxes.forEach(cb => {
  cb.addEventListener('change', function() {
    if (this.checked) {
      this.style.background = '#E3FC02';
      this.style.borderColor = '#E3FC02';
      this.style.boxShadow = '0 0 10px rgba(227, 252, 2, 0.4)';
    } else {
      this.style.background = 'transparent';
      this.style.borderColor = 'rgba(255, 255, 255, 0.3)';
      this.style.boxShadow = 'none';
    }
    updateProgress();
  });
});

// Form Submission
form.addEventListener('submit', function(e) {
  e.preventDefault();
  alert('Application submitted! We\'ll review it and get back to you within 5 business days.');
  form.reset();
  progressBar.style.width = '0%';
  sliderValue.textContent = '40 hours';
  checkboxes.forEach(cb => {
    cb.style.background = 'transparent';
    cb.style.borderColor = 'rgba(255, 255, 255, 0.3)';
    cb.style.boxShadow = 'none';
  });
});

// Smooth Scroll for Apply CTA
const applyCTA = document.querySelector('a[href="#application-form-section"]');
if (applyCTA) {
  applyCTA.addEventListener('click', function(e) {
    e.preventDefault();
    document.getElementById('application-form-section').scrollIntoView({behavior: 'smooth'});
  });
}

document.addEventListener('DOMContentLoaded', function() {
  
  // ===================================
  // DOWNLOAD GATE LOGIC
  // ===================================
  
  const downloadLinks = document.querySelectorAll('.download-link-symmetric');
  const accessModal = document.getElementById('tendaAccessModal');
  const accessCloseBtn = document.getElementById('tendaAccessClose');
  
  // Check subscription status
  // You can replace this with your actual subscription check logic
  function isSubscribed() {
    // Check localStorage
    const localCheck = localStorage.getItem('tenda_subscribed');
    
    // Check cookie
    const cookieCheck = document.cookie.split('; ').find(row => row.startsWith('tenda_subscribed='));
    
    // Return true if either exists
    return localCheck === 'true' || cookieCheck;
  }
  
  // Show access modal
  function showAccessModal() {
    accessModal.classList.add('active');
    document.body.style.overflow = 'hidden'; // Prevent background scroll
  }
  
  // Hide access modal
  function hideAccessModal() {
    accessModal.classList.remove('active');
    document.body.style.overflow = ''; // Restore scroll
  }
  
  // Scroll to footer subscribe section
  function scrollToSubscribe() {
    // Try multiple possible selectors for the subscribe section
    const subscribeSection = 
      document.getElementById('footer-subscribe') ||
      document.querySelector('[id*="newsletter"]') ||
      document.querySelector('[id*="subscribe"]') ||
      document.querySelector('footer form') ||
      document.querySelector('footer');
    
    if (subscribeSection) {
      subscribeSection.scrollIntoView({ 
        behavior: 'smooth',
        block: 'center'
      });
    }
  }
  
  // Trigger download
  function triggerDownload(fileUrl) {
    // Create a temporary link and click it
    const link = document.createElement('a');
    link.href = fileUrl;
    link.download = fileUrl.split('/').pop();
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    
    console.log('Download initiated:', fileUrl);
  }
  
  // Attach click handlers to all download links
  downloadLinks.forEach(link => {
    link.addEventListener('click', function(e) {
      e.preventDefault();
      
      const fileUrl = this.getAttribute('data-file') || this.getAttribute('href');
      
      if (isSubscribed()) {
        // User is subscribed - allow download
        console.log('User is subscribed - downloading file');
        triggerDownload(fileUrl);
      } else {
        // User is NOT subscribed - show modal and redirect
        console.log('User is not subscribed - showing access modal');
        
        // Show access modal
        showAccessModal();
        
        // After brief delay, scroll to subscribe section
        setTimeout(() => {
          scrollToSubscribe();
        }, 1500);
      }
    });
  });
  
  // Close modal on button click
  if (accessCloseBtn) {
    accessCloseBtn.addEventListener('click', hideAccessModal);
  }
  
  // Close modal on backdrop click
  if (accessModal) {
    accessModal.addEventListener('click', function(e) {
      if (e.target === accessModal) {
        hideAccessModal();
      }
    });
  }
  
  // Close modal on Escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && accessModal.classList.contains('active')) {
      hideAccessModal();
    }
  });
  
  // ===================================
  // SUBSCRIPTION SUCCESS HANDLER
  // Call this when user successfully subscribes
  // ===================================
  
  window.markUserAsSubscribed = function() {
    // Set localStorage
    localStorage.setItem('tenda_subscribed', 'true');
    
    // Set cookie (expires in 365 days)
    const expires = new Date();
    expires.setTime(expires.getTime() + (365 * 24 * 60 * 60 * 1000));
    document.cookie = `tenda_subscribed=true; expires=${expires.toUTCString()}; path=/`;
    
    console.log('User marked as subscribed');
  };
  
  // ===================================
  // OPTIONAL: Integrate with Shopify Newsletter Form
  // ===================================
  
  // If you have a newsletter form, you can attach this handler
  const newsletterForm = document.querySelector('form[action*="contact"]');
  
  if (newsletterForm) {
    newsletterForm.addEventListener('submit', function(e) {
      // After form submits successfully, mark user as subscribed
      // You may need to check for success in different ways depending on your setup
      
      setTimeout(() => {
        // Check if submission was successful (adjust based on your form logic)
        if (window.location.hash === '#newsletter' || window.location.search.includes('customer_posted=true')) {
          window.markUserAsSubscribed();
        }
      }, 1000);
    });
  }

  const fileInput = document.getElementById('cvFile');
const fileNameDisplay = document.getElementById('fileNameDisplay');
const MAX_FILE_SIZE = 10 * 1024 * 1024; // 10MB Universal Limit

fileInput.addEventListener('change', function() {
  const file = this.files[0];
  
  if (file) {
    if (file.size > MAX_FILE_SIZE) {
      // Error State: Tenda Neon Warning
      fileNameDisplay.textContent = "File too large (Max 10MB)";
      fileNameDisplay.style.color = "#FF4444"; // Emergency Red
      this.value = ""; // Clear the input
    } else {
      // Success State: Tenda Neon Confirmation
      fileNameDisplay.textContent = file.name;
      fileNameDisplay.style.color = "#E3FC02"; // Neon Yellow
    }
  }
});
  
  // ===================================
  // CATEGORY FILTERING (Updated for Symmetric Cards)
  // ===================================
  
  document.querySelectorAll('.filter-pill').forEach(pill => {
    pill.addEventListener('click', function() {
      document.querySelectorAll('.filter-pill').forEach(p => p.classList.remove('active'));
      this.classList.add('active');
      
      const category = this.dataset.category;
      
      document.querySelectorAll('.resource-card-symmetric').forEach(card => {
        if (category === 'all' || card.dataset.category === category) {
          card.style.display = 'flex'; // Changed from 'block' to 'flex'
          setTimeout(() => {
            card.style.opacity = '1';
            card.style.transform = 'scale(1)';
          }, 10);
        } else {
          card.style.opacity = '0';
          card.style.transform = 'scale(0.95)';
          setTimeout(() => {
            card.style.display = 'none';
          }, 300);
        }
      });
    });
  });
  
  console.log('Tenda Academy download gate initialized');
});

// ===================================
// USAGE EXAMPLE: How to mark user as subscribed
// ===================================

/*
  Call this function when user successfully subscribes to your newsletter:
  
  window.markUserAsSubscribed();
  
  This will:
  1. Set localStorage item 'tenda_subscribed' to 'true'
  2. Set a cookie 'tenda_subscribed' that expires in 365 days
  3. Allow the user to download playbooks without seeing the modal
*/

</script>