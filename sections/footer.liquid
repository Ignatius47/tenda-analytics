<footer class="tenda-footer">

  <!-- ================================
       SUBSCRIBE SECTION - TOP OF FOOTER
       ================================ -->
  <div class="footer-subscribe" id="footerSubscribe">

    <!-- Animated background grain -->
    <div class="sub-grain"></div>
    <!-- Cursor glow follower -->
    <div class="sub-cursor-glow" id="subCursorGlow"></div>

    <div class="sub-inner">

      <!-- Headline - each word animates in -->
      <h2 class="sub-heading">
        <span class="sub-word">Subscribe</span>
        <span class="sub-word sub-word--accent">to our</span>
        <span class="sub-word">emails</span>
      </h2>

      <!-- Subtext -->
      <p class="sub-text">
        {{ section.settings.subscribe_subtext | default: 'Be the first to know about new insights, tools and exclusive offers.' }}
      </p>

      <!-- Email form -->
      {% form 'customer', id: 'FooterNewsletterForm', class: 'sub-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">

        <div class="sub-field-wrap" id="subFieldWrap">
          <div class="sub-field">
            <input
              type="email"
              name="contact[email]"
              id="FooterEmail"
              class="sub-input"
              placeholder="Your email address"
              autocomplete="email"
              aria-label="Email address"
              required
              {% if form.errors %}aria-invalid="true"{% endif %}
            >
            <button type="submit" class="sub-btn" id="FooterSubBtn" aria-label="Subscribe">
              <span class="sub-btn-text">Subscribe</span>
              <span class="sub-btn-arrow">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </span>
              <span class="sub-btn-spinner"></span>
            </button>
          </div>

          {% if form.errors %}
            <p class="sub-error">Please enter a valid email address.</p>
          {% endif %}
        </div>

        {% if form.posted_successfully? %}
          <div class="sub-success" id="subSuccess">
            <span>✓</span>
            <span>You're in! Welcome to the Tenda community.</span>
          </div>
        {% endif %}

      {% endform %}

      <!-- Privacy note -->
      <p class="sub-privacy">No spam, ever. Unsubscribe anytime.</p>

    </div>
  </div>

  <!-- ================================
       FOOTER LINKS + BRAND
       ================================ -->
  <div class="footer-main">
    <div class="footer-inner">

      <div class="footer-grid">

        <!-- BRAND -->
        <div class="footer-brand">
          <h3 class="brand-title">{{ section.settings.brand_name | default: 'Tenda' }}</h3>
          <p class="brand-description">{{ section.settings.brand_description | default: 'Data-driven growth for African retail and service brands.' }}</p>

          <div class="social-links" id="socialLinks">
            <!-- Instagram - Always visible -->
            <a href="{{ section.settings.instagram_url | default: 'https://www.instagram.com/tenda.analytics?igsh=bzRza3RxdGUyOHI3' }}" 
               target="_blank" 
               rel="noopener noreferrer" 
               aria-label="Instagram" 
               class="social-link" 
               data-magnetic>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </a>

            <!-- LinkedIn - Always visible -->
            <a href="{{ section.settings.linkedin_url | default: 'https://www.linkedin.com/company/tenda-analytics/' }}" 
               target="_blank" 
               rel="noopener noreferrer" 
               aria-label="LinkedIn" 
               class="social-link" 
               data-magnetic>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                <rect x="2" y="9" width="4" height="12"></rect>
                <circle cx="4" cy="4" r="2"></circle>
              </svg>
            </a>

            <!-- Twitter/X - Optional -->
            {% if section.settings.twitter_url != blank %}
              <a href="{{ section.settings.twitter_url }}" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)" class="social-link" data-magnetic>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </a>
            {% endif %}

            <!-- Discord - Optional -->
            {% if section.settings.discord_url != blank %}
              <a href="{{ section.settings.discord_url }}" target="_blank" rel="noopener noreferrer" aria-label="Discord" class="social-link" data-magnetic>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0 a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
                </svg>
              </a>
            {% endif %}

            <!-- Email - Optional -->
            {% if section.settings.email != blank %}
              <a href="mailto:{{ section.settings.email }}" aria-label="Email" class="social-link" data-magnetic>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 13.5L0 6V18h24V6L12 13.5zm12-9H0l12 7.5L24 4.5z"/>
                </svg>
              </a>
            {% endif %}
          </div>
        </div>

        <!-- SERVICES -->
        <div class="footer-col">
          <h4 class="footer-col-title">Services</h4>
          <ul class="footer-links">
            <li><a href="{{ section.settings.advisory_link }}">Tenda Advisory</a></li>
            <li><a href="{{ section.settings.platform_link }}">Tenda Platform</a></li>
            <li><a href="{{ section.settings.digital_link }}">Digital Products</a></li>
          </ul>
        </div>

        <!-- COMPANY -->
        <div class="footer-col">
          <h4 class="footer-col-title">Company</h4>
          <ul class="footer-links">
            <li><a href="{{ section.settings.about_link }}">About Us</a></li>
            <li><a href="{{ section.settings.events_link }}">Events</a></li>
            <li><a href="{{ section.settings.marketplace_link }}">Marketplace</a></li>
          </ul>
        </div>

      </div>

      <!-- COPYRIGHT -->
      <div class="footer-bottom">
        <p>&copy; {{ 'now' | date: '%Y' }} Tenda Analytics. All rights reserved.</p>
      </div>

    </div>
  </div>

</footer>

<!-- WHATSAPP FLOAT -->
