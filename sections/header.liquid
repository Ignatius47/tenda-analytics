    box-shadow: 
      0 0 14px rgba(227, 252, 2, 1),
      0 0 28px rgba(227, 252, 2, 0.8),
      0 0 56px rgba(227, 252, 2, 0.6),
      0 4px 12px rgba(0, 0, 0, 0.35);
  }
}

