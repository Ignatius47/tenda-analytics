  }
}

/* ===================================
   BREATHING ANIMATION
   Physical "scale + glow" pulse
   =================================== */

@keyframes neonBadgeBreathing {
  0%, 100% { 
    transform: scale(1);
    box-shadow: 
      0 0 8px rgba(227, 252, 2, 0.8),
      0 0 16px rgba(227, 252, 2, 0.6),
