  .section-header::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--header-accent) 50%, transparent);
    opacity: 0.3;
  }

  .header-wrapper,
  .header {
    background: transparent !important;
    border: none !important;
    margin: 0 !important;
  }

