  align-items: center;
  justify-content: center;
  
  /* SOLID NEON YELLOW - No transparency */
  background: #E3FC02 !important;
  color: #000000 !important;
  
  /* Border for definition */
  border: 1px solid rgba(227, 252, 2, 0.4);
  
