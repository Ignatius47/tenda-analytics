{% comment %}
  Tenda About Us - 2x2 Grid for How We Work
  Structured rows, no horizontal scroll issues
{% endcomment %}


<link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet">
<script src="https://assets.calendly.com/assets/external/widget.js" type="text/javascript" async></script>

<style>
/* ===================================
   TENDA COLOR SYSTEM
   =================================== */

:root {
  --color-tenda-neon: #E3FC02;
  --color-neon-glow: rgba(227, 252, 2, 0.4);
  --color-neon-subtle: rgba(227, 252, 2, 0.15);
  --color-neon-border: rgba(227, 252, 2, 0.1);
  --color-tenda-cyan: #00F2FF;
  --color-cyan-glow: rgba(0, 242, 255, 0.4);
  --color-bg: #1F1F21;
  --color-text: #f5f5f7;
  --color-muted: rgba(245,245,247,0.6);
  --line-height-heading: 1.3;
  --padding-descender: 0.2em;
}

html {
  scroll-behavior: smooth;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: var(--color-bg);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', Roboto, sans-serif;
  overflow-x: hidden;
}

h1, h2, h3, h4, h5, h6,
.hero-title, .section-title, .card-title {
  line-height: var(--line-height-heading) !important;
  padding-bottom: var(--padding-descender) !important;
  overflow: visible !important;
}

.apple-about {
  position: relative;
  z-index: 1;
  padding-bottom: 0;
  margin-bottom: 0;
  background: 
    linear-gradient(180deg, 
      #1F1F21 0%,
      #171719 15%,
      #1F1F21 35%,
      #232325 55%,
      #1F1F21 75%,
      #171719 100%
    );
}

.apple-about::before {
  content: '';
  position: absolute;
  inset: 0;
  background: 
    radial-gradient(ellipse 90% 40% at 50% 0%, rgba(227,252,2,0.08) 0%, transparent 60%),
    radial-gradient(ellipse 50% 60% at 0% 50%, rgba(0,242,255,0.04) 0%, transparent 50%),
    radial-gradient(ellipse 50% 60% at 100% 50%, rgba(227,252,2,0.04) 0%, transparent 50%),
    radial-gradient(ellipse 80% 30% at 50% 100%, rgba(0,242,255,0.05) 0%, transparent 60%);
  z-index: -1;
  pointer-events: none;
}

.apple-about::after {
  content: '';
  position: absolute;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.02'/%3E%3C/svg%3E");
  z-index: -1;
  pointer-events: none;
  opacity: 0.5;
}

/* ===================================
   HERO
   =================================== */

.floating-hero {
  height: 100vh;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  border-top: 1px solid rgba(227, 252, 2, 0.2);
  box-shadow: 
    inset 0 1px 0 rgba(227, 252, 2, 0.1),
    0 -1px 20px rgba(227, 252, 2, 0.15);
}

.hero-foreground {
  position: relative;
  z-index: 2;
  text-align: center;
  padding: 0 5%;
}

.hero-eyebrow {
  font-size: 1rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-tenda-neon);
  margin-bottom: 1rem;
  text-shadow: 0 0 15px var(--color-neon-glow);
}

.hero-title {
  font-size: clamp(3rem, 8vw, 5rem);
  font-weight: 700;
  line-height: 1.05;
  letter-spacing: -0.015em;
  margin-bottom: 1.5rem;
}

.hero-subtitle {
  font-size: clamp(1.25rem, 2.5vw, 1.75rem);
  font-weight: 400;
  line-height: 1.4;
  color: var(--color-muted);
  max-width: 800px;
  margin: 0 auto;
}

/* ===================================
   MANIFESTO
   =================================== */

.manifesto-section {
  min-height: 150vh;
  position: relative;
  padding: 15vh 5% 10vh;
  background: rgba(0, 0, 0, 0.2);
  backdrop-filter: blur(1px);
  border-left: 1px solid rgba(227, 252, 2, 0.05);
  border-right: 1px solid rgba(227, 252, 2, 0.05);
}

.manifesto-sticky {
  position: sticky;
  top: 15vh;
  max-width: 1200px;
  margin: 0 auto;
}

.manifesto-title {
  font-size: 1rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-tenda-neon);
  margin-bottom: 3rem;
  text-align: center;
  text-shadow: 0 0 15px var(--color-neon-glow);
}

.manifesto-text {
  font-size: clamp(1.75rem, 4vw, 3.5rem);
  font-weight: 600;
  line-height: 1.3;
  letter-spacing: -0.01em;
  text-align: center;
}

.manifesto-span {
  opacity: 0.15;
  color: rgba(245,245,247,0.3);
  transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  display: inline-block;
  margin: 0 0.15em;
}

.manifesto-span.revealed {
  opacity: 1;
  color: var(--color-tenda-neon);
  text-shadow: 0 0 20px var(--color-neon-glow);
  transform: translateY(-2px);
}

/* ===================================
   BUTTONS
   =================================== */

.btn-primary,
.magnetic-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  background: var(--color-tenda-neon) !important;
  color: #000 !important;
  padding: 1rem 2rem;
  border-radius: 980px;
  font-size: 1.0625rem;
  font-weight: 700;
  text-decoration: none !important;
  border: none;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 4px 20px var(--color-neon-glow);
  width: auto !important;
  min-width: 200px;
  max-width: 100%;
  white-space: nowrap;
}

.btn-primary:hover,
.magnetic-btn:hover {
  transform: scale(1.02) translateY(-2px);
  box-shadow: 0 8px 30px var(--color-neon-glow);
  text-decoration: none !important;
}

.btn-secondary {
  background: transparent !important;
  color: var(--color-tenda-neon) !important;
  border: 1.5px solid var(--color-neon-border);
  text-decoration: none !important;
  width: auto !important;
  min-width: 200px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 1rem 2rem;
  border-radius: 980px;
  font-size: 1.0625rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  white-space: nowrap;
}

.btn-secondary:hover {
  background: var(--color-neon-subtle) !important;
  border-color: var(--color-tenda-neon);
  text-decoration: none !important;
}

.btn-primary svg,
.btn-secondary svg {
  width: 16px;
  height: 16px;
  transition: transform 0.3s ease;
  flex-shrink: 0;
}

.btn-primary:hover svg,
.btn-secondary:hover svg {
  transform: translateX(3px);
}

/* ===================================
   SECTIONS
   =================================== */

.glass-section {
  position: relative;
  padding: 10vh 5%;
  border-left: 1px solid rgba(227, 252, 2, 0.03);
  border-right: 1px solid rgba(227, 252, 2, 0.03);
}

.glass-container {
  max-width: 1400px;
  margin: 0 auto;
}

.section-title {
  font-size: clamp(2.5rem, 6vw, 5rem);
  font-weight: 700;
  line-height: 1.05;
  letter-spacing: -0.015em;
  margin-bottom: 1.5rem;
  text-align: center;
}

.section-subtitle {
  font-size: clamp(1.125rem, 2vw, 1.5rem);
  font-weight: 400;
  line-height: 1.4;
  color: var(--color-muted);
  text-align: center;
  max-width: 800px;
  margin: 0 auto 3rem;
}

 /* ===================================
     CALENDLY STYLES
     =================================== */
  
  .calendly-overlay {
    background-color: rgba(0, 0, 0, 0.85) !important;
    backdrop-filter: blur(20px) !important;
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    z-index: 99999 !important;
  }

  .calendly-popup,
  .calendly-popup-content {
    width: 90% !important;
    height: 85% !important;
    max-width: 1080px !important;
    background: #121212 !important;
    border-radius: 24px !important;
    border: 1.5px solid #E3FC02 !important;
    box-shadow: 0 0 30px rgba(227, 252, 2, 0.3) !important;
    overflow: hidden !important;
    margin: 0 !important;
  }

  .calendly-popup ::-webkit-scrollbar,
  .calendly-inline-widget ::-webkit-scrollbar {
    width: 6px !important;
  }

  .calendly-popup ::-webkit-scrollbar-track,
  .calendly-inline-widget ::-webkit-scrollbar-track {
    background: #121212 !important;
  }

  .calendly-popup ::-webkit-scrollbar-thumb,
  .calendly-inline-widget ::-webkit-scrollbar-thumb {
    background: #E3FC02 !important;
    border-radius: 10px !important;
  }

  .calendly-close-overlay {
    position: absolute !important;
    right: 30px !important;
    top: 30px !important;
    left: auto !important;
    background: rgba(255, 255, 255, 0.1) !important;
    backdrop-filter: blur(10px) !important;
    border-radius: 50% !important;
    border: 2px solid rgba(255, 255, 255, 0.3) !important;
    width: 44px !important;
    height: 44px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    z-index: 999999 !important;
    transition: all 0.3s ease !important;
  }

  .calendly-close-overlay:hover {
    background: rgba(227, 252, 2, 0.2) !important;
    border-color: #E3FC02 !important;
    transform: scale(1.1) !important;
    box-shadow: 0 0 20px rgba(227, 252, 2, 0.4) !important;
  }

  .calendly-close-overlay::before,
  .calendly-close-overlay::after {
    content: '' !important;
    position: absolute !important;
    width: 20px !important;
    height: 3px !important;
    background: #ffffff !important;
    border-radius: 2px !important;
  }

  .calendly-close-overlay::before {
    transform: rotate(45deg) !important;
  }

  .calendly-close-overlay::after {
    transform: rotate(-45deg) !important;
  }

/* ===================================
   VALUES GRID
   =================================== */

.values-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
  margin-top: 3rem;
}

.value-card {
  background: rgba(255,255,255,0.03);
  backdrop-filter: blur(30px);
  border: 0.5px solid var(--color-neon-border);
  border-radius: 24px;
  padding: 2.5rem 2rem;
  text-align: center;
  transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
}

.value-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 15%;
  right: 15%;
  height: 0.5px;
  background: linear-gradient(90deg,
    transparent 0%,
    var(--color-tenda-neon) 50%,
    transparent 100%
  );
}

.value-card:hover {
  transform: translateY(-10px);
  border-color: var(--color-tenda-neon);
  box-shadow: 0 20px 60px rgba(0,0,0,0.5), 0 0 40px var(--color-neon-subtle);
}

.value-icon {
  font-size: 2.5rem;
  margin-bottom: 1.25rem;
  display: block;
}

.value-title {
  font-size: 1.5rem;
  font-weight: 600;
  line-height: 1.3;
  margin-bottom: 1rem;
}

.value-description {
  font-size: 1.0625rem;
  line-height: 1.5;
  color: var(--color-muted);
}

/* ===================================
   HOW WE WORK - 2x2 GRID
   =================================== */

.philosophy-section {
  padding: 10vh 5%;
  position: relative;
}

.philosophy-container {
  max-width: 1400px;
  margin: 0 auto;
}

.philosophy-header {
  text-align: center;
  margin-bottom: 4rem;
}

.philosophy-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2rem;
  margin-top: 3rem;
}

.philosophy-card {
  background: rgba(255,255,255,0.04);
  backdrop-filter: blur(40px);
  border: 0.5px solid var(--color-neon-border);
  border-radius: 24px;
  padding: 2.5rem;
  position: relative;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  flex-direction: column;
  min-height: 280px;
}

.philosophy-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 12%;
  right: 12%;
  height: 0.5px;
  background: linear-gradient(90deg,
    transparent 0%,
    var(--color-tenda-neon) 50%,
    transparent 100%
  );
}

.philosophy-card:hover {
  transform: translateY(-10px);
  border-color: var(--color-tenda-neon);
  box-shadow: 0 20px 60px rgba(0,0,0,0.5), 0 0 40px var(--color-neon-subtle);
}

.philosophy-number {
  font-size: 2.5rem;
  font-weight: 700;
  color: var(--color-tenda-neon);
  margin-bottom: 1rem;
  line-height: 1;
  text-shadow: 0 0 15px var(--color-neon-glow);
}

.philosophy-title {
  font-size: 1.5rem;
  font-weight: 600;
  margin-bottom: 1rem;
  line-height: 1.3;
}

.philosophy-text {
  font-size: 1.0625rem;
  line-height: 1.6;
  color: var(--color-muted);
}

/* ===================================
   CUSTOM NEON SCROLLBAR
   =================================== */

::-webkit-scrollbar {
  width: 10px;
}

::-webkit-scrollbar-track {
  background: #121212;
}

::-webkit-scrollbar-thumb {
  background: var(--color-tenda-neon);
  border-radius: 10px;
  box-shadow: 0 0 10px var(--color-neon-glow);
}

::-webkit-scrollbar-thumb:hover {
  background: #f6ff4d;
}

/* ===================================
   TEAM CARD
   =================================== */

.frosted-card {
  background: rgba(255,255,255,0.04);
  backdrop-filter: blur(40px) saturate(180%);
  border: 0.5px solid var(--color-neon-border);
  border-radius: 28px;
  padding: 3rem;
  position: relative;
  box-shadow: 0 20px 60px rgba(0,0,0,0.5);
  transition: transform 0.6s ease;
}

.frosted-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 10%;
  right: 10%;
  height: 0.5px;
  background: linear-gradient(90deg,
    transparent 0%,
    var(--color-tenda-neon) 50%,
    transparent 100%
  );
}

.frosted-card:hover {
  transform: translateY(-8px);
  border-color: var(--color-tenda-neon);
  box-shadow: 0 30px 80px rgba(0,0,0,0.6), 0 0 40px var(--color-neon-subtle);
}

.body-large {
  font-size: 1.125rem;
  line-height: 1.5;
  color: var(--color-muted);
}

/* ===================================
   FINAL CTA
   =================================== */

.final-cta {
  padding: 10vh 5% 8vh;
  text-align: center;
  position: relative;
  margin-bottom: 0 !important;
  border-bottom: 2px solid rgba(227, 252, 2, 0.15);
  box-shadow: 0 1px 0 rgba(227, 252, 2, 0.05);
}

.final-cta::before {
  content: '';
  position: absolute;
  top: 0;
  left: 20%;
  right: 20%;
  height: 0.5px;
  background: linear-gradient(90deg,
    transparent 0%,
    var(--color-tenda-neon) 50%,
    transparent 100%
  );
}

.cta-title {
  font-size: clamp(2.5rem, 6vw, 4.5rem);
  font-weight: 700;
  line-height: 1.05;
  letter-spacing: -0.015em;
  margin-bottom: 1.5rem;
}

.cta-subtitle {
  font-size: clamp(1.125rem, 2vw, 1.5rem);
  color: var(--color-muted);
  margin-bottom: 2.5rem;
  max-width: 700px;
  margin-left: auto;
  margin-right: auto;
  line-height: 1.4;
}

.cta-buttons {
  display: flex;
  gap: 1rem;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
}

/* ===================================
   RESPONSIVE
   =================================== */

@media screen and (max-width: 1024px) {
  .values-grid {
    grid-template-columns: 1fr;
  }

  .philosophy-grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
}

@media screen and (max-width: 768px) {
  @media screen and (max-width: 768px) {
  
  /* ===================================
     HERO SECTION - MAJOR REDUCTION
     =================================== */
  
  .floating-hero {
    height: auto !important;
    min-height: 55vh !important; /* Reduced from 100vh */
    padding: 12vh 5% 8vh !important;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-foreground {
    padding: 0 6% !important;
  }

  .hero-eyebrow {
    font-size: 0.8125rem;
    margin-bottom: 0.875rem;
    letter-spacing: 0.06em;
  }

  .hero-title {
    font-size: 2.25rem !important; /* Much smaller */
    line-height: 1.15 !important;
    margin-bottom: 1rem !important;
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    font-size: 1.0625rem !important;
    line-height: 1.5 !important;
    margin-bottom: 0 !important;
    padding: 0;
  }

  /* ===================================
     MANIFESTO - REDUCED SPACING
     =================================== */

  .manifesto-section {
    min-height: auto !important; /* Remove fixed height */
    padding: 6vh 5% 5vh !important; /* Much tighter */
  }

  .manifesto-sticky {
    position: relative !important; /* Remove sticky */
    top: auto !important;
  }

  .manifesto-title {
    font-size: 0.8125rem;
    margin-bottom: 1.5rem !important; /* Reduced from 3rem */
    letter-spacing: 0.06em;
  }

  .manifesto-text {
    font-size: 1.5rem !important; /* Smaller */
    line-height: 1.4 !important;
  }

  .manifesto-span {
    margin: 0 0.08em !important; /* Tighter */
  }

  /* ===================================
     ALL SECTIONS - TIGHTER SPACING
     =================================== */

  .glass-section {
    padding: 5vh 5% !important; /* Reduced from 8vh */
  }

  .philosophy-section {
    padding: 5vh 5% !important;
  }

  .final-cta {
    padding: 5vh 5% 4vh !important;
  }

  .section-title {
    font-size: 2rem !important;
    margin-bottom: 0.875rem !important;
    line-height: 1.15 !important;
  }

  .section-subtitle {
    font-size: 1.0625rem !important;
    margin-bottom: 1.75rem !important; /* Reduced from 3rem */
    line-height: 1.5 !important;
  }

  /* ===================================
     CARDS - COMPACT
     =================================== */

  .frosted-card {
    padding: 1.75rem !important; /* Reduced from 2rem */
  }

  .philosophy-card {
    min-height: auto !important;
    padding: 1.75rem !important; /* Reduced from 2rem */
  }

  .value-card {
    padding: 1.75rem 1.5rem !important;
  }

  /* ===================================
     TYPOGRAPHY - SMALLER
     =================================== */

  .body-large {
    font-size: 1rem !important;
    line-height: 1.6 !important;
  }

  .body-large + .body-large {
    margin-top: 1rem !important;
  }

  .value-title {
    font-size: 1.25rem !important;
    margin-bottom: 0.75rem !important;
  }

  .value-description {
    font-size: 0.9375rem !important;
    line-height: 1.6 !important;
  }

  .philosophy-title {
    font-size: 1.25rem !important;
    margin-bottom: 0.75rem !important;
  }

  .philosophy-text {
    font-size: 0.9375rem !important;
    line-height: 1.6 !important;
  }

  .philosophy-number {
    font-size: 2rem !important;
    margin-bottom: 0.75rem !important;
  }

  /* ===================================
     CTA SECTION - COMPACT
     =================================== */

  .cta-title {
    font-size: 2rem !important;
    margin-bottom: 1rem !important;
    line-height: 1.15 !important;
  }

  .cta-subtitle {
    font-size: 1.0625rem !important;
    margin-bottom: 1.75rem !important;
    line-height: 1.5 !important;
  }

  .cta-buttons {
    flex-direction: column;
    align-items: center;
    gap: 0.875rem !important;
  }

  .btn-primary,
  .btn-secondary {
    width: 100% !important;
    max-width: 300px !important;
    min-height: 48px !important;
    padding: 0.875rem 1.75rem !important;
    font-size: 0.9375rem !important;
  }

  /* ===================================
     GRIDS - SINGLE COLUMN
     =================================== */

  .values-grid {
    grid-template-columns: 1fr !important;
    gap: 1.25rem !important;
    margin-top: 2rem !important;
  }

  .philosophy-grid {
    grid-template-columns: 1fr !important;
    gap: 1.25rem !important;
    margin-top: 2rem !important;
  }

  /* ===================================
     DIVIDERS - SMALLER
     =================================== */

  .section-divider {
    margin: 2rem 0 2.5rem 0 !important;
    width: 90% !important;
  }
}

/* ===================================
   VERY SMALL DEVICES (< 375px)
   =================================== */

@media screen and (max-width: 374px) {
  .floating-hero {
    min-height: 50vh !important;
    padding: 10vh 5% 7vh !important;
  }

  .hero-title {
    font-size: 1.875rem !important;
  }

  .hero-subtitle {
    font-size: 1rem !important;
  }

  .manifesto-text {
    font-size: 1.375rem !important;
  }

  .section-title {
    font-size: 1.75rem !important;
  }

  .frosted-card,
