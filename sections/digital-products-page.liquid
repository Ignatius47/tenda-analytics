{% comment %}
  Digital Products — App Store Experience
  Tenda — Business tools for real growth
{% endcomment %}

<style>
/* ================================================
   DIGITAL PRODUCTS — APP STORE EXPERIENCE
   ================================================ */

:root {
  --dp-bg:        #0a0a0c;
  --dp-surface:   rgba(28, 28, 30, 0.88);
  --dp-accent:    #E3FC02;
  --dp-purple:    #8A2BE2;
  --dp-cyan:      #00F2FF;
  --dp-text:      #ffffff;
  --dp-muted:     rgba(255,255,255,0.5);
  --dp-border:    rgba(0,242,255,0.2);
  --dp-spring:    cubic-bezier(0.34,1.56,0.64,1);
  --dp-smooth:    cubic-bezier(0.16, 1, 0.3, 1);
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  background: var(--dp-bg);
  color: var(--dp-text);
  font-family: system-ui, -apple-system, sans-serif;
  overflow-x: hidden;
}

html {
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
}

/* ── ANIMATED BACKGROUND GRID ──────────────────── */
.dp-background-grid {
  position: fixed;
  inset: 0;
  background-image: 
    linear-gradient(rgba(138,43,226,0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,242,255,0.03) 1px, transparent 1px);
  background-size: 50px 50px;
  pointer-events: none;
  z-index: 0;
  animation: gridFloat 20s ease-in-out infinite;
}

@keyframes gridFloat {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-20px); }
}

.dp-page { position: relative; z-index: 1; }

/* ================================================
   HERO SECTION — TENDA BI PLATFORM
   ================================================ */

.dp-hero {
  padding: 160px 5% 120px;
  max-width: 1400px;
  margin: 0 auto;
  position: relative;
  
  /* App launch animation */
  opacity: 0;
  transform: scale(0.94) translateY(40px);
  animation: appLaunch 0.75s var(--dp-spring) 0.2s forwards;
}

@keyframes appLaunch {
  0%   { opacity: 0; transform: scale(0.94) translateY(40px); filter: blur(10px); }
  65%  { opacity: 1; transform: scale(1.02) translateY(-6px); filter: blur(0); }
  85%  { transform: scale(0.99) translateY(2px); }
  100% { opacity: 1; transform: scale(1) translateY(0); filter: blur(0); }
}

.dp-hero__content {
  text-align: center;
  max-width: 900px;
  margin: 0 auto;
}

.dp-hero__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.625rem;
  font-size: 0.9375rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--dp-cyan);
  margin-bottom: 2rem;
}

.dp-hero__eyebrow::before {
  content: '';
  width: 9px; height: 9px;
  background: var(--dp-cyan);
  border-radius: 50%;
  box-shadow: 0 0 14px rgba(0,242,255,0.9);
  animation: dpDotPulse 2.5s ease-in-out infinite;
}

@keyframes dpDotPulse {
  0%,100% { box-shadow: 0 0 0 0 rgba(0,242,255,0.9); }
  50%      { box-shadow: 0 0 0 10px rgba(0,242,255,0); }
}

.dp-hero__title {
  font-size: clamp(3rem, 8vw, 5.75rem);
  font-weight: 900;
  letter-spacing: -0.055em;
  line-height: 1.3;  /* Fixed to prevent letter clipping */
  margin-bottom: 1.5rem;
  padding-bottom: 0.2em;
  overflow: visible;
}

.dp-hero__title span {
  background: linear-gradient(135deg, var(--dp-purple) 0%, var(--dp-cyan) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: gradientShift 4s ease-in-out infinite;
}

@keyframes gradientShift {
  0%, 100% { filter: hue-rotate(0deg); }
  50%      { filter: hue-rotate(15deg); }
}

.dp-hero__subtitle {
  font-size: clamp(1.25rem, 2.5vw, 1.75rem);
  color: var(--dp-muted);
  line-height: 1.75;
  margin-bottom: 2.5rem;
  max-width: 680px;
  margin-left: auto;
  margin-right: auto;
}

/* Coming Soon Badge */
.coming-soon-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: var(--dp-accent);
  color: #000;
  font-weight: 800;
  font-size: 0.875rem;
  padding: 0.5rem 1.25rem;
  border-radius: 100px;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  margin-bottom: 2.5rem;
  animation: glowPulse 2s ease-in-out infinite;
  box-shadow: 0 0 0 0 rgba(227,252,2,0.5);
}

@keyframes glowPulse {
  0%, 100% { 
    box-shadow: 0 0 0 0 rgba(227,252,2,0.5), 0 0 20px rgba(227,252,2,0.3);
  }
  50% { 
    box-shadow: 0 0 0 8px rgba(227,252,2,0), 0 0 32px rgba(227,252,2,0.6);
  }
}

.coming-soon-badge__dot {
  width: 7px; height: 7px;
  background: #000;
  border-radius: 50%;
  animation: dotPing 2s ease-in-out infinite;
}

@keyframes dotPing {
  0%, 100% { transform: scale(1); opacity: 1; }
  50%      { transform: scale(1.4); opacity: 0.7; }
}

.dp-hero__buttons {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1.25rem;
  flex-wrap: wrap;
}

.dp-btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  background: linear-gradient(135deg, var(--dp-purple) 0%, var(--dp-cyan) 100%);
  color: #fff;
  border: none;
  border-radius: 16px;
  padding: 1.25rem 2.75rem;
  font-weight: 800;
  font-size: 1.125rem;
  cursor: pointer;
  text-decoration: none;
  position: relative;
  overflow: hidden;
  letter-spacing: 0.01em;
  transition: transform 0.35s var(--dp-spring), box-shadow 0.35s ease;
  box-shadow: 
    0 10px 36px rgba(138,43,226,0.35),
    inset 0 1px 0 rgba(255,255,255,0.25);
  animation: btnPulse 3s ease-in-out infinite;
}

@keyframes btnPulse {
  0%, 100% { 
    box-shadow: 0 10px 36px rgba(138,43,226,0.35), inset 0 1px 0 rgba(255,255,255,0.25);
  }
  50% { 
    box-shadow: 0 14px 48px rgba(138,43,226,0.65), 0 0 52px rgba(138,43,226,0.2), inset 0 1px 0 rgba(255,255,255,0.3);
  }
}

.dp-btn-primary::before {
  content: '';
  position: absolute;
  top: 0; left: -100%;
  width: 60%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
  transition: left 0.55s ease;
}

.dp-btn-primary:hover::before { left: 200%; }

.dp-btn-primary:hover {
  transform: translateY(-4px) scale(1.04);
  box-shadow: 
    0 16px 52px rgba(138,43,226,0.56),
    inset 0 1px 0 rgba(255,255,255,0.3);
  animation-play-state: paused;
}

.dp-btn-secondary {
  display: inline-flex;
  align-items: center;
  gap: 0.625rem;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.12);
  color: var(--dp-text);
  border-radius: 16px;
  padding: 1.25rem 2.5rem;
  font-weight: 700;
  font-size: 1.0625rem;
  cursor: pointer;
  text-decoration: none;
  transition: all 0.35s var(--dp-spring);
  backdrop-filter: blur(10px);
}

.dp-btn-secondary:hover {
  background: rgba(255,255,255,0.08);
  border-color: rgba(0,242,255,0.4);
  transform: translateY(-3px);
  box-shadow: 0 10px 30px rgba(0,0,0,0.3);
}

/* ================================================
   PRODUCT GALLERY GRID
   ================================================ */

.dp-products-section {
  padding: 120px 5% 100px;
  max-width: 1400px;
  margin: 0 auto;
  position: relative;
}

.dp-products-section__header {
  text-align: center;
  margin-bottom: 5rem;
  opacity: 0;
  transform: translateY(30px);
  animation: dpSlideUp 0.7s var(--dp-spring) 0.6s forwards;
}

@keyframes dpSlideUp {
  to { opacity: 1; transform: translateY(0); }
}

.dp-products-section__label {
  font-size: 0.9375rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--dp-cyan);
  margin-bottom: 1.25rem;
}

.dp-products-section__title {
  font-size: clamp(2.5rem, 5vw, 3.75rem);
  font-weight: 900;
  letter-spacing: -0.045em;
  line-height: 1.3;
  margin-bottom: 1.25rem;
  padding-bottom: 0.15em;
}

.dp-products-section__subtitle {
  font-size: 1.3rem;
  color: var(--dp-muted);
  max-width: 680px;
  margin: 0 auto;
  line-height: 1.75;
}

/* Product Cards Grid */
.dp-products-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(480px, 1fr));
  gap: 2.5rem;
}

/* ── PRODUCT SHOWCASE GLASS CARD ────────────────── */
.product-card {
  background: rgba(31, 31, 33, 0.7);
  backdrop-filter: blur(40px) saturate(150%);
  -webkit-backdrop-filter: blur(40px) saturate(150%);
  border: 1px solid var(--dp-border);
  border-radius: 32px;
  padding: 3rem 2.75rem;
  position: relative;
  overflow: hidden;
  cursor: default;
  transition: all 0.5s var(--dp-spring);
  
  /* Staggered entrance */
  opacity: 0;
  transform: translateY(40px) scale(0.96);
}

.product-card:nth-child(1) { animation: appLaunch 0.75s var(--dp-spring) 0.9s forwards; }
.product-card:nth-child(2) { animation: appLaunch 0.75s var(--dp-spring) 1.05s forwards; }
.product-card:nth-child(3) { animation: appLaunch 0.75s var(--dp-spring) 1.2s forwards; }
.product-card:nth-child(4) { animation: appLaunch 0.75s var(--dp-spring) 1.35s forwards; }

/* Purple-to-Cyan gradient border */
.product-card::before {
  content: '';
  position: absolute;
  top: -1px; bottom: -1px;
  left: -1px; right: -1px;
  background: linear-gradient(135deg, var(--dp-purple) 0%, var(--dp-cyan) 100%);
  border-radius: 32px;
  z-index: -1;
  opacity: 0.2;
  transition: opacity 0.4s ease;
  animation: gradientRotate 8s linear infinite;
}

@keyframes gradientRotate {
  0%   { filter: hue-rotate(0deg); }
  100% { filter: hue-rotate(360deg); }
}

.product-card:hover {
  transform: translateY(-8px) scale(1.02);
  border-color: var(--dp-cyan);
  box-shadow: 0 0 50px rgba(0,242,255,0.15), 0 20px 60px rgba(0,0,0,0.5);
}

.product-card:hover::before {
  opacity: 0.5;
}

/* Top-edge seam */
.product-card::after {
  content: '';
  position: absolute;
  top: 0; left: 15%; right: 15%;
  height: 1px;
  background: linear-gradient(90deg, 
    transparent 0%, 
    var(--dp-cyan) 50%, 
    transparent 100%
  );
  pointer-events: none;
  z-index: 2;
}

.product-card > * { position: relative; z-index: 1; }

/* Card Header */
.product-card__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 2rem;
  gap: 1.5rem;
}

.product-card__icon {
  width: 72px; height: 72px;
  background: rgba(138,43,226,0.1);
  border: 1px solid rgba(138,43,226,0.3);
  border-radius: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.45s var(--dp-spring);
}

.product-card:hover .product-card__icon {
  background: rgba(138,43,226,0.2);
  border-color: rgba(0,242,255,0.5);
  transform: scale(1.1) rotate(-8deg);
  box-shadow: 0 8px 24px rgba(138,43,226,0.3);
}

.product-card__icon svg {
  width: 36px; height: 36px;
  stroke: var(--dp-cyan);
  fill: none;
  stroke-width: 2;
}

.product-card__badges {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0.625rem;
}

.product-card__version {
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--dp-muted);
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 8px;
  padding: 0.3rem 0.75rem;
  letter-spacing: 0.05em;
}

.product-card__status {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--dp-cyan);
  background: rgba(0,242,255,0.08);
  border: 1px solid rgba(0,242,255,0.25);
  border-radius: 8px;
  padding: 0.3rem 0.75rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.product-card__status--live::before {
  content: '';
  width: 7px; height: 7px;
  background: var(--dp-cyan);
  border-radius: 50%;
  box-shadow: 0 0 8px rgba(0,242,255,0.8);
  animation: dpDotPulse 2.5s ease-in-out infinite;
}

.product-card__status--dev {
  color: var(--dp-accent);
  background: rgba(227,252,2,0.08);
  border-color: rgba(227,252,2,0.25);
}

.product-card__status--dev::before {
  content: '';
  width: 7px; height: 7px;
  background: var(--dp-accent);
  border-radius: 50%;
  animation: dotPing 2s ease-in-out infinite;
}

/* Card Content */
.product-card__title {
  font-size: 1.875rem;
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1.3;
  margin-bottom: 1rem;
  padding-bottom: 0.1em;
}

.product-card__description {
  font-size: 1.0625rem;
  color: var(--dp-muted);
  line-height: 1.75;
  margin-bottom: 2.25rem;
}

/* Features List */
.product-card__features {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  margin-bottom: 2.5rem;
}

.product-feature {
  display: flex;
  align-items: flex-start;
  gap: 0.875rem;
  font-size: 0.9375rem;
  color: rgba(255,255,255,0.8);
  line-height: 1.7;
  position: relative;
}

.product-feature::before {
  content: '';
  width: 7px; height: 7px;
  background: var(--dp-cyan);
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 0.55em;
  box-shadow: 0 0 8px rgba(0,242,255,0.7);
}

/* Hover Tooltip */
.product-feature__tooltip {
  position: absolute;
  left: 30px;
  top: 100%;
  margin-top: 0.5rem;
  background: rgba(20,20,22,0.96);
  backdrop-filter: blur(20px) saturate(150%);
  border: 1px solid rgba(0,242,255,0.3);
  border-radius: 12px;
  padding: 0.75rem 1rem;
  font-size: 0.8125rem;
  color: var(--dp-text);
  white-space: nowrap;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-8px);
  transition: all 0.3s var(--dp-spring);
  pointer-events: none;
  z-index: 100;
  box-shadow: 0 8px 24px rgba(0,0,0,0.5);
}

.product-feature:hover .product-feature__tooltip {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

/* Development Progress Bar */
.product-card__progress {
  margin-bottom: 2rem;
}

.progress-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.8125rem;
  color: var(--dp-muted);
  margin-bottom: 0.625rem;
}

.progress-percent {
  color: var(--dp-accent);
  font-weight: 700;
}

.progress-bar {
  width: 100%;
  height: 8px;
  background: rgba(255,255,255,0.05);
  border-radius: 100px;
  overflow: hidden;
  position: relative;
}

.progress-bar__fill {
  height: 100%;
  background: linear-gradient(90deg, var(--dp-accent) 0%, rgba(227,252,2,0.6) 100%);
  border-radius: 100px;
  position: relative;
  transition: width 1s ease;
}

/* Shimmer animation */
.progress-bar__fill::before {
  content: '';
  position: absolute;
  top: 0; left: -100%;
  width: 40%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
  animation: shimmer 2s ease-in-out infinite;
}

@keyframes shimmer {
  0%, 40%, 100% { left: -100%; }
  60%, 80%       { left: 200%; }
}

/* Card Actions */
.product-card__actions {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
}

.product-card__btn {
  flex: 1;
  min-width: 140px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.625rem;
  padding: 0.875rem 1.75rem;
  border-radius: 12px;
  font-weight: 700;
  font-size: 0.9375rem;
  text-decoration: none;
  transition: all 0.35s var(--dp-spring);
  letter-spacing: 0.01em;
}

.product-card__btn--primary {
  background: linear-gradient(135deg, var(--dp-purple) 0%, var(--dp-cyan) 100%);
  color: #fff;
  border: none;
  box-shadow: 0 6px 20px rgba(138,43,226,0.3);
}

.product-card__btn--primary:hover {
  transform: translateY(-3px) scale(1.04);
  box-shadow: 0 10px 32px rgba(138,43,226,0.5);
}

.product-card__btn--secondary {
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.15);
  color: var(--dp-text);
}

.product-card__btn--secondary:hover {
  background: rgba(255,255,255,0.1);
  border-color: rgba(0,242,255,0.4);
  transform: translateY(-2px);
}

.product-card__btn svg {
  width: 16px; height: 16px;
  stroke: currentColor;
  fill: none;
}

/* ================================================
   CHANGELOG MODAL (MacBook-style)
   ================================================ */

.changelog-modal {
  position: fixed;
  inset: 0;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 2rem;
  z-index: 10000;
  backdrop-filter: blur(8px);
  background: rgba(0,0,0,0.6);
}

.changelog-modal.active {
  display: flex;
  animation: modalFadeIn 0.3s ease forwards;
}

@keyframes modalFadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

.changelog-modal__content {
  background: rgba(28,28,30,0.96);
  backdrop-filter: blur(40px) saturate(170%);
  -webkit-backdrop-filter: blur(40px) saturate(170%);
  border: 1px solid rgba(0,242,255,0.2);
  border-radius: 24px;
  max-width: 700px;
  width: 100%;
  max-height: 80vh;
  overflow: hidden;
  box-shadow: 
    0 40px 100px rgba(0,0,0,0.7),
    0 0 0 1px rgba(255,255,255,0.05),
    inset 0 1px 0 rgba(255,255,255,0.08);
  
  /* Genie animation */
  opacity: 0;
  transform: scale(0.88) translateY(30px);
  animation: modalGenie 0.58s var(--dp-spring) forwards;
}

@keyframes modalGenie {
  0%   { opacity: 0; transform: scale(0.88) translateY(30px); filter: blur(10px); }
  60%  { opacity: 1; transform: scale(1.02) translateY(-6px); filter: blur(0); }
  80%  { transform: scale(0.99) translateY(2px); }
  100% { opacity: 1; transform: scale(1) translateY(0); filter: blur(0); }
}

.changelog-modal__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 2rem 2.5rem 1.5rem;
  border-bottom: 1px solid rgba(255,255,255,0.08);
}

.changelog-modal__title {
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--dp-text);
}

.changelog-modal__close {
  width: 36px; height: 36px;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.3s ease;
}

.changelog-modal__close:hover {
  background: rgba(255,255,255,0.1);
  border-color: rgba(0,242,255,0.4);
  transform: rotate(90deg);
}

.changelog-modal__close svg {
  width: 18px; height: 18px;
  stroke: var(--dp-text);
}

.changelog-modal__body {
  padding: 2rem 2.5rem 2.5rem;
  max-height: 60vh;
  overflow-y: auto;
}

.changelog-version {
  margin-bottom: 2rem;
  padding-bottom: 2rem;
  border-bottom: 1px solid rgba(255,255,255,0.06);
}

.changelog-version:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.changelog-version__header {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1rem;
}

.changelog-version__number {
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--dp-cyan);
}

.changelog-version__date {
  font-size: 0.875rem;
  color: var(--dp-muted);
}

.changelog-version__changes {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.changelog-change {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  font-size: 0.9375rem;
  color: rgba(255,255,255,0.85);
  line-height: 1.65;
}

.changelog-change::before {
  content: '';
  width: 6px; height: 6px;
  background: var(--dp-cyan);
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 0.55em;
  box-shadow: 0 0 8px rgba(0,242,255,0.6);
}

/* ================================================
   RESPONSIVE
   ================================================ */

@media screen and (max-width: 1024px) {
  .dp-products-grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .product-card {
    padding: 2.5rem 2rem;
  }
}

@media screen and (max-width: 640px) {
  .dp-hero {
