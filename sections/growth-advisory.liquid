{% comment %}
  Growth & Advisory — Premium Liquid Glass Showcase
  Tenda — Advisory and data for real business growth
{% endcomment %}

<style>
/* ================================================
   GROWTH & ADVISORY — LIQUID GLASS SHOWCASE
   ================================================ */

:root {
  --ga-bg:        #0F0F11;
  --ga-surface:   rgba(28, 28, 30, 0.88);
  --ga-accent:    #E3FC02;
  --ga-text:      #ffffff;
  --ga-muted:     rgba(255,255,255,0.45);
  --ga-border:    rgba(227,252,2,0.15);
  --ga-spring:    cubic-bezier(0.34,1.56,0.64,1);
  --ga-smooth:    cubic-bezier(0.16, 1, 0.3, 1);
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  background: var(--ga-bg);
  color: var(--ga-text);
  font-family: system-ui, -apple-system, sans-serif;
  overflow-x: hidden;
}

/* Smooth inertia scrolling */
html {
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
}

/* ── PARALLAX BACKGROUND GRAIN ──────────────────── */
.ga-parallax-grain {
  position: fixed;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  opacity: 0.025;
  pointer-events: none;
  z-index: 0;
  will-change: transform;
}

.ga-page { position: relative; z-index: 1; }

/* ================================================
   HIGH-IMPACT HERO SECTION — SPLIT LAYOUT
   ================================================ */

.ga-hero {
  padding: 140px 5% 100px;
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 5rem;
  align-items: center;
  max-width: 1500px;
  margin: 0 auto;
  min-height: 90vh;
  position: relative;
  
  /* Genie entrance animation */
  opacity: 0;
  transform: scale(0.92) translateY(50px);
  animation: gaGenieOpen 0.85s var(--ga-spring) 0.15s forwards;
}

@keyframes gaGenieOpen {
  0%   { opacity: 0; transform: scale(0.92) translateY(50px); filter: blur(14px); }
  58%  { opacity: 1; transform: scale(1.02) translateY(-10px); filter: blur(0); }
  78%  { transform: scale(0.99) translateY(4px); }
  100% { opacity: 1; transform: scale(1) translateY(0); filter: blur(0); }
}

/* ── LEFT: BOLD TEXT ────────────────────────────── */
.ga-hero__text {
  opacity: 0;
  transform: translateY(35px);
  animation: gaSlideUp 0.75s var(--ga-spring) 0.5s forwards;
}

@keyframes gaSlideUp {
  to { opacity: 1; transform: translateY(0); }
}

.ga-hero__eyebrow {
  font-size: 0.875rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--ga-accent);
  margin-bottom: 1.75rem;
  display: flex;
  align-items: center;
  gap: 0.625rem;
}

/* Pulsing neon status dot */
.ga-hero__eyebrow::before {
  content: '';
  width: 9px; height: 9px;
  background: var(--ga-accent);
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 0 14px rgba(227,252,2,0.8);
  animation: gaDotPulse 2.8s ease-in-out infinite;
}

@keyframes gaDotPulse {
  0%,100% { box-shadow: 0 0 0 0 rgba(227,252,2,0.8); }
  50%      { box-shadow: 0 0 0 10px rgba(227,252,2,0); }
}

/* Heavy headline with proper line-height to prevent truncation */
.ga-hero__title {
  font-size: clamp(2.75rem, 7vw, 5.5rem);
  font-weight: 900;
  letter-spacing: -0.055em;
  line-height: 1.18;  /* Generous line-height to prevent clipping */
  margin-bottom: 2rem;
  padding-bottom: 0.15em;  /* Extra padding to ensure descenders are visible */
  overflow: visible;
  display: block;
}

.ga-hero__title span {
  background: linear-gradient(135deg, var(--ga-text) 0%, var(--ga-accent) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  text-shadow: none;
}

.ga-hero__description {
  font-size: clamp(1.125rem, 2.2vw, 1.5rem);
  color: var(--ga-muted);
  line-height: 1.75;
  margin-bottom: 3rem;
  max-width: 580px;
}

.ga-hero__stats {
  display: flex;
  gap: 3rem;
  margin-bottom: 3rem;
  flex-wrap: wrap;
}

.ga-stat {
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
}

.ga-stat__value {
  font-size: 2.5rem;
  font-weight: 900;
  color: var(--ga-accent);
  letter-spacing: -0.04em;
  line-height: 1;
}

.ga-stat__label {
  font-size: 0.875rem;
  color: var(--ga-muted);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.ga-hero__cta {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  background: var(--ga-accent);
  color: #000;
  border: none;
  border-radius: 16px;
  padding: 1.25rem 2.75rem;
  font-weight: 800;
  font-size: 1.125rem;
  cursor: pointer;
  text-decoration: none;
  position: relative;
  overflow: hidden;
  letter-spacing: 0.01em;
  transition: transform 0.35s var(--ga-spring), box-shadow 0.35s ease;
  box-shadow: 0 10px 36px rgba(227,252,2,0.35), inset 0 1px 0 rgba(255,255,255,0.35);
}

/* Glass shine sweep */
.ga-hero__cta::before {
  content: '';
  position: absolute;
  top: 0; left: -100%;
  width: 60%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.42), transparent);
  transition: left 0.55s ease;
}

.ga-hero__cta:hover::before { left: 200%; }

.ga-hero__cta:hover {
  transform: translateY(-4px) scale(1.04);
  box-shadow: 0 16px 52px rgba(227,252,2,0.56);
}

.ga-hero__cta svg {
  width: 20px; height: 20px;
  stroke: currentColor;
  transition: transform 0.35s var(--ga-spring);
}

.ga-hero__cta:hover svg {
  transform: translateX(5px);
}

/* ── RIGHT: HIGH-FIDELITY IMAGE ─────────────────── */
.ga-hero__visual {
  position: relative;
  opacity: 0;
  transform: translateY(40px) scale(0.96);
  animation: gaImageReveal 0.9s var(--ga-spring) 0.65s forwards;
}

@keyframes gaImageReveal {
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.ga-hero__image-frame {
  position: relative;
  border-radius: 28px;
  overflow: hidden;
  box-shadow: 
    0 40px 100px rgba(0,0,0,0.6),
    0 0 0 1px rgba(227,252,2,0.18),
    inset 0 1px 0 rgba(255,255,255,0.1);
  backdrop-filter: blur(2px);
}

.ga-hero__image-frame img {
  width: 100%;
  height: auto;
  display: block;
  transition: transform 0.7s ease;
}

.ga-hero__image-frame:hover img {
  transform: scale(1.06);
}

/* Floating neon accent frame */
.ga-hero__visual::before {
  content: '';
  position: absolute;
  top: -16px; right: -16px;
  width: calc(100% + 32px);
  height: calc(100% + 32px);
  border: 2.5px solid rgba(227,252,2,0.28);
  border-radius: 32px;
  pointer-events: none;
  z-index: -1;
}

/* ================================================
   THE "PILLAR" GRID — INTERACTIVE GLASS CARDS
   ================================================ */

.ga-pillars-section {
  padding: 120px 5% 100px;
  max-width: 1500px;
  margin: 0 auto;
  position: relative;
}

.ga-pillars-section__header {
  text-align: center;
  margin-bottom: 5rem;
  opacity: 0;
  transform: translateY(35px);
  animation: gaSlideUp 0.75s var(--ga-spring) 0.8s forwards;
}

.ga-pillars-section__label {
  font-size: 0.875rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--ga-accent);
  margin-bottom: 1.25rem;
}

.ga-pillars-section__title {
  font-size: clamp(2.25rem, 5vw, 3.75rem);
  font-weight: 900;
  letter-spacing: -0.045em;
  line-height: 1.2;
  margin-bottom: 1.25rem;
}

.ga-pillars-section__subtitle {
  font-size: 1.25rem;
  color: var(--ga-muted);
  max-width: 680px;
  margin: 0 auto;
  line-height: 1.7;
}

/* Grid of pillar cards */
.ga-pillars-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
  gap: 2.5rem;
}

/* Individual pillar card — frosted glass with magnetic hover */
.advisory-pillar-card {
  background: rgba(31, 31, 33, 0.82);
  backdrop-filter: blur(30px) saturate(165%);
  -webkit-backdrop-filter: blur(30px) saturate(165%);
  border: 1px solid rgba(227, 252, 2, 0.15);
  border-radius: 24px;
  padding: 3rem 2.75rem;
  position: relative;
  overflow: hidden;
  cursor: default;
  transition: all 0.6s var(--ga-smooth);
  
  /* Staggered entrance */
  opacity: 0;
  transform: translateY(50px);
}

.advisory-pillar-card:nth-child(1) { animation: gaSlideUp 0.75s var(--ga-spring) 1.0s forwards; }
.advisory-pillar-card:nth-child(2) { animation: gaSlideUp 0.75s var(--ga-spring) 1.2s forwards; }
.advisory-pillar-card:nth-child(3) { animation: gaSlideUp 0.75s var(--ga-spring) 1.4s forwards; }

/* Top-edge neon seam */
.advisory-pillar-card::before {
  content: '';
  position: absolute;
  top: 0; left: 18%; right: 18%;
  height: 1px;
  background: linear-gradient(90deg, 
    transparent 0%, 
    rgba(227,252,2,0.45) 50%, 
    transparent 100%
  );
  pointer-events: none;
  z-index: 2;
}

/* Radial glow that expands on hover */
.advisory-pillar-card::after {
  content: '';
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 300px; height: 300px;
  background: radial-gradient(circle, rgba(227,252,2,0.08) 0%, transparent 65%);
  opacity: 0;
  transition: all 0.7s ease;
  pointer-events: none;
  z-index: 0;
}

/* Hover: lift + neon glow expansion */
.advisory-pillar-card:hover {
  transform: translateY(-14px) scale(1.03);
  border-color: var(--ga-accent);
  box-shadow: 
    0 24px 60px rgba(0, 0, 0, 0.5),
    0 0 32px rgba(227, 252, 2, 0.18),
    inset 0 1px 0 rgba(255,255,255,0.12);
}

.advisory-pillar-card:hover::after {
  opacity: 1;
  width: 500px; height: 500px;
}

.advisory-pillar-card > * { position: relative; z-index: 1; }

/* Pulsing neon status indicator */
.pillar-card__status {
  position: absolute;
  top: 2.25rem;
  right: 2.25rem;
  width: 11px; height: 11px;
  background: var(--ga-accent);
  border-radius: 50%;
  box-shadow: 0 0 14px rgba(227,252,2,0.85);
  animation: gaDotPulse 2.8s ease-in-out infinite;
  z-index: 3;
}

.pillar-card__icon {
  width: 64px; height: 64px;
  background: rgba(227,252,2,0.12);
  border: 1px solid rgba(227,252,2,0.28);
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 2.25rem;
  transition: all 0.5s var(--ga-spring);
}

.advisory-pillar-card:hover .pillar-card__icon {
  background: rgba(227,252,2,0.2);
  border-color: rgba(227,252,2,0.5);
  transform: scale(1.1) rotate(8deg);
  box-shadow: 0 4px 18px rgba(227,252,2,0.3);
}

.pillar-card__icon svg {
  width: 32px; height: 32px;
  stroke: var(--ga-accent);
  fill: none;
  stroke-width: 2;
}

.pillar-card__title {
  font-size: 1.75rem;
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1.28;
  margin-bottom: 1.125rem;
  /* Prevent truncation */
  padding-bottom: 0.1em;
}

.pillar-card__description {
  font-size: 1.0625rem;
  color: var(--ga-muted);
  line-height: 1.75;
  margin-bottom: 2rem;
}

.pillar-card__features {
  display: flex;
  flex-direction: column;
  gap: 0.875rem;
  margin-bottom: 2.25rem;
}

.pillar-card__feature {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  font-size: 0.9375rem;
  color: rgba(255,255,255,0.8);
  line-height: 1.6;
}

.pillar-card__feature::before {
  content: '';
  width: 7px; height: 7px;
  background: var(--ga-accent);
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 0.5em;
  box-shadow: 0 0 8px rgba(227,252,2,0.6);
}

.pillar-card__link {
  display: inline-flex;
  align-items: center;
  gap: 0.625rem;
  color: var(--ga-accent);
  font-size: 0.9375rem;
  font-weight: 700;
  text-decoration: none;
  transition: gap 0.35s var(--ga-spring);
  letter-spacing: 0.01em;
}

.pillar-card__link:hover {
  gap: 1rem;
}

.pillar-card__link svg {
  width: 16px; height: 16px;
  stroke: currentColor;
  transition: transform 0.35s var(--ga-spring);
}

.pillar-card__link:hover svg {
  transform: translateX(4px);
}

/* ================================================
   SUCCESS STORIES — AUTO-SCROLL CLIENT LOGOS
   ================================================ */

.ga-success-stories {
  padding: 100px 5% 120px;
  background: rgba(0,0,0,0.3);
  position: relative;
  overflow: hidden;
}

.ga-success-stories::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, 
    transparent 0%, 
    rgba(227,252,2,0.3) 50%, 
    transparent 100%
  );
}

.ga-success-stories__header {
  text-align: center;
  margin-bottom: 4rem;
  opacity: 0;
  transform: translateY(30px);
  animation: gaSlideUp 0.75s var(--ga-spring) 1.6s forwards;
}

.ga-success-stories__label {
  font-size: 0.875rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--ga-accent);
  margin-bottom: 1rem;
}

.ga-success-stories__title {
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 900;
  letter-spacing: -0.04em;
  margin-bottom: 0.875rem;
}

.ga-success-stories__subtitle {
  font-size: 1.125rem;
  color: var(--ga-muted);
  max-width: 620px;
  margin: 0 auto;
}

/* Infinite horizontal scroll container */
.ga-logo-scroll {
  position: relative;
  width: 100%;
  overflow: hidden;
  mask-image: linear-gradient(
    to right,
    transparent 0%,
    black 10%,
    black 90%,
    transparent 100%
  );
  -webkit-mask-image: linear-gradient(
    to right,
    transparent 0%,
    black 10%,
    black 90%,
    transparent 100%
  );
}

.ga-logo-scroll__track {
  display: flex;
  gap: 4rem;
  animation: gaLogoScroll 40s linear infinite;
  will-change: transform;
}

@keyframes gaLogoScroll {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.ga-logo-scroll:hover .ga-logo-scroll__track {
  animation-play-state: paused;
}

.ga-logo-item {
  flex-shrink: 0;
  width: 180px;
  height: 80px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 14px;
  padding: 1.25rem;
  transition: all 0.4s var(--ga-spring);
  backdrop-filter: blur(8px);
}

.ga-logo-item:hover {
  background: rgba(255,255,255,0.06);
  border-color: rgba(227,252,2,0.3);
  transform: translateY(-4px) scale(1.05);
  box-shadow: 0 8px 24px rgba(0,0,0,0.3);
}

.ga-logo-item img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  filter: grayscale(1) brightness(0.7);
  transition: filter 0.4s ease;
}

.ga-logo-item:hover img {
  filter: grayscale(0) brightness(1);
}

/* ================================================
   RESPONSIVE ADJUSTMENTS
   ================================================ */

@media screen and (max-width: 1024px) {
  .ga-hero {
    grid-template-columns: 1fr;
    gap: 3.5rem;
    padding: 100px 4% 80px;
    min-height: auto;
  }

  .ga-hero__title {
    font-size: clamp(2.25rem, 8vw, 3.5rem);
  }

  .ga-hero__visual::before {
    display: none;
  }

  .ga-pillars-grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .advisory-pillar-card {
    padding: 2.5rem 2rem;
  }

  .ga-logo-scroll__track {
    gap: 3rem;
  }

  .ga-logo-item {
    width: 150px;
    height: 70px;
  }
}

@media screen and (max-width: 640px) {
  .ga-hero {
    padding: 80px 4% 60px;
  }

  .ga-hero__stats {
    gap: 2rem;
  }

  .ga-stat__value {
    font-size: 2rem;
  }

  .advisory-pillar-card {
    padding: 2rem 1.75rem;
  }

  .pillar-card__title {
    font-size: 1.5rem;
  }

  .ga-logo-item {
    width: 130px;
    height: 60px;
  }
}

/* ================================================
   UTILITIES
   ================================================ */

.heavy-headline {
  line-height: 1.3;
  padding-bottom: 10px;
  display: block;
}

</style>

<!-- Parallax grain background -->
<div class="ga-parallax-grain" id="gaParallaxGrain"></div>

<div class="ga-page">

  <!-- ========================================
       HIGH-IMPACT HERO SECTION
       ======================================== -->
  <section class="ga-hero">
    <div class="ga-hero__text">
      <p class="ga-hero__eyebrow">Growth & Advisory</p>
      
      <h1 class="ga-hero__title heavy-headline">
        <span>Advisory and data for real business growth.</span>
      </h1>
      
      <p class="ga-hero__description">
        We partner with ambitious organizations to unlock sustainable growth through data-driven strategy, advanced analytics, and decision intelligence.
      </p>

      <div class="ga-hero__stats">
        <div class="ga-stat">
          <span class="ga-stat__value">50+</span>
          <span class="ga-stat__label">Projects Delivered</span>
        </div>
        <div class="ga-stat">
          <span class="ga-stat__value">98%</span>
          <span class="ga-stat__label">Client Retention</span>
        </div>
        <div class="ga-stat">
          <span class="ga-stat__value">15+</span>
          <span class="ga-stat__label">Industries Served</span>
        </div>
      </div>

      <a href="#pillars" class="ga-hero__cta">
        Explore Our Services
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>

    <div class="ga-hero__visual">
      <div class="ga-hero__image-frame">
        {% comment %}
          Replace with actual high-fidelity workspace image
          Example: {{ 'advisory-workspace.jpg' | asset_url | img_tag }}
        {% endcomment %}
        <img 
          src="https://images.unsplash.com/photo-1553877522-43269d4ea984?w=1200&q=85" 
          alt="Modern tech-enabled workspace with analytics dashboards"
          loading="eager"
          width="800"
          height="600"
        >
      </div>
    </div>
  </section>

  <!-- ========================================
       THE "PILLAR" GRID — SERVICE CARDS
       ======================================== -->
  <section class="ga-pillars-section" id="pillars">
    <div class="ga-pillars-section__header">
      <p class="ga-pillars-section__label">Our Expertise</p>
      <h2 class="ga-pillars-section__title">Three Pillars of Growth</h2>
      <p class="ga-pillars-section__subtitle">
        Comprehensive advisory services designed to transform your business through strategic execution, data intelligence, and decision-making excellence.
      </p>
    </div>

    <div class="ga-pillars-grid">
      
      <!-- Pillar 1: Strategy & Execution -->
      <div class="advisory-pillar-card" data-magnetic>
        <span class="pillar-card__status"></span>
        
        <div class="pillar-card__icon">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
          </svg>
        </div>

        <h3 class="pillar-card__title heavy-headline">Strategy & Execution for Growth</h3>
        
        <p class="pillar-card__description">
          Transform vision into reality with data-backed strategies and execution frameworks that drive measurable business outcomes.
        </p>

        <div class="pillar-card__features">
          <div class="pillar-card__feature">Growth strategy development and market opportunity analysis</div>
          <div class="pillar-card__feature">Business model innovation and revenue optimization</div>
          <div class="pillar-card__feature">Operational efficiency and process transformation</div>
          <div class="pillar-card__feature">Performance measurement and KPI frameworks</div>
        </div>

        <a href="/pages/strategy-execution" class="pillar-card__link">
          Learn More
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>

      <!-- Pillar 2: Data Strategy & Infrastructure -->
      <div class="advisory-pillar-card" data-magnetic>
        <span class="pillar-card__status"></span>
        
