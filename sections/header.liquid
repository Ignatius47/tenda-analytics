  font-size: 0.6rem;
  font-weight: 800;
  padding: 0.25rem 0.65rem;
  border-radius: 100px;
  margin-left: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  line-height: 1;
  white-space: nowrap;
  
  /* Multi-layered shadow for depth */
  box-shadow: 
    0 0 8px rgba(227, 252, 2, 0.8),      /* Inner glow */
    0 0 16px rgba(227, 252, 2, 0.6),     /* Mid glow */
    0 0 32px rgba(227, 252, 2, 0.4),     /* Outer glow */
    0 2px 8px rgba(0, 0, 0, 0.3);        /* Drop shadow */
  
  /* Ensure glow isn't clipped */
  position: relative;
  z-index: 100;
  
  /* Breathing animation */
  animation: neonBadgeBreathing 2s ease-in-out infinite;
  
  /* Smooth transitions */
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* Hover state - Enhanced glow */
