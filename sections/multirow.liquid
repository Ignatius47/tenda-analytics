<script>
  // Intersection Observer for scroll animations
  document.addEventListener('DOMContentLoaded', function() {
    const observerOptions = {
      threshold: 0.15,
      rootMargin: '0px 0px -80px 0px'
    };

    const observer = new IntersectionObserver(function(entries) {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.style.animationPlayState = 'running';
        }
      });
    }, observerOptions);

    // Observe all animated elements
    const animatedElements = document.querySelectorAll('[class*="animate-"]');
    animatedElements.forEach(el => {
      el.style.animationPlayState = 'paused';
      observer.observe(el);
    });

    // Mac-Style Insights Drawer Logic
    const bubble = document.getElementById('bubbleTrigger');
    const drawer = document.getElementById('insightsDrawer');
    const backdrop = document.getElementById('drawerBackdrop');
    const closeBtn = document.getElementById('drawerClose');

    // Open drawer on pill click
    bubble.addEventListener('click', function(e) {
      e.stopPropagation();
      drawer.classList.add('open');
      backdrop.classList.add('active');
      bubble.classList.add('hidden');
    });

    // Close drawer on close button click
    closeBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      drawer.classList.remove('open');
      backdrop.classList.remove('active');
      setTimeout(() => {
        bubble.classList.remove('hidden');
      }, 200);  // Delay pill reappearance
    });

    // Close drawer on backdrop click (Mac-style dismiss)
    backdrop.addEventListener('click', function(e) {
      if (e.target === backdrop) {
        drawer.classList.remove('open');
        backdrop.classList.remove('active');
        setTimeout(() => {
          bubble.classList.remove('hidden');
        }, 200);
      }
    });

    // Prevent drawer clicks from closing
    drawer.addEventListener('click', function(e) {
      e.stopPropagation();
    });

    // Shrink pill on scroll (Mac minimize effect)
    let lastScrollTop = 0;
    window.addEventListener('scroll', function() {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
      
      if (scrollTop > 400) {
        bubble.classList.add('scrolled');
      } else {
        bubble.classList.remove('scrolled');
      }
      
      lastScrollTop = scrollTop;
    });

    // Close on Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && drawer.classList.contains('open')) {
        drawer.classList.remove('open');
        backdrop.classList.remove('active');
        setTimeout(() => {
          bubble.classList.remove('hidden');
        }, 200);
      }
    });
  });

  // Smooth scroll for anchor links
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      const target = document.querySelector(this.getAttribute('href'));
      if (target) {
        target.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      }
    });
  });

  // ===================================
  // ENGAGEMENT-BASED ENTRY MODAL LOGIC
  // ===================================

  document.addEventListener('DOMContentLoaded', function() {
    const entryModal = document.getElementById('entryModal');
    const modalCloseBtn = document.getElementById('modalCloseBtn');
    const modalForm = document.getElementById('modalNewsletterForm');
    const modalDefaultState = document.getElementById('modalDefaultState');
    const modalSuccessState = document.getElementById('modalSuccessState');

    let modalTriggered = false;
    let scrollDepthReached = false;
    let timeOnPageReached = false;

    // Cookie Helper Functions
    function setCookie(name, value, days) {
      const expires = new Date();
      expires.setTime(expires.getTime() + (days * 24 * 60 * 60 * 1000));
      document.cookie = name + '=' + value + ';expires=' + expires.toUTCString() + ';path=/';
    }

    function getCookie(name) {
      const nameEQ = name + '=';
      const ca = document.cookie.split(';');
      for (let i = 0; i < ca.length; i++) {
        let c = ca[i];
        while (c.charAt(0) === ' ') c = c.substring(1, c.length);
        if (c.indexOf(nameEQ) === 0) return c.substring(nameEQ.length, c.length);
      }
      return null;
    }

    // Show Modal Function
    function showModal() {
      if (modalTriggered) return;
      
      modalTriggered = true;
      entryModal.classList.add('active');
      setCookie('tenda_modal_seen', 'true', 30); // Remember for 30 days
    }

    // Close Modal Function
    function closeModal() {
      entryModal.classList.remove('active');
    }

    // Check if modal should be enabled
    const hasSeenModal = getCookie('tenda_modal_seen');
    
    if (!hasSeenModal) {
      
      // ===================================
      // TRIGGER 1: SCROLL DEPTH (50%)
      // ===================================
      
      window.addEventListener('scroll', function() {
        if (scrollDepthReached || modalTriggered) return;
        
        const scrollPercent = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100;
        
        if (scrollPercent >= 50) {
          scrollDepthReached = true;
          console.log('50% scroll depth reached - showing modal');
          showModal();
        }
      });

      // ===================================
      // TRIGGER 2: TIME ON PAGE (45 seconds)
      // ===================================
      
      setTimeout(function() {
        if (!scrollDepthReached && !modalTriggered) {
          timeOnPageReached = true;
          console.log('45 seconds elapsed - showing modal');
          showModal();
        }
      }, 45000); // 45 seconds

      // ===================================
      // TRIGGER 3: EXIT INTENT
      // ===================================
      
      document.addEventListener('mouseleave', function(e) {
        if (modalTriggered) return;
        
        // Detect if cursor is leaving from the top (towards browser controls)
        if (e.clientY <= 10) {
          console.log('Exit intent detected - showing modal');
          showModal();
        }
      });
    }

    // ===================================
    // MODAL INTERACTIONS
    // ===================================

    // Close button click
    if (modalCloseBtn) {
      modalCloseBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        closeModal();
      });
    }

    // Close on backdrop click
    if (entryModal) {
      entryModal.addEventListener('click', function(e) {
        if (e.target === entryModal) {
          closeModal();
        }
      });
    }

    // Prevent modal content clicks from closing
    const modalContent = document.querySelector('.tenda-modal-content');
    if (modalContent) {
      modalContent.addEventListener('click', function(e) {
        e.stopPropagation();
      });
    }

    // Close on Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && entryModal.classList.contains('active')) {
        closeModal();
      }
    });

    // ===================================
    // FORM SUBMISSION
    // ===================================

    if (modalForm) {
      modalForm.addEventListener('submit', function(e) {
        // After form submits, check for success
        setTimeout(function() {
          // Check if URL has newsletter hash (Shopify success redirect)
          if (window.location.hash === '#newsletter' || window.location.search.includes('customer_posted=true')) {
            modalDefaultState.style.display = 'none';
            modalSuccessState.classList.add('active');
            
            // Auto-close after 4 seconds
            setTimeout(function() {
              closeModal();
              
              // Reset for next time (if they clear cookies)
              setTimeout(function() {
                modalDefaultState.style.display = 'block';
                modalSuccessState.classList.remove('active');
              }, 500);
            }, 4000);
          }
        }, 500);
      });
    }

    console.log('Engagement-based modal initialized');
  });
