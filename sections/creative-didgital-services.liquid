{% comment %}
  Creative & Digital Services Page
  Third pillar - Project-based creative execution
{% endcomment %}

<style>
:root {
  --neon: #E3FC02;
  --neon-glow: rgba(227, 252, 2, 0.4);
  --neon-subtle: rgba(227, 252, 2, 0.15);
  --neon-border: rgba(227, 252, 2, 0.1);
  --bg: #1F1F21;
  --glass: rgba(255, 255, 255, 0.03);
  --text: #f5f5f7;
  --muted: rgba(245, 245, 247, 0.6);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  overflow-x: hidden;
}

/* ===================================
   CREATIVE SERVICES PAGE
   =================================== */

.creative-services-page {
  background: linear-gradient(180deg, 
    #1F1F21 0%,
    #171719 15%,
    #1F1F21 50%,
    #171719 100%
  );
  min-height: 100vh;
  padding: 10vh 5%;
}

/* Hero Section */
.creative-hero {
  text-align: center;
  max-width: 900px;
  margin: 0 auto 8vh;
  padding-bottom: 6vh;
  border-bottom: 1px solid var(--neon-border);
}

.hero-eyebrow {
  font-size: 0.875rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--neon);
  margin-bottom: 1.5rem;
}

.hero-title {
  font-size: clamp(2.5rem, 6vw, 4.5rem);
  font-weight: 800;
  line-height: 1.1;
  margin-bottom: 1.5rem;
  color: var(--text);
  padding-bottom: 0.2em;
}

.hero-subtitle {
  font-size: clamp(1.125rem, 2vw, 1.375rem);
  color: var(--muted);
  line-height: 1.7;
  max-width: 700px;
  margin: 0 auto;
}

/* Services Grid - 3 columns */
.services-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2.5rem;
  max-width: 1400px;
  margin: 6vh auto;
}

/* Service Card */
.service-card {
  background: var(--glass);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1.5px solid var(--neon-border);
  border-radius: 24px;
  padding: 2.5rem;
  position: relative;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  overflow: hidden;
  cursor: pointer;
}

.service-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 15%;
  right: 15%;
  height: 1.5px;
  background: var(--neon);
  box-shadow: 0 0 10px var(--neon-glow);
}

/* Hover State - Reveal Details */
.service-card:hover {
  transform: translateY(-10px);
  border-color: var(--neon);
  box-shadow: 0 20px 60px rgba(0,0,0,0.6), 0 0 40px var(--neon-subtle);
}

.service-card:hover .service-details {
  opacity: 1;
  max-height: 500px;
}

.service-card:hover .service-title {
  color: var(--neon);
}

/* Neon Bullet Point */
.service-bullet {
  display: inline-block;
  width: 6px;
  height: 6px;
  background: var(--neon);
  border-radius: 2px;
  margin-right: 0.75rem;
  box-shadow: 0 0 8px var(--neon-glow);
}

/* Service Icon */
.service-icon {
  width: 60px;
  height: 60px;
  margin-bottom: 1.5rem;
  color: var(--neon);
}

/* Service Title */
.service-title {
  font-size: 1.75rem;
  font-weight: 700;
  margin-bottom: 1rem;
  color: var(--text);
  transition: color 0.3s ease;
  padding-bottom: 0.15em;
}

/* Service Summary */
.service-summary {
  font-size: 1.0625rem;
  line-height: 1.7;
  color: var(--muted);
  margin-bottom: 1.5rem;
}

/* Service Details - Hidden until hover */
.service-details {
  opacity: 0;
  max-height: 0;
  overflow: hidden;
  transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}

.service-details-list {
  list-style: none;
  padding: 0;
  margin-top: 1.5rem;
  padding-top: 1.5rem;
  border-top: 1px solid rgba(227, 252, 2, 0.15);
}

.service-details-list li {
  font-size: 0.9375rem;
  line-height: 1.6;
  color: var(--muted);
  margin-bottom: 0.75rem;
  display: flex;
  align-items: flex-start;
}

/* Bundle Note Section */
.bundle-note {
  max-width: 1000px;
  margin: 8vh auto 0;
  padding: 3rem;
  background: rgba(227, 252, 2, 0.05);
  border: 1.5px solid rgba(227, 252, 2, 0.2);
  border-radius: 24px;
  text-align: center;
  backdrop-filter: blur(20px);
}

.bundle-note-text {
  font-size: 1.125rem;
  line-height: 1.7;
  color: var(--text);
}

.bundle-note-text strong {
  color: var(--neon);
}

/* CTA Section */
.cta-section {
  text-align: center;
  margin-top: 6vh;
}

.btn-primary {
  display: inline-block;
  padding: 1.25rem 3rem;
  background: var(--neon);
  color: #000;
  font-weight: 700;
  font-size: 1rem;
  border-radius: 12px;
  text-decoration: none;
  transition: all 0.3s ease;
  box-shadow: 0 4px 20px var(--neon-glow);
}

.btn-primary:hover {
  background: #ffffff;
  transform: translateY(-2px);
  box-shadow: 0 8px 30px var(--neon-glow);
}

/* ===================================
   RESPONSIVE
   =================================== */

@media (max-width: 1024px) {
  .services-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
}

@media (max-width: 768px) {
  .creative-services-page {
    padding: 8vh 5%;
  }

  .services-grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .service-card {
    padding: 2rem;
  }

  .service-title {
    font-size: 1.5rem;
  }

  .bundle-note {
    padding: 2rem;
  }
}

/* ===================================
   GLOBAL SCROLLBAR
   =================================== */

::-webkit-scrollbar {
  width: 10px;
}

::-webkit-scrollbar-track {
  background: #121212;
}

::-webkit-scrollbar-thumb {
  background: var(--neon);
  border-radius: 10px;
  box-shadow: 0 0 10px var(--neon-glow);
}
</style>

