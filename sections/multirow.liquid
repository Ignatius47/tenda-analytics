{% comment %}
  Tenda Homepage - Floating Action Bubble (FAB) Insights Drawer
  Features: Android-style notification bubble with drawer expansion
{% endcomment %}

<!-- Calendly Integration -->
<link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet">
<script src="https://assets.calendly.com/assets/external/widget.js" type="text/javascript" async></script>

<style>
  :root {
    --font-body-size: 1.125rem;
    --font-heading-line-height: 1.3;
    --font-body-line-height: 1.6;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    background-color: #1F1F21;
    color: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    font-size: var(--font-body-size);
    line-height: var(--font-body-line-height);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  h1, h2, h3, h4, h5, h6,
  .hero-title,
  .section-title,
  .card-title {
    line-height: var(--font-heading-line-height);
    padding-bottom: 0.2em;
    overflow: visible !important;
  }

  /* ===================================
     CUSTOM NEON SCROLLBAR
     =================================== */

  ::-webkit-scrollbar {
    width: 10px;
  }

  ::-webkit-scrollbar-track {
    background: #121212;
  }

  ::-webkit-scrollbar-thumb {
    background: #E3FC02;
    border-radius: 10px;
    box-shadow: 0 0 10px rgba(227, 252, 2, 0.4);
  }

  ::-webkit-scrollbar-thumb:hover {
    background: #f6ff4d;
  }
  
  /* ===================================
     BLOOMBERG-STYLE DATA TICKER
     =================================== */

  /* Ticker Container - Floating below header */
  .tenda-ticker-wrap {
    position: fixed;
    top: 90px;  /* 12px below header (assuming 78px header) */
    left: 0;
    width: 100%;
    height: 32px;
    background: rgba(18, 18, 20, 0.65);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 0.5px solid rgba(227, 252, 2, 0.12);
    border-bottom: 0.5px solid rgba(227, 252, 2, 0.12);
    overflow: hidden;
    z-index: 9996;
    display: flex;
    align-items: center;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
  }

  /* The Scrolling Content - Seamless Loop */
  .tenda-ticker-content {
    display: flex;
    white-space: nowrap;
    animation: ticker-move 60s linear infinite;
    will-change: transform;
  }

  /* Pause on hover for readability */
  .tenda-ticker-wrap:hover .tenda-ticker-content {
    animation-play-state: paused;
  }

  /* Individual Ticker Items */
  .tenda-ticker-item {
    color: #E3FC02;
    font-size: 0.75rem;
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 2px;
    padding: 0 4rem;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  /* Category Labels */
  .ticker-label {
    font-weight: 800;
    font-size: 0.7rem;
    background: rgba(227, 252, 2, 0.15);
    padding: 2px 8px;
    border-radius: 3px;
    letter-spacing: 1.5px;
  }

  /* Separator Dots */
  .ticker-separator {
    width: 4px;
    height: 4px;
    background: rgba(227, 252, 2, 0.4);
    border-radius: 50%;
    margin: 0 2rem;
  }

  /* Seamless Loop Animation */
  @keyframes ticker-move {
    0% { 
      transform: translateX(0); 
    }
    100% { 
      transform: translateX(-50%); 
    }
  }

  /* Mobile: Faster scroll, smaller text */
  @media (max-width: 768px) {
    .tenda-ticker-wrap {
      top: 78px;
      height: 28px;
    }

    .tenda-ticker-content {
      animation: ticker-move 40s linear infinite;
    }

    .tenda-ticker-item {
      font-size: 0.7rem;
      letter-spacing: 1.5px;
      padding: 0 3rem;
    }

    .ticker-label {
      font-size: 0.65rem;
      padding: 2px 6px;
    }

    .ticker-separator {
      margin: 0 1.5rem;
    }
  }

  /* Tablet */
  @media (min-width: 769px) and (max-width: 1024px) {
    .tenda-ticker-wrap {
      top: 84px;
      height: 30px;
    }

    .tenda-ticker-content {
      animation: ticker-move 50s linear infinite;
    }
  }

  /* ===================================
     INSIGHTS PILL - MAC TASKBAR STYLE
     =================================== */

  /* The Pill (Collapsed State) */
  .insight-bubble-trigger {
    position: fixed;
    right: 20px;
    bottom: 100px;
    padding: 12px 20px;
    border-radius: 980px;  /* Pill shape */
    background: rgba(227, 252, 2, 0.12);
    border: 1.5px solid rgba(227, 252, 2, 0.5);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    display: flex !important;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    z-index: 9998;
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);  /* Mac bounce */
    box-shadow: 0 4px 24px rgba(227, 252, 2, 0.3),
                0 0 0 0 rgba(227, 252, 2, 0.4);
    animation: pill-breathe 3s infinite ease-in-out;
    white-space: nowrap;
    font-size: 13px;
    font-weight: 700;
    color: #E3FC02;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  /* Pill Icon */
  .insight-bubble-trigger::before {
    content: '⚡';
    font-size: 18px;
    line-height: 1;
    display: inline-block;
  }

  /* Notification Badge */
  .insight-bubble-trigger::after {
    content: '2';
    background: #E3FC02;
    color: #000;
    font-size: 10px;
    font-weight: 900;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(227, 252, 2, 0.6);
    margin-left: 4px;
  }

  /* Breathing Animation */
  @keyframes pill-breathe {
    0%, 100% { 
      box-shadow: 0 4px 24px rgba(227, 252, 2, 0.3),
                  0 0 0 0 rgba(227, 252, 2, 0.4);
    }
    50% { 
      box-shadow: 0 6px 32px rgba(227, 252, 2, 0.5),
                  0 0 0 8px rgba(227, 252, 2, 0);
    }
  }

  /* Hover State - Mac Bounce */
  .insight-bubble-trigger:hover {
    background: rgba(227, 252, 2, 0.2);
    border-color: rgba(227, 252, 2, 0.8);
    transform: scale(1.05) translateY(-4px);
    box-shadow: 0 8px 40px rgba(227, 252, 2, 0.5);
  }

  /* Active/Pressed State */
  .insight-bubble-trigger:active {
    transform: scale(0.98) translateY(0);
  }

  /* Hidden when drawer opens */
  .insight-bubble-trigger.hidden {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.8) translateY(20px);
  }

  /* Shrink on deep scroll */
  .insight-bubble-trigger.scrolled {
    padding: 10px 16px;
    font-size: 12px;
    bottom: 95px;
  }

  .insight-bubble-trigger.scrolled::before {
    font-size: 16px;
  }

  .insight-bubble-trigger.scrolled::after {
    width: 16px;
    height: 16px;
    font-size: 9px;
  }

  /* Mobile: Smaller pill */
  @media (max-width: 768px) {
    .insight-bubble-trigger {
      right: 16px;
      bottom: 160px;
      padding: 10px 16px;
      font-size: 12px;
    }

    .insight-bubble-trigger::before {
      font-size: 16px;
    }

    .insight-bubble-trigger::after {
      width: 16px;
      height: 16px;
      font-size: 9px;
    }

    .insight-bubble-trigger.scrolled {
      padding: 8px 14px;
      font-size: 11px;
      bottom: 155px;
    }
  }

  /* Tablet */
  @media (min-width: 769px) and (max-width: 1024px) {
    .insight-bubble-trigger {
      right: 18px;
      bottom: 120px;
    }
  }

  /* ===================================
     INSIGHTS DRAWER - MAC TASKBAR EXPANSION
     =================================== */

  .insight-drawer-wrapper {
    position: fixed;
    right: 20px;
    bottom: 100px;  /* Same position as pill */
    width: 400px;
    max-width: calc(100vw - 40px);
    max-height: 0;
    z-index: 9999;
    background: rgba(18, 18, 20, 0.96);
    backdrop-filter: blur(40px);
    -webkit-backdrop-filter: blur(40px);
    border: 1.5px solid rgba(227, 252, 2, 0.4);
    border-radius: 24px;
    padding: 0;
    overflow: hidden;
    scrollbar-width: thin;
    scrollbar-color: #E3FC02 #121214;
    scrollbar-gutter: stable;
    box-shadow: 0 0 0 rgba(0, 0, 0, 0);
    
    /* Mac Taskbar Animation */
    transform-origin: bottom right;
    transform: scale(0.9) translateY(20px);
    opacity: 0;
    transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);  /* Mac bounce */
  }

  /* Open State - Mac Bounce */
  .insight-drawer-wrapper.open {
    max-height: 70vh;
    padding: 2rem;
    transform: scale(1) translateY(0);
    opacity: 1;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8), 
                0 0 40px rgba(227, 252, 2, 0.25),
                0 0 100px rgba(227, 252, 2, 0.1);
    overflow-y: auto;
  }

  /* Precision Scrollbar */
  .insight-drawer-wrapper::-webkit-scrollbar {
    width: 4px;
  }

  .insight-drawer-wrapper::-webkit-scrollbar-track {
    background: transparent;
    margin: 10px 0;
  }

  .insight-drawer-wrapper::-webkit-scrollbar-thumb {
    background: #E3FC02;
    border-radius: 10px;
  }

  .insight-drawer-wrapper::-webkit-scrollbar-thumb:hover {
    background: #f6ff4d;
  }

  /* Close Button - Always visible on mobile */
  .drawer-close-btn {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    width: 36px;
    height: 36px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.15);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    z-index: 10;
    opacity: 1;
  }

  .drawer-close-btn::before,
  .drawer-close-btn::after {
    content: '';
    position: absolute;
    width: 16px;
    height: 2px;
    background: #ffffff;
    border-radius: 2px;
  }

  .drawer-close-btn::before {
    transform: rotate(45deg);
  }

  .drawer-close-btn::after {
    transform: rotate(-45deg);
  }

  .drawer-close-btn:hover {
    background: rgba(227, 252, 2, 0.15);
    border-color: rgba(227, 252, 2, 0.4);
    transform: scale(1.1) rotate(90deg);
  }

  .drawer-close-btn:active {
    transform: scale(0.95);
  }

  /* Drawer Header */
  .drawer-header {
    margin-bottom: 1.5rem;
    padding-right: 2.5rem;
  }

  .drawer-header h3 {
    font-size: 1.5rem;
    font-weight: 800;
    color: #E3FC02;
    margin-bottom: 0.5rem;
    line-height: 1.2;
  }

  .drawer-header p {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.4;
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .insight-drawer-wrapper {
      right: 16px;
      left: 16px;
      bottom: 20px;
      width: auto;
    }

    .insight-drawer-wrapper.open {
      max-height: 65vh;
      padding: 1.5rem;
    }

    /* Make X button more prominent on mobile */
    .drawer-close-btn {
      top: 1rem;
      right: 1rem;
      width: 40px;
      height: 40px;
      background: rgba(227, 252, 2, 0.12);
      border: 2px solid rgba(227, 252, 2, 0.3);
    }

    .drawer-close-btn::before,
    .drawer-close-btn::after {
      width: 18px;
      height: 2.5px;
    }

    .drawer-header {
      padding-right: 3rem;
    }

    .drawer-header h3 {
      font-size: 1.25rem;
    }
  }

  /* Tablet */
  @media (min-width: 769px) and (max-width: 1024px) {
    .insight-drawer-wrapper {
      right: 18px;
      width: 380px;
    }

    .insight-drawer-wrapper.open {
      max-height: 68vh;
    }
  }

  /* Precision Scrollbar */
  .insight-drawer-wrapper::-webkit-scrollbar {
    width: 4px;
  }

  .insight-drawer-wrapper::-webkit-scrollbar-track {
    background: transparent;
    margin: 10px 0;
  }

  .insight-drawer-wrapper::-webkit-scrollbar-thumb {
    background: #E3FC02;
    border-radius: 10px;
  }

  .insight-drawer-wrapper::-webkit-scrollbar-thumb:hover {
    background: #f6ff4d;
  }

  /* Close Button */
  .drawer-close-btn {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 32px;
    height: 32px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.2);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    z-index: 10;
  }

  .drawer-close-btn::before,
  .drawer-close-btn::after {
    content: '';
    position: absolute;
    width: 14px;
    height: 2px;
    background: #ffffff;
  }

  .drawer-close-btn::before {
    transform: rotate(45deg);
  }

  .drawer-close-btn::after {
    transform: rotate(-45deg);
  }

  .drawer-close-btn:hover {
    background: rgba(227, 252, 2, 0.2);
    border-color: #E3FC02;
    transform: scale(1.1);
  }

  /* Drawer Header */
  .drawer-header {
    margin-bottom: 1.5rem;
    padding-right: 2rem;
  }

  .drawer-header h3 {
    font-size: 1.5rem;
    font-weight: 800;
    color: #E3FC02;
    margin-bottom: 0.5rem;
  }

  .drawer-header p {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.6);
  }

  /* ===================================
     BACKDROP BLUR OVERLAY - ENHANCED
     =================================== */

  .drawer-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(20px) brightness(0.4);
    -webkit-backdrop-filter: blur(20px) brightness(0.4);
    z-index: 9997;
    opacity: 0;
    pointer-events: none;
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .drawer-backdrop.active {
    opacity: 1;
    pointer-events: all;
  }

  /* Mobile: Stronger blur */
  @media (max-width: 768px) {
    .drawer-backdrop {
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(25px) brightness(0.3);
      -webkit-backdrop-filter: blur(25px) brightness(0.3);
    }
  }

  /* ===================================
     MINI INSIGHT CARDS (unchanged)
     =================================== */

  .mini-insight-card {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(15px);
    border: 0.5px solid rgba(227, 252, 2, 0.2);
    border-top: 2px solid #E3FC02;
    border-radius: 16px;
    padding: 1.5rem;
    transition: all 0.3s ease;
  }

  .mini-insight-card:hover {
    border-color: #E3FC02;
    background: rgba(255, 255, 255, 0.05);
    box-shadow: 0 8px 30px rgba(227, 252, 2, 0.15);
    transform: translateY(-4px);
  }

  .mini-badge {
    display: inline-block;
    padding: 0.375rem 0.75rem;
    background: rgba(227, 252, 2, 0.15);
    border: 1px solid rgba(227, 252, 2, 0.3);
    border-radius: 6px;
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #E3FC02;
    margin-bottom: 0.75rem;
  }

  .mini-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0.75rem 0;
    line-height: 1.3;
    padding-bottom: 0.1em;
  }

  .mini-excerpt {
    font-size: 0.875rem;
    font-style: italic;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .mini-btn-neon {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    background: transparent;
    color: #E3FC02;
    border: 1.5px solid #E3FC02;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 0 15px rgba(227, 252, 2, 0.15);
  }

  .mini-btn-neon:hover {
    background: #E3FC02;
    color: #000;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(227, 252, 2, 0.4);
  }

  .mini-btn-neon svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .mini-btn-neon:hover svg {
    transform: scale(1.1);
  }

  /* ===================================
     CALENDLY STYLES
     =================================== */
  
  .calendly-overlay {
    background-color: rgba(0, 0, 0, 0.85) !important;
    backdrop-filter: blur(20px) !important;
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    z-index: 99999 !important;
  }

  .calendly-popup,
  .calendly-popup-content {
    width: 90% !important;
    height: 85% !important;
    max-width: 1080px !important;
    background: #121212 !important;
    border-radius: 24px !important;
    border: 1.5px solid #E3FC02 !important;
    box-shadow: 0 0 30px rgba(227, 252, 2, 0.3) !important;
    overflow: hidden !important;
    margin: 0 !important;
  }

  .calendly-popup ::-webkit-scrollbar,
  .calendly-inline-widget ::-webkit-scrollbar {
    width: 6px !important;
  }

  .calendly-popup ::-webkit-scrollbar-track,
  .calendly-inline-widget ::-webkit-scrollbar-track {
    background: #121212 !important;
  }

  .calendly-popup ::-webkit-scrollbar-thumb,
  .calendly-inline-widget ::-webkit-scrollbar-thumb {
    background: #E3FC02 !important;
    border-radius: 10px !important;
  }

  .calendly-close-overlay {
    position: absolute !important;
    right: 30px !important;
    top: 30px !important;
    left: auto !important;
    background: rgba(255, 255, 255, 0.1) !important;
    backdrop-filter: blur(10px) !important;
    border-radius: 50% !important;
    border: 2px solid rgba(255, 255, 255, 0.3) !important;
    width: 44px !important;
    height: 44px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    z-index: 999999 !important;
    transition: all 0.3s ease !important;
  }

  .calendly-close-overlay:hover {
    background: rgba(227, 252, 2, 0.2) !important;
    border-color: #E3FC02 !important;
    transform: scale(1.1) !important;
    box-shadow: 0 0 20px rgba(227, 252, 2, 0.4) !important;
  }

  .calendly-close-overlay::before,
  .calendly-close-overlay::after {
    content: '' !important;
    position: absolute !important;
    width: 20px !important;
    height: 3px !important;
    background: #ffffff !important;
    border-radius: 2px !important;
  }

  .calendly-close-overlay::before {
    transform: rotate(45deg) !important;
  }

  .calendly-close-overlay::after {
    transform: rotate(-45deg) !important;
  }

  /* ===================================
     PREMIUM LIVE DIVIDER
     =================================== */
  
  .section-divider {
    height: 1px;
    width: 80%;
    margin: 70px auto;
    background: linear-gradient(90deg, 
      rgba(227, 252, 2, 0) 0%, 
      rgba(227, 252, 2, 0.8) 50%, 
      rgba(227, 252, 2, 0) 100%
    );
    position: relative;
    overflow: hidden;
    opacity: 0;
    animation: dividerDraw 1.2s ease-out 0.3s forwards;
  }

  @keyframes dividerDraw {
    0% {
      transform: scaleX(0);
      opacity: 0;
    }
    100% {
      transform: scaleX(1);
      opacity: 1;
    }
  }

  .section-divider::after {
    content: '';
    position: absolute;
    top: -2px;
    left: -100%;
    width: 50%;
    height: 5px;
    background: linear-gradient(90deg, 
      transparent, 
      rgba(255, 255, 255, 0.6), 
      transparent
    );
    animation: shimmerTravel 4s infinite linear 1.5s;
    filter: blur(2px);
  }

  @keyframes shimmerTravel {
    0% { left: -100%; }
    100% { left: 150%; }
  }

  .section-divider:hover {
    background: linear-gradient(90deg, 
      rgba(227, 252, 2, 0) 0%, 
      rgba(227, 252, 2, 1) 50%, 
      rgba(227, 252, 2, 0) 100%
    );
    box-shadow: 0 0 20px rgba(227, 252, 2, 0.5);
    transition: all 0.3s ease;
  }

  /* ===================================
     ANIMATIONS
     =================================== */

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes slideInLeft {
    from {
      opacity: 0;
      transform: translateX(-40px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes float {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-20px);
    }
  }

  @keyframes glow {
    0%, 100% {
      box-shadow: 0 0 20px rgba(227, 252, 2, 0.3);
    }
    50% {
