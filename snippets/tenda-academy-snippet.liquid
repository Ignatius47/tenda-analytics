{% comment %}
  Tenda Hub - Upgraded Tabbed Interface
  Academy + Professional Consultant Portal
{% endcomment %}

<style>
:root {
  --neon: #E3FC02;
  --neon-glow: rgba(227, 252, 2, 0.4);
  --neon-subtle: rgba(227, 252, 2, 0.15);
  --neon-border: rgba(227, 252, 2, 0.1);
  --bg: #1F1F21;
  --glass: rgba(255, 255, 255, 0.03);
  --text: #f5f5f7;
  --muted: rgba(245, 245, 247, 0.6);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', Roboto, sans-serif;
  overflow-x: hidden;
}

.tenda-hub {
  background: linear-gradient(180deg, 
    #1F1F21 0%,
    #171719 15%,
    #1F1F21 35%,
    #232325 55%,
    #1F1F21 75%,
    #171719 100%
  );
  min-height: 100vh;
}

/* ===================================
   STICKY TAB NAVIGATION
   =================================== */

.hub-nav {
  position: sticky;
  top: 80px;
  z-index: 100;
  background: rgba(31, 31, 33, 0.95);
  backdrop-filter: blur(30px);
  border-bottom: 1px solid var(--neon-border);
  padding: 0;
  display: flex;
  justify-content: center;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
}

.tab-triggers {
  display: flex;
  gap: 0;
  position: relative;
}

.tab-trigger {
  padding: 1.5rem 3rem;
  font-size: 1rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  border-bottom: 3px solid transparent;
  color: var(--muted);
  position: relative;
  background: transparent;
  border: none;
  white-space: nowrap;
}

.tab-trigger:hover {
  color: var(--text);
  background: rgba(227, 252, 2, 0.05);
}

.tab-trigger.active {
  color: var(--neon);
  border-bottom-color: var(--neon);
  background: rgba(227, 252, 2, 0.08);
  box-shadow: 0 -2px 20px var(--neon-glow) inset;
}

.tab-trigger.active::after {
  content: '';
  position: absolute;
  bottom: -3px;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--neon);
  box-shadow: 0 0 15px var(--neon-glow);
  animation: slideIn 0.3s ease;
}

@keyframes slideIn {
  from { transform: scaleX(0); }
  to { transform: scaleX(1); }
}

/* ===================================
   TAB CONTENT
   =================================== */

.hub-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 5%;
}

.tab-content {
  display: none;
  animation: fadeSlideIn 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}

.tab-content.active {
  display: block;
}

@keyframes fadeSlideIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ===================================
   REVEALS
   =================================== */

.reveal {
  opacity: 0;
  transform: translateY(30px);
  transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
}

.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

.reveal-delay-1 { transition-delay: 0.1s; }
.reveal-delay-2 { transition-delay: 0.2s; }
.reveal-delay-3 { transition-delay: 0.3s; }
.reveal-delay-4 { transition-delay: 0.4s; }

/* ===================================
   HERO SECTIONS
   =================================== */

.hero-section {
  text-align: center;
  padding: 12vh 5% 8vh;
}

.hero-eyebrow {
  font-size: 0.875rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--neon);
  margin-bottom: 1.5rem;
}

.hero-title {
  font-size: clamp(2.5rem, 6vw, 4.5rem);
  font-weight: 800;
  line-height: 1.1;
  margin-bottom: 1.5rem;
}

.hero-subtitle {
  font-size: clamp(1.125rem, 2vw, 1.375rem);
  color: var(--muted);
  max-width: 700px;
  margin: 0 auto;
  line-height: 1.6;
}

/* Neon Button */
.tenda-btn-neon {
  padding: 1.25rem 3rem;
  background: transparent;
  color: var(--neon);
  border: 2px solid var(--neon);
  border-radius: 12px;
  font-size: 1.0625rem;
  font-weight: 700;
  text-decoration: none;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 0 20px rgba(227, 252, 2, 0.2);
}

.tenda-btn-neon:hover {
  background: var(--neon);
  color: #000;
  transform: translateY(-2px);
  box-shadow: 0 8px 30px var(--neon-glow);
}

/* ===================================
   CATEGORY FILTERS
   =================================== */

.filter-pills {
  display: flex;
  justify-content: center;
  gap: 0.75rem;
  flex-wrap: wrap;
  margin: 3rem 0;
}

.filter-pill {
  padding: 0.75rem 1.5rem;
  border-radius: 980px;
  border: 1.5px solid rgba(255, 255, 255, 0.1);
  background: var(--glass);
  color: var(--muted);
  font-size: 0.9375rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  white-space: nowrap;
}

.filter-pill:hover {
  border-color: rgba(227, 252, 2, 0.3);
  background: rgba(227, 252, 2, 0.05);
  color: var(--text);
}

.filter-pill.active {
  background: var(--neon);
  color: #000;
  border-color: var(--neon);
  box-shadow: 0 4px 20px var(--neon-glow);
}

/* ===================================
   ACADEMY GRID
   =================================== */
.academy-grid,
.academy-grid-symmetric {
  margin-top: 3rem;
}

/* Container for symmetric layout */
.academy-grid-symmetric {
  display: flex;
  flex-direction: column;
  gap: 2rem;
  max-width: 1200px;
  margin-left: auto;
  margin-right: auto;
}

/* Top Row - Two Equal Cards */
.symmetric-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2rem;
}

/* Bottom Row - Single Centered Card */
.symmetric-row-single {
  display: grid;
  grid-template-columns: 1fr;
  max-width: calc(50% - 1rem);
  margin: 0 auto;
}

/* Symmetric Resource Card - Enhanced Glassmorphism */
.resource-card-symmetric {
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  border: 1px solid var(--neon);
  border-radius: 24px;
  padding: 0;
  position: relative;
  overflow: hidden;
  transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  cursor: pointer;
  
  /* Ensure flex layout for perfect bottom alignment */
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

/* Hover Glow Effect */
.hover-glow-symmetric {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 50% 50%, rgba(227, 252, 2, 0.08) 0%, transparent 70%);
  opacity: 0;
  transition: opacity 0.5s ease;
  pointer-events: none;
}

.resource-card-symmetric:hover .hover-glow-symmetric {
  opacity: 1;
}

.resource-card-symmetric:hover {
  transform: translateY(-12px) scale(1.02);
  border-color: var(--neon);
  box-shadow: 
    0 25px 70px rgba(0, 0, 0, 0.7),
    0 0 60px rgba(227, 252, 2, 0.3),
    inset 0 0 40px rgba(227, 252, 2, 0.05);
}

/* Card Content Wrapper - Ensures Perfect Alignment */
.card-content-symmetric {
  padding: 2.5rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 100%;
  gap: 2rem;
}

/* Icon */
.resource-icon-symmetric {
  font-size: 3rem;
  display: block;
  margin-bottom: 1.5rem;
  filter: drop-shadow(0 0 20px rgba(227, 252, 2, 0.4));
}

/* Category Tags - Neon Yellow Background */
.resource-tag-symmetric {
  display: inline-block;
  padding: 0.5rem 1rem;
  border-radius: 8px;
  font-size: 0.75rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 1.5rem;
  box-shadow: 0 4px 15px rgba(227, 252, 2, 0.3);
  transition: all 0.3s ease;
}

.resource-tag-symmetric.featured {
  background: var(--neon);
  color: #000000;
  border: 1px solid var(--neon);
}

.resource-tag-symmetric.playbook {
  background: var(--neon);
  color: #000000;
  border: 1px solid var(--neon);
}

.resource-tag-symmetric.checklist {
  background: var(--neon);
  color: #000000;
  border: 1px solid var(--neon);
}

.resource-card-symmetric:hover .resource-tag-symmetric {
  transform: scale(1.05);
  box-shadow: 0 6px 20px rgba(227, 252, 2, 0.5);
}

/* Title */
.resource-title-symmetric {
  font-size: 1.625rem;
  font-weight: 800;
  line-height: 1.3;
  margin-bottom: 1rem;
  color: var(--text);
}

/* Meta */
.resource-meta-symmetric {
  font-size: 0.875rem;
  color: var(--muted);
  margin-bottom: 1.25rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

/* Description */
.resource-description-symmetric {
  color: var(--muted);
  line-height: 1.7;
  font-size: 1.0625rem;
  margin-bottom: 0;
}

/* Download Link - Perfectly Aligned at Bottom */
.download-link-symmetric {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  color: var(--neon);
  text-decoration: none;
  font-weight: 700;
  font-size: 1.0625rem;
  padding: 1.25rem 2rem;
  background: rgba(227, 252, 2, 0.08);
  border: 1.5px solid rgba(227, 252, 2, 0.3);
  border-radius: 12px;
  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  margin-top: auto;
  width: fit-content;
  box-shadow: 0 0 20px rgba(227, 252, 2, 0.15);
}

.download-link-symmetric:hover {
  background: var(--neon);
  color: #000000;
  border-color: var(--neon);
  transform: translateX(8px);
  box-shadow: 0 8px 30px rgba(227, 252, 2, 0.4);
}

.download-link-symmetric svg {
  transition: transform 0.3s ease;
}

.download-link-symmetric:hover svg {
  transform: translateY(3px);
}

/* ===================================
   ACCESS RESTRICTED MODAL
   =================================== */

.tenda-access-modal {
  position: fixed;
  inset: 0;
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.85);
  backdrop-filter: blur(30px);
  -webkit-backdrop-filter: blur(30px);
  opacity: 0;
  pointer-events: none;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.tenda-access-modal.active {
  opacity: 1;
  pointer-events: all;
}

.tenda-access-modal-content {
  width: 90%;
  max-width: 550px;
  background: rgba(20, 20, 22, 0.95);
  backdrop-filter: blur(40px) saturate(160%);
  -webkit-backdrop-filter: blur(40px) saturate(160%);
  border: 2px solid rgba(227, 252, 2, 0.4);
  border-radius: 32px;
  padding: 3.5rem 3rem;
  text-align: center;
  box-shadow: 
    0 0 0 1px rgba(227, 252, 2, 0.2),
    0 60px 140px rgba(0, 0, 0, 0.9),
    inset 0 1px 0 rgba(255, 255, 255, 0.08);
  position: relative;
  transform: scale(0.9) translateY(30px);
  transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tenda-access-modal.active .tenda-access-modal-content {
  transform: scale(1) translateY(0);
}

/* Top seam */
.tenda-access-modal-content::before {
  content: '';
  position: absolute;
  top: 0;
  left: 15%;
  right: 15%;
  height: 2px;
  background: linear-gradient(90deg, 
    transparent 0%, 
    rgba(227, 252, 2, 0.8) 30%, 
    rgba(255, 255, 255, 0.3) 50%,
    rgba(227, 252, 2, 0.8) 70%, 
    transparent 100%
  );
}

.tenda-access-icon {
  width: 90px;
  height: 90px;
  background: linear-gradient(135deg, rgba(227, 252, 2, 0.2) 0%, rgba(227, 252, 2, 0.1) 100%);
  border: 2.5px solid rgba(227, 252, 2, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 3rem;
  margin: 0 auto 2rem;
  animation: modalIconBounce 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 0.2s backwards;
}

@keyframes modalIconBounce {
  0% { opacity: 0; transform: scale(0.3) rotate(-20deg); }
  60% { transform: scale(1.15) rotate(10deg); }
  100% { opacity: 1; transform: scale(1) rotate(0deg); }
}

.tenda-access-title {
  font-size: 2.25rem;
  font-weight: 900;
  color: #E3FC02;
  margin-bottom: 1.25rem;
  text-shadow: 0 0 30px rgba(227, 252, 2, 0.5);
  animation: modalTextSlide 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.35s backwards;
}

@keyframes modalTextSlide {
  0% { opacity: 0; transform: translateY(20px); }
  100% { opacity: 1; transform: translateY(0); }
}

.tenda-access-message {
  font-size: 1.1875rem;
  color: rgba(255, 255, 255, 0.75);
  line-height: 1.6;
  margin-bottom: 2.5rem;
  animation: modalTextSlide 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.45s backwards;
}

.tenda-access-close {
  padding: 1.125rem 2.5rem;
  background: var(--neon);
  color: #000000;
  border: none;
  border-radius: 14px;
  font-weight: 900;
  font-size: 1.0625rem;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  cursor: pointer;
  box-shadow: 0 10px 35px rgba(227, 252, 2, 0.4);
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  animation: modalButtonSlide 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.55s backwards;
}

@keyframes modalButtonSlide {
  0% { opacity: 0; transform: translateY(25px); }
  100% { opacity: 1; transform: translateY(0); }
}

.tenda-access-close:hover {
  transform: translateY(-3px);
  box-shadow: 0 15px 50px rgba(227, 252, 2, 0.6);
}

.tenda-access-close:active {
  transform: scale(0.97);
}

/* ===================================
   MOBILE RESPONSIVE
   =================================== */

@media (max-width: 1024px) {
  .symmetric-row {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .symmetric-row-single {
    max-width: 100%;
  }
}

@media (max-width: 768px) {
  .card-content-symmetric {
    padding: 2rem 1.75rem;
  }

  .resource-icon-symmetric {
    font-size: 2.5rem;
  }

  .resource-title-symmetric {
    font-size: 1.375rem;
  }

  .download-link-symmetric {
    padding: 1rem 1.75rem;
    font-size: 1rem;
  }

  .tenda-access-modal-content {
    padding: 3rem 2rem;
    border-radius: 28px;
  }

  .tenda-access-icon {
    width: 75px;
    height: 75px;
    font-size: 2.5rem;
  }

  .tenda-access-title {
    font-size: 1.875rem;
  }

  .tenda-access-message {
    font-size: 1.0625rem;
  }
}

/* ===================================
   TIMELINE
   =================================== */

.timeline-container {
  max-width: 1000px;
  margin: 5rem auto;
  position: relative;
}

.timeline-line {
  position: absolute;
  left: 40px;
  top: 0;
  bottom: 0;
  width: 2px;
  background: rgba(255, 255, 255, 0.1);
}

.timeline-line::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 0;
  background: var(--neon);
  box-shadow: 0 0 10px var(--neon-glow);
  transition: height 0.8s ease;
}

.timeline-line.active::before {
  height: 100%;
}

.timeline-steps {
  padding-left: 100px;
  position: relative;
}

.timeline-step {
  position: relative;
  margin-bottom: 5rem;
  opacity: 0.3;
  transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

.timeline-step.active {
  opacity: 1;
}

.step-icon {
  position: absolute;
  left: -83px;
  top: 0;
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background: var(--glass);
  backdrop-filter: blur(20px);
  border: 2px solid rgba(227, 252, 2, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
  transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  font-weight: 800;
  color: var(--neon);
}

.timeline-step.active .step-icon {
  background: var(--neon);
  border-color: var(--neon);
  box-shadow: 0 0 30px var(--neon-glow);
  transform: scale(1.1);
  color: #000;
}

.step-number {
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--neon);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 0.5rem;
}

.step-title {
  font-size: 1.75rem;
  font-weight: 700;
  margin-bottom: 0.75rem;
}

.step-description {
  font-size: 1.0625rem;
  color: var(--muted);
  line-height: 1.6;
}

/* Tenda Styled File Upload Wrapper */
  .upload-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .file-upload-wrapper {
    position: relative;
    border: 1px dashed rgba(227, 252, 2, 0.3);
    border-radius: 12px;
    padding: 1.5rem;
    text-align: center;
    transition: all 0.3s ease;
    background: rgba(255, 255, 255, 0.02);
  }

  .file-upload-wrapper:hover {
    border-color: var(--neon);
    background: rgba(227, 252, 2, 0.05);
  }

  .file-input-hidden {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
    width: 100%;
  }

  .upload-label {
    color: #fff;
    font-size: 0.9rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    pointer-events: none;
  }

  .upload-label svg {
    color: var(--neon);
  }

  .divider-text {
    align-self: center;
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-align: center;
  }

/* ===================================
   EXPERTISE GRID
   =================================== */

.expertise-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
  margin: 5rem 0;
}

.expertise-card {
  background: var(--glass);
  backdrop-filter: blur(30px);
  border: 0.5px solid var(--neon-border);
  border-radius: 24px;
  padding: 2.5rem 2rem;
  text-align: center;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
  overflow: hidden;
}

.expertise-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 15%;
  right: 15%;
  height: 2px;
  background: var(--neon);
  box-shadow: 0 0 10px var(--neon-glow);
  transition: all 0.4s ease;
}

.expertise-card:hover {
  transform: translateY(-10px) scale(1.05);
  border-color: var(--neon);
  box-shadow: 0 20px 60px rgba(0,0,0,0.5), 0 0 40px var(--neon-subtle);
}

.expertise-card:hover::before {
  left: 0;
  right: 0;
  box-shadow: 0 0 25px var(--neon-glow);
  animation: neonPulse 1.5s ease-in-out infinite;
}

@keyframes neonPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}

.expertise-icon {
  width: 60px;
  height: 60px;
  margin: 0 auto 1.5rem;
  color: var(--neon);
}

.expertise-title {
  font-size: 1.375rem;
  font-weight: 700;
  margin-bottom: 0.75rem;
}

.expertise-description {
  font-size: 0.9375rem;
  color: var(--muted);
  line-height: 1.5;
}

/* ===================================
   FORM
   =================================== */

.application-form {
  background: var(--glass);
  backdrop-filter: blur(30px);
  border: 0.5px solid var(--neon-border);
  border-radius: 30px;
  padding: 4rem;
  max-width: 800px;
  margin: 5rem auto;
}

.form-header {
  text-align: center;
  margin-bottom: 3rem;
}

.form-title {
  font-size: 2.5rem;
  font-weight: 700;
  margin-bottom: 1rem;
}

.form-subtitle {
  font-size: 1.125rem;
  color: var(--muted);
}

.form-group {
  position: relative;
  margin-bottom: 2rem;
}

.form-input,
.form-textarea,
.form-select {
  width: 100%;
  padding: 1.25rem 1.25rem 0.75rem;
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(12px);
  border: 1.5px solid rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  font-size: 1rem;
  color: var(--text);
  transition: all 0.3s ease;
  font-family: inherit;
}

.form-input.valid,
.form-textarea.valid {
  border-color: var(--neon);
  box-shadow: 0 0 0 3px rgba(227, 252, 2, 0.1);
}

.form-input:focus,
.form-textarea:focus,
.form-select:focus {
  outline: none;
  border-color: var(--neon);
  box-shadow: 0 0 0 3px rgba(227, 252, 2, 0.1), 0 0 20px rgba(227, 252, 2, 0.2);
}

.form-input:focus ~ .form-label,
