              <span class="metric-pill__value">+41%</span>
              <span>CLV</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Case Study 3 -->
      <div class="case-card">
        <div class="case-card__image">
          <img src="{{ 'case-grocery.jpg' | asset_url }}" alt="Grocery store" loading="lazy">
          <div class="case-card__logo">
            <img src="{{ 'logo-client-3.svg' | asset_url }}" alt="Client logo">
          </div>
        </div>

