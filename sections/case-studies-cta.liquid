{% comment %}
  Case Studies Final CTA Section
{% endcomment %}

<style>
.final-cta-section {
  padding: 100px 5%;
  max-width: 1400px;
  margin: 0 auto;
  text-align: center;
  background: #1F1F21;
}

.final-cta-section__title {
  font-size: clamp(2.5rem, 5vw, 4rem);
  font-weight: 900;
  margin-bottom: 1.5rem;
  color: #ffffff;
  line-height: 1.2;
}

.final-cta-section__description {
  font-size: 1.25rem;
  color: rgba(255,255,255,0.55);
  margin-bottom: 3rem;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
  line-height: 1.6;
}

.final-cta-section__button {
  display: inline-flex;
  align-items: center;
  gap: 0.625rem;
  background: #E3FC02;
  color: #000;
  border: none;
  border-radius: 12px;
  padding: 1rem 2rem;
  font-weight: 800;
  font-size: 0.9375rem;
  text-decoration: none;
  letter-spacing: 0.01em;
  transition: all 0.3s ease;
  box-shadow: 0 4px 16px rgba(227,252,2,0.3);
  cursor: pointer;
}

.final-cta-section__button:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 28px rgba(227,252,2,0.5);
}

.final-cta-section__button svg {
  width: 16px;
  height: 16px;
  stroke: currentColor;
}
</style>

<section class="final-cta-section">
  <h2 class="final-cta-section__title">
    {{ section.settings.title | default: "Ready to write your success story?" }}
  </h2>
  <p class="final-cta-section__description">
    {{ section.settings.description | default: "Let's discuss how Tenda can help your business achieve measurable growth." }}
  </p>
  <a href="{{ section.settings.cta_url | default: '/pages/contact' }}" class="final-cta-section__button">
    {{ section.settings.cta_text | default: "Book a Strategy Call" }}
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
    </svg>
  </a>
</section>

{% schema %}
{
  "name": "Case Studies CTA",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Ready to write your success story?"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Let's discuss how Tenda can help your business achieve measurable growth."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Book a Strategy Call"
    },
    {
  "type": "url",
  "id": "cta_url",
  "label": "CTA Button URL"
}
  ]
}
{% endschema %}