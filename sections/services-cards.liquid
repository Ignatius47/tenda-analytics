{% comment %}
  Services Cards Section
  - Hover glow border (colour per card)
  - Spotlight/cursor glow follow effect per card
  - Staggered scroll reveal
  - Icon + title + description + optional CTA link
{% endcomment %}

<style>
/* ── SECTION ──────────────────────────────────────────────────── */
.ta-svc {
  padding: var(--svc-pt, 5.5rem) 1.5rem var(--svc-pb, 5.5rem);
  background: var(--ta-bg, #060608);
  position: relative;
  overflow: hidden;
}

/* subtle ambient gradient */
.ta-svc::before {
  content: '';
  position: absolute;
  top: -20%;
  left: 50%;
  transform: translateX(-50%);
  width: 900px;
  height: 600px;
  background: radial-gradient(ellipse at center,
    rgba(124,58,237,0.06) 0%,
    transparent 65%
  );
  pointer-events: none;
}

/* ── HEADER ───────────────────────────────────────────────────── */
.ta-svc__inner { max-width: 1200px; margin: 0 auto; }

.ta-svc__hdr {
  text-align: center;
  margin-bottom: clamp(2.5rem, 5vw, 4rem);
}

.ta-svc__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: #A78BFA;
  margin-bottom: 1rem;
}

html[data-theme="light"] .ta-svc__eyebrow { color: #6D28D9; }

.ta-svc__eyebrow::before {
  content: '';
  width: 5px; height: 5px;
  border-radius: 50%;
  background: #7C3AED;
  box-shadow: 0 0 8px rgba(124,58,237,0.9);
  flex-shrink: 0;
}

.ta-svc__title {
  font-family: var(--ta-font-display, 'Plus Jakarta Sans', sans-serif);
  font-size: clamp(1.9rem, 4vw, 3rem);
  font-weight: 800;
  letter-spacing: -0.035em;
  line-height: 1.15;
  color: var(--ta-text-primary, #F8F8FF);
  margin: 0 0 1rem;
}

html[data-theme="light"] .ta-svc__title { color: #1A1A2E; }

.ta-svc__desc {
  font-size: 1.05rem;
  line-height: 1.65;
  color: var(--ta-text-secondary, rgba(248,248,255,0.55));
  max-width: 540px;
  margin: 0 auto;
}

html[data-theme="light"] .ta-svc__desc { color: #52526B; }

/* ── GRID ─────────────────────────────────────────────────────── */
.ta-svc__grid {
  display: grid;
  grid-template-columns: repeat(var(--svc-cols, 3), 1fr);
  gap: 1.25rem;
}

@media (max-width: 900px) { .ta-svc__grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 560px) { .ta-svc__grid { grid-template-columns: 1fr; } }

/* ── CARD ─────────────────────────────────────────────────────── */
.ta-svc__card {
  position: relative;
  background: var(--ta-bg-elevated, #18181E);
  border: 1px solid var(--ta-border, rgba(255,255,255,0.06));
  border-radius: 20px;
  padding: 2rem 1.75rem 2rem;
  overflow: hidden;
  transition:
    border-color 0.3s ease,
    box-shadow 0.3s ease,
    transform 0.3s var(--ta-ease-spring, cubic-bezier(0.34,1.56,0.64,1));
  cursor: default;
}

html[data-theme="light"] .ta-svc__card {
  background: #FFFFFF;
  border-color: rgba(0,0,0,0.06);
  box-shadow: 0 2px 12px rgba(0,0,0,0.05);
}

/* Spotlight glow that follows cursor */
.ta-svc__spotlight {
  position: absolute;
  pointer-events: none;
  width: 260px; height: 260px;
  border-radius: 50%;
  background: radial-gradient(circle, var(--card-glow-color, rgba(124,58,237,0.18)) 0%, transparent 65%);
  transform: translate(-50%, -50%);
  left: 50%; top: 30%;
  opacity: 0;
  transition: opacity 0.4s ease;
  filter: blur(10px);
}

.ta-svc__card:hover .ta-svc__spotlight { opacity: 1; }

/* Top edge glow line */
.ta-svc__card::before {
  content: '';
  position: absolute;
  top: 0; left: 10%; right: 10%;
  height: 1px;
  background: linear-gradient(90deg,
    transparent,
    var(--card-line-color, rgba(124,58,237,0.5)) 50%,
    transparent
  );
  opacity: 0;
  transition: opacity 0.3s ease;
}

.ta-svc__card:hover::before { opacity: 1; }
.ta-svc__card:hover {
  border-color: var(--card-border-color, rgba(124,58,237,0.3));
  box-shadow:
    0 0 0 1px var(--card-border-color, rgba(124,58,237,0.15)),
    0 16px 48px rgba(0,0,0,0.4),
    var(--card-shadow-glow, 0 0 40px rgba(124,58,237,0.1));
  transform: translateY(-4px);
}

/* ── Colour variants ── */
/* Purple (default) */
.ta-svc__card[data-glow="purple"] {
  --card-glow-color:    rgba(124,58,237,0.18);
  --card-line-color:    rgba(124,58,237,0.5);
  --card-border-color:  rgba(124,58,237,0.28);
  --card-shadow-glow:   0 0 40px rgba(124,58,237,0.08);
  --card-icon-bg:       rgba(124,58,237,0.12);
  --card-icon-color:    #A78BFA;
}
/* Cyan */
.ta-svc__card[data-glow="cyan"] {
  --card-glow-color:    rgba(6,182,212,0.16);
  --card-line-color:    rgba(6,182,212,0.5);
  --card-border-color:  rgba(6,182,212,0.28);
  --card-shadow-glow:   0 0 40px rgba(6,182,212,0.08);
  --card-icon-bg:       rgba(6,182,212,0.12);
  --card-icon-color:    #67E8F9;
}
/* Accent (yellow) */
.ta-svc__card[data-glow="accent"] {
  --card-glow-color:    rgba(227,252,2,0.12);
  --card-line-color:    rgba(227,252,2,0.4);
  --card-border-color:  rgba(227,252,2,0.22);
  --card-shadow-glow:   0 0 40px rgba(227,252,2,0.06);
  --card-icon-bg:       rgba(227,252,2,0.1);
  --card-icon-color:    #E3FC02;
}
/* Blue */
.ta-svc__card[data-glow="blue"] {
  --card-glow-color:    rgba(59,130,246,0.16);
  --card-line-color:    rgba(59,130,246,0.5);
  --card-border-color:  rgba(59,130,246,0.28);
  --card-shadow-glow:   0 0 40px rgba(59,130,246,0.08);
  --card-icon-bg:       rgba(59,130,246,0.12);
  --card-icon-color:    #93C5FD;
}
/* Green */
.ta-svc__card[data-glow="green"] {
  --card-glow-color:    rgba(52,211,153,0.14);
  --card-line-color:    rgba(52,211,153,0.45);
  --card-border-color:  rgba(52,211,153,0.25);
  --card-shadow-glow:   0 0 40px rgba(52,211,153,0.07);
  --card-icon-bg:       rgba(52,211,153,0.1);
  --card-icon-color:    #6EE7B7;
}

/* ── Icon ── */
.ta-svc__icon {
  width: 48px; height: 48px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.4rem;
  background: var(--card-icon-bg, rgba(124,58,237,0.12));
  color: var(--card-icon-color, #A78BFA);
  margin-bottom: 1.25rem;
  flex-shrink: 0;
  transition: transform 0.3s var(--ta-ease-spring, cubic-bezier(0.34,1.56,0.64,1));
}

.ta-svc__card:hover .ta-svc__icon { transform: scale(1.1) rotate(-4deg); }

/* ── Title ── */
.ta-svc__card-title {
  font-family: var(--ta-font-display, 'Plus Jakarta Sans', sans-serif);
  font-size: 1.05rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--ta-text-primary, #F8F8FF);
  margin: 0 0 0.6rem;
}

html[data-theme="light"] .ta-svc__card-title { color: #1A1A2E; }

/* ── Description ── */
.ta-svc__card-desc {
  font-size: 0.875rem;
  line-height: 1.65;
  color: var(--ta-text-secondary, rgba(248,248,255,0.5));
  margin: 0 0 1.25rem;
}

html[data-theme="light"] .ta-svc__card-desc { color: #52526B; }

/* ── Arrow link ── */
.ta-svc__card-link {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--card-icon-color, #A78BFA);
  text-decoration: none;
  transition: gap 0.2s ease, opacity 0.2s ease;
  opacity: 0.7;
}

.ta-svc__card-link:hover { gap: 0.6rem; opacity: 1; }

.ta-svc__card-link svg {
  width: 14px; height: 14px;
  flex-shrink: 0;
}

/* ── Scroll reveal ── */
.ta-svc__card {
  opacity: 0;
  transform: translateY(24px);
  transition:
    opacity 0.6s cubic-bezier(0.22,1,0.36,1),
    transform 0.6s cubic-bezier(0.22,1,0.36,1),
    border-color 0.3s ease,
    box-shadow 0.3s ease;
}

.ta-svc__card.ta-is-visible {
  opacity: 1;
  transform: translateY(0);
}

@media (prefers-reduced-motion: reduce) {
  .ta-svc__card { opacity: 1 !important; transform: none !important; }
}
</style>

<section
  class="ta-svc"
  style="
    --svc-pt: {{ section.settings.padding_top }}px;
    --svc-pb: {{ section.settings.padding_bottom }}px;
    --svc-cols: {{ section.settings.columns }};
  "
>
  <div class="ta-svc__inner">

    {%- if section.settings.eyebrow != blank or section.settings.title != blank -%}
      <div class="ta-svc__hdr ta-animate ta-animate-fade-up">
        {%- if section.settings.eyebrow != blank -%}
          <div class="ta-svc__eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="ta-svc__title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="ta-svc__desc">{{ section.settings.description }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="ta-svc__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'service' -%}
          <div
            class="ta-svc__card"
            data-glow="{{ block.settings.glow_color }}"
            style="transition-delay: {{ forloop.index0 | times: 0.08 }}s;"
            {{ block.shopify_attributes }}
          >
            <!-- Cursor spotlight -->
            <div class="ta-svc__spotlight"></div>

            {%- if block.settings.icon != blank -%}
              <div class="ta-svc__icon">{{ block.settings.icon }}</div>
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              <h3 class="ta-svc__card-title">{{ block.settings.title }}</h3>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <p class="ta-svc__card-desc">{{ block.settings.description }}</p>
            {%- endif -%}

            {%- if block.settings.link_label != blank and block.settings.link_url != blank -%}
              <a href="{{ block.settings.link_url }}" class="ta-svc__card-link">
                {{ block.settings.link_label }}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

<script>
(function () {
  /* Scroll reveal */
  var cards = document.querySelectorAll('.ta-svc__card');
  if (!cards.length) return;

  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) { e.target.classList.add('ta-is-visible'); io.unobserve(e.target); }
    });
  }, { threshold: 0.1 });
  cards.forEach(function (c) { io.observe(c); });

  /* Spotlight follow */
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  cards.forEach(function (card) {
    var spot = card.querySelector('.ta-svc__spotlight');
    if (!spot) return;
    card.addEventListener('mousemove', function (e) {
      var r = card.getBoundingClientRect();
      spot.style.left = (e.clientX - r.left) + 'px';
      spot.style.top  = (e.clientY - r.top)  + 'px';
    }, { passive: true });
  });
})();
</script>

{% schema %}
{
  "name": "Services Cards",
  "tag": "section",
  "class": "section-services-cards",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "What We Do"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Services built for data-driven growth"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns (desktop)",
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 88
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service Card",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "📊"
        },
        {
          "type": "select",
          "id": "glow_color",
          "label": "Glow colour",
          "options": [
            { "value": "purple", "label": "Purple" },
            { "value": "cyan",   "label": "Cyan"   },
            { "value": "blue",   "label": "Blue"   },
            { "value": "green",  "label": "Green"  },
            { "value": "accent", "label": "Yellow" }
          ],
          "default": "purple"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Data Consulting"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "We embed with your team to identify data opportunities and build a roadmap for measurable growth."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Services Cards",
      "blocks": [
        { "type": "service", "settings": { "icon": "📊", "glow_color": "purple", "title": "Data Consulting & Analytics", "description": "We embed with your team to identify data opportunities and build a roadmap for measurable growth.", "link_label": "Learn more" } },
        { "type": "service", "settings": { "icon": "📐", "glow_color": "cyan",   "title": "BI Platform Development",    "description": "Custom dashboards, KPI frameworks and automated reporting systems tailored to your business.", "link_label": "Learn more" } },
        { "type": "service", "settings": { "icon": "🤖", "glow_color": "blue",   "title": "AI & Predictive Insights",   "description": "From demand forecasting to customer segmentation — we turn your data into forward-looking intelligence.", "link_label": "Learn more" } },
        { "type": "service", "settings": { "icon": "🎨", "glow_color": "green",  "title": "Creative Digital Services",  "description": "Brand strategy, content production and digital marketing informed by data and audience insights.", "link_label": "Learn more" } },
        { "type": "service", "settings": { "icon": "🧭", "glow_color": "accent", "title": "Growth Advisory",            "description": "Senior-level strategic counsel to help you scale with confidence, clarity and the right KPIs.", "link_label": "Learn more" } },
        { "type": "service", "settings": { "icon": "📦", "glow_color": "purple", "title": "Digital Products",           "description": "Templates, tools and training programmes that help your team become self-sufficient with data.", "link_label": "Learn more" } }
      ]
    }
  ]
}
{% endschema %}
