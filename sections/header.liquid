    0 0 12px rgba(227, 252, 2, 1),       /* Brighter inner */
    0 0 24px rgba(227, 252, 2, 0.8),     /* Brighter mid */
    0 0 48px rgba(227, 252, 2, 0.6),     /* Brighter outer */
