    <!-- Icons -->
    <div class="header__icons">
      <details-modal class="header__search">
        <details id="searchDetails">
          <summary class="search-pill-trigger">
            <span class="header__icon">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
            </span>
          </summary>
          <div class="search-pill-expanded">
            <form action="{{ routes.search_url }}" method="get" class="search-pill">
              <!-- Search icon (always visible) -->
              <span class="header__icon">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
              </span>
              <!-- Expanding input field -->
              <input 
                type="search" 
                name="q" 
                class="search-pill__input" 
                placeholder="Search products, services..." 
                autocomplete="off"
                id="searchInput"
              >
              <!-- Submit button (appears when expanded) -->
              <button type="submit" class="search-pill__submit" aria-label="Search">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                </svg>
              </button>
            </form>
          </div>
        </details>
      </details-modal>

      {%- if shop.customer_accounts_enabled -%}
        <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}#auth-modal{%- endif -%}" 
           class="header__icon header__icon--account" 
           {%- unless customer -%}onclick="openAuthModal(event)"{%- endunless -%}>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
        </a>
      {%- endif -%}

      <!-- Dark / Light mode toggle -->
      <button
        class="ta-theme-toggle header__icon"
        data-ta-theme-toggle
        aria-label="Toggle color theme"
