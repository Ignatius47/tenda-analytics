{% comment %}
  Renders cart drawer - Tenda Clean Version with M-Pesa STK Push
  
  Usage:
  {% render 'cart-drawer' %}
{% endcomment %}

{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

<style>
  /* ===================================
     TENDA CART DRAWER - CLEAN VERSION
     =================================== */

  :root {
    --tenda-accent: #E3FC02;
    --tenda-dark: #121212;
    --tenda-black: #000000;
    --tenda-charcoal: #1a1a1a;
    --tenda-border: rgba(227, 252, 2, 0.1);
    --tenda-border-hover: rgba(227, 252, 2, 0.3);
  }

  .drawer {
    visibility: hidden;
  }

  /* Cart Drawer Container */
  .cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 500px;
    z-index: 1000;
    transform: translateX(100%);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .cart-drawer.active {
    transform: translateX(0);
  }

  /* Overlay */
  .cart-drawer__overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(10px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
    z-index: 999;
  }

  cart-drawer.active .cart-drawer__overlay {
    opacity: 1;
    pointer-events: all;
  }

  /* Drawer Inner */
  .drawer__inner {
    position: relative;
    width: 100%;
    height: 100%;
    background: var(--tenda-dark) !important;
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--tenda-border);
    box-shadow: -10px 0 40px rgba(0, 0, 0, 0.5);
  }

  /* Header */
  .drawer__header {
    padding: 2rem 1.5rem;
    border-bottom: 1px solid var(--tenda-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--tenda-charcoal);
  }

  .drawer__heading {
    font-size: 1.5rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .drawer__close {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: transparent;
    border: 1px solid var(--tenda-border);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    color: rgba(255, 255, 255, 0.6);
  }

  .drawer__close:hover {
    background: rgba(227, 252, 2, 0.1);
    border-color: var(--tenda-accent);
    color: var(--tenda-accent);
    transform: rotate(90deg);
  }

  .drawer__close svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  /* Cart Items Container */
  .drawer__contents {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
  }

  /* Custom Scrollbar */
  .drawer__contents::-webkit-scrollbar {
    width: 6px;
  }

  .drawer__contents::-webkit-scrollbar-track {
    background: rgba(227, 252, 2, 0.05);
  }

  .drawer__contents::-webkit-scrollbar-thumb {
    background: var(--tenda-accent);
    border-radius: 3px;
  }

  /* Cart Items Table */
  .cart-items {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 1rem;
  }

  .cart-items thead {
    display: none;
  }

  /* Cart Item Row */
  .cart-item {
    background: var(--tenda-charcoal);
    border: 1px solid var(--tenda-border);
    border-radius: 16px;
    transition: all 0.3s ease;
    display: flex;
    gap: 1rem;
    padding: 1rem;
  }

  .cart-item:hover {
    border-color: var(--tenda-border-hover);
    box-shadow: 0 0 20px rgba(227, 252, 2, 0.1);
  }

  /* Cart Item Media */
  .cart-item__media {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    border-radius: 12px;
    overflow: hidden;
    background: var(--tenda-dark);
    border: 1px solid var(--tenda-border);
  }

  .cart-item__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Cart Item Details */
  .cart-item__details {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cart-item__name {
    font-size: 1rem;
    font-weight: 600;
    color: #ffffff;
    margin: 0;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .cart-item__name:hover {
    color: var(--tenda-accent);
  }

  .product-option,
  .cart-item__old-price,
  .cart-item__final-price {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .cart-item__old-price {
    text-decoration: line-through;
    color: rgba(255, 255, 255, 0.4);
  }

  .cart-item__final-price {
    color: var(--tenda-accent);
    font-weight: 700;
  }

  /* Cart Item Totals */
  .cart-item__totals {
    text-align: right;
  }

  .price {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--tenda-accent);
  }

  /* Quantity Controls */
  .cart-item__quantity {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-end;
  }

  .quantity-popover-wrapper {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .quantity {
    display: flex;
    align-items: center;
    background: var(--tenda-dark);
    border: 1px solid var(--tenda-border);
    border-radius: 8px;
    overflow: hidden;
  }

  .quantity__button {
    width: 32px;
    height: 32px;
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.6);
    transition: all 0.3s ease;
  }

  .quantity__button:hover {
    background: rgba(227, 252, 2, 0.1);
    color: var(--tenda-accent);
  }

  .quantity__button svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  .quantity__input {
    width: 40px;
    height: 32px;
    text-align: center;
    border: none;
    background: transparent;
    color: #ffffff;
    font-weight: 600;
    font-size: 0.875rem;
  }

  .quantity__input:focus {
    outline: none;
  }

  /* Remove Button */
  .cart-remove-button {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: transparent;
    border: 1px solid rgba(255, 59, 48, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    color: rgba(255, 59, 48, 0.6);
  }

  .cart-remove-button:hover {
    background: rgba(255, 59, 48, 0.1);
    border-color: rgba(255, 59, 48, 0.6);
    color: rgba(255, 59, 48, 1);
  }

  .cart-remove-button svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  /* Footer */
  .drawer__footer {
    padding: 1.5rem;
    border-top: 1px solid var(--tenda-border);
    background: var(--tenda-charcoal);
  }

  /* Totals */
  .totals {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding: 1rem;
    background: var(--tenda-dark);
    border: 1px solid var(--tenda-border);
    border-radius: 12px;
  }

  .totals__total {
    font-size: 1.125rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
  }

  .totals__total-value {
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--tenda-accent);
    margin: 0;
  }

  /* Tax Note */
  .tax-note {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.5);
    margin: 0.5rem 0 1.5rem;
    line-height: 1.5;
  }

  /* ===================================
     M-PESA PAYMENT SECTION
     =================================== */

  .payment-methods {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  /* M-Pesa Button (Primary) */
  .mpesa-button {
    width: 100%;
    padding: 1.25rem;
    background: var(--tenda-accent);
    color: var(--tenda-black);
    border: none;
    border-radius: 12px;
    font-size: 1.125rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    box-shadow: 0 4px 20px rgba(227, 252, 2, 0.3);
    position: relative;
    overflow: hidden;
  }

  .mpesa-button::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    transform: translate(-50%, -50%);
    transition: width 0.6s ease, height 0.6s ease;
  }

  .mpesa-button:hover::before {
    width: 400px;
    height: 400px;
  }

  .mpesa-button:hover {
    background: #ffffff;
    box-shadow: 0 8px 30px rgba(227, 252, 2, 0.5);
    transform: translateY(-2px);
  }

  .mpesa-button span {
    position: relative;
    z-index: 1;
  }

  .mpesa-logo {
    width: 24px;
    height: 24px;
    position: relative;
    z-index: 1;
  }

  /* Standard Checkout Button */
  .cart__checkout-button {
    width: 100%;
    padding: 1rem;
    background: transparent;
    color: #ffffff;
    border: 2px solid var(--tenda-border);
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .cart__checkout-button:hover {
    background: rgba(227, 252, 2, 0.1);
    border-color: var(--tenda-accent);
    color: var(--tenda-accent);
  }

  /* ===================================
     M-PESA STK PUSH MODAL
     =================================== */

  .mpesa-modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(20px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .mpesa-modal.active {
    opacity: 1;
    pointer-events: all;
  }

  .mpesa-modal__content {
    width: 90%;
    max-width: 450px;
    background: var(--tenda-dark);
    border: 1px solid var(--tenda-border);
    border-radius: 16px;
    padding: 2rem;
    transform: scale(0.9);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .mpesa-modal.active .mpesa-modal__content {
    transform: scale(1);
  }

  .mpesa-modal__header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .mpesa-modal__title {
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--tenda-accent);
    margin: 0 0 0.5rem;
    text-transform: uppercase;
  }

  .mpesa-modal__subtitle {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.6);
    margin: 0;
  }

  /* Phone Input */
  .mpesa-input-group {
    margin-bottom: 1.5rem;
  }

  .mpesa-input-label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .mpesa-input {
    width: 100%;
    padding: 1rem;
    background: var(--tenda-charcoal);
    border: 1px solid var(--tenda-border);
    border-radius: 12px;
    color: #ffffff;
    font-size: 1.125rem;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .mpesa-input:focus {
    outline: none;
    border-color: var(--tenda-accent);
    box-shadow: 0 0 0 3px rgba(227, 252, 2, 0.1);
  }

  .mpesa-input::placeholder {
    color: rgba(255, 255, 255, 0.3);
  }

  /* Progress Bar */
  .mpesa-progress {
    margin: 1.5rem 0;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .mpesa-progress.active {
    opacity: 1;
  }

  .mpesa-progress__label {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 0.5rem;
    text-align: center;
  }

  .mpesa-progress__bar {
    width: 100%;
    height: 4px;
    background: rgba(227, 252, 2, 0.2);
    border-radius: 2px;
    overflow: hidden;
    position: relative;
  }

  .mpesa-progress__fill {
    height: 100%;
    background: var(--tenda-accent);
    width: 0%;
    transition: width 0.3s ease;
    box-shadow: 0 0 10px var(--tenda-accent);
    animation: pulse 1.5s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% {
      box-shadow: 0 0 10px var(--tenda-accent);
    }
    50% {
      box-shadow: 0 0 20px var(--tenda-accent);
    }
  }

  /* Modal Buttons */
  .mpesa-modal__actions {
    display: flex;
    gap: 0.75rem;
  }

  .mpesa-modal__button {
    flex: 1;
    padding: 1rem;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
    border: none;
  }

  .mpesa-modal__button--primary {
    background: var(--tenda-accent);
    color: var(--tenda-black);
  }

  .mpesa-modal__button--primary:hover {
    background: #ffffff;
    box-shadow: 0 4px 20px rgba(227, 252, 2, 0.4);
  }

  .mpesa-modal__button--secondary {
    background: transparent;
    color: rgba(255, 255, 255, 0.6);
    border: 1px solid var(--tenda-border);
  }

  .mpesa-modal__button--secondary:hover {
    background: rgba(255, 255, 255, 0.05);
    color: #ffffff;
  }

  /* ===================================
     EMPTY STATE
     =================================== */

  .drawer__inner-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 2rem;
    text-align: center;
  }

  .cart__empty-text {
    font-size: 1.5rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 2rem;
  }

  .cart-drawer__empty-content .button {
    background: var(--tenda-accent);
    color: var(--tenda-black);
    padding: 1rem 2rem;
    border-radius: 12px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    display: inline-block;
    transition: all 0.3s ease;
  }

  .cart-drawer__empty-content .button:hover {
    background: #ffffff;
    box-shadow: 0 4px 20px rgba(227, 252, 2, 0.4);
    transform: translateY(-2px);
  }

  /* ===================================
     MOBILE OPTIMIZATION
     =================================== */

  @media screen and (max-width: 749px) {
    .cart-drawer {
      max-width: 100%;
    }

    .drawer__header {
      padding: 1.5rem 1rem;
    }

    .drawer__heading {
      font-size: 1.25rem;
    }

    .drawer__contents {
      padding: 1rem;
    }

    .cart-item {
      padding: 0.75rem;
    }

    .cart-item__media {
      width: 60px;
      height: 60px;
    }

    .totals__total {
      font-size: 1rem;
    }

    .totals__total-value {
      font-size: 1.25rem;
    }

    .mpesa-button {
      padding: 1rem;
      font-size: 1rem;
    }

    .mpesa-modal__content {
      width: 95%;
      padding: 1.5rem;
    }
  }

  /* Fixed Bottom Sheet on Mobile */
  @media screen and (max-width: 749px) {
    .drawer__footer {
      position: sticky;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 100;
      box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.5);
    }
  }

  /* ===================================
     CART COUNT BADGE (HEADER)
     =================================== */

  .cart-count-bubble {
    position: absolute;
    top: -8px;
    right: -8px;
    min-width: 20px;
    height: 20px;
    background: var(--tenda-accent);
    color: var(--tenda-black);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 900;
    padding: 0 6px;
    box-shadow: 0 2px 8px rgba(227, 252, 2, 0.4);
  }

  /* Discounts */
  .discounts {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0;
  }

  .discounts__discount {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: rgba(227, 252, 2, 0.8);
    font-size: 0.875rem;
    margin-bottom: 0.25rem;
  }

  .discounts__discount svg {
    width: 16px;
    height: 16px;
    fill: var(--tenda-accent);
  }
</style>

<cart-drawer class="drawer{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>
    <div
      class="drawer__inner gradient color-{{ settings.cart_color_scheme }}"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.cart.title' | t }}"
      tabindex="-1"
    >
      {%- if cart == empty -%}
        <div class="drawer__inner-empty">
          <div class="cart-drawer__warnings center">
            <div class="cart-drawer__empty-content">
              <h2 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h2>
              <button
                class="drawer__close"
                type="button"
                onclick="this.closest('cart-drawer').close()"
                aria-label="{{ 'accessibility.close' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button>
              <a href="{{ routes.all_products_collection_url }}" class="button">
                Discover Products
              </a>
            </div>
          </div>
        </div>
      {%- endif -%}

      <div class="drawer__header">
        <h2 class="drawer__heading">Your Cart</h2>
        <button
          class="drawer__close"
          type="button"
          onclick="this.closest('cart-drawer').close()"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </span>
        </button>
      </div>

      <cart-drawer-items{% if cart == empty %} class="is-empty"{% endif %}>
        <form
          action="{{ routes.cart_url }}"
          id="CartDrawer-Form"
          class="cart__contents cart-drawer__form"
          method="post"
        >
          <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
            {%- if cart != empty -%}
              <div class="drawer__cart-items-wrapper">
                <table class="cart-items" role="table">
                  <tbody role="rowgroup">
                    {%- for item in cart.items -%}
                      <tr class="cart-item" role="row">
                        <td class="cart-item__media">
                          {% if item.image %}
                            <a href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                              <img
                                class="cart-item__image"
                                src="{{ item.image | image_url: width: 300 }}"
                                alt="{{ item.image.alt | escape }}"
                                loading="lazy"
                                width="80"
                                height="80"
                              >
                            </a>
                          {% endif %}
                        </td>

                        <td class="cart-item__details">
                          <a href="{{ item.url }}" class="cart-item__name h4">
                            {{- item.product.title | escape -}}
                          </a>

                          {%- if item.original_price != item.final_price -%}
                            <div class="cart-item__discounted-prices">
                              <s class="cart-item__old-price">{{ item.original_price | money }}</s>
                              <strong class="cart-item__final-price">{{ item.final_price | money }}</strong>
                            </div>
                          {%- else -%}
                            <div class="product-option">{{ item.original_price | money }}</div>
                          {%- endif -%}

                          {%- if item.product.has_only_default_variant == false -%}
                            {%- for option in item.options_with_values -%}
                              <div class="product-option">
                                {{ option.name }}: {{ option.value }}
                              </div>
                            {%- endfor -%}
                          {%- endif -%}

                          <ul class="discounts list-unstyled">
                            {%- for discount in item.line_level_discount_allocations -%}
                              <li class="discounts__discount">
                                {{- 'icon-discount.svg' | inline_asset_content -}}
                                {{ discount.discount_application.title }}
                              </li>
                            {%- endfor -%}
                          </ul>
                        </td>

                        <td class="cart-item__totals">
                          <span class="price">{{ item.final_line_price | money }}</span>
                        </td>

                        <td class="cart-item__quantity">
                          <quantity-popover>
                            <div class="quantity-popover-wrapper">
                              <quantity-input class="quantity cart-quantity">
                                <button class="quantity__button" name="minus" type="button">
                                  <span class="svg-wrapper">
                                    {{- 'icon-minus.svg' | inline_asset_content -}}
                                  </span>
                                </button>
                                <input
                                  class="quantity__input"
                                  type="number"
                                  name="updates[]"
                                  value="{{ item.quantity }}"
                                  min="0"
                                  aria-label="Quantity"
                                  id="Drawer-quantity-{{ item.index | plus: 1 }}"
                                  data-index="{{ item.index | plus: 1 }}"
                                >
                                <button class="quantity__button" name="plus" type="button">
                                  <span class="svg-wrapper">
                                    {{- 'icon-plus.svg' | inline_asset_content -}}
                                  </span>
                                </button>
                              </quantity-input>

                              <cart-remove-button
                                id="CartDrawer-Remove-{{ item.index | plus: 1 }}"
                                data-index="{{ item.index | plus: 1 }}"
                              >
                                <button
                                  type="button"
                                  class="cart-remove-button"
                                  aria-label="Remove {{ item.title | escape }}"
                                  data-variant-id="{{ item.variant.id }}"
                                >
                                  <span class="svg-wrapper">
                                    {{- 'icon-remove.svg' | inline_asset_content -}}
                                  </span>
                                </button>
                              </cart-remove-button>
                            </div>
                          </quantity-popover>
                        </td>
                      </tr>
                    {%- endfor -%}
                  </tbody>
                </table>
              </div>
            {%- endif -%}
          </div>
        </form>
      </cart-drawer-items>

      <div class="drawer__footer">
        {%- if cart.cart_level_discount_allocations.size > 0 -%}
          <ul class="discounts list-unstyled">
            {%- for discount in cart.cart_level_discount_allocations -%}
              <li class="discounts__discount">
                {{- 'icon-discount.svg' | inline_asset_content -}}
                {{ discount.title | escape }} (-{{ discount.total_allocated_amount | money }})
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="totals">
          <h2 class="totals__total">Total</h2>
          <p class="totals__total-value">{{ cart.total_price | money_with_currency }}</p>
        </div>

        <small class="tax-note">
          {%- if cart.taxes_included -%}
            Taxes included. Shipping calculated at checkout.
          {%- else -%}
            Taxes and shipping calculated at checkout.
          {%- endif -%}
        </small>

        <!-- Payment Methods -->
        <div class="payment-methods">
          <!-- M-Pesa Button (Primary) -->
          <button
            type="button"
            class="mpesa-button"
            id="mpesaButton"
            {% if cart == empty %}disabled{% endif %}
          >
            <svg class="mpesa-logo" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z"/>
            </svg>
            <span>Pay with M-Pesa</span>
          </button>

          <!-- Standard Checkout -->
          <button
            type="submit"
            class="cart__checkout-button"
            name="checkout"
            form="CartDrawer-Form"
            {% if cart == empty %}disabled{% endif %}
          >
            Other Payment Methods
          </button>
        </div>
      </div>
    </div>
  </div>
</cart-drawer>

<!-- M-Pesa STK Push Modal -->
<div class="mpesa-modal" id="mpesaModal">
  <div class="mpesa-modal__content">
    <div class="mpesa-modal__header">
      <h3 class="mpesa-modal__title">M-Pesa Payment</h3>
      <p class="mpesa-modal__subtitle">Enter your phone number to complete payment</p>
    </div>

    <div class="mpesa-input-group">
      <label class="mpesa-input-label" for="mpesaPhone">Phone Number</label>
      <input
        type="tel"
        id="mpesaPhone"
        class="mpesa-input"
        placeholder="254712345678"
        pattern="[0-9]{12}"
        maxlength="12"
      >
    </div>

    <div class="mpesa-progress" id="mpesaProgress">
      <p class="mpesa-progress__label">Waiting for PIN entry on your phone...</p>
      <div class="mpesa-progress__bar">
        <div class="mpesa-progress__fill" id="mpesaProgressFill"></div>
      </div>
    </div>

    <div class="mpesa-modal__actions">
      <button
        type="button"
        class="mpesa-modal__button mpesa-modal__button--secondary"
        id="mpesaCancelButton"
      >
        Cancel
      </button>
      <button
        type="button"
        class="mpesa-modal__button mpesa-modal__button--primary"
        id="mpesaSubmitButton"
      >
        Send Request
      </button>
    </div>
  </div>
</div>

<script>
  /* ===================================
     M-PESA STK PUSH INTEGRATION
     =================================== */

  document.addEventListener('DOMContentLoaded', function() {
    const mpesaButton = document.getElementById('mpesaButton');
    const mpesaModal = document.getElementById('mpesaModal');
    const mpesaPhone = document.getElementById('mpesaPhone');
    const mpesaSubmitButton = document.getElementById('mpesaSubmitButton');
    const mpesaCancelButton = document.getElementById('mpesaCancelButton');
    const mpesaProgress = document.getElementById('mpesaProgress');
    const mpesaProgressFill = document.getElementById('mpesaProgressFill');

    // Open M-Pesa Modal
    if (mpesaButton) {
      mpesaButton.addEventListener('click', function() {
        mpesaModal.classList.add('active');
        mpesaPhone.focus();
      });
    }

    // Close M-Pesa Modal
    if (mpesaCancelButton) {
      mpesaCancelButton.addEventListener('click', function() {
        mpesaModal.classList.remove('active');
        mpesaProgress.classList.remove('active');
        mpesaProgressFill.style.width = '0%';
        mpesaPhone.value = '';
      });
    }

    // Submit M-Pesa Payment
    if (mpesaSubmitButton) {
      mpesaSubmitButton.addEventListener('click', function() {
        const phone = mpesaPhone.value.trim();

        // Validate phone number
        if (!phone || phone.length !== 12 || !phone.startsWith('254')) {
          alert('Please enter a valid phone number (254XXXXXXXXX)');
          return;
        }

        // Show progress
        mpesaProgress.classList.add('active');
        mpesaSubmitButton.disabled = true;
        mpesaSubmitButton.textContent = 'Processing...';

        // Simulate progress bar
        let progress = 0;
        const progressInterval = setInterval(() => {
          progress += 10;
          mpesaProgressFill.style.width = progress + '%';

          if (progress >= 100) {
            clearInterval(progressInterval);
            mpesaProgressFill.style.width = '0%';
          }
        }, 500);

        // Call Daraja API (Replace with actual backend endpoint)
        fetch('/apps/mpesa/stk-push', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            phone: phone,
            amount: {{ cart.total_price | divided_by: 100.0 }},
            reference: 'CART-{{ cart.token }}',
          }),
        })
          .then(response => response.json())
          .then(data => {
            clearInterval(progressInterval);

            if (data.success) {
              // Success - redirect or show confirmation
              alert('Payment request sent! Please enter your M-Pesa PIN on your phone.');
              
              // Poll for payment confirmation
              checkPaymentStatus(data.checkoutRequestID);
            } else {
              // Error
              alert('Payment request failed: ' + data.message);
              mpesaSubmitButton.disabled = false;
              mpesaSubmitButton.textContent = 'Send Request';
              mpesaProgress.classList.remove('active');
            }
          })
          .catch(error => {
            clearInterval(progressInterval);
            console.error('M-Pesa Error:', error);
            alert('Payment request failed. Please try again.');
            mpesaSubmitButton.disabled = false;
            mpesaSubmitButton.textContent = 'Send Request';
            mpesaProgress.classList.remove('active');
          });
      });
    }

    // Check Payment Status
    function checkPaymentStatus(checkoutRequestID) {
      const statusInterval = setInterval(() => {
        fetch('/apps/mpesa/check-status', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            checkoutRequestID: checkoutRequestID,
          }),
        })
          .then(response => response.json())
          .then(data => {
            if (data.status === 'completed') {
              clearInterval(statusInterval);
              mpesaModal.classList.remove('active');
              alert('Payment successful! Redirecting to confirmation...');
              window.location.href = '/checkout/thank-you';
            } else if (data.status === 'failed') {
              clearInterval(statusInterval);
              alert('Payment failed or cancelled.');
              mpesaSubmitButton.disabled = false;
              mpesaSubmitButton.textContent = 'Send Request';
              mpesaProgress.classList.remove('active');
            }
          })
          .catch(error => {
            clearInterval(statusInterval);
            console.error('Status Check Error:', error);
          });
      }, 3000); // Check every 3 seconds

      // Timeout after 60 seconds
      setTimeout(() => {
        clearInterval(statusInterval);
      }, 60000);
    }

    // Close modal on overlay click
    if (mpesaModal) {
      mpesaModal.addEventListener('click', function(e) {
        if (e.target === mpesaModal) {
          mpesaModal.classList.remove('active');
          mpesaProgress.classList.remove('active');
          mpesaProgressFill.style.width = '0%';
        }
      });
    }
  });
</script>