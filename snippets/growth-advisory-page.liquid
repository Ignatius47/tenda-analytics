<script>
// =========================================
// PARALLAX GRAIN SCROLLING
// =========================================
document.addEventListener('DOMContentLoaded', function() {
  const grain = document.getElementById('gaParallaxGrain');
  
  if (grain) {
    let ticking = false;
    
    window.addEventListener('scroll', function() {
      if (!ticking) {
        window.requestAnimationFrame(function() {
          const scrollY = window.pageYOffset;
          // Move grain at 40% speed of scroll for depth effect
          grain.style.transform = `translateY(${scrollY * 0.4}px)`;
          ticking = false;
        });
        ticking = true;
      }
    });
  }

  // =========================================
  // SCROLL REVEAL FOR PILLAR CARDS
  // =========================================
  const observerOptions = {
    threshold: 0.15,
    rootMargin: '0px 0px -50px 0px'
  };

  const revealObserver = new IntersectionObserver(function(entries) {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        // Optionally unobserve after reveal
        // revealObserver.unobserve(entry.target);
      }
    });
  }, observerOptions);

  // Observe all cards with data-scroll-reveal
  document.querySelectorAll('[data-scroll-reveal]').forEach(card => {
    revealObserver.observe(card);
  });

  // =========================================
  // FLOATING CONTACT BUTTON TRIGGER
  // =========================================
  const floatingBtn = document.querySelector('.ga-floating-contact');
  const heroSection = document.querySelector('.ga-hero');
  
  if (floatingBtn && heroSection) {
    window.addEventListener('scroll', function() {
      const heroBottom = heroSection.offsetTop + heroSection.offsetHeight;
      const scrollPos = window.pageYOffset + window.innerHeight;
      
      // Show button once user scrolls past hero section
      if (scrollPos > heroBottom + 200) {
        floatingBtn.classList.add('is-visible');
      } else {
        floatingBtn.classList.remove('is-visible');
      }
    }, { passive: true });
  }

  // =========================================
  // MAGNETIC HOVER EFFECT ON PILLAR CARDS
  // =========================================
  const magneticCards = document.querySelectorAll('[data-magnetic]');
  
  magneticCards.forEach(card => {
    card.addEventListener('mousemove', function(e) {
      const rect = this.getBoundingClientRect();
      const x = e.clientX - rect.left - rect.width / 2;
      const y = e.clientY - rect.top - rect.height / 2;
      
      // Magnetic pull intensity: 12% of cursor offset for gentle lean
      const moveX = x * 0.12;
      const moveY = y * 0.12;
      
      // Apply magnetic shift to entire card
      this.style.transform = `translate(${moveX}px, ${moveY}px)`;
    });
    
    card.addEventListener('mouseleave', function() {
      // Reset position smoothly
      this.style.transform = '';
    });
  });
});
</script>