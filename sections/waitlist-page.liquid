{% comment %}
  Tenda OS Waitlist - Multi-Layered Interactive Experience
  Cinematic header + Interactive form + Feature pillars
{% endcomment %}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Join the Queue - Tenda OS</title>
  
  <!-- Lenis Smooth Scroll -->
  <script src="https://cdn.jsdelivr.net/gh/studio-freight/lenis@1.0.29/bundled/lenis.min.js"></script>
  
  <!-- GSAP + ScrollTrigger -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
  
  <!-- Three.js for 3D Sphere -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  
  <style>
    /* ===================================
       RESET & FOUNDATION
       =================================== */
    
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    html, body {
      width: 100%;
      overflow-x: hidden;
      background: #000000;
      color: #ffffff;
      font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    
    /* Custom scrollbar */
    ::-webkit-scrollbar {
      width: 10px;
    }
    
    ::-webkit-scrollbar-track {
      background: #000000;
    }
    
    ::-webkit-scrollbar-thumb {
      background: #E3FC02;
      border-radius: 10px;
    }
    
    /* ===================================
       HEADER TRANSPARENCY ON SCROLL
       =================================== */
    
    .shopify-section-header,
    header {
      position: fixed !important;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 9999;
      transition: opacity 0.6s ease, transform 0.6s ease;
    }
    
    .shopify-section-header.scrolled,
    header.scrolled {
      opacity: 0.3;
    }
    
    /* ===================================
       MAIN CONTAINER
       =================================== */
    
    .waitlist-page {
      width: 100%;
      min-height: 100vh;
      position: relative;
      background: #000000;
    }
    
    /* ===================================
       SECTION 1: CINEMATIC HEADER
       =================================== */
    
    .cinematic-header {
      position: relative;
      width: 100%;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      padding: 8rem 2rem 4rem;
    }
    
    /* 3D Sphere Background */
    #nebulaSphere {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100vh;
      z-index: 1;
      opacity: 0.5;
      transition: all 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    
    #nebulaSphere.swallow {
      transform: scale(2);
      opacity: 0;
    }
    
    /* Headline Container */
    .cinematic-content {
      position: relative;
      z-index: 10;
      text-align: center;
      max-width: 1200px;
      opacity: 0;
      animation: cinematicFadeIn 2s cubic-bezier(0.16, 1, 0.3, 1) 0.5s forwards;
    }
    
    @keyframes cinematicFadeIn {
      0% { opacity: 0; transform: translateY(40px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    
    .cinematic-headline {
      font-size: clamp(3rem, 8vw, 7rem);
      font-weight: 900;
      line-height: 1.05;
      letter-spacing: -0.06em;
      margin-bottom: 2.5rem;
      background: linear-gradient(180deg, #ffffff 0%, #888888 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', sans-serif;
      font-stretch: condensed;
    }
    
    .cinematic-subheadline {
      font-size: clamp(1.25rem, 2.5vw, 1.875rem);
      font-weight: 400;
      color: rgba(255, 255, 255, 0.65);
      line-height: 1.6;
      max-width: 800px;
      margin: 0 auto 4rem;
    }
    
    /* Scroll Indicator */
    .scroll-hint {
      position: absolute;
      bottom: 4rem;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      opacity: 0;
      animation: scrollHintFadeIn 1s ease 2.5s forwards;
    }
    
    @keyframes scrollHintFadeIn {
      to { opacity: 1; }
    }
    
    .scroll-hint-text {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 2.5px;
      color: rgba(255, 255, 255, 0.5);
    }
    
    .scroll-hint-arrow {
      width: 2px;
      height: 50px;
      background: linear-gradient(180deg, transparent, #E3FC02);
      animation: scrollBounce 2s ease-in-out infinite;
    }
    
    .scroll-hint-arrow::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 0;
      height: 0;
      border-left: 7px solid transparent;
      border-right: 7px solid transparent;
      border-top: 10px solid #E3FC02;
    }
    
    @keyframes scrollBounce {
      0%, 100% { transform: translateY(0); opacity: 1; }
      50% { transform: translateY(12px); opacity: 0.6; }
    }
    
    /* ===================================
       SECTION 2: INTERACTIVE PRIORITY FORM
       =================================== */
    
    .priority-form-section {
      position: relative;
      width: 100%;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 4rem 2rem;
      z-index: 20;
      background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.8) 50%, rgba(0,0,0,1) 100%);
    }
    
    .form-container {
      width: 100%;
      max-width: 650px;
      opacity: 0;
      transform: translateY(60px);
    }
    
    .form-container.revealed {
      animation: formSlideUp 1.2s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }
    
    @keyframes formSlideUp {
      0% { opacity: 0; transform: translateY(60px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    
    /* Form Header */
    .form-header {
      text-align: center;
      margin-bottom: 3rem;
    }
    
    .form-badge {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 0.625rem 1.5rem;
      background: rgba(227, 252, 2, 0.08);
      border: 1.5px solid rgba(227, 252, 2, 0.3);
      border-radius: 100px;
      font-size: 0.8125rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #E3FC02;
      margin-bottom: 2rem;
    }
    
    .form-badge-dot {
      width: 7px;
      height: 7px;
      background: #E3FC02;
      border-radius: 50%;
      animation: badgePulse 2.5s ease-in-out infinite;
      box-shadow: 0 0 10px rgba(227, 252, 2, 0.8);
    }
    
    @keyframes badgePulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.7); }
    }
    
    .form-title {
      font-size: clamp(2.25rem, 5vw, 3.5rem);
      font-weight: 900;
      margin-bottom: 1.25rem;
      letter-spacing: -0.05em;
      background: linear-gradient(180deg, #ffffff 0%, #b0b0b0 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    
    .form-subtitle {
      font-size: 1.1875rem;
      color: rgba(255, 255, 255, 0.6);
      line-height: 1.6;
    }
    
    /* Email Input - Dark Charcoal with Glow */
    .email-input-wrapper {
      position: relative;
      margin-bottom: 1.75rem;
    }
    
    .priority-email-input {
      width: 100%;
      padding: 1.625rem 2rem;
      background: #1a1a1c;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 16px;
      color: #ffffff;
      font-size: 1.125rem;
      font-weight: 500;
      transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.5);
    }
    
    .priority-email-input::placeholder {
      color: rgba(255, 255, 255, 0.3);
    }
    
    .priority-email-input:focus {
      outline: none;
      border-color: #E3FC02;
      box-shadow: 
        0 0 0 4px rgba(227, 252, 2, 0.15),
        0 0 30px rgba(227, 252, 2, 0.3),
        inset 0 2px 8px rgba(0, 0, 0, 0.4);
    }
    
    /* Submit Button */
    .priority-submit-btn {
      width: 100%;
      padding: 1.625rem 3rem;
      background: linear-gradient(135deg, #E3FC02 0%, #c8e800 100%);
      color: #000000;
      border: none;
      border-radius: 16px;
      font-weight: 900;
      font-size: 1.125rem;
      text-transform: uppercase;
      letter-spacing: 2.5px;
      cursor: pointer;
      position: relative;
      overflow: hidden;
      box-shadow: 
        0 14px 45px rgba(227, 252, 2, 0.4),
        inset 0 1px 0 rgba(255, 255, 255, 0.4);
      transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    
    .priority-submit-btn:hover {
      transform: translateY(-4px);
      box-shadow: 
        0 20px 65px rgba(227, 252, 2, 0.6),
        inset 0 1px 0 rgba(255, 255, 255, 0.5);
    }
    
    .priority-submit-btn:active {
      transform: scale(0.98);
    }
    
    /* Ripple Effect on Submit */
    .form-container.ripple::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 0;
      height: 0;
      border-radius: 50%;
      background: rgba(227, 252, 2, 0.3);
      animation: ripplePulse 1.5s ease-out;
    }
    
    @keyframes ripplePulse {
      0% {
        width: 0;
        height: 0;
        opacity: 1;
      }
      100% {
        width: 1000px;
        height: 1000px;
        opacity: 0;
      }
    }
    
    /* "Backed By" Logos Bar */
    .backed-by-section {
      margin-top: 4rem;
      padding-top: 3rem;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }
    
    .backed-by-label {
      text-align: center;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: rgba(255, 255, 255, 0.4);
      margin-bottom: 2rem;
    }
    
    .backed-by-logos {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 3rem;
      flex-wrap: wrap;
    }
    
    .backed-logo {
      width: 120px;
      height: 50px;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0.3;
      filter: grayscale(100%);
      transition: all 0.4s ease;
    }
    
    .backed-logo:hover {
      opacity: 1;
      filter: grayscale(0%);
      transform: scale(1.1);
    }
    
    .backed-logo img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }
    
    /* Success State */
    .success-state {
      display: none;
      text-align: center;
    }
    
    .success-state.active {
      display: block;
      animation: successReveal 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    
    @keyframes successReveal {
      0% { opacity: 0; transform: scale(0.9) translateY(40px); }
      100% { opacity: 1; transform: scale(1) translateY(0); }
    }
    
    .success-icon {
      width: 110px;
      height: 110px;
      background: linear-gradient(135deg, rgba(227, 252, 2, 0.25) 0%, rgba(227, 252, 2, 0.1) 100%);
      border: 2.5px solid rgba(227, 252, 2, 0.5);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 4.5rem;
      margin: 0 auto 2.5rem;
      animation: successCheckmark 1s cubic-bezier(0.34, 1.56, 0.64, 1) 0.4s backwards;
    }
    
    @keyframes successCheckmark {
      0% { opacity: 0; transform: scale(0) rotate(-180deg); }
      60% { transform: scale(1.2) rotate(20deg); }
      100% { opacity: 1; transform: scale(1) rotate(0deg); }
    }
    
    .success-title {
      font-size: 2.75rem;
      font-weight: 900;
      color: #E3FC02;
      margin-bottom: 2rem;
      text-shadow: 0 0 35px rgba(227, 252, 2, 0.6);
    }
    
    .queue-position-display {
      background: rgba(227, 252, 2, 0.06);
      border: 1.5px solid rgba(227, 252, 2, 0.25);
      border-radius: 20px;
      padding: 2.5rem 3rem;
      margin: 2.5rem 0;
    }
    
    .queue-label {
      font-size: 0.9375rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: rgba(255, 255, 255, 0.6);
      margin-bottom: 1.25rem;
    }
    
    .queue-number {
      font-size: 3.5rem;
      font-weight: 900;
      color: #ffffff;
      font-variant-numeric: tabular-nums;
      font-family: 'SF Mono', 'Consolas', monospace;
    }
    
    .queue-number.ticking {
      animation: queueTick 0.35s ease-in-out;
    }
    
    @keyframes queueTick {
      0% { transform: translateY(0); }
      50% { transform: translateY(-8px); opacity: 0.5; }
      100% { transform: translateY(0); }
    }
    
    /* ===================================
       SECTION 3: FEATURE PILLARS
       =================================== */
    
    .feature-pillars-section {
      position: relative;
      width: 100%;
      padding: 8rem 2rem 10rem;
      background: #000000;
      z-index: 20;
    }
    
    .pillars-header {
      text-align: center;
      max-width: 800px;
      margin: 0 auto 6rem;
    }
    
    .pillars-title {
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 900;
      margin-bottom: 1.5rem;
      letter-spacing: -0.04em;
      background: linear-gradient(180deg, #ffffff 0%, #a0a0a0 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    
    .pillars-subtitle {
      font-size: 1.125rem;
      color: rgba(255, 255, 255, 0.6);
      line-height: 1.7;
    }
    
    /* Pillars Grid */
    .pillars-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 2.5rem;
      max-width: 1200px;
      margin: 0 auto;
    }
    
    /* Individual Pillar Card */
    .pillar-card {
      position: relative;
      background: rgba(255, 255, 255, 0.02);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 24px;
      padding: 3rem 2.5rem;
      transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
      overflow: hidden;
      cursor: pointer;
    }
    
    /* Glow Trail Effect */
    .pillar-card::before {
      content: '';
      position: absolute;
      top: var(--mouse-y, 50%);
      left: var(--mouse-x, 50%);
      transform: translate(-50%, -50%);
      width: 200px;
      height: 200px;
      background: radial-gradient(circle, rgba(227, 252, 2, 0.15) 0%, transparent 70%);
      opacity: 0;
      transition: opacity 0.4s ease;
      pointer-events: none;
      filter: blur(30px);
    }
    
    .pillar-card:hover::before {
      opacity: 1;
    }
    
    .pillar-card:hover {
      border-color: rgba(227, 252, 2, 0.3);
      background: rgba(255, 255, 255, 0.04);
      transform: translateY(-12px);
      box-shadow: 
        0 20px 60px rgba(0, 0, 0, 0.5),
        0 0 40px rgba(227, 252, 2, 0.1);
    }
    
    /* Pillar Icon */
    .pillar-icon {
      width: 70px;
      height: 70px;
      background: rgba(227, 252, 2, 0.1);
      border: 1.5px solid rgba(227, 252, 2, 0.3);
      border-radius: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.25rem;
      margin-bottom: 2rem;
      transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    
    .pillar-card:hover .pillar-icon {
      background: rgba(227, 252, 2, 0.15);
      border-color: rgba(227, 252, 2, 0.6);
      transform: scale(1.1) rotate(5deg);
      box-shadow: 0 0 30px rgba(227, 252, 2, 0.4);
    }
    
    .pillar-title {
      font-size: 1.75rem;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 1rem;
      line-height: 1.3;
    }
    
    .pillar-description {
      font-size: 1.0625rem;
      color: rgba(255, 255, 255, 0.65);
      line-height: 1.7;
    }
    
    /* ===================================
       MOBILE RESPONSIVE
       =================================== */
    
    @media (max-width: 768px) {
      .cinematic-header {
        min-height: 90vh;
        padding: 6rem 1.5rem 3rem;
      }
      
      .cinematic-headline {
        font-size: 2.75rem;
      }
      
      .priority-form-section {
        padding: 3rem 1.5rem;
      }
      
      .form-title {
        font-size: 2rem;
      }
      
      .backed-by-logos {
        gap: 2rem;
      }
      
      .backed-logo {
        width: 100px;
        height: 40px;
      }
      
      .feature-pillars-section {
        padding: 5rem 1.5rem 7rem;
      }
      
      .pillars-grid {
        grid-template-columns: 1fr;
        gap: 2rem;
      }
      
      .pillar-card {
        padding: 2.5rem 2rem;
      }
    }
    
    /* ===================================
       PERFORMANCE OPTIMIZATIONS
       =================================== */
    
    @media (prefers-reduced-motion: reduce) {
      * {
        animation: none !important;
        transition: none !important;
      }
    }
  </style>
</head>

<body>
  <!-- Main Container -->
  <div class="waitlist-page">
    
    <!-- SECTION 1: CINEMATIC HEADER -->
    <section class="cinematic-header">
      <!-- 3D Sphere Background -->
      <canvas id="nebulaSphere"></canvas>
      
      <div class="cinematic-content">
        <h1 class="cinematic-headline">
          The future of operational intelligence has a queue.
        </h1>
        <p class="cinematic-subheadline">
          Join the pioneers shaping Africa's data infrastructure. Reserve your position in Tenda OS.
        </p>
      </div>
      
      <div class="scroll-hint">
        <span class="scroll-hint-text">Scroll to Continue</span>
        <div class="scroll-hint-arrow"></div>
      </div>
    </section>
    
    <!-- SECTION 2: INTERACTIVE PRIORITY FORM -->
    <section class="priority-form-section">
      <div class="form-container" id="formContainer">
        
        <!-- Default Form State -->
        <div id="formDefaultState">
          <div class="form-header">
            <div class="form-badge">
              <span class="form-badge-dot"></span>
              Priority Access
            </div>
            <h2 class="form-title">Reserve Your Position</h2>
            <p class="form-subtitle">
              Secure your slot in the infrastructure of tomorrow.
            </p>
          </div>
          
          <form id="waitlistForm" action="/contact#newsletter" method="post">
            <input type="hidden" name="form_type" value="customer" />
            <input type="hidden" name="utf8" value="✓" />
            <input type="hidden" name="contact[tags]" value="newsletter,waitlist,priority,tenda-os" />
            
            <div class="email-input-wrapper">
              <input 
                type="email" 
                name="contact[email]"
                class="priority-email-input"
                id="priorityEmailInput"
                placeholder="your@email.com"
                required
                autocomplete="email"
              />
            </div>
            
            <button type="submit" class="priority-submit-btn" id="submitBtn">
              Join Waitlist
            </button>
          </form>
          
          <!-- Backed By Section -->
          <div class="backed-by-section">
            <p class="backed-by-label">Backed By</p>
            <div class="backed-by-logos">
              <!-- Add your logo images here -->
              <div class="backed-logo">
                <img src="{{ 'logo-1.png' | asset_url }}" alt="Partner 1">
              </div>
              <div class="backed-logo">
                <img src="{{ 'logo-2.png' | asset_url }}" alt="Partner 2">
              </div>
              <div class="backed-logo">
                <img src="{{ 'logo-3.png' | asset_url }}" alt="Partner 3">
              </div>
            </div>
          </div>
        </div>
        
        <!-- Success State -->
        <div class="success-state" id="successState">
          <div class="success-icon">✓</div>
          <h2 class="success-title">Reserved</h2>
          
          <div class="queue-position-display">
            <p class="queue-label">Position in Queue</p>
            <div class="queue-number" id="queuePosition">0000</div>
          </div>
          
          <p style="font-size: 1.125rem; color: rgba(255,255,255,0.7); margin-top: 2rem;">
            Check your inbox for confirmation and next steps.
          </p>
        </div>
        
      </div>
    </section>
    
    <!-- SECTION 3: FEATURE PILLARS -->
    <section class="feature-pillars-section">
      <div class="pillars-header">
        <h2 class="pillars-title">Built for Excellence</h2>
        <p class="pillars-subtitle">
          Tenda OS is engineered with privacy, performance, and quality at its core.
        </p>
      </div>
      
      <div class="pillars-grid">
        
        <!-- Pillar 1: Privacy Guaranteed -->
        <div class="pillar-card" data-pillar="privacy">
          <div class="pillar-icon">🔑</div>
          <h3 class="pillar-title">Privacy Guaranteed</h3>
          <p class="pillar-description">
            Your data is encrypted end-to-end. We never sell or share your operational intelligence with third parties.
          </p>
        </div>
        
        <!-- Pillar 2: Exceptional Performance -->
        <div class="pillar-card" data-pillar="performance">
          <div class="pillar-icon">⚡</div>
          <h3 class="pillar-title">Exceptional Performance</h3>
          <p class="pillar-description">
            Sub-second query times across millions of records. Built on modern infrastructure that scales with your business.
          </p>
        </div>
        
        <!-- Pillar 3: Quality Design -->
        <div class="pillar-card" data-pillar="design">
          <div class="pillar-icon">💎</div>
          <h3 class="pillar-title">Quality Design</h3>
          <p class="pillar-description">
            Premium engineering meets intuitive interfaces. Every pixel crafted for clarity and confidence.
          </p>
        </div>
        
      </div>
    </section>
    
  </div>

  <script>
    // ===================================
    // LENIS SMOOTH SCROLL
    // ===================================
    
    const lenis = new Lenis({
      duration: 1.6,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      orientation: 'vertical',
      smoothWheel: true
    });

    function raf(time) {
      lenis.raf(time);
      requestAnimationFrame(raf);
    }
    requestAnimationFrame(raf);

    // ===================================
    // HEADER TRANSPARENCY ON SCROLL
    // ===================================
    
    const header = document.querySelector('.shopify-section-header') || document.querySelector('header');
    
    if (header) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 100) {
          header.classList.add('scrolled');
        } else {
          header.classList.remove('scrolled');
        }
      });
    }

    // ===================================
    // THREE.JS NEBULA SPHERE
    // ===================================
    
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
    const renderer = new THREE.WebGLRenderer({
      canvas: document.getElementById('nebulaSphere'),
      alpha: true,
      antialias: true
    });

    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // Create wireframe sphere
    const geometry = new THREE.SphereGeometry(2.5, 64, 64);
    const material = new THREE.MeshBasicMaterial({
      color: 0xE3FC02,
      wireframe: true,
      transparent: true,
      opacity: 0.6
    });
    const sphere = new THREE.Mesh(geometry, material);
    scene.add(sphere);

    camera.position.z = 5;

    // Animate sphere
    function animateSphere() {
      requestAnimationFrame(animateSphere);
      sphere.rotation.x += 0.002;
      sphere.rotation.y += 0.003;
      renderer.render(scene, camera);
    }
    animateSphere();

    // Handle resize
    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });

    // ===================================
    // GSAP SCROLL ANIMATIONS
    // ===================================
    
    gsap.registerPlugin(ScrollTrigger);

    // Sphere swallow effect
    ScrollTrigger.create({
      trigger: '.priority-form-section',
      start: 'top center',
      onEnter: () => {
        document.getElementById('nebulaSphere').classList.add('swallow');
      },
      onLeaveBack: () => {
        document.getElementById('nebulaSphere').classList.remove('swallow');
      }
    });

    // Form reveal with spring bounce
    ScrollTrigger.create({
      trigger: '.priority-form-section',
      start: 'top 70%',
      onEnter: () => {
        document.getElementById('formContainer').classList.add('revealed');
      }
    });

    // Pillar cards stagger reveal
    gsap.utils.toArray('.pillar-card').forEach((card, index) => {
      gsap.from(card, {
        opacity: 0,
        y: 80,
        duration: 1,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: card,
          start: 'top 85%',
        },
        delay: index * 0.15
      });
    });

    // ===================================
    // GLOW TRAIL EFFECT ON PILLARS
    // ===================================
    
    const pillarCards = document.querySelectorAll('.pillar-card');
    
    pillarCards.forEach(card => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        
        card.style.setProperty('--mouse-x', x + '%');
        card.style.setProperty('--mouse-y', y + '%');
      });
    });

    // ===================================
    // FORM SUBMISSION & SUCCESS STATE
    // ===================================
    
    const form = document.getElementById('waitlistForm');
    const formDefaultState = document.getElementById('formDefaultState');
    const successState = document.getElementById('successState');
    const formContainer = document.getElementById('formContainer');
    const queuePositionEl = document.getElementById('queuePosition');

    // Queue position animation (watch-face style)
    function animateQueuePosition(start, end, duration) {
      const startTime = performance.now();

      function update(currentTime) {
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);
        
        const easeOut = 1 - Math.pow(1 - progress, 3);
        const current = Math.floor(start + (end - start) * easeOut);
        
        queuePositionEl.textContent = String(current).padStart(4, '0');
        queuePositionEl.classList.add('ticking');
        
        setTimeout(() => {
          queuePositionEl.classList.remove('ticking');
        }, 150);

        if (progress < 1) {
          requestAnimationFrame(update);
        }
      }

      requestAnimationFrame(update);
    }

    form.addEventListener('submit', function(e) {
      e.preventDefault();

      // Trigger ripple effect
      formContainer.classList.add('ripple');
      
      setTimeout(() => {
        formContainer.classList.remove('ripple');
      }, 1500);

      // Submit to Shopify
      const formData = new FormData(form);
      
      fetch('/contact', {
        method: 'POST',
        body: formData,
        headers: {
          'X-Requested-With': 'XMLHttpRequest'
        }
      })
      .then(response => {
        // Delay for ripple effect
        setTimeout(() => {
          // Show success state
          formDefaultState.style.display = 'none';
          successState.classList.add('active');

          // Animate queue position (random 1200-1500)
          const queueEnd = Math.floor(Math.random() * 300) + 1200;
          setTimeout(() => {
            animateQueuePosition(0, queueEnd, 2800);
          }, 800);
        }, 800);
      })
      .catch(error => {
        console.error('Error:', error);
        formContainer.classList.remove('ripple');
        alert('There was an error. Please try again.');
      });
    });
  </script>
</body>
</html>