{% comment %}
  Case Studies Hero Section
{% endcomment %}

<style>
:root {
  --case-bg: #1F1F21;
  --case-accent: #E3FC02;
  --case-text: #ffffff;
  --case-muted: rgba(255,255,255,0.55);
}

.case-hero {
  padding: 180px 5% 100px;
  max-width: 1400px;
  margin: 0 auto;
  text-align: center;
  position: relative;
  background: var(--case-bg);
}

.case-hero__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.625rem;
  font-size: 0.875rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--case-accent);
  margin-bottom: 2rem;
  text-shadow: 0 0 10px rgba(227,252,2,0.4);
}

.case-hero__eyebrow::before {
  content: '';
  width: 8px;
  height: 8px;
  background: var(--case-accent);
  border-radius: 50%;
  box-shadow: 0 0 12px rgba(227,252,2,0.8);
  animation: dotPulse 2.5s ease-in-out infinite;
}

@keyframes dotPulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(227,252,2,0.8); }
  50% { box-shadow: 0 0 0 12px rgba(227,252,2,0); }
}

.case-hero__title {
  font-size: clamp(3rem, 8vw, 5.5rem);
  font-weight: 900;
  letter-spacing: -0.05em;
  line-height: 1.2;
  margin-bottom: 2rem;
  color: var(--case-text);
}

.case-hero__subtitle {
  font-size: clamp(1.25rem, 2.5vw, 1.75rem);
  color: var(--case-muted);
  line-height: 1.6;
  max-width: 800px;
  margin: 0 auto 3rem;
}

.stats-bar {
  display: flex;
  justify-content: center;
  gap: 4rem;
  flex-wrap: wrap;
  margin-top: 4rem;
}

.stat-item {
  text-align: center;
}

.stat-item__value {
  font-size: 3rem;
  font-weight: 900;
  color: var(--case-accent);
  line-height: 1;
  margin-bottom: 0.5rem;
  text-shadow: 0 0 20px rgba(227,252,2,0.4);
}

.stat-item__label {
  font-size: 0.9375rem;
  color: var(--case-muted);
  font-weight: 600;
  letter-spacing: 0.05em;
}

@media screen and (max-width: 768px) {
  .case-hero {
    padding: 140px 5% 80px;
  }
  .stats-bar {
    gap: 2rem;
  }
}
</style>

<section class="case-hero">
  <p class="case-hero__eyebrow">Success Stories</p>
  
  <h1 class="case-hero__title">
    Transforming retail data into measurable growth.
  </h1>
  
  <p class="case-hero__subtitle">
    Real businesses. Real results. See how we've helped African retail and service brands turn their data into decisions that drive revenue, improve margins, and accelerate growth.
  </p>

  <div class="stats-bar">
    <div class="stat-item">
      <div class="stat-item__value">$12M+</div>
      <div class="stat-item__label">Revenue Impact</div>
    </div>
    <div class="stat-item">
      <div class="stat-item__value">40+</div>
      <div class="stat-item__label">Client Success Stories</div>
    </div>
    <div class="stat-item">
      <div class="stat-item__value">8.5x</div>
      <div class="stat-item__label">Average ROI</div>
    </div>
  </div>
</section>

<!-- Premium Divider -->
<div style="width: 100%; height: 2px; margin: 3rem 0 4rem 0; background: linear-gradient(90deg, transparent 0%, rgba(227, 252, 2, 0.6) 20%, rgba(227, 252, 2, 1) 50%, rgba(227, 252, 2, 0.6) 80%, transparent 100%); box-shadow: 0 0 20px rgba(227, 252, 2, 0.4); border-radius: 50px;"></div>

{% schema %}
{
  "name": "Case Studies Hero",
  "settings": []
}
{% endschema %}