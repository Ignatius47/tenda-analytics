{% comment %}
  Tenda Analytics - Interactive FAQ Page
  Features: Staggered animations, instant search, category navigation, smooth accordions
{% endcomment %}

<style>
:root {
  --neon: #E3FC02;
  --neon-glow: rgba(227, 252, 2, 0.4);
  --neon-subtle: rgba(227, 252, 2, 0.15);
  --neon-border: rgba(227, 252, 2, 0.1);
  --bg: #1F1F21;
  --glass: rgba(255, 255, 255, 0.03);
  --text: #f5f5f7;
  --muted: rgba(245, 245, 247, 0.6);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: linear-gradient(180deg, 
    #1F1F21 0%,
    #171719 15%,
    #1F1F21 50%,
    #171719 100%
  );
  color: var(--text);
  font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  min-height: 100vh;
  overflow-x: hidden;
}

/* ===================================
   HERO SECTION
   =================================== */

.faq-hero {
  text-align: center;
  padding: 8vh 5% 6vh;
  position: relative;
  border-bottom: 1px solid var(--neon-border);
}

.faq-hero::before {
  content: '';
  position: absolute;
  top: 0;
  left: 20%;
  right: 20%;
  height: 1px;
  background: linear-gradient(90deg,
    transparent 0%,
    var(--neon) 50%,
    transparent 100%
  );
}

.hero-eyebrow {
  font-size: 0.875rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--neon);
  margin-bottom: 1.5rem;
  opacity: 0;
  animation: fadeIn 0.6s ease forwards;
}

@keyframes fadeIn {
  to { opacity: 1; }
}

.hero-title {
  font-size: clamp(2.5rem, 6vw, 4.5rem);
  font-weight: 800;
  line-height: 1.1;
  margin-bottom: 1.5rem;
  opacity: 0;
  animation: fadeIn 0.8s ease 0.2s forwards;
}

.hero-subtitle {
  font-size: clamp(1.125rem, 2vw, 1.375rem);
  color: var(--muted);
  max-width: 700px;
  margin: 0 auto 3rem;
  line-height: 1.6;
  opacity: 0;
  animation: fadeIn 0.8s ease 0.4s forwards;
}

/* ===================================
   SEARCH BAR
   =================================== */

.search-container {
  max-width: 700px;
  margin: 0 auto;
  position: relative;
  opacity: 0;
  animation: fadeIn 0.8s ease 0.6s forwards;
}

.search-input {
  width: 100%;
  padding: 1.25rem 3.5rem 1.25rem 1.5rem;
  background: rgba(255, 255, 255, 0.05);
  border: 2px solid var(--neon-border);
  border-radius: 12px;
  font-size: 1rem;
  color: var(--text);
  transition: all 0.3s ease;
  backdrop-filter: blur(10px);
}

.search-input::placeholder {
  color: var(--muted);
}

.search-input:focus {
  outline: none;
  border-color: var(--neon);
  box-shadow: 0 0 0 4px rgba(227, 252, 2, 0.1);
  background: rgba(255, 255, 255, 0.08);
}

.search-icon {
  position: absolute;
  right: 1.5rem;
  top: 50%;
  transform: translateY(-50%);
  color: var(--neon);
  font-size: 1.5rem;
  pointer-events: none;
}

/* ===================================
   MAIN CONTAINER
   =================================== */

.faq-main {
  max-width: 1400px;
  margin: 0 auto;
  padding: 4rem 5%;
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 4rem;
}

/* ===================================
   CATEGORY SIDEBAR
   =================================== */

.category-nav {
  position: sticky;
  top: 2rem;
  height: fit-content;
}

.category-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.category-item {
  padding: 1rem 1.5rem;
  border-radius: 8px;
  border: 1px solid transparent;
  color: var(--muted);
  font-weight: 600;
  font-size: 0.9375rem;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  background: rgba(255, 255, 255, 0.02);
}

.category-item:hover {
  background: rgba(255, 255, 255, 0.05);
  color: var(--text);
  border-color: var(--neon-border);
}

.category-item.active {
  background: rgba(227, 252, 2, 0.1);
  color: var(--neon);
  border-color: var(--neon);
  box-shadow: 0 0 20px rgba(227, 252, 2, 0.2);
}

/* ===================================
   FAQ CONTENT
   =================================== */

.faq-content {
  opacity: 0;
  animation: fadeIn 0.8s ease 0.8s forwards;
}

.faq-category {
  margin-bottom: 4rem;
}

.category-title {
  font-size: 2rem;
  font-weight: 800;
  color: var(--text);
  margin-bottom: 2rem;
  padding-bottom: 1rem;
  border-bottom: 2px solid var(--neon-border);
  display: flex;
  align-items: center;
  gap: 1rem;
}

.category-icon {
  width: 40px;
  height: 40px;
  background: var(--neon);
  color: #000;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
  font-size: 1.25rem;
}

/* ===================================
   ACCORDION ITEMS
   =================================== */

.faq-items {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.faq-item {
  background: var(--glass);
  backdrop-filter: blur(25px);
  border: 1px solid var(--neon-border);
  border-radius: 12px;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  opacity: 0;
  transform: translateY(20px);
  animation: slideUp 0.5s ease forwards;
}

@keyframes slideUp {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.faq-item:hover {
  transform: translateY(-4px);
  border-color: var(--neon);
  box-shadow: 0 8px 30px rgba(227, 252, 2, 0.15);
}

.faq-item.active {
  border-color: var(--neon);
  box-shadow: 0 0 30px rgba(227, 252, 2, 0.2);
  background: rgba(255, 255, 255, 0.05);
}

.faq-item.hidden {
  display: none;
}

.faq-question {
  padding: 1.5rem 2rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  transition: all 0.3s ease;
  user-select: none;
}

.faq-question:hover {
  background: rgba(255, 255, 255, 0.03);
}

.question-text {
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--text);
  line-height: 1.4;
}

.question-icon {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--neon);
  color: #000;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
  font-weight: 900;
  flex-shrink: 0;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.faq-item.active .question-icon {
  transform: rotate(45deg);
  background: var(--text);
  color: var(--bg);
}

.faq-answer {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}

.faq-item.active .faq-answer {
  max-height: 1000px;
}

.answer-content {
  padding: 0 2rem 1.5rem;
  color: var(--muted);
  font-size: 1rem;
  line-height: 1.7;
}

.answer-content p {
  margin-bottom: 1rem;
}

.answer-content p:last-child {
  margin-bottom: 0;
}

/* ===================================
   NO RESULTS STATE
   =================================== */

.no-results {
  text-align: center;
  padding: 4rem 2rem;
  display: none;
}

.no-results.show {
  display: block;
}

.no-results-icon {
  font-size: 4rem;
  margin-bottom: 1.5rem;
  opacity: 0.3;
}

.no-results-text {
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--muted);
  margin-bottom: 0.5rem;
}

.no-results-subtext {
  color: var(--muted);
  opacity: 0.7;
}

/* ===================================
   RESPONSIVE
   =================================== */

@media (max-width: 1024px) {
  .faq-main {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .category-nav {
    position: static;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .category-list {
    flex-direction: row;
    white-space: nowrap;
  }

  .category-item {
    padding: 0.75rem 1.25rem;
  }
}

@media (max-width: 640px) {
  .faq-hero {
    padding: 6vh 5% 4vh;
  }

  .hero-title {
    font-size: 2rem;
  }

  .faq-main {
    padding: 2rem 5%;
  }

  .category-title {
    font-size: 1.5rem;
  }

  .faq-question {
    padding: 1.25rem 1.5rem;
  }

  .question-text {
    font-size: 1rem;
  }

  .answer-content {
    padding: 0 1.5rem 1.25rem;
    font-size: 0.9375rem;
  }
}

/* ===================================
   SCROLLBAR
   =================================== */

::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}

::-webkit-scrollbar-track {
  background: #121212;
}

::-webkit-scrollbar-thumb {
  background: var(--neon);
  border-radius: 10px;
  box-shadow: 0 0 10px var(--neon-glow);
}

::-webkit-scrollbar-thumb:hover {
  background: #f6ff4d;
  box-shadow: 0 0 15px rgba(227, 252, 2, 0.6);
}
</style>

<!-- Hero Section -->
<section class="faq-hero">
  <div class="hero-eyebrow">Support & Guidance</div>
  <h1 class="hero-title">Frequently Asked Questions</h1>
  <p class="hero-subtitle">
    Everything you need to know about Tenda Analytics, from pricing to implementation.
  </p>

  <!-- Search Bar -->
  <div class="search-container">
    <input 
      type="text" 
      class="search-input" 
      id="faqSearch"
      placeholder="Search questions... (e.g., 'pricing', 'data security', 'integration')"
      autocomplete="off">
    <span class="search-icon">🔍</span>
  </div>
</section>

<!-- Main Content -->
<div class="faq-main">
  
  <!-- Category Navigation -->
  <nav class="category-nav">
    <ul class="category-list" id="categoryNav">
      <li class="category-item active" data-category="growth">Growth & Advisory</li>
      <li class="category-item" data-category="pricing">Pricing</li>
      <li class="category-item" data-category="platform">Platform & Features</li>
      <li class="category-item" data-category="security">Data & Security</li>
      <li class="category-item" data-category="integration">Integration</li>
      <li class="category-item" data-category="support">Support</li>
    </ul>
  </nav>

  <!-- FAQ Content -->
  <div class="faq-content">

    <!-- No Results State -->
    <div class="no-results" id="noResults">
      <div class="no-results-icon">🔍</div>
      <div class="no-results-text">No matches found</div>
      <div class="no-results-subtext">Try a different search term</div>
    </div>

    <!-- Growth & Advisory -->
    <section class="faq-category" id="growth" data-category="growth">
      <h2 class="category-title">
        <span class="category-icon">📈</span>
        Growth & Advisory
      </h2>
      <div class="faq-items">
        
        <div class="faq-item" style="animation-delay: 0.1s">
          <div class="faq-question">
            <span class="question-text">What type of businesses does Tenda work with?</span>
            <span class="question-icon">+</span>
          </div>
          <div class="faq-answer">
            <div class="answer-content">
              <p>We specialize in retail, e-commerce, and consumer-facing businesses in Africa. Our clients range from emerging startups to established enterprises looking to leverage data for growth. If you're tracking sales, inventory, or customer behavior, Tenda can help you make better decisions.</p>
            </div>
          </div>
        </div>

        <div class="faq-item" style="animation-delay: 0.15s">
          <div class="faq-question">
            <span class="question-text">How quickly can I see results from using Tenda?</span>
            <span class="question-icon">+</span>
          </div>
          <div class="faq-answer">
            <div class="answer-content">
              <p>Most clients identify their first actionable insight within the first week of setup. Meaningful operational improvements typically appear within 30-60 days as you begin optimizing based on your metrics. The exact timeline depends on your data maturity and implementation speed.</p>
            </div>
          </div>
        </div>

        <div class="faq-item" style="animation-delay: 0.2s">
          <div class="faq-question">
            <span class="question-text">Do I need a data team to use Tenda?</span>
            <span class="question-icon">+</span>
          </div>
          <div class="faq-answer">
            <div class="answer-content">
              <p>No. Tenda is designed for operators, not data scientists. Our dashboards are built to answer business questions, not technical ones. If you can use Excel, you can use Tenda. We handle the complex analytics in the background.</p>
            </div>
          </div>
        </div>

        <div class="faq-item" style="animation-delay: 0.25s">
          <div class="faq-question">
            <span class="question-text">What's the difference between your playbooks and custom advisory?</span>
            <span class="question-icon">+</span>
          </div>
          <div class="faq-answer">
            <div class="answer-content">
              <p>Playbooks are self-serve frameworks (like our "10 Numbers" guide) that help you analyze your own business. Custom advisory is hands-on support where our team analyzes your data with you, builds custom dashboards, and provides strategic recommendations tailored to your specific challenges.</p>
            </div>
          </div>
        </div>

        <div class="faq-item" style="animation-delay: 0.3s">
          <div class="faq-question">
            <span class="question-text">Can Tenda help with forecasting and projections?</span>
            <span class="question-icon">+</span>
          </div>
          <div class="faq-answer">
            <div class="answer-content">
              <p>Yes. Our platform includes predictive models for inventory needs, cash flow, and demand forecasting. For enterprise clients, we build custom ML models tailored to your specific business patterns and seasonality.</p>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- Pricing -->
    <section class="faq-category" id="pricing" data-category="pricing">
      <h2 class="category-title">
        <span class="category-icon">💰</span>
        Pricing
      </h2>
      <div class="faq-items">
        
        <div class="faq-item" style="animation-delay: 0.1s">
          <div class="faq-question">
            <span class="question-text">How much does Tenda cost?</span>
            <span class="question-icon">+</span>
          </div>
          <div class="faq-answer">
            <div class="answer-content">
              <p>Pricing is based on your business size and needs. Our starter packages begin at $200/month for SMBs. Enterprise solutions are custom-quoted based on data volume, integrations, and support requirements. Contact us for a tailored quote.</p>
            </div>
          </div>
        </div>

        <div class="faq-item" style="animation-delay: 0.15s">
          <div class="faq-question">
            <span class="question-text">Is there a free trial?</span>
            <span class="question-icon">+</span>
          </div>
          <div class="faq-answer">
            <div class="answer-content">
              <p>We offer a 14-day pilot program where we connect to one data source and build a sample dashboard. This lets you see real insights from your own data before committing. No credit card required to start.</p>
            </div>
          </div>
        </div>

        <div class="faq-item" style="animation-delay: 0.2s">
          <div class="faq-question">
            <span class="question-text">Are the playbooks free?</span>
            <span class="question-icon">+</span>
          </div>
          <div class="faq-answer">
            <div class="answer-content">
              <p>Yes. All our playbooks and frameworks (like the "10 Numbers" guide) are available for free to newsletter subscribers. These are designed to help you build data literacy even before you're ready for the full platform.</p>
            </div>
          </div>
        </div>

        <div class="faq-item" style="animation-delay: 0.25s">
          <div class="faq-question">
            <span class="question-text">What payment methods do you accept?</span>
            <span class="question-icon">+</span>
          </div>
          <div class="faq-answer">
            <div class="answer-content">
              <p>We accept bank transfers, mobile money (M-Pesa, Airtel Money), and credit cards. For annual subscriptions, we offer flexible payment plans and a 15% discount.</p>
            </div>
          </div>
        </div>

        <div class="faq-item" style="animation-delay: 0.3s">
          <div class="faq-question">
            <span class="question-text">Can I cancel anytime?</span>
            <span class="question-icon">+</span>
          </div>
          <div class="faq-answer">
            <div class="answer-content">
              <p>Yes. Monthly subscriptions can be canceled with 30 days notice. Annual plans are non-refundable but can be paused for up to 3 months if needed. We believe in earning your business every month.</p>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- Platform & Features -->
    <section class="faq-category" id="platform" data-category="platform">
      <h2 class="category-title">
        <span class="category-icon">⚡</span>
        Platform & Features
      </h2>
      <div class="faq-items">
        
        <div class="faq-item" style="animation-delay: 0.1s">
          <div class="faq-question">
            <span class="question-text">What data sources can Tenda connect to?</span>
            <span class="question-icon">+</span>
          </div>
          <div class="faq-answer">
            <div class="answer-content">
              <p>We integrate with Shopify, WooCommerce, QuickBooks, Excel/Google Sheets, M-Pesa API, payment processors (Stripe, Flutterwave, Paystack), and custom databases. If you track data anywhere, we can likely connect to it.</p>
            </div>
          </div>
        </div>

        <div class="faq-item" style="animation-delay: 0.15s">
          <div class="faq-question">
            <span class="question-text">Can I customize my dashboards?</span>
            <span class="question-icon">+</span>
          </div>
          <div class="faq-answer">
            <div class="answer-content">
              <p>Absolutely. You can create custom views, set your own KPIs, and choose which metrics appear on your homepage. Enterprise clients get fully custom-built dashboards tailored to their specific workflows.</p>
            </div>
          </div>
        </div>

        <div class="faq-item" style="animation-delay: 0.2s">
          <div class="faq-question">
            <span class="question-text">Does Tenda work on mobile?</span>
            <span class="question-icon">+</span>
          </div>
          <div class="faq-answer">
            <div class="answer-content">
              <p>Yes. Our dashboards are fully responsive and optimized for mobile. You can check your key metrics, receive alerts, and make quick decisions from your phone. iOS and Android apps are coming in Q2 2026.</p>
            </div>
          </div>
        </div>

        <div class="faq-item" style="animation-delay: 0.25s">
          <div class="faq-question">
            <span class="question-text">How often does data refresh?</span>
            <span class="question-icon">+</span>
          </div>
          <div class="faq-answer">
            <div class="answer-content">
              <p>Real-time for API-connected sources (Shopify, payment processors). Daily syncs for accounting software and spreadsheets. You can manually trigger a refresh anytime, and enterprise plans support custom sync schedules.</p>
            </div>
          </div>
        </div>

        <div class="faq-item" style="animation-delay: 0.3s">
          <div class="faq-question">
            <span class="question-text">Can I export my data?</span>
            <span class="question-icon">+</span>
          </div>
          <div class="faq-answer">
            <div class="answer-content">
              <p>Yes. Export any report to CSV, Excel, or PDF. You can also schedule automated email reports to be sent daily, weekly, or monthly to your team. Your data is always yours.</p>
            </div>
          </div>
        </div>

        <div class="faq-item" style="animation-delay: 0.35s">
          <div class="faq-question">
            <span class="question-text">What analytics features are included?</span>
            <span class="question-icon">+</span>
          </div>
          <div class="faq-answer">
            <div class="answer-content">
              <p>Trend analysis, cohort analysis, customer segmentation, inventory optimization, profit margin tracking, cash flow projections, and automated alerts for anomalies. Enterprise plans include predictive models and custom ML features.</p>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- Data & Security -->
    <section class="faq-category" id="security" data-category="security">
      <h2 class="category-title">
        <span class="category-icon">🔒</span>
        Data & Security
      </h2>
      <div class="faq-items">
        
        <div class="faq-item" style="animation-delay: 0.1s">
          <div class="faq-question">
            <span class="question-text">How secure is my data?</span>
            <span class="question-icon">+</span>
          </div>
          <div class="faq-answer">
            <div class="answer-content">
              <p>We use bank-level AES-256 encryption for data at rest and TLS 1.3 for data in transit. All servers are hosted on AWS with automatic backups and multi-region redundancy. We're SOC 2 compliant and undergo regular third-party security audits.</p>
            </div>
          </div>
        </div>

        <div class="faq-item" style="animation-delay: 0.15s">
          <div class="faq-question">
            <span class="question-text">Who can see my data?</span>
            <span class="question-icon">+</span>
          </div>
          <div class="faq-answer">
            <div class="answer-content">
              <p>Only you and users you explicitly grant access to. Tenda staff never access client data unless you request support and grant temporary permission. All access is logged and auditable.</p>
            </div>
          </div>
        </div>

        <div class="faq-item" style="animation-delay: 0.2s">
          <div class="faq-question">
            <span class="question-text">Where is my data stored?</span>
            <span class="question-icon">+</span>
          </div>
          <div class="faq-answer">
            <div class="answer-content">
              <p>Primary data centers are in AWS EU (Frankfurt) with backup replication in AWS Africa (Cape Town). Enterprise clients can request specific geographic storage locations for compliance requirements.</p>
            </div>
          </div>
        </div>

        <div class="faq-item" style="animation-delay: 0.25s">
          <div class="faq-question">
            <span class="question-text">Is Tenda GDPR compliant?</span>
            <span class="question-icon">+</span>
          </div>
          <div class="faq-answer">
            <div class="answer-content">
              <p>Yes. We're fully GDPR compliant and provide data processing agreements (DPAs) for all clients. You maintain full ownership of your data and can request deletion or export at any time.</p>
            </div>
          </div>
        </div>

        <div class="faq-item" style="animation-delay: 0.3s">
          <div class="faq-question">
            <span class="question-text">What happens to my data if I cancel?</span>
            <span class="question-icon">+</span>
          </div>
          <div class="faq-answer">
            <div class="answer-content">
              <p>You have 90 days to export all your data after cancellation. After 90 days, we securely delete all your information from our systems. We never sell or share client data, even after cancellation.</p>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- Integration -->
    <section class="faq-category" id="integration" data-category="integration">
      <h2 class="category-title">
        <span class="category-icon">🔌</span>
        Integration & Setup
      </h2>
      <div class="faq-items">
        
        <div class="faq-item" style="animation-delay: 0.1s">
