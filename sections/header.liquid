<script>
  function toggleMobileMenu() {
    const menu = document.getElementById('mobileMenu');
    const hamburger = document.querySelector('.hamburger');
    const overlay = document.getElementById('mobileOverlay');
    const body = document.body;
    
    if (!menu || !hamburger) return;
    
    menu.classList.toggle('active');
    hamburger.classList.toggle('active');
    if (overlay) overlay.classList.toggle('active');
    body.classList.toggle('menu-open');
  }

  function closeMobileMenu() {
    const menu = document.getElementById('mobileMenu');
    const hamburger = document.querySelector('.hamburger');
    const overlay = document.getElementById('mobileOverlay');
    
    if (menu) menu.classList.remove('active');
    if (hamburger) hamburger.classList.remove('active');
    if (overlay) overlay.classList.remove('active');
    document.body.classList.remove('menu-open');
  }

  function toggleServicesMenu(event) {
    event.stopPropagation();
    event.preventDefault();
    
    const trigger = event.currentTarget;
    const submenu = document.getElementById('servicesSubmenu');
    
    if (!submenu || !trigger) return;
    
    // Mobile: preserve scroll position
    if (window.innerWidth < 1024) {
      const menu = document.getElementById('mobileMenu');
      const scrollPos = menu ? menu.scrollTop : 0;
      
      // Toggle classes
      const isOpen = trigger.classList.contains('is-open');
      trigger.classList.toggle('is-open');
      trigger.setAttribute('aria-expanded', !isOpen);
      submenu.classList.toggle('active');
      
      // Restore scroll position
      if (menu) {
        requestAnimationFrame(() => {
          menu.scrollTop = scrollPos;
        });
      }
    } else {
      // Desktop: toggle dropdown
      const isOpen = trigger.classList.contains('is-open');
      trigger.classList.toggle('is-open');
      trigger.setAttribute('aria-expanded', !isOpen);
      submenu.classList.toggle('active');
    }
  }

  // Close desktop dropdown when clicking outside
  document.addEventListener('click', function(e) {
    if (window.innerWidth >= 1024) {
      const servicesMenu = document.querySelector('.has-submenu');
      const submenu = document.getElementById('servicesSubmenu');
      const trigger = document.querySelector('.services-trigger');
      
      if (servicesMenu && !servicesMenu.contains(e.target)) {
        if (submenu) submenu.classList.remove('active');
        if (trigger) {
          trigger.classList.remove('is-open');
          trigger.setAttribute('aria-expanded', 'false');
        }
      }
    }
  });

  document.addEventListener('DOMContentLoaded', function() {
    const currentPath = window.location.pathname;
    
    // Mark active page
    document.querySelectorAll('.header__menu-item a').forEach(link => {
      if (new URL(link.href).pathname === currentPath) {
        link.classList.add('active');
      }
      
      // Close menu on link click (mobile)
      link.addEventListener('click', function() {
        if (window.innerWidth < 1024) {
          setTimeout(() => closeMobileMenu(), 200);
        }
      });
    });

    // ESC key closes menu
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        const menu = document.getElementById('mobileMenu');
        if (menu && menu.classList.contains('active')) {
          closeMobileMenu();
        }
        const search = document.querySelector('.header__search details[open]');
        if (search) search.removeAttribute('open');
      }
    });

    // Resize handler
    window.addEventListener('resize', function() {
      if (window.innerWidth >= 1024) {
        closeMobileMenu();
        const submenu = document.getElementById('servicesSubmenu');
        const trigger = document.querySelector('.services-trigger');
        if (submenu) submenu.classList.remove('active');
        if (trigger) {
          trigger.classList.remove('is-open');
          trigger.setAttribute('aria-expanded', 'false');
        }
      }
    });
  });

  class StickyHeader extends HTMLElement {
    connectedCallback() {
      const header = document.querySelector('.section-header');
      if (!header) return;
      
      window.addEventListener('scroll', () => {
        header.classList.toggle('is-scrolled', window.scrollY > 50);
      }, { passive: true });
    }
  }

  customElements.define('sticky-header', StickyHeader);

  class DetailsModal extends HTMLElement {
    constructor() {
      super();
      this.details = this.querySelector('details');
      this.summary = this.querySelector('summary');
      this.content = this.querySelector('.modal__content');
      
      if (!this.details || !this.summary) return;
      
      this.summary.addEventListener('click', (e) => {
        e.preventDefault();
        this.details.hasAttribute('open') ? this.close() : this.open();
      });
    }

    open() {
      this.details.setAttribute('open', '');
      setTimeout(() => {
        const input = this.content.querySelector('.search__input');
        if (input) {
          input.focus();
          input.select();
        }
      }, 150);
      
      setTimeout(() => {
        document.addEventListener('click', this.outsideClick);
      }, 100);
    }

    close() {
      this.details.removeAttribute('open');
      document.removeEventListener('click', this.outsideClick);
    }

    outsideClick = (e) => {
      if (!this.content.contains(e.target) && !this.summary.contains(e.target)) {
        this.close();
      }
    }
  }

  customElements.define('details-modal', DetailsModal);

  // =========================================
  // LIQUID GLASS AUTH MODAL
  // =========================================

  function openAuthModal(event) {
    if (event) event.preventDefault();
    const modal   = document.getElementById('authModal');
    const content = modal?.querySelector('.auth-modal__content');
    if (!modal || !content) return;

    // --- Measure the account icon's position relative to the viewport ---
    const trigger = event?.currentTarget || document.querySelector('.header__icon--account');
    const iconRect = trigger ? trigger.getBoundingClientRect() : null;

    // Compute where the icon center sits relative to the modal card's final
    // rendered position (card is centered in the viewport)
    if (iconRect) {
      const vpW = window.innerWidth;
      const vpH = window.innerHeight;

      // Icon center in viewport coords
      const iconCX = iconRect.left + iconRect.width  / 2;
      const iconCY = iconRect.top  + iconRect.height / 2;

      // Card will be centered → its top-left corner sits at:
      // ( (vpW - cardW) / 2 , (vpH - cardH) / 2 )
      // We don't know cardH exactly yet, so use a reasonable estimate (560px)
      const cardW = Math.min(920, vpW - 32);
      const cardH = Math.min(560, vpH * 0.92);
      const cardLeft = (vpW - cardW) / 2;
      const cardTop  = (vpH - cardH) / 2;

      // transform-origin is expressed as % or px relative to the card itself
      const originX = iconCX - cardLeft;
      const originY = iconCY - cardTop;

      content.style.transformOrigin = `${originX}px ${originY}px`;
    } else {
      // Fallback: top-right corner (where icons live)
      content.style.transformOrigin = 'right top';
    }

    // Reset any lingering close animation
    content.classList.remove('genie-close');
    // Force reflow so removing the class takes effect before we add the new one
    void content.offsetWidth;

    modal.classList.add('active');
    document.body.classList.add('menu-open');

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        content.classList.add('genie-open');
      });
    });
  }

  function closeAuthModal() {
    const modal   = document.getElementById('authModal');
    const content = modal?.querySelector('.auth-modal__content');
    if (!modal || !content) return;

    // Reverse: shrink back toward the same origin point
    content.classList.remove('genie-open');
    void content.offsetWidth; // reflow
    content.classList.add('genie-close');

    setTimeout(() => {
      modal.classList.remove('active');
      document.body.classList.remove('menu-open');
      content.classList.remove('genie-close');
      // Reset so next open recalculates from fresh icon position
      content.style.transformOrigin = '';
    }, 380);
  }

  function switchAuthMode(mode) {
    const signinForm = document.getElementById('signinForm');
    const signupForm = document.getElementById('signupForm');
    const title      = document.getElementById('authTitle');
    const subtitle   = document.getElementById('authSubtitle');
    const buttons    = document.querySelectorAll('.auth-modal__toggle-btn');

    buttons.forEach(btn => btn.classList.remove('active'));
    event.target.classList.add('active');

    const showForm  = mode === 'signin' ? signinForm : signupForm;
    const hideForm  = mode === 'signin' ? signupForm : signinForm;

    hideForm.style.display = 'none';
    showForm.style.display = 'flex';

    // Spring bounce fade in
    showForm.classList.remove('animating');
    void showForm.offsetWidth; // reflow
    showForm.classList.add('animating');
    setTimeout(() => showForm.classList.remove('animating'), 400);

    title.textContent    = mode === 'signin' ? 'Welcome Back'    : 'Create Account';
    subtitle.textContent = mode === 'signin' ? 'Sign in to access your account' : 'Join Tenda and unlock exclusive benefits';
  }

  // Magnetic pull on the submit button
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.auth-modal__submit').forEach(function (btn) {
      btn.addEventListener('mousemove', function (e) {
        const rect = this.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width  / 2;
        const y = e.clientY - rect.top  - rect.height / 2;
        const dist = Math.sqrt(x * x + y * y);
        const maxR  = 80;
        if (dist < maxR) {
          const pull = (maxR - dist) / maxR;
          this.style.transform = 'translate(' + (x * pull * 0.22) + 'px,' + (y * pull * 0.22) + 'px) scale(1.04)';
        }
      });
      btn.addEventListener('mouseleave', function () {
        this.style.transform = '';
      });
    });
  });

  // ESC key and outside-click close
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeAuthModal();
  });

  document.getElementById('authModal')?.addEventListener('click', function (e) {
    if (e.target === this) closeAuthModal();
  });

  // =========================================
  // SEARCH WITH GENIE ANIMATION
  // =========================================
  document.addEventListener('DOMContentLoaded', function () {
    
    // ── Search: Genie animation + auto-focus + click-outside-to-close ──
    const searchDetails = document.getElementById('searchDetails');
    const searchInput = document.getElementById('searchInput');
    const searchPill = document.querySelector('.search-pill');
    const searchTrigger = document.querySelector('.search-pill-trigger');
    
    if (searchDetails && searchInput && searchPill) {
      // Set transform-origin when opening
      searchDetails.addEventListener('toggle', function () {
        if (this.open) {
          // Measure search icon position to set transform-origin
          if (searchTrigger) {
            const iconRect = searchTrigger.getBoundingClientRect();
            const pillRect = searchPill.getBoundingClientRect();
            
            // Icon center relative to pill's final position
            const iconCX = iconRect.left + iconRect.width / 2;
            const iconCY = iconRect.top + iconRect.height / 2;
            
            // Pill is positioned fixed at top: var(--header-height)
            const pillTop = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--header-height'));
            
            // Origin relative to pill
            const originX = iconCX - pillRect.left;
            const originY = iconCY - pillTop;
            
            searchPill.style.transformOrigin = `${originX}px ${originY}px`;
          }
          
          // Auto-focus after animation
          setTimeout(() => {
            searchInput.focus();
          }, 300);
        } else {
          // Closing - trigger genie-close animation
          searchPill.classList.add('genie-closing');
          setTimeout(() => {
            searchPill.classList.remove('genie-closing');
            searchPill.style.transformOrigin = '';
          }, 350);
        }
      });

      // Close on click outside
      document.addEventListener('click', function (e) {
        if (!searchDetails.contains(e.target) && searchDetails.open) {
          searchDetails.open = false;
        }
      });

      // Prevent closing when clicking inside
      searchDetails.addEventListener('click', function (e) {
        e.stopPropagation();
      });
    }
    
    // Magnetic pull for search icon
    const searchIcon = document.querySelector('.search-pill-trigger .header__icon');
    if (searchIcon) {
      searchIcon.addEventListener('mousemove', function (e) {
        const rect = this.getBoundingClientRect();
        const centerX = rect.left + rect.width / 2;
        const centerY = rect.top + rect.height / 2;
        
        const deltaX = e.clientX - centerX;
        const deltaY = e.clientY - centerY;
        const distance = Math.sqrt(deltaX * deltaX + deltaY * deltaY);
        
        const maxDistance = 35;
        
        if (distance < maxDistance) {
          const pullStrength = (maxDistance - distance) / maxDistance;
          const offsetX = deltaX * pullStrength * 0.25;
          const offsetY = deltaY * pullStrength * 0.25;
          
          this.style.transform = `translate(${offsetX}px, ${offsetY}px) scale(1.04)`;
        }
      });
      
      searchIcon.addEventListener('mouseleave', function () {
        this.style.transform = '';
      });
    }
    
    // Magnetic pull for Services dropdown arrow
    const servicesArrow = document.querySelector('.services-trigger');
    if (servicesArrow) {
      servicesArrow.addEventListener('mousemove', function (e) {
        const rect = this.getBoundingClientRect();
        const centerX = rect.left + rect.width / 2;
        const centerY = rect.top + rect.height / 2;
        
        const deltaX = e.clientX - centerX;
        const deltaY = e.clientY - centerY;
        const distance = Math.sqrt(deltaX * deltaX + deltaY * deltaY);
        
        const maxDistance = 30;
        
        if (distance < maxDistance) {
          const pullStrength = (maxDistance - distance) / maxDistance;
          const offsetX = deltaX * pullStrength * 0.18;
          const offsetY = deltaY * pullStrength * 0.18;
          
          this.style.transform = `translate(${offsetX}px, ${offsetY}px)`;
        }
      });
      
      servicesArrow.addEventListener('mouseleave', function () {
        this.style.transform = '';
      });
    }
  });

  function toggleMobileMenu() {
  const menu = document.getElementById('mobileMenu');
  const hamburger = document.querySelector('.hamburger');
  const overlay = document.getElementById('mobileOverlay');
  const body = document.body;
  
  if (!menu || !hamburger) return;
  
  const isOpen = menu.classList.contains('active');
  
  if (isOpen) {
    // Close menu
    menu.classList.remove('active');
    hamburger.classList.remove('active');
    if (overlay) overlay.classList.remove('active');
    body.classList.remove('menu-open');
    
    // Restore body scroll
    body.style.overflow = '';
    body.style.position = '';
    body.style.width = '';
    body.style.height = '';
  } else {
    // Open menu
    menu.classList.add('active');
    hamburger.classList.add('active');
    if (overlay) overlay.classList.add('active');
    body.classList.add('menu-open');
    
    // Lock body scroll
    body.style.overflow = 'hidden';
    body.style.position = 'fixed';
    body.style.width = '100%';
    body.style.height = '100%';
  }
}

function closeMobileMenu() {
  const menu = document.getElementById('mobileMenu');
  const hamburger = document.querySelector('.hamburger');
  const overlay = document.getElementById('mobileOverlay');
  const body = document.body;
  
  if (menu) menu.classList.remove('active');
  if (hamburger) hamburger.classList.remove('active');
  if (overlay) overlay.classList.remove('active');
  body.classList.remove('menu-open');
  
  // Restore body scroll
  body.style.overflow = '';
  body.style.position = '';
  body.style.width = '';
  body.style.height = '';
}

function toggleServicesMenu(event) {
  event.stopPropagation();
  event.preventDefault();
  
  const trigger = event.currentTarget;
  const submenu = document.getElementById('servicesSubmenu');
  
  if (!submenu || !trigger) return;
  
  const isOpen = trigger.classList.contains('is-open');
  
  // Toggle classes
  trigger.classList.toggle('is-open');
  trigger.setAttribute('aria-expanded', !isOpen);
  submenu.classList.toggle('active');
}

// Desktop: Close dropdown when clicking outside
document.addEventListener('click', function(e) {
  if (window.innerWidth >= 1024) {
    const servicesMenu = document.querySelector('.has-submenu');
    const submenu = document.getElementById('servicesSubmenu');
    const trigger = document.querySelector('.services-trigger');
    
    if (servicesMenu && !servicesMenu.contains(e.target)) {
      if (submenu) submenu.classList.remove('active');
      if (trigger) {
        trigger.classList.remove('is-open');
        trigger.setAttribute('aria-expanded', 'false');
      }
    }
  }
});

// Desktop: Open on hover
document.addEventListener('DOMContentLoaded', function() {
  if (window.innerWidth >= 1024) {
    const servicesMenu = document.querySelector('.has-submenu');
    const submenu = document.getElementById('servicesSubmenu');
    const trigger = document.querySelector('.services-trigger');
    
    if (servicesMenu && submenu && trigger) {
      servicesMenu.addEventListener('mouseenter', function() {
        submenu.classList.add('active');
        trigger.classList.add('is-open');
        trigger.setAttribute('aria-expanded', 'true');
      });
      
      servicesMenu.addEventListener('mouseleave', function() {
        submenu.classList.remove('active');
        trigger.classList.remove('is-open');
        trigger.setAttribute('aria-expanded', 'false');
      });
    }
  }
});

// Initialize
document.addEventListener('DOMContentLoaded', function() {
  const currentPath = window.location.pathname;
  
  // Mark active page
  document.querySelectorAll('.header__menu-item a').forEach(link => {
    if (new URL(link.href).pathname === currentPath) {
      link.classList.add('active');
    }
    
    // Close menu on link click (mobile)
    link.addEventListener('click', function() {
      if (window.innerWidth < 1024) {
        setTimeout(() => closeMobileMenu(), 200);
      }
    });
  });

  // ESC key closes menu
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      const menu = document.getElementById('mobileMenu');
      if (menu && menu.classList.contains('active')) {
        closeMobileMenu();
      }
    }
  });

  // Resize handler - close mobile menu on resize to desktop
  let resizeTimer;
  window.addEventListener('resize', function() {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function() {
      if (window.innerWidth >= 1024) {
        closeMobileMenu();
        const submenu = document.getElementById('servicesSubmenu');
        const trigger = document.querySelector('.services-trigger');
        if (submenu) submenu.classList.remove('active');
        if (trigger) {
          trigger.classList.remove('is-open');
          trigger.setAttribute('aria-expanded', 'false');
        }
      }
    }, 250);
  });
});

</script>

