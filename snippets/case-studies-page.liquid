    </div>
  </section>

  <!-- Distinct Divider -->
  <div class="section-divider" 
       style="
          width: 100%;
          height: 2px;
          margin: 3rem 0 4rem 0;
          background: linear-gradient(
              90deg,
              transparent 0%,
              rgba(227, 252, 2, 0.6) 20%,
              rgba(227, 252, 2, 1) 50%,
              rgba(227, 252, 2, 0.6) 80%,
              transparent 100%
          );
          box-shadow: 0 0 20px rgba(227, 252, 2, 0.4);
          border-radius: 50px;
       ">
  </div>

  <!-- ========================================
       CATEGORY DIVIDER - DIGITAL
       ======================================== -->
  <section class="category-divider">
    <div class="category-divider__line"></div>
    <h2 class="category-divider__title">Digital Tech Success Stories</h2>
    <p class="category-divider__subtitle">
      How we've helped tech companies and digital-first brands scale their data infrastructure.
    </p>
  </section>

  <!-- ========================================
       DIGITAL CASE STUDIES GRID
       ======================================== -->
  <section class="cases-grid">
    <div class="cases-grid__container">

      <!-- Case Study 4 -->
      <div class="case-card">
        <div class="case-card__image">
