<!-- BACK TO TOP -->
<button class="back-to-top" id="backToTop" aria-label="Back to top">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 19V5M5 12l7-7 7 7"/>
  </svg>
</button>

<style>

  /* ===========================================
     SUBSCRIBE SECTION
     =========================================== */

  .footer-subscribe {
    background: #161618;
    padding: 110px 24px 100px;
    text-align: center;
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  /* Animated grain texture */
  .sub-grain {
    position: absolute;
    inset: -50%;
    width: 200%;
    height: 200%;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    opacity: 0.035;
    pointer-events: none;
    animation: grainDrift 8s steps(2) infinite;
    will-change: transform;
  }

  @keyframes grainDrift {
    0%   { transform: translate(0, 0); }
    25%  { transform: translate(-2%, -1%); }
    50%  { transform: translate(1%, 2%); }
    75%  { transform: translate(-1%, 1%); }
    100% { transform: translate(0, 0); }
  }

  /* Cursor glow */
  .sub-cursor-glow {
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(227,252,2,0.05) 0%, transparent 65%);
    pointer-events: none;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 0.5s ease;
    z-index: 0;
  }

  .footer-subscribe:hover .sub-cursor-glow { opacity: 1; }

  /* Content container */
  .sub-inner {
    max-width: 680px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  /* Live badge */
  .sub-live-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(227,252,2,0.07);
    border: 1px solid rgba(227,252,2,0.18);
    border-radius: 100px;
    padding: 6px 18px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: rgba(255,255,255,0.75);
    margin-bottom: 2rem;
    letter-spacing: 0.02em;

    /* Entrance */
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .footer-subscribe.in-view .sub-live-badge {
    opacity: 1;
    transform: translateY(0);
  }

  /* Pulsing dot */
  .sub-live-dot {
    width: 8px;
    height: 8px;
    background: #E3FC02;
    border-radius: 50%;
    flex-shrink: 0;
    animation: dotPulse 2s ease-in-out infinite;
  }

  @keyframes dotPulse {
    0%   { box-shadow: 0 0 0 0 rgba(227,252,2,0.7); }
    70%  { box-shadow: 0 0 0 8px rgba(227,252,2,0); }
    100% { box-shadow: 0 0 0 0 rgba(227,252,2,0); }
  }

  /* Heading with word-by-word reveal */
  .sub-heading {
    font-size: clamp(2.4rem, 5.5vw, 4rem);
    font-weight: 900;
    color: #ffffff;
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 0.3em;
  }

  .sub-word {
    display: inline-block;
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.55s cubic-bezier(0.34,1.56,0.64,1),
                transform 0.55s cubic-bezier(0.34,1.56,0.64,1);
  }

  .sub-word:nth-child(2) { transition-delay: 0.12s; }
  .sub-word:nth-child(3) { transition-delay: 0.24s; }

  /* Accent word in neon yellow */
  .sub-word--accent { color: #E3FC02; }

  .footer-subscribe.in-view .sub-word {
    opacity: 1;
    transform: translateY(0);
  }

  /* Subtext */
  .sub-text {
    font-size: 1.0625rem;
    color: rgba(255,255,255,0.5);
    line-height: 1.75;
    margin-bottom: 2.75rem;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.55s ease 0.36s, transform 0.55s ease 0.36s;
  }

  .footer-subscribe.in-view .sub-text {
    opacity: 1;
    transform: translateY(0);
  }

  /* Form */
  .sub-form {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.55s ease 0.48s, transform 0.55s ease 0.48s;
  }

  .footer-subscribe.in-view .sub-form {
    opacity: 1;
    transform: translateY(0);
  }

  .sub-field-wrap { margin-bottom: 1rem; }

  .sub-field {
    display: flex;
    align-items: stretch;
    max-width: 560px;
    margin: 0 auto;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 0.875rem;
    overflow: hidden;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .sub-field:focus-within {
    border-color: rgba(227,252,2,0.45);
    box-shadow: 0 0 0 3px rgba(227,252,2,0.08),
                0 0 40px rgba(227,252,2,0.1);
  }

  .sub-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    padding: 1.125rem 1.25rem;
    font-size: 0.9375rem;
    color: #ffffff;
    min-width: 0;
  }

  .sub-input::placeholder { color: rgba(255,255,255,0.28); }

  /* Button */
  .sub-btn {
    background: #E3FC02;
    color: #000000;
    border: none;
    padding: 0 1.75rem;
    font-size: 0.9375rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
    transition: background 0.25s ease, transform 0.25s cubic-bezier(0.34,1.56,0.64,1);
    letter-spacing: 0.01em;
  }

  /* Shine sweep on hover */
  .sub-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 60%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.35), transparent);
    transition: left 0.45s ease;
  }

  .sub-btn:hover::before { left: 160%; }
  .sub-btn:hover {
    background: #f1ff10;
    transform: scale(1.04);
  }

  /* Arrow nudge animation */
  .sub-btn-arrow svg {
    animation: arrowNudge 1.8s ease-in-out infinite;
    display: block;
  }

  @keyframes arrowNudge {
    0%, 100% { transform: translateX(0); }
    50%       { transform: translateX(5px); }
  }

  .sub-btn:hover .sub-btn-arrow svg {
    animation: none;
    transform: translateX(6px);
  }

  /* Loading spinner */
  .sub-btn-spinner {
    display: none;
    width: 16px;
    height: 16px;
    border: 2px solid rgba(0,0,0,0.25);
    border-top-color: #000;
    border-radius: 50%;
    animation: spin 0.65s linear infinite;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  .sub-btn.loading .sub-btn-text,
  .sub-btn.loading .sub-btn-arrow { display: none; }
  .sub-btn.loading .sub-btn-spinner { display: block; }

  /* Error */
  .sub-error {
    color: #ff6b6b;
    font-size: 0.8125rem;
    margin-top: 0.625rem;
    text-align: center;
  }

  /* Success */
  .sub-success {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    max-width: 560px;
    margin: 0 auto;
    padding: 1.25rem;
    background: rgba(227,252,2,0.07);
    border: 1px solid rgba(227,252,2,0.25);
    border-radius: 0.875rem;
    color: #E3FC02;
    font-weight: 700;
    font-size: 1rem;
    animation: successPop 0.6s cubic-bezier(0.34,1.56,0.64,1);
  }

  @keyframes successPop {
    from { opacity: 0; transform: scale(0.85); }
    to   { opacity: 1; transform: scale(1); }
  }

  /* Privacy note */
  .sub-privacy {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.22);
    margin-top: 1.25rem;
    opacity: 0;
    transition: opacity 0.55s ease 0.6s;
  }

  .footer-subscribe.in-view .sub-privacy { opacity: 1; }

  /* ===========================================
     FOOTER MAIN
     =========================================== */

  .footer-main {
    background: #1F1F21;
    color: #bbb;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 24px 32px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 50px;
  }

  .brand-title {
    color: #fff;
    font-size: 1.375rem;
    font-weight: 800;
    margin-bottom: 0.875rem;
  }

  .brand-description {
    color: #666;
    font-size: 0.9rem;
    line-height: 1.65;
    margin-bottom: 1.5rem;
    max-width: 340px;
  }

  .footer-col-title {
    color: #fff;
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-links li { margin-bottom: 0.75rem; }

  .footer-links a {
    color: #666;
    text-decoration: none;
    font-size: 0.9375rem;
    transition: color 0.25s ease, padding-left 0.25s ease;
    display: inline-block;
  }

  .footer-links a:hover {
    color: #E3FC02;
    padding-left: 4px;
  }

  /* ===========================================
     WEB3 SOCIAL ICONS - NEON ACTIVATION
     =========================================== */

  .social-links {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(227, 252, 2, 0.15);
    border-radius: 50%;
    background: rgba(255,255,255,0.02);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: rgba(227, 252, 2, 0.4); /* Low-opacity neon base state */
    text-decoration: none;
    position: relative;
    opacity: 0;
    animation: springIn 0.5s cubic-bezier(0.34,1.56,0.64,1) forwards;
    transition: color 0.3s ease, 
                border-color 0.3s ease,
                background 0.3s ease, 
                box-shadow 0.3s ease,
                filter 0.3s ease;
  }

  .social-link:nth-child(1) { animation-delay: 0.05s; }
  .social-link:nth-child(2) { animation-delay: 0.15s; }
  .social-link:nth-child(3) { animation-delay: 0.25s; }
  .social-link:nth-child(4) { animation-delay: 0.35s; }
  .social-link:nth-child(5) { animation-delay: 0.45s; }

  @keyframes springIn {
    0%   { opacity: 0; transform: scale(0) rotate(-90deg); }
    60%  { transform: scale(1.15) rotate(5deg); }
    100% { opacity: 1; transform: scale(1) rotate(0); }
  }

  /* NEON ACTIVATION - Hover State */
  .social-link:hover {
    border-color: #E3FC02;
    color: #E3FC02; /* Full neon yellow */
    background: rgba(227,252,2,0.08);
    box-shadow: 0 0 18px rgba(227,252,2,0.3),
                inset 0 0 12px rgba(227,252,2,0.1);
    filter: drop-shadow(0 0 5px #E3FC02); /* Neon glow effect */
    transform: translateY(-2px) scale(1.05);
  }

  /* Surgical line-art icons stay crisp */
  .social-link svg {
    transition: transform 0.3s ease;
  }

  .social-link:hover svg {
    transform: scale(1.1);
  }

  /* ===========================================
     FOOTER BOTTOM
     =========================================== */

  .footer-bottom {
    border-top: 1px solid #252527;
    margin-top: 3rem;
    padding-top: 1.25rem;
    text-align: center;
    font-size: 0.8125rem;
    color: #444;
  }

  /* ===========================================
     WHATSAPP FLOAT - TENDA NEON AESTHETIC
     =========================================== */

  .whatsapp-float {
    position: fixed;
    bottom: 88px;
    right: 28px;
    width: 48px;
    height: 48px;
    background: rgba(20, 20, 22, 0.92);
    border: 1.5px solid rgba(227, 252, 2, 0.35);
    border-radius: 50%;
    color: #E3FC02;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 9998;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    text-decoration: none;
    animation: dotPulse 2.5s ease-in-out infinite;
  }

  .whatsapp-float:hover {
    background: #E3FC02;
    color: #000;
    border-color: #E3FC02;
    transform: translateY(-4px) scale(1.1);
    box-shadow: 0 8px 24px rgba(227, 252, 2, 0.35);
    animation: none;
  }

  /* ===========================================
     BACK TO TOP
     =========================================== */

  .back-to-top {
    position: fixed;
    bottom: 28px;
    right: 28px;
    width: 48px;
    height: 48px;
    background: rgba(20,20,22,0.92);
    border: 1.5px solid rgba(227,252,2,0.35);
    border-radius: 50%;
    color: #E3FC02;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: all 0.3s cubic-bezier(0.34,1.56,0.64,1);
    z-index: 9999;
    animation: dotPulse 2.5s ease-in-out infinite;
  }

  .back-to-top.visible {
    opacity: 1;
    visibility: visible;
  }

  .back-to-top:hover {
    background: #E3FC02;
    color: #000;
    border-color: #E3FC02;
    transform: translateY(-4px) scale(1.1);
    box-shadow: 0 8px 24px rgba(227,252,2,0.35);
    animation: none;
  }

  /* ===========================================
     RESPONSIVE
     =========================================== */

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
    }
    .footer-brand { grid-column: 1 / -1; }
  }

  @media (max-width: 640px) {
    .footer-subscribe { padding: 72px 20px 64px; }
    .sub-heading { font-size: 2.2rem; }
    .sub-field { flex-direction: column; border-radius: 0.875rem; }
    .sub-btn { padding: 1rem; justify-content: center; border-radius: 0; }
    .footer-grid { grid-template-columns: 1fr; gap: 28px; }
    .footer-brand { grid-column: auto; }
    
    .whatsapp-float {
      bottom: 74px;
      right: 20px;
      width: 42px;
      height: 42px;
    }
    
    .back-to-top {
      bottom: 20px;
      right: 20px;
      width: 42px;
      height: 42px;
    }
  }

  /* =========================================
     LIGHT MODE OVERRIDES
     =========================================
     Applied when html[data-theme="light"]
     All footer sections adapt to the light palette
     ========================================= */

  html[data-theme="light"] .footer-subscribe {
    background: #F5F5F7;
    border-top: 1px solid rgba(0,0,0,0.07);
    border-bottom: 1px solid rgba(0,0,0,0.07);
  }

  html[data-theme="light"] .sub-heading {
    color: #1D1D1F;
  }

  html[data-theme="light"] .sub-heading .sub-word--accent {
    background: linear-gradient(135deg, #7a6c00 0%, #5a5000 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  html[data-theme="light"] .sub-text,
  html[data-theme="light"] .sub-privacy {
    color: #6E6E73;
  }

  html[data-theme="light"] .sub-field {
    background: rgba(255,255,255,0.9);
    border-color: rgba(0,0,0,0.1);
    box-shadow: 0 2px 16px rgba(0,0,0,0.06);
  }

  html[data-theme="light"] .sub-input {
    color: #1D1D1F;
    background: transparent;
  }

  html[data-theme="light"] .sub-input::placeholder {
    color: #98989D;
  }

  html[data-theme="light"] .footer-main {
    background: #FFFFFF;
    color: #6E6E73;
    border-top: 1px solid rgba(0,0,0,0.07);
  }

  html[data-theme="light"] .brand-title {
    color: #1D1D1F;
  }

  html[data-theme="light"] .brand-description {
    color: #6E6E73;
  }

  html[data-theme="light"] .footer-col-title {
    color: #1D1D1F;
  }

  html[data-theme="light"] .footer-col-title::after {
    background: rgba(180,160,0,0.5);
  }

  html[data-theme="light"] .footer-link {
    color: #6E6E73;
  }

  html[data-theme="light"] .footer-link:hover {
    color: #5A5000;
  }

  html[data-theme="light"] .footer-bottom {
    background: #F5F5F7;
    border-top-color: rgba(0,0,0,0.07);
  }

  html[data-theme="light"] .footer-bottom-text,
  html[data-theme="light"] .footer-copy {
    color: #98989D;
  }

  html[data-theme="light"] .social-link {
    background: rgba(0,0,0,0.05);
    border-color: rgba(0,0,0,0.08);
    color: #6E6E73;
  }

  html[data-theme="light"] .social-link:hover {
    background: rgba(0,0,0,0.08);
    color: #1D1D1F;
  }

  html[data-theme="light"] .back-to-top {
    background: rgba(0,0,0,0.08);
    color: #1D1D1F;
    border-color: rgba(0,0,0,0.1);
  }

  html[data-theme="light"] .back-to-top:hover {
    background: rgba(0,0,0,0.13);
  }

  html[data-theme="light"] .whatsapp-float {
    box-shadow: 0 4px 20px rgba(37,211,102,0.25), 0 2px 8px rgba(0,0,0,0.1);
  }

</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {

    /* ---- Subscribe section scroll reveal ---- */
    const subscribeSection = document.getElementById('footerSubscribe');
    const cursorGlow = document.getElementById('subCursorGlow');
    const parallaxGrain = subscribeSection ? subscribeSection.querySelector('.sub-grain') : null;

    if (subscribeSection) {
      const io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });
      io.observe(subscribeSection);
    }

    /* ---- Cursor glow follow ---- */
    if (subscribeSection && cursorGlow) {
      subscribeSection.addEventListener('mousemove', function (e) {
        var rect = subscribeSection.getBoundingClientRect();
        cursorGlow.style.left = (e.clientX - rect.left) + 'px';
        cursorGlow.style.top  = (e.clientY - rect.top)  + 'px';
      });
    }

    /* ---- Parallax grain on scroll ---- */
    if (parallaxGrain && subscribeSection) {
      window.addEventListener('scroll', function () {
        var rect = subscribeSection.getBoundingClientRect();
        var progress = (window.innerHeight - rect.top) / window.innerHeight;
        parallaxGrain.style.transform = 'translate(' + (progress * -2) + '%, ' + (progress * 25) + 'px)';
      }, { passive: true });
    }

    /* ---- Form loading state ---- */
    var subForm = document.getElementById('FooterNewsletterForm');
    var subBtn  = document.getElementById('FooterSubBtn');

    if (subForm && subBtn) {
      subForm.addEventListener('submit', function () {
        subBtn.classList.add('loading');
        subBtn.disabled = true;
      });
    }

    /* ---- Magnetic social icons ---- */
    document.querySelectorAll('[data-magnetic]').forEach(function (link) {
      link.addEventListener('mousemove', function (e) {
        var rect = this.getBoundingClientRect();
        var x = e.clientX - rect.left - rect.width  / 2;
        var y = e.clientY - rect.top  - rect.height / 2;
        var dist = Math.sqrt(x * x + y * y);
        var maxDist = 70;
        if (dist < maxDist) {
          var pull = (maxDist - dist) / maxDist;
          this.style.transform = 'translate(' + (x * pull * 0.28) + 'px,' + (y * pull * 0.28) + 'px) scale(1.06)';
        }
      });
      link.addEventListener('mouseleave', function () {
        this.style.transform = '';
      });
    });

    /* ---- Back to top ---- */
    var backToTop = document.getElementById('backToTop');
    if (backToTop) {
      window.addEventListener('scroll', function () {
        backToTop.classList.toggle('visible', window.pageYOffset > 400);
      }, { passive: true });
      backToTop.addEventListener('click', function () {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

  });
</script>

