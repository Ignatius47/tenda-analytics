{% comment %}
  Tenda Live-Insight Blog Hub
  Immersive, interactive grid with direct content integration
{% endcomment %}

<style>
:root {
  --neon: #E3FC02;
  --neon-glow: rgba(227, 252, 2, 0.4);
  --neon-subtle: rgba(227, 252, 2, 0.15);
  --neon-border: rgba(227, 252, 2, 0.1);
  --bg: #1F1F21;
  --glass: rgba(255, 255, 255, 0.03);
  --text: #f5f5f7;
  --muted: rgba(245, 245, 247, 0.6);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  overflow-x: hidden;
}

/* ===================================
   READING PROGRESS INDICATOR
   =================================== */

.reading-progress {
  position: fixed;
  top: 0;
  left: 0;
  width: 0;
  height: 3px;
  background: var(--neon);
  box-shadow: 0 0 15px var(--neon-glow);
  z-index: 10001;
  transition: width 0.1s ease;
}

/* ===================================
   BLOG HUB CONTAINER
   =================================== */

.blog-hub {
  background: linear-gradient(180deg, 
    #1F1F21 0%,
    #171719 15%,
    #1F1F21 50%,
    #171719 100%
  );
  min-height: 100vh;
  padding-bottom: 10vh;
}

/* ===================================
   HERO SECTION
   =================================== */

.blog-hero {
  text-align: center;
  padding: 15vh 5% 8vh;
  position: relative;
  border-bottom: 1px solid var(--neon-border);
}

.blog-hero::before {
  content: '';
  position: absolute;
  top: 0;
  left: 20%;
  right: 20%;
  height: 1px;
  background: linear-gradient(90deg,
    transparent 0%,
    var(--neon) 50%,
    transparent 100%
  );
}

.hero-eyebrow {
  font-size: 0.875rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--neon);
  margin-bottom: 1.5rem;
}

.hero-title {
  font-size: clamp(2.5rem, 6vw, 4.5rem);
  font-weight: 800;
  line-height: 1.1;
  margin-bottom: 1.5rem;
}

.hero-subtitle {
  font-size: clamp(1.125rem, 2vw, 1.375rem);
  color: var(--muted);
  max-width: 700px;
  margin: 0 auto;
  line-height: 1.6;
}

/* ===================================
   STICKY CATEGORY FILTERS
   =================================== */

.category-filters {
  position: sticky;
  top: 80px;
  z-index: 100;
  background: rgba(31, 31, 33, 0.95);
  backdrop-filter: blur(30px);
  border-bottom: 1px solid var(--neon-border);
  padding: 1.5rem 5%;
  display: flex;
  justify-content: center;
  gap: 0.75rem;
  flex-wrap: wrap;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
}

.filter-pill {
  padding: 0.75rem 1.5rem;
  border-radius: 980px;
  border: 1.5px solid rgba(255, 255, 255, 0.1);
  background: var(--glass);
  color: var(--muted);
  font-size: 0.9375rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  white-space: nowrap;
}

.filter-pill:hover {
  border-color: rgba(227, 252, 2, 0.3);
  background: rgba(227, 252, 2, 0.05);
  color: var(--text);
}

.filter-pill.active {
  background: var(--neon);
  color: #000;
  border-color: var(--neon);
  box-shadow: 0 4px 20px var(--neon-glow);
}

/* ===================================
   MASONRY GRID - 3 COLUMNS
   =================================== */

.blog-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 5vh 5%;
}

.blog-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
  margin-top: 3rem;
}

/* Hero Card - Spans 2 Columns */
.blog-card.hero-card {
  grid-column: span 2;
  grid-row: span 2;
}

/* ===================================
   BLOG CARD DESIGN
   =================================== */

.blog-card {
  background: var(--glass);
  backdrop-filter: blur(20px);
  border: 0.5px solid var(--neon-border);
  border-top: 2px solid var(--neon);
  border-radius: 24px;
  padding: 0;
  position: relative;
  cursor: pointer;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  overflow: hidden;
  opacity: 0;
  transform: translateY(30px);
}

.blog-card.visible {
  opacity: 1;
  transform: translateY(0);
}

/* Neon Top Border with Glow */
.blog-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: var(--neon);
  box-shadow: 0 0 10px var(--neon-glow);
  transition: all 0.4s ease;
}

/* Data-Pulse Hover Effect */
.blog-card:hover {
  transform: translateY(-10px);
  border-color: var(--neon);
  box-shadow: 0 20px 60px rgba(0,0,0,0.6), 0 0 40px var(--neon-subtle);
  backdrop-filter: blur(40px);
}

.blog-card:hover::before {
  height: 4px;
  box-shadow: 0 0 25px var(--neon-glow), 0 0 50px rgba(227, 252, 2, 0.2);
}

/* Card Image */
.card-image {
  width: 100%;
  height: 240px;
  object-fit: cover;
  display: block;
}

.blog-card.hero-card .card-image {
  height: 400px;
}

/* Card Content */
.card-content {
  padding: 2rem;
}

.blog-card.hero-card .card-content {
  padding: 2.5rem;
}

/* Category Badge */
.card-category {
  display: inline-block;
  padding: 0.375rem 0.75rem;
  background: rgba(227, 252, 2, 0.1);
  border: 1px solid rgba(227, 252, 2, 0.2);
  border-radius: 6px;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--neon);
  margin-bottom: 1rem;
}

/* Card Title */
.card-title {
  font-size: 1.375rem;
  font-weight: 700;
  line-height: 1.3;
  margin-bottom: 0.75rem;
  color: var(--text);
}

.blog-card.hero-card .card-title {
  font-size: 2rem;
  margin-bottom: 1rem;
}

/* Card Excerpt */
.card-excerpt {
  font-size: 0.9375rem;
  line-height: 1.6;
  color: var(--muted);
  margin-bottom: 1.5rem;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.blog-card.hero-card .card-excerpt {
  font-size: 1.0625rem;
  -webkit-line-clamp: 4;
}

/* Card Meta */
.card-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 0.875rem;
  color: var(--muted);
}

.card-date {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.card-read-time {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--neon);
  font-weight: 600;
}

/* ===================================
   ARTICLE MODAL (READER MODE)
   =================================== */

.article-modal {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.95);
  backdrop-filter: blur(30px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.4s ease;
  padding: 2rem;
}

.article-modal.active {
  opacity: 1;
  visibility: visible;
}

.article-content-wrapper {
  background: rgba(31, 31, 33, 0.98);
  backdrop-filter: blur(40px);
  border: 1px solid var(--neon-border);
  border-radius: 24px;
  max-width: 900px;
  max-height: 90vh;
  width: 100%;
  overflow-y: auto;
  position: relative;
  box-shadow: 0 0 60px rgba(0, 0, 0, 0.8), 0 0 40px var(--neon-subtle);
  transform: scale(0.95);
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.article-modal.active .article-content-wrapper {
  transform: scale(1);
}

/* Custom Scrollbar for Modal */
.article-content-wrapper::-webkit-scrollbar {
  width: 6px;
}

.article-content-wrapper::-webkit-scrollbar-track {
  background: #121212;
}

.article-content-wrapper::-webkit-scrollbar-thumb {
  background: var(--neon);
  border-radius: 10px;
  box-shadow: 0 0 10px var(--neon-glow);
}

/* Close Button */
.modal-close {
  position: sticky;
  top: 2rem;
  right: 2rem;
  margin-left: auto;
  width: 44px;
  height: 44px;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
  border: 1.5px solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.3s ease;
  z-index: 10;
  margin-bottom: -44px;
}

.modal-close:hover {
  background: rgba(227, 252, 2, 0.2);
  border-color: var(--neon);
  transform: scale(1.1);
  box-shadow: 0 0 20px var(--neon-glow);
}

.modal-close svg {
  width: 20px;
  height: 20px;
  stroke: var(--text);
  transition: stroke 0.3s ease;
}

.modal-close:hover svg {
  stroke: var(--neon);
}

/* Article Content */
.article-content {
  padding: 3rem;
}

.article-header {
  margin-bottom: 2rem;
  padding-bottom: 2rem;
  border-bottom: 1px solid var(--neon-border);
}

.article-title {
  font-size: 2.5rem;
  font-weight: 800;
  line-height: 1.2;
  margin-bottom: 1.5rem;
}

.article-meta {
  display: flex;
  align-items: center;
  gap: 2rem;
  font-size: 0.9375rem;
  color: var(--muted);
}

.article-body {
  font-size: 1.125rem;
  line-height: 1.8;
  color: var(--text);
}

.article-body p {
  margin-bottom: 1.5rem;
}

.article-body h2 {
  font-size: 1.75rem;
  font-weight: 700;
  margin: 2.5rem 0 1rem;
  color: var(--text);
}

.article-body h3 {
  font-size: 1.375rem;
  font-weight: 600;
  margin: 2rem 0 1rem;
  color: var(--text);
}

.article-body img {
  width: 100%;
  border-radius: 16px;
  margin: 2rem 0;
}

.article-body blockquote {
  padding: 1.5rem;
  background: var(--glass);
  border-left: 4px solid var(--neon);
  border-radius: 12px;
  margin: 2rem 0;
  font-style: italic;
  color: var(--muted);
}

/* ===================================
   FLOATING NEWSLETTER TRIGGER
   =================================== */

.newsletter-float {
  position: fixed;
  bottom: 88px;
  right: 28px;
  width: auto;
  padding: 1rem 1.5rem;
  background: var(--neon);
  color: #000;
  border: none;
  border-radius: 980px;
  font-size: 0.9375rem;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 4px 20px var(--neon-glow);
  z-index: 9999;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  align-items: center;
  gap: 0.5rem;
  white-space: nowrap;
}

.newsletter-float:hover {
  transform: translateY(-4px) scale(1.05);
  box-shadow: 0 8px 30px var(--neon-glow);
}

/* ===================================
   RESPONSIVE
   =================================== */

@media (max-width: 1024px) {
  .blog-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .blog-card.hero-card {
    grid-column: span 2;
    grid-row: span 1;
  }

  .blog-card.hero-card .card-image {
    height: 300px;
  }
}

@media (max-width: 768px) {
  .blog-grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .blog-card.hero-card {
    grid-column: span 1;
  }

  .category-filters {
    top: 60px;
    padding: 1rem 5%;
  }

  .filter-pill {
    font-size: 0.875rem;
    padding: 0.625rem 1.25rem;
  }

  .article-content {
    padding: 2rem;
  }

  .article-title {
    font-size: 2rem;
  }

  .newsletter-float {
    bottom: 74px;
    right: 20px;
    padding: 0.875rem 1.25rem;
    font-size: 0.875rem;
  }
}

@media (max-width: 640px) {
  .card-meta {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .article-modal {
    padding: 1rem;
  }

  .article-content {
    padding: 1.5rem;
  }
}

/* ===================================
