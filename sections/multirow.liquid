  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
  background-image: 
    linear-gradient(rgba(227, 252, 2, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(227, 252, 2, 0.03) 1px, transparent 1px);
  background-size: 50px 50px;
  background-position: center center;
}

/* Grid Pulse Animation on Interaction */
@keyframes grid-pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 1.5;
  }
}

body:hover::before {
  animation: grid-pulse 3s ease-in-out infinite;
}

/* ===================================
   2. MOUSE SPOTLIGHT - INTERACTIVE GLOW
   =================================== */

/* Cursor-Following Radial Gradient */
#mouseSpotlight {
  position: fixed;
  width: 600px;
  height: 600px;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(227, 252, 2, 0.08) 0%,
    rgba(227, 252, 2, 0.04) 30%,
    transparent 70%
  );
  pointer-events: none;
  z-index: 1;
  transform: translate(-50%, -50%);
  transition: opacity 0.3s ease;
  opacity: 0;
  mix-blend-mode: screen;
}

#mouseSpotlight.active {
  opacity: 1;
}

/* Enhanced Spotlight on Click */
#mouseSpotlight.pulse {
  animation: spotlight-pulse 0.6s ease-out;
}

@keyframes spotlight-pulse {
  0% {
    transform: translate(-50%, -50%) scale(1);
  }
  50% {
    transform: translate(-50%, -50%) scale(1.2);
    opacity: 1;
  }
  100% {
    transform: translate(-50%, -50%) scale(1);
  }
}

/* ===================================
   3. FLOATING DATA NODES - ANIMATED DEPTH
   =================================== */

/* Nodes Container */
.data-nodes-layer {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  pointer-events: none;
  overflow: hidden;
}

/* Individual Data Node */
.data-node {
  position: absolute;
  border-radius: 50%;
  background: #E3FC02;
  box-shadow: 0 0 8px rgba(227, 252, 2, 0.6);
  animation: float-node ease-in-out infinite;
  will-change: transform;
  transition: transform 0.3s ease;
}

/* Node Size Variations */
.data-node.small {
  width: 2px;
  height: 2px;
  opacity: 0.4;
  animation-duration: 8s;
}

.data-node.medium {
  width: 3px;
  height: 3px;
  opacity: 0.5;
  animation-duration: 10s;
}

.data-node.large {
  width: 4px;
  height: 4px;
  opacity: 0.6;
  animation-duration: 12s;
}

/* Floating Animation - 3D Parallax Effect */
@keyframes float-node {
  0%, 100% {
    transform: translateY(0) translateX(0);
  }
  25% {
    transform: translateY(-20px) translateX(10px);
  }
  50% {
    transform: translateY(-40px) translateX(-10px);
  }
  75% {
    transform: translateY(-20px) translateX(15px);
  }
}

/* Parallax Speed Variations */
.data-node[data-speed="slow"] {
  animation-duration: 15s;
}

.data-node[data-speed="fast"] {
  animation-duration: 6s;
}

/* ===================================
   4. GRID FADE MASKS - VIDEO INTEGRATION
   =================================== */

/* Top Gradient Fade */
.grid-fade-top {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 200px;
  background: linear-gradient(180deg, #000000 0%, transparent 100%);
  z-index: 2;
  pointer-events: none;
}

/* Bottom Gradient Fade */
.grid-fade-bottom {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 200px;
  background: linear-gradient(0deg, #000000 0%, transparent 100%);
  z-index: 2;
  pointer-events: none;
}

/* ===================================
   5. "PLUGGED IN" SECTION BORDERS
   =================================== */

/* Enhanced Section Borders */
.section {
  position: relative;
  z-index: 10;
  border-top: 1px solid rgba(227, 252, 2, 0.05);
  border-bottom: 1px solid rgba(227, 252, 2, 0.05);
}

/* Animated Top Border on Hover */
.section::before {
  content: '';
  position: absolute;
  top: -1px;
  left: 0;
  width: 100%;
  height: 1px;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(227, 252, 2, 0.3) 50%,
    transparent 100%
  );
  opacity: 0;
  transition: opacity 0.5s ease;
}

.section:hover::before {
  opacity: 1;
}

/* Animated Bottom Border on Hover */
.section::after {
  content: '';
  position: absolute;
  bottom: -1px;
  left: 0;
  width: 100%;
  height: 1px;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(227, 252, 2, 0.3) 50%,
    transparent 100%
  );
  opacity: 0;
  transition: opacity 0.5s ease;
}

.section:hover::after {
  opacity: 1;
}

/* ===================================
   6. Z-INDEX HIERARCHY
   =================================== */

/* Ensure content sits above background layers */
.section,
.container,
.hero-video-wrapper,
main,
header,
footer,
.tenda-ticker-wrap,
.insight-bubble-trigger,
.insight-drawer-wrapper,
.drawer-backdrop {
  position: relative;
  z-index: 10;
}

/* Background layers stay behind */
body::before,
#mouseSpotlight,
.data-nodes-layer,
.grid-fade-top,
.grid-fade-bottom {
  z-index: 0 !important;
}

/* Exceptions for modals */
.tenda-modal-overlay,
.calendly-overlay,
.waitlist-modal-overlay {
  z-index: 10000 !important;
}

/* ===================================
   7. RESPONSIVE OPTIMIZATIONS
   =================================== */

/* Mobile: Reduce background complexity */
@media (max-width: 768px) {
  body::before {
    background-size: 75px 75px;
    opacity: 0.5;
  }

  #mouseSpotlight {
    width: 400px;
    height: 400px;
    display: none; /* Disable on mobile for performance */
  }

  .data-node {
    display: none; /* Hide nodes on mobile */
  }

  .grid-fade-top,
  .grid-fade-bottom {
    height: 100px;
  }
}

/* Tablet */
@media (min-width: 769px) and (max-width: 1024px) {
  body::before {
    background-size: 60px 60px;
  }

  #mouseSpotlight {
    width: 500px;
    height: 500px;
  }

  .data-node {
    opacity: 0.5;
  }
}

/* Desktop: Full effects */
@media (min-width: 1025px) {
  body::before {
    background-size: 50px 50px;
  }

  #mouseSpotlight {
    width: 600px;
    height: 600px;
  }
}

/* ===================================
   8. PERFORMANCE OPTIMIZATIONS
   =================================== */

/* Reduce motion for accessibility */
@media (prefers-reduced-motion: reduce) {
  body::before {
    animation: none !important;
  }

  #mouseSpotlight {
    display: none;
  }

  .data-node {
    animation: none !important;
    display: none;
  }

  .section::before,
  .section::after {
    transition: none;
  }
}

/* GPU acceleration for smooth animations */
#mouseSpotlight,
.data-node {
  transform: translateZ(0);
  backface-visibility: hidden;
  will-change: transform;
}


