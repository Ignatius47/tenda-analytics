  }

  .search-pill-trigger:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(227,252,2,0.35);
    transform: scale(1.08);
  }

  .search-pill-trigger .header__icon {
    width: 40px !important;
    height: 40px !important;
    background: transparent !important;
    border-radius: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  /* Expanded form container - positioned below header */
  .search-pill-expanded {
    position: fixed;
    top: var(--header-height);
    right: 1.5rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    z-index: 10100;
    transition: none; /* Animation handled by keyframe */
  }

  /* Hide trigger when expanded */
  .header__search details[open] .search-pill-trigger {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  /* Show expanded form */
  .header__search details[open] .search-pill-expanded {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Genie open animation from search icon origin */
  @keyframes searchGenieOpen {
    0%   { transform: scale(0.05) translateY(-20px); opacity: 0; filter: blur(10px); }
    40%  { opacity: 1; filter: blur(0); }
    70%  { transform: scale(1.04) translateY(0); }
    85%  { transform: scale(0.98) translateY(0); }
    100% { transform: scale(1) translateY(0); opacity: 1; filter: blur(0); }
  }

  /* Genie close animation back to icon origin */
  @keyframes searchGenieClose {
    0%   { transform: scale(1) translateY(0); opacity: 1; filter: blur(0); }
    20%  { transform: scale(1.03) translateY(0); }
    100% { transform: scale(0.05) translateY(-20px); opacity: 0; filter: blur(10px); }
  }

  /* Search pill with genie animation */
  .search-pill {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    width: 320px;
    height: 46px;
    background: rgba(31, 31, 33, 0.92);
    border: 1px solid rgba(227,252,2,0.45);
    border-radius: 23px;
    overflow: hidden;
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    position: relative;
    box-shadow: 
      0 8px 32px rgba(0,0,0,0.5),
      0 0 0 1px rgba(227,252,2,0.2),
      inset 0 1px 0 rgba(255,255,255,0.1);
    /* Default: invisible, genie animation will reveal */
    opacity: 0;
    transform: scale(0.05) translateY(-20px);
  }

  /* Apply genie-open when details open */
  .header__search details[open] .search-pill {
    animation: searchGenieOpen 0.5s cubic-bezier(0.34,1.56,0.64,1) forwards;
  }

  /* Apply genie-close when closing */
  .search-pill.genie-closing {
    animation: searchGenieClose 0.35s cubic-bezier(0.4,0,0.8,0.2) forwards !important;
  }

  /* Top-edge neon seam */
  .search-pill::before {
    content: '';
    position: absolute;
    top: 0; left: 15%; right: 15%;
    height: 1px;
    background: linear-gradient(90deg, 
      transparent 0%, 
      rgba(227,252,2,0.6) 50%, 
      transparent 100%
    );
    pointer-events: none;
  }

  /* Icon stays at left edge */
  .search-pill .header__icon {
    width: 46px !important;
    height: 46px !important;
    min-width: 46px !important;
    flex-shrink: 0;
    background: transparent !important;
    border-radius: 0 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  /* Input field */
  .search-pill__input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--header-text);
    font-size: 0.9375rem;
    padding: 0 14px 0 0;
    outline: none;
    opacity: 0;
    transition: opacity 0.25s ease 0.2s;
  }

  .header__search details[open] .search-pill__input {
    opacity: 1;
  }

  .search-pill__input::placeholder {
    color: var(--header-text-muted);
  }

  .search-pill__input:focus {
    caret-color: var(--header-accent);
  }

  /* Submit arrow button */
  .search-pill__submit {
    width: 34px;
    height: 34px;
    min-width: 34px;
    flex-shrink: 0;
    background: rgba(227,252,2,0.12);
    border: 1px solid rgba(227,252,2,0.28);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    margin-right: 6px;
    opacity: 0;
    transition: all 0.28s cubic-bezier(0.34,1.56,0.64,1), opacity 0.25s ease 0.2s;
  }

  .header__search details[open] .search-pill__submit {
    opacity: 1;
  }

  .search-pill__submit svg {
    width: 14px;
    height: 14px;
    stroke: var(--header-accent);
    fill: none;
  }

  .search-pill__submit:hover {
    background: var(--header-accent);
    transform: scale(1.14);
    box-shadow: 0 2px 12px rgba(227,252,2,0.35);
  }

  .search-pill__submit:hover svg {
    stroke: #000;
  }

  /* Mobile positioning */
  @media screen and (max-width: 1023px) {
    .search-pill-expanded {
      right: 1rem;
      left: 1rem;
      right: auto;
      width: calc(100% - 2rem);
    }

    .search-pill {
      width: 100%;
    }
  }

  /* Desktop: No nav shift needed since search is below header now */
  @media screen and (min-width: 1024px) {
  /* Services trigger with inline chevron */
  .services-trigger {
    position: relative !important;
    padding-right: 0 !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 0.5rem !important; /* Space between text and arrow */
    cursor: pointer;
    background: none;
    border: none;
    color: inherit;
  }

  /* Animated chevron - positioned inline */
  .services-trigger::after {
    content: '';
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 4px solid rgba(255,255,255,0.5);
    transition: transform 0.35s cubic-bezier(0.34,1.56,0.64,1),
                border-top-color 0.25s ease,
                opacity 0.25s ease;
    opacity: 0.7;
    /* NOT absolute - flows inline */
    position: relative;
    flex-shrink: 0;
  }

  /* Rotate chevron when open */
  .services-trigger.is-open::after {
    transform: rotate(180deg);
    border-top-color: var(--header-accent);
    opacity: 1;
  }

  /* Also rotate on hover (desktop only) */
  .has-submenu:hover .services-trigger::after {
    transform: rotate(180deg);
    border-top-color: var(--header-accent);
    opacity: 1;
  }

  /* Ensure submenu opens on hover too */
  .has-submenu:hover .header__submenu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) scale(1) translateY(0);
  }

  /* Prevent gap issues */
  .has-submenu::before {
    content: '';
    position: absolute;
    bottom: -12px;
    left: 0;
    right: 0;
    height: 12px;
    background: transparent;
    pointer-events: auto;
  }
}

/* ===================================
   MOBILE: COMPLETE NAVIGATION FIX
   =================================== */

@media screen and (max-width: 1023px) {
  
  /* ===================================
     FULL SCREEN DRAWER - NO BODY SCROLL
     =================================== */
  
  .menu-drawer,
  .header__inline-menu {
    position: fixed !important;
    top: var(--header-height) !important;
    left: 0 !important;
    width: 100vw !important;
    height: calc(100vh - var(--header-height)) !important;
    max-height: calc(100vh - var(--header-height)) !important;
    background: var(--header-bg) !important;
    z-index: 9999 !important;
    
    /* Full screen, centered content */
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: flex-start !important;
    
    /* Hidden by default */
    opacity: 0 !important;
    visibility: hidden !important;
    transform: translateX(-100%) !important;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1) !important;
    
    /* Scrollable ONLY when open */
    overflow-y: auto !important;
    overflow-x: hidden !important;
    -webkit-overflow-scrolling: touch !important;
    
    /* Padding for content */
    padding: 2rem 1.5rem 4rem !important;
  }

  /* Active state - slide in */
  .menu-drawer.active,
  .header__inline-menu.active {
    opacity: 1 !important;
    visibility: visible !important;
    transform: translateX(0) !important;
  }

  /* Lock body scroll when menu open */
  body.menu-open {
    overflow: hidden !important;
    position: fixed !important;
    width: 100% !important;
    height: 100% !important;
  }

  /* ===================================
     MENU ITEMS - CENTERED & ALIGNED
     =================================== */

  .header__menu {
    list-style: none;
    padding: 0;
    margin: 0;
    width: 100%;
    max-width: 500px;
    display: flex;
    flex-direction: column;
    align-items: stretch !important; /* Full width items */
  }

  .header__menu-item {
    width: 100%;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    opacity: 0;
    transform: translateX(-50px);
    transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .header__inline-menu.active .header__menu-item {
    opacity: 1 !important;
    transform: translateX(0) !important;
  }

  /* Staggered animation */
  .header__inline-menu.active .header__menu-item:nth-child(1) { transition-delay: 0.1s; }
  .header__inline-menu.active .header__menu-item:nth-child(2) { transition-delay: 0.15s; }
  .header__inline-menu.active .header__menu-item:nth-child(3) { transition-delay: 0.2s; }
  .header__inline-menu.active .header__menu-item:nth-child(4) { transition-delay: 0.25s; }
  .header__inline-menu.active .header__menu-item:nth-child(5) { transition-delay: 0.3s; }
  .header__inline-menu.active .header__menu-item:nth-child(6) { transition-delay: 0.35s; }
  .header__inline-menu.active .header__menu-item:nth-child(7) { transition-delay: 0.4s; }
  .header__inline-menu.active .header__menu-item:nth-child(8) { transition-delay: 0.45s; }

  /* ===================================
     LINKS - CENTERED TEXT
     =================================== */

  .header__menu-item a,
  .header__menu-item button {
    color: var(--header-text) !important;
    text-decoration: none !important;
    font-weight: 600;
    font-size: 1.25rem;
    padding: 1.5rem 2rem;
    display: flex !important;
    align-items: center;
    justify-content: center !important; /* CENTER TEXT */
    text-align: center !important;
    position: relative;
    transition: all 0.3s ease;
    background: none;
    border: none;
    width: 100%;
    cursor: pointer;
  }

  /* Neon indicator on left */
  .header__menu-item a::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%) scaleY(0);
    width: 4px;
    height: 60%;
    background: var(--header-accent);
    box-shadow: 0 0 10px rgba(227, 252, 2, 0.6);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .header__menu-item a:hover,
  .header__menu-item a.active {
    color: var(--header-accent) !important;
    background: rgba(227, 252, 2, 0.1);
  }

  .header__menu-item a:hover::before,
  .header__menu-item a.active::before {
    transform: translateY(-50%) scaleY(1);
  }

  /* ===================================
     SERVICES BUTTON - CENTERED WITH ARROW
     =================================== */

  .services-trigger {
    position: relative !important;
    padding-right: 0 !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important; /* CENTER */
    gap: 0.5rem !important;
    width: 100% !important;
  }

  /* Animated chevron for mobile */
  .services-trigger::after {
    content: '';
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 4px solid rgba(255,255,255,0.55);
    transition: transform 0.35s cubic-bezier(0.34,1.56,0.64,1),
                border-top-color 0.25s ease;
    position: relative; /* Inline flow */
    flex-shrink: 0;
  }

  /* Arrow rotates when open */
  .services-trigger.is-open::after {
    transform: rotate(180deg);
    border-top-color: var(--header-accent);
  }

  /* ===================================
     SUBMENU - SMOOTH EXPAND
     =================================== */

  .header__submenu {
    list-style: none;
    padding: 0;
    margin: 0;
    width: 100%;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    background: rgba(0, 0, 0, 0.2);
  }

  .header__submenu.active {
    max-height: 500px;
  }

  /* Submenu items */
  .header__submenu-item {
    opacity: 0;
    transform: translateX(20px);
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .header__submenu.active .header__submenu-item {
    opacity: 1;
    transform: translateX(0);
  }

  .header__submenu.active .header__submenu-item:nth-child(1) { transition-delay: 0.1s; }
  .header__submenu.active .header__submenu-item:nth-child(2) { transition-delay: 0.15s; }
  .header__submenu.active .header__submenu-item:nth-child(3) { transition-delay: 0.2s; }
  .header__submenu.active .header__submenu-item:nth-child(4) { transition-delay: 0.25s; }
  .header__submenu.active .header__submenu-item:nth-child(5) { transition-delay: 0.3s; }

  .header__submenu-item a {
    font-size: 1rem !important;
    padding: 1rem 2rem 1rem 3rem !important;
    color: var(--header-text-muted) !important;
    background: rgba(255, 255, 255, 0.02) !important;
    transition: all 0.3s ease;
    justify-content: center !important; /* CENTER SUBMENU TEXT */
  }

  .header__submenu-item a:hover {
    color: var(--header-accent) !important;
    background: rgba(227, 252, 2, 0.08) !important;
  }

  /* ===================================
     NEON SCROLLBAR FOR DRAWER
     =================================== */

  .menu-drawer::-webkit-scrollbar,
  .header__inline-menu::-webkit-scrollbar {
    width: 6px;
  }

  .menu-drawer::-webkit-scrollbar-track,
  .header__inline-menu::-webkit-scrollbar-track {
    background: rgba(31, 31, 33, 0.5);
  }

  .menu-drawer::-webkit-scrollbar-thumb,
  .header__inline-menu::-webkit-scrollbar-thumb {
    background: var(--header-accent);
    border-radius: 10px;
    box-shadow: 0 0 10px rgba(227, 252, 2, 0.5);
  }

  /* Firefox */
  .menu-drawer,
  .header__inline-menu {
    scrollbar-width: thin;
    scrollbar-color: var(--header-accent) rgba(31, 31, 33, 0.5);
  }
}

/* ===================================
   OVERLAY - BLOCK BACKGROUND SCROLL
   =================================== */

.mobile-overlay {
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  right: 0 !important;
  bottom: 0 !important;
  width: 100vw !important;
  height: 100vh !important;
  background: rgba(0, 0, 0, 0.8) !important;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
  z-index: 9998 !important;
  backdrop-filter: blur(5px);
  pointer-events: none;
}

.mobile-overlay.active {
  opacity: 1 !important;
  visibility: visible !important;
  pointer-events: auto !important;
}

/* ===================================
   COMING SOON BADGE
   =================================== */

.coming-soon-badge {
  display: inline-flex;
  align-items: center;
  background: rgba(227, 252, 2, 0.1);
  color: #E3FC02;
  border: 1px solid rgba(227, 252, 2, 0.35);
  font-size: 0.6rem;
  font-weight: 800;
  padding: 0.2rem 0.55rem;
  border-radius: 100px;
  margin-left: 0.5rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  animation: neonBadgePulse 2s ease-in-out infinite;
  white-space: nowrap;
}

@keyframes neonBadgePulse {
  0%, 100% { 
    box-shadow: 0 0 6px rgba(227,252,2,0.4), 0 0 12px rgba(227,252,2,0.2); 
    opacity: 1; 
  }
  50% { 
    box-shadow: 0 0 14px rgba(227,252,2,0.9), 0 0 28px rgba(227,252,2,0.45); 
    opacity: 0.85; 
  }
}

  /* ===================================
     LIQUID GLASS AUTH MODAL
     =================================== */

  /* Genie open: expands outward from the icon origin point */
  @keyframes genieOpen {
    0%   { transform: scale(0.05); opacity: 0; filter: blur(10px); }
    40%  { opacity: 1; filter: blur(0); }
    70%  { transform: scale(1.04); }
    85%  { transform: scale(0.98); }
    100% { transform: scale(1); opacity: 1; filter: blur(0); }
  }

  /* Genie close: shrinks back into the icon origin point */
  @keyframes genieClose {
    0%   { transform: scale(1); opacity: 1; filter: blur(0); }
    20%  { transform: scale(1.03); }
    100% { transform: scale(0.05); opacity: 0; filter: blur(10px); }
  }

  /* Input focus breath glow */
  @keyframes breathGlow {
    0%, 100% { box-shadow: 0 0 0 2px rgba(227,252,2,0.25), inset 0 2px 8px rgba(0,0,0,0.25); }
    50%       { box-shadow: 0 0 0 4px rgba(227,252,2,0.4), 0 0 20px rgba(227,252,2,0.2), inset 0 2px 8px rgba(0,0,0,0.2); }
  }

  /* Liquid gradient shift on submit button */
  @keyframes liquidShift {
    0%   { background-position: 0% 50%; }
    50%  { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  /* Overlay */
  .auth-modal {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    /* Simple dark tint — NO backdrop-filter here, that causes full-screen fog */
    background: rgba(0, 0, 0, 0.72);
    z-index: 10200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .auth-modal.active {
    opacity: 1;
    visibility: visible;
  }

  /* Liquid glass card — backdrop-filter ONLY here, scoped to the card */
  .auth-modal__content {
    background: rgba(22, 22, 24, 0.88);
    backdrop-filter: blur(40px) saturate(180%);
    -webkit-backdrop-filter: blur(40px) saturate(180%);
    border: 1px solid transparent;
    background-clip: padding-box;
    border-radius: 28px;
    box-shadow:
      0 0 0 1px rgba(227,252,2,0.18),
      0 0 0 1.5px rgba(255,255,255,0.04),
      0 32px 64px rgba(0,0,0,0.65),
      0 8px 24px rgba(0,0,0,0.4),
      inset 0 1px 0 rgba(255,255,255,0.06),
      inset 0 -1px 0 rgba(0,0,0,0.2);
    color: #ffffff;
    max-width: 920px;
    width: 100%;
    max-height: 92vh;
    overflow: hidden;
    position: relative;
    /* Default state: invisible — JS sets transform-origin then adds .genie-open */
    opacity: 0;
    transform: scale(0.05);
  }

  .auth-modal__content.genie-open {
    animation: genieOpen 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  .auth-modal__content.genie-close {
    animation: genieClose 0.36s cubic-bezier(0.4, 0, 0.8, 0.2) forwards;
  }

  /* Top edge light seam */
  .auth-modal__content::before {
    content: '';
    position: absolute;
    top: 0; left: 12px; right: 12px;
    height: 1px;
    background: linear-gradient(90deg,
      transparent 0%,
      rgba(227,252,2,0.5) 30%,
      rgba(255,255,255,0.15) 60%,
      transparent 100%
    );
    border-radius: 50%;
    pointer-events: none;
    z-index: 2;
  }

  /* Subtle inner noise grain for tactile glass feel */
  .auth-modal__content::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 28px;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    opacity: 0.025;
    pointer-events: none;
    z-index: 1;
  }

  .auth-modal__container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    position: relative;
    z-index: 3;
  }

  /* Divider between columns */
  .auth-modal__form-section {
    padding: 2.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    border-right: 1px solid rgba(255,255,255,0.06);
  }

  /* Close button — glass disc */
  .auth-modal__close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    width: 34px;
    height: 34px;
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.25s ease, border-color 0.25s ease,
                transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 0.25s ease;
    z-index: 10;
    backdrop-filter: blur(10px);
  }

  .auth-modal__close:hover {
    background: #E3FC02;
    border-color: #E3FC02;
    transform: rotate(90deg) scale(1.1);
    box-shadow: 0 0 16px rgba(227,252,2,0.45);
  }

  .auth-modal__close svg {
    width: 14px; height: 14px;
    stroke: rgba(255,255,255,0.8);
    transition: stroke 0.2s ease;
  }

  .auth-modal__close:hover svg { stroke: #000; }

  /* Header */
  .auth-modal__header { margin-bottom: 0.25rem; }

  .auth-modal__title {
    font-size: 1.875rem;
    font-weight: 800;
    margin-bottom: 0.375rem;
    background: linear-gradient(125deg, #ffffff 0%, rgba(227,252,2,0.9) 100%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .auth-modal__subtitle {
    color: rgba(255,255,255,0.45);
    font-size: 0.875rem;
  }

  /* Toggle pill */
  .auth-modal__toggle {
    display: flex;
    gap: 0.375rem;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 14px;
    padding: 0.3rem;
  }

  .auth-modal__toggle-btn {
    flex: 1;
    padding: 0.625rem 1rem;
    background: transparent;
    border: none;
    border-radius: 10px;
    color: rgba(255,255,255,0.45);
    font-weight: 600;
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .auth-modal__toggle-btn.active {
    background: #E3FC02;
    color: #000;
    box-shadow: 0 2px 12px rgba(227,252,2,0.35), 0 1px 0 rgba(255,255,255,0.15);
    transform: scale(1.02);
  }

  /* Input group */
  .auth-modal__input-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .auth-modal__label {
    font-size: 0.75rem;
    font-weight: 700;
    color: rgba(255,255,255,0.55);
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }

  /* Glassmorphism inset input — carved into the glass */
  .auth-modal__input {
    -webkit-appearance: none;
    appearance: none;
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    padding: 11px 15px;
    color: #ffffff;
    font-size: 0.9375rem;
    outline: none;
    width: 100%;
    box-shadow: inset 0 2px 8px rgba(0,0,0,0.35), inset 0 1px 0 rgba(255,255,255,0.04);
    transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1),
                border-color 0.25s ease;
  }

  .auth-modal__input::placeholder { color: rgba(255,255,255,0.25); }

  /* Focus: grow 2% + breath glow */
  .auth-modal__input:focus {
    transform: scale(1.02);
    border-color: rgba(227,252,2,0.6);
    animation: breathGlow 2.2s ease-in-out infinite;
  }

  /* Liquid gradient submit button */
  .auth-modal__submit {
    background: linear-gradient(120deg, #E3FC02 0%, #c8e800 40%, #f0ff50 70%, #E3FC02 100%);
    background-size: 250% 250%;
    color: #000;
    border: none;
    padding: 0.875rem 1rem;
    border-radius: 14px;
    font-weight: 800;
    font-size: 0.9375rem;
    cursor: pointer;
    letter-spacing: 0.01em;
    margin-top: 0.375rem;
    position: relative;
    overflow: hidden;
    animation: liquidShift 4s ease infinite;
    transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1),
                box-shadow 0.3s ease;
    box-shadow: 0 4px 16px rgba(227,252,2,0.3), 0 1px 0 rgba(255,255,255,0.2) inset;
  }

  /* Shine layer */
  .auth-modal__submit::before {
    content: '';
    position: absolute;
    top: 0; left: -100%;
    width: 60%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.35), transparent);
    transition: left 0.5s ease;
  }

  .auth-modal__submit:hover::before { left: 160%; }

  .auth-modal__submit:hover {
    transform: scale(1.03) translateY(-1px);
    box-shadow: 0 8px 24px rgba(227,252,2,0.45);
    animation-play-state: paused;
    background-position: 80% 50%;
  }

  /* Info panel */
  .auth-modal__info-section {
    padding: 2.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    background: rgba(255,255,255,0.015);
  }

  .auth-modal__info-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 18px;
    padding: 1.375rem;
    position: relative;
    overflow: hidden;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.06);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .auth-modal__info-card:hover {
    border-color: rgba(227,252,2,0.18);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.08), 0 0 20px rgba(227,252,2,0.04);
  }

  /* Top edge seam on cards */
  .auth-modal__info-card::before {
    content: '';
    position: absolute;
    top: 0; left: 10%; right: 10%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.12), transparent);
    pointer-events: none;
  }

  .auth-modal__info-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.625rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .auth-modal__info-icon {
    width: 26px; height: 26px;
    background: rgba(227,252,2,0.12);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 1px solid rgba(227,252,2,0.2);
  }

  .auth-modal__info-icon svg { width: 13px; height: 13px; stroke: #E3FC02; }

  .auth-modal__info-text {
    color: rgba(255,255,255,0.45);
    font-size: 0.8125rem;
    line-height: 1.65;
  }

  .auth-modal__info-features {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.875rem;
  }

  .auth-modal__feature {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.625rem;
    background: rgba(255,255,255,0.025);
    border-radius: 9px;
    border: 1px solid rgba(255,255,255,0.05);
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .auth-modal__feature:hover {
    background: rgba(227,252,2,0.04);
    border-color: rgba(227,252,2,0.12);
  }

  .auth-modal__feature-icon {
    width: 7px; height: 7px;
    background: #E3FC02;
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: 0 0 8px rgba(227,252,2,0.7);
  }

  .auth-modal__feature-text {
    color: rgba(255,255,255,0.8);
    font-size: 0.8125rem;
  }

  /* Form cross-fade */
  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @keyframes formFadeUp {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .auth-form.animating {
    animation: formFadeUp 0.35s cubic-bezier(0.34,1.56,0.64,1) forwards;
  }

  /* Mobile responsive */
  @media screen and (max-width: 768px) {
    .auth-modal__container {
      grid-template-columns: 1fr;
    }
    .auth-modal__info-section { display: none; }
    .auth-modal__form-section { border-right: none; padding: 2rem 1.5rem; }
    .auth-modal__title { font-size: 1.6rem; }
    .auth-modal__content::after { display: none; }
  }

  /* ===================================
     DESKTOP LAYOUT (≥1024px) - JUSTIFIED NAV
     =================================== */

  @media screen and (min-width: 1024px) {
    .header {
      padding: 0 3rem !important;
      gap: 0;
      align-items: center !important; /* Prevent link sagging */
    }

    .hamburger {
      display: none !important;
    }

    /* Desktop three-column layout */
    .header__heading {
      position: static;
      left: auto;
      transform: none;
      order: 1;
      flex: 1 0 0 !important; /* Equal basis */
      flex-shrink: 0;
      justify-content: flex-start !important;
    }

    .header__heading-logo-wrapper {
      width: 160px;
    }

    /* Navigation - Centered with justified spacing */
    .header__inline-menu {
      position: static !important;
      width: auto !important;
      height: auto !important;
      opacity: 1 !important;
      visibility: visible !important;
      transform: none !important;
      background: transparent !important;
      display: flex !important;
      flex-direction: row !important;
      justify-content: center !important; /* Center nav links */
      align-items: center !important; /* Vertical alignment */
      order: 2;
      flex: 2 0 auto !important; /* Double space for center */
      padding: 0 !important;
      overflow: visible !important;
      z-index: auto !important;
    }

    /* Menu with justified spacing */
    .header__menu {
      display: flex !important;
      flex-direction: row !important;
      align-items: center !important;
      gap: 3rem !important; /* Even spacing for justified look */
      max-width: none;
      margin: 0;
      padding: 0;
      width: 100%; /* Full available space */
      justify-content: center !important;
    }

    .header__menu-item {
      border: none;
      opacity: 1 !important;
      transform: none !important;
      transition: none;
      width: auto;
      position: relative;
    }

    .header__menu-item a,
    .header__menu-item button {
      font-size: 0.9rem;
      padding: 0.5rem 0 !important;
      color: var(--header-text-muted) !important;
      text-align: left;
      line-height: 1.5;
      transform: none !important;
      background: transparent !important;
      box-shadow: none !important;
      width: auto;
      justify-content: flex-start;
    }

    .header__menu-item a::before {
      display: none;
    }

    .header__menu-item a::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 0;
      height: 2px;
      background: var(--header-accent);
      transition: width 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .header__menu-item a:hover::after,
    .header__menu-item a.active::after {
      width: 100%;
    }

    /* Services chevron indicator with proper spacing */
    .services-trigger {
      position: relative;
      padding-right: 0 !important; /* Remove old padding */
      display: inline-flex;
      align-items: center;
      gap: 0.5rem; /* Natural spacing between text and arrow */
    }

    .services-trigger::after {
      content: '';
      width: 0;
      height: 0;
      border-left: 4px solid transparent;
      border-right: 4px solid transparent;
      border-top: 4px solid rgba(255,255,255,0.5);
      transition: transform 0.35s cubic-bezier(0.34,1.56,0.64,1),
                  border-top-color 0.25s ease;
      opacity: 0.7;
      position: relative; /* Not absolute - flows inline */
      top: 0; /* Reset absolute positioning */
      transform: none; /* Reset centering transform */
    }

    .services-trigger.is-open::after,
    .has-submenu:hover .services-trigger::after {
      transform: rotate(180deg) translateY(2px); /* Rotate + shift down */
      border-top-color: var(--header-accent);
      opacity: 1;
    }

    .coming-soon-badge {
  display: inline-flex;
  align-items: center;
  background: rgba(227, 252, 2, 0.1);
  color: #E3FC02;
  border: 1px solid rgba(227, 252, 2, 0.35);
  font-size: 0.6rem;
  font-weight: 800;
  padding: 0.2rem 0.55rem;
  border-radius: 100px;
  margin-left: 0.5rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  animation: neonBadgePulse 2s ease-in-out infinite;
  white-space: nowrap;
}

    /* ===================================
       FOCUSED FLOATING GLASS DROPDOWN
       =================================== */

    .has-submenu {
      position: relative;
    }

    /* Compact floating tile centered below 'Services' */
    .header__submenu {
      position: absolute;
      top: calc(100% + 12px); /* 12px gap below the link */
      left: 50%;
      transform: translateX(-50%);
      width: 460px;
      background: rgba(28, 28, 30, 0.92);
      backdrop-filter: blur(24px) saturate(160%);
      -webkit-backdrop-filter: blur(24px) saturate(160%);
      border: 1px solid rgba(227, 252, 2, 0.22);
      border-radius: 18px;
      box-shadow: 
        0 20px 60px rgba(0, 0, 0, 0.5),
        0 0 0 1px rgba(0,0,0,0.6),
        inset 0 1px 0 rgba(255, 255, 255, 0.08);
      padding: 1.5rem;
      margin: 0;
      opacity: 0;
      visibility: hidden;
      list-style: none;
      z-index: 10100;
      pointer-events: none;
      
      /* Genie animation from Services text origin */
      transform: translateX(-50%) scale(0.88) translateY(-8px);
      transform-origin: top center;
      transition: all 0.42s cubic-bezier(0.34,1.56,0.64,1);
    }

    .header__submenu.active {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateX(-50%) scale(1) translateY(0);
    }

    /* Top-edge neon seam */
    .header__submenu::before {
      content: '';
      position: absolute;
      top: 0;
      left: 12%;
      right: 12%;
      height: 1px;
      background: linear-gradient(90deg, 
        transparent 0%, 
        rgba(227, 252, 2, 0.52) 50%, 
        transparent 100%
      );
      pointer-events: none;
      border-radius: 50%;
    }

    /* Compact vertically-stacked items */
    .header__submenu {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .header__submenu-item {
      opacity: 0;
      transform: translateY(10px);
      transition: all 0.32s cubic-bezier(0.34, 1.56, 0.64, 1);
      width: 100%;
    }

    .header__submenu.active .header__submenu-item {
      opacity: 1;
      transform: translateY(0);
    }

    .header__submenu.active .header__submenu-item:nth-child(1) { transition-delay: 0.05s; }
    .header__submenu.active .header__submenu-item:nth-child(2) { transition-delay: 0.1s; }
    .header__submenu.active .header__submenu-item:nth-child(3) { transition-delay: 0.15s; }
    .header__submenu.active .header__submenu-item:nth-child(4) { transition-delay: 0.2s; }

    /* Compact glass tiles */
    .header__submenu-item a {
      font-size: 0.9375rem !important;
      padding: 0.875rem 1.25rem !important;
      color: var(--header-text-muted) !important;
      background: rgba(255, 255, 255, 0.03) !important;
      border: 1px solid rgba(255,255,255,0.05);
      border-radius: 11px;
      display: flex !important;
      align-items: center;
      justify-content: flex-start !important;
      position: relative;
      overflow: hidden;
      transition: all 0.28s cubic-bezier(0.34,1.56,0.64,1);
      white-space: nowrap;
    }

    /* Left neon indicator */
    .header__submenu-item a::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 3px;
      background: var(--header-accent);
      opacity: 0;
      transform: scaleY(0);
      transition: opacity 0.24s ease, transform 0.28s cubic-bezier(0.34,1.56,0.64,1);
      border-radius: 0 8px 8px 0;
    }

    .header__submenu-item a:hover {
      color: var(--header-accent) !important;
      background: rgba(227, 252, 2, 0.09) !important;
      border-color: rgba(227,252,2,0.2);
      padding-left: 1.5rem !important;
      box-shadow: 0 3px 14px rgba(227,252,2,0.12), inset 0 1px 0 rgba(255,255,255,0.06);
      transform: translateX(3px);
    }

    .header__submenu-item a:hover::before {
      opacity: 1;
      transform: scaleY(1);
    }

    /* Coming Soon badge - persistent glow */
    .header__submenu-item .coming-soon-badge {
      font-size: 0.625rem;
      padding: 0.2rem 0.45rem;
      margin-left: 0.75rem;
      background: rgba(227, 252, 2, 0.12);
      border: 1px solid rgba(227, 252, 2, 0.42);
      box-shadow: 
        0 0 8px rgba(227,252,2,0.52),
        0 0 16px rgba(227,252,2,0.28),
        inset 0 1px 0 rgba(255,255,255,0.15);
      animation: comingSoonGlow 2.2s ease-in-out infinite;
    }

    @keyframes comingSoonGlow {
      0%, 100% { 
        box-shadow: 
          0 0 8px rgba(227,252,2,0.52),
          0 0 16px rgba(227,252,2,0.28),
          inset 0 1px 0 rgba(255,255,255,0.15);
      }
      50% { 
        box-shadow: 
          0 0 14px rgba(227,252,2,0.85),
          0 0 28px rgba(227,252,2,0.48),
          inset 0 1px 0 rgba(255,255,255,0.2);
      }
    }

    /* Tenda BI emphasis */
    .header__submenu-item:last-child a {
      background: rgba(227, 252, 2, 0.045) !important;
      border-color: rgba(227,252,2,0.16);
    }

    .header__submenu-item:last-child a:hover {
      background: rgba(227, 252, 2, 0.13) !important;
      border-color: rgba(227,252,2,0.32);
    }
  }

  @media screen and (min-width: 1024px) and (max-width: 1200px) {
    .header__menu {
      gap: 1.5rem;
    }

    .header__menu-item a {
      font-size: 0.85rem;
      letter-spacing: -0.2px;
    }
  }

  @media screen and (min-width: 1200px) {
    .header {
      max-width: 1800px;
      margin: 0 auto;
    }

    .header__menu {
      gap: 2.5rem;
    }
  }

  /* ===================================
     UTILITIES
     =================================== */

  body {
    padding-top: var(--header-height) !important;
  }

  body.menu-open {
    overflow: hidden;
  }

  .section-header.is-scrolled .header__heading-logo-wrapper {
    width: 100px;
  }

  @media screen and (min-width: 1024px) {
    .section-header.is-scrolled .header__heading-logo-wrapper {
      width: 140px;
    }
  }
</style>

<!-- Background Overlay -->
<div class="mobile-overlay" id="mobileOverlay" onclick="closeMobileMenu()"></div>

<sticky-header class="header-wrapper">
  <header class="header">
    
    <!-- Hamburger -->
    <div class="hamburger" onclick="toggleMobileMenu()">
      <span></span>
      <span></span>
      <span></span>
    </div>

    <!-- Logo -->
    {%- if request.page_type == 'index' -%}
      <h1 class="header__heading">
    {%- else -%}
      <div class="header__heading">
    {%- endif -%}
        <a href="{{ routes.root_url }}" class="header__heading-link">
          {%- if settings.logo != blank -%}
            <div class="header__heading-logo-wrapper">
              {{ settings.logo | image_url: width: 400 | image_tag: class: 'header__heading-logo', alt: shop.name }}
            </div>
          {%- else -%}
            <span class="h2">{{ shop.name }}</span>
          {%- endif -%}
        </a>
    {%- if request.page_type == 'index' -%}
      </h1>
    {%- else -%}
      </div>
    {%- endif -%}

    <!-- Navigation Drawer -->
    <nav class="header__inline-menu" id="mobileMenu">
      <ul class="header__menu">
        <!-- 1. Home -->
        <li class="header__menu-item">
          <a href="{{ routes.root_url }}">Home</a>
        </li>
        
        <!-- 2. About Us -->
        <li class="header__menu-item">
          <a href="/pages/about-us">About Us</a>
        </li>
        
        <!-- 3. Services (Expandable) -->
        <li class="header__menu-item has-submenu">
          <button class="services-trigger" onclick="toggleServicesMenu(event)" aria-expanded="false">
            Services
          </button>
          <ul class="header__submenu" id="servicesSubmenu">
            <li class="header__submenu-item">
              <a href="/pages/growth-advisory">Growth & Advisory</a>
            </li>
            <li class="header__submenu-item">
              <a href="/pages/data-consulting-analytics">Data Consulting & Analytics</a>
            </li>
            <li class="header__submenu-item">
              <a href="/pages/creative-digital-services">Creative & Digital Services</a>
            </li>
            <li class="header__submenu-item">
              <a href="/collections/all">Digital Products</a>
            </li>
