{% comment %}
  Floating CTA Section
  Full-width interactive CTA with floating gradient, cursor glow,
  and glassmorphism card — Stripe/Linear style
{% endcomment %}

<style>
/* ── SECTION ──────────────────────────────────────────────────── */
.ta-cta-section {
  padding: var(--cta-pt, 5rem) 1.5rem var(--cta-pb, 5rem);
  position: relative;
  overflow: hidden;
  background: var(--ta-bg, #08080A);
}

/* ── FLOATING CARD ───────────────────────────────────────────── */
.ta-cta__card {
  max-width: 960px;
  margin: 0 auto;
  background: var(--ta-cta-card-bg, rgba(255,255,255,0.04));
  backdrop-filter: blur(24px) saturate(160%);
  -webkit-backdrop-filter: blur(24px) saturate(160%);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 28px;
  padding: clamp(3rem, 7vw, 5.5rem) clamp(2rem, 6vw, 5rem);
  text-align: center;
  position: relative;
  overflow: hidden;
  transition: border-color 0.4s ease, box-shadow 0.4s ease;
}

html[data-theme="light"] .ta-cta__card {
  background: rgba(255,255,255,0.85);
  border-color: rgba(0,0,0,0.08);
  box-shadow: 0 8px 40px rgba(0,0,0,0.07);
}

/* Top shimmer seam */
.ta-cta__card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 10%;
  right: 10%;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(227,252,2,0.5) 50%, transparent);
  pointer-events: none;
  transition: opacity 0.4s ease;
}

html[data-theme="light"] .ta-cta__card::before {
  background: linear-gradient(90deg, transparent, rgba(180,160,0,0.4) 50%, transparent);
}

/* Gradient glow orb inside card */
.ta-cta__card::after {
  content: '';
  position: absolute;
  top: -30%;
  left: 50%;
  transform: translateX(-50%);
  width: 700px;
  height: 400px;
  background: radial-gradient(ellipse at center, rgba(227,252,2,0.08) 0%, transparent 70%);
  pointer-events: none;
  transition: opacity 0.4s ease;
  animation: ta-cta-glow 10s ease-in-out infinite;
}

@keyframes ta-cta-glow {
  0%, 100% { transform: translateX(-50%) scale(1); opacity: 1; }
  50%       { transform: translateX(-50%) scale(1.1); opacity: 0.7; }
}

/* Cursor-following glow (JS-powered) */
.ta-cta__cursor-glow {
  position: absolute;
  pointer-events: none;
  width: 300px;
  height: 300px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(227,252,2,0.12) 0%, transparent 70%);
  transform: translate(-50%, -50%);
  filter: blur(40px);
  opacity: 0;
  transition: opacity 0.4s ease;
}

.ta-cta__card:hover .ta-cta__cursor-glow {
  opacity: 1;
}

/* ── EYEBROW ──────────────────────────────────────────────────── */
.ta-cta__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: #E3FC02;
  margin-bottom: 1.5rem;
  position: relative;
  z-index: 1;
}

html[data-theme="light"] .ta-cta__eyebrow { color: #6B5D00; }

/* ── HEADING ──────────────────────────────────────────────────── */
.ta-cta__title {
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 900;
  letter-spacing: -0.04em;
  line-height: 1.1;
  color: #FFFFFF;
  margin: 0 0 1.25rem;
  position: relative;
  z-index: 1;
}

html[data-theme="light"] .ta-cta__title { color: #1D1D1F; }

.ta-cta__title-accent {
  background: linear-gradient(135deg, #E3FC02 0%, #c8e800 40%, #f0ff50 70%, #E3FC02 100%);
  background-size: 250% auto;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: ta-cta-gradient 5s ease-in-out infinite;
}

html[data-theme="light"] .ta-cta__title-accent {
  background: linear-gradient(135deg, #7a6c00 0%, #5a5000 60%);
  background-size: 200% auto;
  -webkit-background-clip: text;
  background-clip: text;
}

@keyframes ta-cta-gradient {
  0%, 100% { background-position: 0% 50%; }
  50%       { background-position: 100% 50%; }
}

/* ── DESCRIPTION ─────────────────────────────────────────────── */
.ta-cta__desc {
  font-size: 1.05rem;
  line-height: 1.65;
  color: rgba(255,255,255,0.55);
  max-width: 560px;
  margin: 0 auto 2.75rem;
  position: relative;
  z-index: 1;
}

html[data-theme="light"] .ta-cta__desc { color: #6E6E73; }

/* ── ACTIONS ──────────────────────────────────────────────────── */
.ta-cta__actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  flex-wrap: wrap;
  position: relative;
  z-index: 1;
}

/* Primary button */
.ta-cta__btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.9rem 2.5rem;
  background: #E3FC02;
  color: #0A0A0A;
  border-radius: 100px;
  font-size: 0.95rem;
  font-weight: 700;
  text-decoration: none;
  box-shadow: 0 0 28px rgba(227,252,2,0.35), 0 4px 16px rgba(0,0,0,0.2);
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  letter-spacing: -0.01em;
  border: none;
  cursor: pointer;
}

.ta-cta__btn-primary:hover {
  transform: translateY(-2px) scale(1.02);
  box-shadow: 0 0 48px rgba(227,252,2,0.55), 0 8px 28px rgba(0,0,0,0.25);
}

.ta-cta__btn-primary:active {
  transform: translateY(0) scale(1);
}

/* Secondary button */
.ta-cta__btn-secondary {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.9rem 2.25rem;
  background: transparent;
  color: rgba(255,255,255,0.8);
  border-radius: 100px;
  font-size: 0.95rem;
  font-weight: 600;
  text-decoration: none;
  border: 1px solid rgba(255,255,255,0.18);
  transition: all 0.25s ease;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  letter-spacing: -0.01em;
}

html[data-theme="light"] .ta-cta__btn-secondary {
  color: #1D1D1F;
  border-color: rgba(0,0,0,0.15);
}

.ta-cta__btn-secondary:hover {
  border-color: rgba(255,255,255,0.35);
  background: rgba(255,255,255,0.06);
  transform: translateY(-1px);
}

html[data-theme="light"] .ta-cta__btn-secondary:hover {
  border-color: rgba(0,0,0,0.25);
  background: rgba(0,0,0,0.04);
}

/* Arrow */
.ta-cta__arrow {
  width: 18px;
  height: 18px;
  transition: transform 0.2s ease;
}

.ta-cta__btn-primary:hover .ta-cta__arrow,
.ta-cta__btn-secondary:hover .ta-cta__arrow {
  transform: translateX(3px);
}

/* ── FEATURE PILLS ───────────────────────────────────────────── */
.ta-cta__features {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-top: 2.25rem;
  position: relative;
  z-index: 1;
}

.ta-cta__feature-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.35rem 0.9rem;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 100px;
  font-size: 0.78rem;
  color: rgba(255,255,255,0.55);
  transition: border-color 0.25s ease, background 0.25s ease;
}

html[data-theme="light"] .ta-cta__feature-pill {
  background: rgba(0,0,0,0.04);
  border-color: rgba(0,0,0,0.07);
  color: #98989D;
}

.ta-cta__feature-pill:hover {
  border-color: rgba(227,252,2,0.2);
  background: rgba(227,252,2,0.05);
}

.ta-cta__feature-pill-dot {
  width: 5px;
  height: 5px;
  background: #E3FC02;
  border-radius: 50%;
  flex-shrink: 0;
  opacity: 0.7;
}

html[data-theme="light"] .ta-cta__feature-pill-dot {
  background: #8a7a00;
}

/* ── ENTER ANIMATION ─────────────────────────────────────────── */
.ta-cta__card {
  opacity: 0;
  transform: translateY(32px) scale(0.98);
  transition:
    opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
    transform 0.8s cubic-bezier(0.22, 1, 0.36, 1),
    border-color 0.4s ease,
    box-shadow 0.4s ease;
}

.ta-cta__card.ta-is-visible {
  opacity: 1;
  transform: translateY(0) scale(1);
}

@media (prefers-reduced-motion: reduce) {
  .ta-cta__card {
    opacity: 1 !important;
    transform: none !important;
    transition: border-color 0.3s ease, box-shadow 0.3s ease !important;
  }
  .ta-cta__card::after {
    animation: none !important;
  }
}
</style>

<section
  class="ta-cta-section"
  style="
    --cta-pt: {{ section.settings.padding_top }}px;
    --cta-pb: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="ta-cta__card" id="ta-cta-card-{{ section.id }}">
    <!-- Cursor glow follower -->
    <div class="ta-cta__cursor-glow" id="ta-cta-glow-{{ section.id }}" aria-hidden="true"></div>

    <!-- Eyebrow -->
    {%- if section.settings.eyebrow != blank -%}
      <div class="ta-cta__eyebrow">{{ section.settings.eyebrow }}</div>
    {%- endif -%}

    <!-- Title -->
    {%- if section.settings.title != blank -%}
      <h2 class="ta-cta__title">
        {{ section.settings.title }}
        {%- if section.settings.title_accent != blank -%}
          <span class="ta-cta__title-accent">{{ section.settings.title_accent }}</span>
        {%- endif -%}
      </h2>
    {%- endif -%}

    <!-- Description -->
    {%- if section.settings.description != blank -%}
      <p class="ta-cta__desc">{{ section.settings.description }}</p>
    {%- endif -%}

    <!-- Actions -->
    {%- if section.settings.btn_primary_label != blank or section.settings.btn_secondary_label != blank -%}
      <div class="ta-cta__actions">
        {%- if section.settings.btn_primary_label != blank -%}
          <a href="{{ section.settings.btn_primary_link | default: '#' }}" class="ta-cta__btn-primary">
            {{ section.settings.btn_primary_label }}
            <svg class="ta-cta__arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        {%- endif -%}
        {%- if section.settings.btn_secondary_label != blank -%}
          <a href="{{ section.settings.btn_secondary_link | default: '#' }}" class="ta-cta__btn-secondary">
            {{ section.settings.btn_secondary_label }}
            <svg class="ta-cta__arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Feature pills -->
    {%- assign has_features = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'feature' -%}{%- assign has_features = true -%}{%- endif -%}
    {%- endfor -%}

    {%- if has_features -%}
      <div class="ta-cta__features">
        {%- for block in section.blocks -%}
          {%- if block.type == 'feature' -%}
            <span class="ta-cta__feature-pill" {{ block.shopify_attributes }}>
              <span class="ta-cta__feature-pill-dot" aria-hidden="true"></span>
              {{ block.settings.text }}
            </span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
(function () {
  var card = document.getElementById('ta-cta-card-{{ section.id }}');
  var glow = document.getElementById('ta-cta-glow-{{ section.id }}');

  if (!card) return;

  // Scroll reveal
  var observer = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('ta-is-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });
  observer.observe(card);

  // Cursor glow follow
  if (glow && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    card.addEventListener('mousemove', function (e) {
      var rect = card.getBoundingClientRect();
      glow.style.left = (e.clientX - rect.left) + 'px';
      glow.style.top  = (e.clientY - rect.top) + 'px';
    });
  }
})();
</script>

{% schema %}
{
  "name": "Floating CTA",
  "tag": "section",
  "class": "section-floating-cta",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Get Started"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Ready to unlock your data's"
    },
    {
      "type": "text",
      "id": "title_accent",
      "label": "Accent heading (gradient)",
      "default": "full potential?"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Book a free 30-minute consultation and discover how Tenda Analytics can transform your business with data-driven insights."
    },
    {
      "type": "header",
      "content": "Primary CTA"
    },
    {
      "type": "text",
      "id": "btn_primary_label",
      "label": "Button label",
      "default": "Book Free Consultation"
    },
    {
      "type": "url",
      "id": "btn_primary_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Secondary CTA"
    },
    {
      "type": "text",
      "id": "btn_secondary_label",
      "label": "Button label",
      "default": "View Case Studies"
    },
    {
      "type": "url",
      "id": "btn_secondary_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature pill",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "No long-term commitment"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Floating CTA",
      "blocks": [
        { "type": "feature", "settings": { "text": "Free initial consultation" } },
        { "type": "feature", "settings": { "text": "Results-driven approach" } },
        { "type": "feature", "settings": { "text": "Expert-led team" } },
        { "type": "feature", "settings": { "text": "Flexible engagement" } }
      ]
    }
  ]
}
{% endschema %}
