grid-template-columns:repeat(auto-fit,minmax(320px,1fr));
gap:2rem;
margin-bottom:4rem;
}

/* CARD BASE */
.blog-preview-card{
position:relative;
padding:2rem;
border-radius:18px;
background:rgba(255,255,255,0.03);
backdrop-filter:blur(20px);
-webkit-backdrop-filter:blur(20px);
border:1px solid rgba(227,252,2,0.15);
transition:all .35s ease;
overflow:hidden;
}

/* TOP GLOW LINE */
.blog-preview-card::before{
content:"";
position:absolute;
top:0;
left:0;
width:100%;
height:2px;
background:#E3FC02;
box-shadow:0 0 15px #E3FC02;
}

/* HOVER EFFECT */
.blog-preview-card:hover{
transform:translateY(-8px);
border:1px solid rgba(227,252,2,0.35);
box-shadow:
0 10px 30px rgba(0,0,0,0.6),
0 0 20px rgba(227,252,2,0.15);
}

/* CATEGORY */
.blog-category{
color:#E3FC02;
font-size:.7rem;
letter-spacing:1.5px;
text-transform:uppercase;
font-weight:700;
margin-bottom:1rem;
}

/* TITLE */
.blog-title{
color:#fff;
font-size:1.375rem;
font-weight:700;
line-height:1.3;
margin:1rem 0 .75rem 0;
}

/* DESCRIPTION */
.blog-desc{
color:rgba(255,255,255,0.6);
font-size:.95rem;
line-height:1.6;
margin-bottom:1.5rem;
}

/* LINK */
.blog-link{
color:#E3FC02;
text-decoration:none;
font-size:.875rem;
font-weight:700;
padding-bottom:4px;
display:inline-block;
position:relative;
}

/* animated underline */
.blog-link::after{
content:"";
position:absolute;
left:0;
bottom:0;
width:0;
height:2px;
background:#E3FC02;
transition:width .3s ease;
}

.blog-preview-card:hover .blog-link::after{
width:100%;
}

/* CTA BUTTON */
.btn-secondary{
padding:1.25rem 3rem;
border:2px solid #E3FC02;
color:#E3FC02;
text-decoration:none;
border-radius:980px;
font-weight:700;
font-size:.875rem;
letter-spacing:1px;
text-transform:uppercase;
display:inline-block;
transition:all .35s ease;
}

.btn-secondary:hover{
background:#E3FC02;
color:#000;
box-shadow:0 0 20px rgba(227,252,2,0.4);
}
