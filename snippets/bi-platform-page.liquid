{% comment %}
  Tenda BI Platform — Polished Brand Colors
  Only using #1F1F21 and #E3FC02 with premium dividers
{% endcomment %}

<style>
/* ================================================
   TENDA BI PLATFORM — BRAND COLORS ONLY
   ================================================ */

:root {
  --bi-bg:        #1F1F21;
  --bi-surface:   rgba(31, 31, 33, 0.92);
  --bi-accent:    #E3FC02;
  --bi-text:      #ffffff;
  --bi-muted:     rgba(255,255,255,0.55);
  --bi-border:    rgba(227,252,2,0.1);
  --bi-smooth:    cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  background: var(--bi-bg);
  color: var(--bi-text);
  font-family: system-ui, -apple-system, sans-serif;
  overflow-x: hidden;
}

html {
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
  -webkit-font-smoothing: antialiased;
}

/* ── CREATIVE BACKGROUND ──────────────────────── */
.bi-background {
  position: fixed;
  inset: 0;
  background: 
    /* Vertical gradient for depth */
    linear-gradient(180deg,
      #1F1F21 0%,
      #171719 20%,
      #1F1F21 50%,
      #232325 80%,
      #1F1F21 100%
    ),
    /* Subtle accent glows */
    radial-gradient(ellipse 80% 50% at 50% 10%, rgba(227,252,2,0.06) 0%, transparent 60%),
    radial-gradient(ellipse 60% 40% at 10% 60%, rgba(227,252,2,0.03) 0%, transparent 50%),
    radial-gradient(ellipse 60% 40% at 90% 80%, rgba(227,252,2,0.04) 0%, transparent 50%);
  pointer-events: none;
  z-index: 0;
}

/* Animated accent particles */
.bi-background::after {
  content: '';
  position: absolute;
  inset: 0;
  background-image: 
    radial-gradient(circle at 20% 30%, rgba(227,252,2,0.4) 0%, transparent 2%),
    radial-gradient(circle at 60% 70%, rgba(227,252,2,0.3) 0%, transparent 1.5%),
    radial-gradient(circle at 80% 20%, rgba(227,252,2,0.35) 0%, transparent 1.8%),
    radial-gradient(circle at 30% 90%, rgba(227,252,2,0.25) 0%, transparent 1.2%);
  background-size: 100% 100%;
  animation: particleFloat 20s ease-in-out infinite;
  opacity: 0.4;
}

@keyframes particleFloat {
  0%, 100% { transform: translate(0, 0); }
  33% { transform: translate(-10px, -15px); }
  66% { transform: translate(10px, 15px); }
}

/* ── ANIMATED DATA LINES ──────────────────────── */
.bi-data-flow {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 1;
  opacity: 0.25;
}

.flow-line {
  position: absolute;
  background: linear-gradient(90deg, 
    transparent 0%, 
    var(--bi-accent) 50%, 
    transparent 100%
  );
  height: 1px;
  box-shadow: 0 0 6px rgba(227,252,2,0.6);
  animation: flowMove 12s linear infinite;
}

@keyframes flowMove {
  0%   { transform: translateX(-100%); opacity: 0; }
  10%  { opacity: 0.6; }
  90%  { opacity: 0.6; }
  100% { transform: translateX(100vw); opacity: 0; }
}

.flow-line:nth-child(1) {
  top: 20%; width: 45%;
  animation-delay: 0s;
}

.flow-line:nth-child(2) {
  top: 40%; width: 38%;
  animation-delay: 3s;
}

.flow-line:nth-child(3) {
  top: 60%; width: 50%;
  animation-delay: 6s;
}

.flow-line:nth-child(4) {
  top: 80%; width: 35%;
  animation-delay: 9s;
}

.bi-page { position: relative; z-index: 2; }

/* ================================================
   HERO SECTION — WORKSPACE
   ================================================ */

.bi-hero {
  padding: 180px 5% 140px;
  max-width: 1500px;
  margin: 0 auto;
  position: relative;
  text-align: center;
}

/* Status Pill - Neon Yellow Theme */
.bi-status-pill {
  position: absolute;
  top: 100px;
  right: 5%;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: rgba(31,31,33,0.95);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(227,252,2,0.3);
  border-radius: 100px;
  padding: 0.625rem 1.25rem;
  font-size: 0.8125rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--bi-text);
  box-shadow: 
    0 4px 16px rgba(227,252,2,0.25),
    inset 0 1px 0 rgba(227,252,2,0.1);
  animation: pillFloat 3s ease-in-out infinite;
}

@keyframes pillFloat {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-5px); }
}

.bi-status-pill__indicator {
  width: 8px;
  height: 8px;
  background: var(--bi-accent);
  border-radius: 50%;
  box-shadow: 0 0 12px rgba(227,252,2,0.8);
  animation: statusBlink 2s ease-in-out infinite;
}

@keyframes statusBlink {
  0%, 100% { opacity: 1; box-shadow: 0 0 12px rgba(227,252,2,0.8); }
  50%      { opacity: 0.4; box-shadow: 0 0 6px rgba(227,252,2,0.4); }
}

.bi-status-pill__text {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  line-height: 1.3;
}

.bi-status-pill__label {
  font-size: 0.625rem;
  color: var(--bi-muted);
  font-weight: 600;
}

.bi-status-pill__value {
  font-size: 0.8125rem;
  color: var(--bi-accent);
  font-weight: 800;
  text-shadow: 0 0 8px rgba(227,252,2,0.6);
}

/* Hero Content */
.bi-hero__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.625rem;
  font-size: 0.875rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--bi-accent);
  margin-bottom: 2rem;
  text-shadow: 0 0 10px rgba(227,252,2,0.4);
}

.bi-hero__eyebrow::before {
  content: '';
  width: 8px;
  height: 8px;
  background: var(--bi-accent);
  border-radius: 50%;
  box-shadow: 0 0 12px rgba(227,252,2,0.8);
  animation: biDotPulse 2.5s ease-in-out infinite;
}

@keyframes biDotPulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(227,252,2,0.8); }
  50%      { box-shadow: 0 0 0 12px rgba(227,252,2,0); }
}

.bi-hero__title {
  font-size: clamp(3.5rem, 9vw, 6.5rem);
  font-weight: 900;
  letter-spacing: -0.055em;
  line-height: 1.3;
  margin-bottom: 2rem;
  padding-bottom: 0.2em;
  overflow: visible;
}

/* Neon Yellow Gradient */
.bi-hero-accent {
  background: linear-gradient(135deg, 
    rgba(227,252,2,0.9) 0%, 
    var(--bi-accent) 50%, 
    rgba(227,252,2,0.7) 100%
  );
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  display: inline-block;
  filter: drop-shadow(0 0 20px rgba(227,252,2,0.3));
}

.bi-hero__subtitle {
  font-size: clamp(1.25rem, 2.5vw, 1.875rem);
  color: var(--bi-muted);
  line-height: 1.75;
  margin-bottom: 3rem;
  max-width: 800px;
  margin-left: auto;
  margin-right: auto;
}

.bi-hero__description {
  font-size: 1.125rem;
  color: rgba(255,255,255,0.7);
  line-height: 1.7;
  margin-bottom: 3.5rem;
  max-width: 680px;
  margin-left: auto;
  margin-right: auto;
}

/* Waitlist CTA - Premium Neon */
.btn-waitlist {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  background: var(--bi-accent);
  color: #000;
  border: none;
  border-radius: 14px;
  padding: 1.25rem 3rem;
  font-weight: 800;
  font-size: 1.125rem;
  cursor: pointer;
  text-decoration: none;
  letter-spacing: 0.01em;
  position: relative;
  overflow: hidden;
  box-shadow: 
    0 0 20px rgba(227,252,2,0.4),
    0 10px 36px rgba(227,252,2,0.3);
  animation: waitlistPulse 2.5s infinite ease-in-out;
  transition: transform 0.3s ease;
}

@keyframes waitlistPulse {
  0%, 100% { 
    box-shadow: 
      0 0 20px rgba(227,252,2,0.4),
      0 10px 36px rgba(227,252,2,0.3);
  }
  50% { 
    box-shadow: 
      0 0 35px rgba(227,252,2,0.7),
      0 14px 48px rgba(227,252,2,0.5);
  }
}

.btn-waitlist:hover {
  transform: translateY(-3px) scale(1.03);
  animation-play-state: paused;
}

.btn-waitlist svg {
  width: 20px;
  height: 20px;
  stroke: currentColor;
  flex-shrink: 0;
}

/* ================================================
   UNIFIED CAPABILITIES GRID
   ================================================ */

.bi-capabilities {
  padding: 120px 5% 100px;
  max-width: 1500px;
  margin: 0 auto;
  position: relative;
}

.bi-capabilities__header {
  text-align: center;
  margin-bottom: 5rem;
}

.bi-capabilities__label {
  font-size: 0.875rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--bi-accent);
  margin-bottom: 1.25rem;
  text-shadow: 0 0 10px rgba(227,252,2,0.4);
}

.bi-capabilities__title {
  font-size: clamp(2.5rem, 5vw, 3.75rem);
  font-weight: 900;
  letter-spacing: -0.045em;
  line-height: 1.3;
  margin-bottom: 1.25rem;
  padding-bottom: 0.15em;
  overflow: visible;
}

.bi-capabilities__subtitle {
  font-size: 1.25rem;
  color: var(--bi-muted);
  max-width: 680px;
  margin: 0 auto;
  line-height: 1.75;
}

/* Capabilities Grid */
.capabilities-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 2rem;
}

@media screen and (min-width: 1024px) {
  .capabilities-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* Glass Feature Card - Neon Theme */
.capability-card {
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(25px) saturate(145%);
  -webkit-backdrop-filter: blur(25px) saturate(145%);
  border: 1px solid var(--bi-border);
  border-radius: 16px;
  padding: 2.5rem;
  position: relative;
  overflow: hidden;
  cursor: default;
  transition: all 0.4s var(--bi-smooth);
  
  /* Entrance animation */
  opacity: 0;
  transform: translateY(30px);
}

.capability-card:nth-child(1) { animation: cardFadeIn 0.6s ease 0.1s forwards; }
.capability-card:nth-child(2) { animation: cardFadeIn 0.6s ease 0.2s forwards; }
.capability-card:nth-child(3) { animation: cardFadeIn 0.6s ease 0.3s forwards; }
.capability-card:nth-child(4) { animation: cardFadeIn 0.6s ease 0.4s forwards; }

@keyframes cardFadeIn {
  to { opacity: 1; transform: translateY(0); }
}

.capability-card:hover {
  border-color: rgba(227,252,2,0.4);
  transform: translateY(-8px);
  box-shadow: 
    0 10px 40px rgba(227,252,2,0.2),
    inset 0 0 0 1px rgba(227,252,2,0.1);
}

/* Top edge neon seam */
.capability-card::after {
  content: '';
  position: absolute;
  top: 0;
  left: 15%;
  right: 15%;
  height: 1px;
  background: linear-gradient(90deg, 
    transparent 0%, 
    var(--bi-accent) 50%, 
    transparent 100%
  );
  box-shadow: 0 0 8px rgba(227,252,2,0.6);
  pointer-events: none;
  z-index: 2;
}

.capability-card > * { position: relative; z-index: 1; }

.capability-card__icon {
  width: 64px;
  height: 64px;
  background: rgba(227,252,2,0.08);
  border: 1px solid rgba(227,252,2,0.2);
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 1.75rem;
  transition: all 0.4s ease;
  box-shadow: inset 0 0 20px rgba(227,252,2,0.05);
}

.capability-card:hover .capability-card__icon {
  background: rgba(227,252,2,0.15);
  border-color: rgba(227,252,2,0.5);
  transform: scale(1.08);
  box-shadow: 
    0 6px 20px rgba(227,252,2,0.3),
    inset 0 0 30px rgba(227,252,2,0.1);
}

.capability-card__icon svg {
  width: 32px;
  height: 32px;
  stroke: var(--bi-accent);
  fill: none;
  stroke-width: 2;
  filter: drop-shadow(0 0 4px rgba(227,252,2,0.6));
}

.capability-card__title {
  font-size: 1.625rem;
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1.3;
  margin-bottom: 1rem;
  padding-bottom: 0.1em;
  overflow: visible;
}

.capability-card__description {
  font-size: 1rem;
  color: var(--bi-muted);
  line-height: 1.75;
  margin-bottom: 1.75rem;
}

.capability-card__features {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.capability-feature {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  font-size: 0.9375rem;
  color: rgba(255,255,255,0.8);
  line-height: 1.65;
}

/* Neon yellow bullet dots */
.capability-feature::before {
  content: '';
  width: 6px;
  height: 6px;
  background: var(--bi-accent);
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 0.55em;
  box-shadow: 0 0 8px rgba(227,252,2,0.7);
}

/* ================================================
   EARLY ACCESS & PILOT SECTIONS
   ================================================ */

.bi-access-section {
  padding: 100px 5% 120px;
  max-width: 1200px;
  margin: 0 auto;
  position: relative;
}

.bi-access-section__header {
  text-align: center;
  margin-bottom: 4rem;
}

.bi-access-section__label {
  font-size: 0.875rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--bi-accent);
  margin-bottom: 1rem;
  text-shadow: 0 0 10px rgba(227,252,2,0.4);
}

.bi-access-section__title {
  font-size: clamp(2.25rem, 4vw, 3.25rem);
  font-weight: 900;
  letter-spacing: -0.04em;
  line-height: 1.3;
  margin-bottom: 1rem;
  padding-bottom: 0.15em;
  overflow: visible;
}

.bi-access-section__subtitle {
  font-size: 1.125rem;
  color: var(--bi-muted);
  max-width: 620px;
  margin: 0 auto;
  line-height: 1.7;
}

/* Interactive Cohort Tiles */
.cohort-tiles {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 2rem;
}

.cohort-tile {
  background: rgba(255,255,255,0.04);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(227,252,2,0.15);
  border-radius: 20px;
  padding: 2.5rem;
  position: relative;
  overflow: hidden;
  cursor: pointer;
  transition: all 0.4s var(--bi-smooth);
}

/* Radial glow on hover */
.cohort-tile::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 0;
  height: 0;
  background: radial-gradient(circle, rgba(227,252,2,0.12) 0%, transparent 70%);
  transition: all 0.5s ease;
  pointer-events: none;
}

.cohort-tile:hover {
  border-color: rgba(227,252,2,0.5);
  transform: translateY(-8px) scale(1.02);
  box-shadow: 
    0 12px 40px rgba(227,252,2,0.25),
    inset 0 0 0 1px rgba(227,252,2,0.1);
}

.cohort-tile:hover::before {
  width: 500px;
  height: 500px;
}

.cohort-tile__badge {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  background: rgba(227,252,2,0.12);
  border: 1px solid rgba(227,252,2,0.3);
  border-radius: 8px;
  padding: 0.375rem 0.875rem;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--bi-accent);
  margin-bottom: 1.5rem;
  box-shadow: 0 0 10px rgba(227,252,2,0.2);
}

.cohort-tile__badge svg {
  width: 12px;
  height: 12px;
  stroke: currentColor;
}

.cohort-tile__title {
  font-size: 1.75rem;
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1.3;
  margin-bottom: 1rem;
  padding-bottom: 0.1em;
  overflow: visible;
}

.cohort-tile__description {
  font-size: 1rem;
  color: var(--bi-muted);
  line-height: 1.7;
  margin-bottom: 2rem;
}

.cohort-tile__benefits {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  margin-bottom: 2rem;
}

.cohort-benefit {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  font-size: 0.9375rem;
  color: rgba(255,255,255,0.85);
  line-height: 1.6;
}

/* Neon yellow checkmarks */
.cohort-benefit::before {
  content: '✓';
  width: 20px;
  height: 20px;
  background: rgba(227,252,2,0.15);
  border: 1px solid rgba(227,252,2,0.35);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--bi-accent);
  box-shadow: 0 0 8px rgba(227,252,2,0.3);
}

.cohort-tile__cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.625rem;
  width: 100%;
  background: var(--bi-accent);
  color: #000;
  border: none;
  border-radius: 12px;
  padding: 1rem 2rem;
  font-weight: 800;
  font-size: 0.9375rem;
  text-decoration: none;
  letter-spacing: 0.01em;
  transition: all 0.3s ease;
  box-shadow: 0 4px 16px rgba(227,252,2,0.3);
}

.cohort-tile:hover .cohort-tile__cta {
  transform: translateY(-2px);
  box-shadow: 0 8px 28px rgba(227,252,2,0.5);
}

.cohort-tile__cta svg {
  width: 16px;
  height: 16px;
  stroke: currentColor;
}

/* Premium Pilot variant - Darker with stronger glow */
.cohort-tile--pilot {
  border: 1px solid rgba(227,252,2,0.2);
  background: rgba(255,255,255,0.02);
}

.cohort-tile--pilot:hover {
  border-color: rgba(227,252,2,0.6);
  box-shadow: 
    0 12px 40px rgba(227,252,2,0.3),
    inset 0 0 0 1px rgba(227,252,2,0.15);
}

.cohort-tile--pilot::before {
  background: radial-gradient(circle, rgba(227,252,2,0.15) 0%, transparent 70%);
}

.cohort-tile--pilot .cohort-tile__badge {
  background: rgba(227,252,2,0.15);
  border-color: rgba(227,252,2,0.4);
}

.cohort-tile--pilot .cohort-tile__cta {
  background: transparent;
  color: var(--bi-accent);
  border: 2px solid var(--bi-accent);
}

.cohort-tile--pilot:hover .cohort-tile__cta {
  background: var(--bi-accent);
  color: #000;
}

/* ================================================
   RESPONSIVE
   ================================================ */

@media screen and (max-width: 1024px) {
  .bi-status-pill {
    position: static;
    margin: 0 auto 2rem;
  }

  .capabilities-grid {
    grid-template-columns: 1fr;
  }
}

@media screen and (max-width: 640px) {
  .bi-hero {
    padding: 140px 4% 100px;
  }

  .bi-hero__title {
    font-size: clamp(2.75rem, 12vw, 4rem);
  }

  .capability-card {
    padding: 2rem 1.5rem;
  }

  .cohort-tiles {
    grid-template-columns: 1fr;
  }

  .cohort-tile {
    padding: 2rem 1.5rem;
  }
}

.heavy-headline {
  line-height: 1.3;
  padding-bottom: 10px;
  display: block;
  overflow: visible;
}

</style>

<!-- Creative background -->
<div class="bi-background"></div>

<!-- Animated data lines -->
<div class="bi-data-flow">
  <div class="flow-line"></div>
  <div class="flow-line"></div>
  <div class="flow-line"></div>
  <div class="flow-line"></div>
</div>

<div class="bi-page">

  <!-- ========================================
       HERO SECTION
       ======================================== -->
  <section class="bi-hero">
    <div class="bi-status-pill">
      <span class="bi-status-pill__indicator"></span>
      <span class="bi-status-pill__text">
        <span class="bi-status-pill__label">Status</span>
        <span class="bi-status-pill__value">Pilot Phase</span>
      </span>
    </div>

    <p class="bi-hero__eyebrow">Tenda BI Platform</p>
    
    <h1 class="bi-hero__title heavy-headline">
      <span class="bi-hero-accent">Your retail BI workspace.</span>
    </h1>
    
    <p class="bi-hero__subtitle">
      Unified data. Real-time insights. No more spreadsheets.
    </p>

    <p class="bi-hero__description">
      Connect your POS, eCommerce, and inventory systems into one intelligent workspace. Track profitability, identify dead stock, and understand customer behavior all in real time.
    </p>

    <a href="#waitlist" class="btn-waitlist">
      Join the Platform Waitlist
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
      </svg>
    </a>
  </section>

  <!-- Distinct Divider -->
  <div class="section-divider" 
       style="
          width: 100%;
          height: 2px;
          margin: 3rem 0 4rem 0;
          background: linear-gradient(
              90deg,
              transparent 0%,
              rgba(227, 252, 2, 0.6) 20%,
              rgba(227, 252, 2, 1) 50%,
              rgba(227, 252, 2, 0.6) 80%,
